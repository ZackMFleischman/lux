{
  "format": "lux-scene",
  "version": 4,
  "source": {
    "sourceVersion": 2,
    "sdkVersion": "0.4.0",
    "entry": "visual.ts",
    "files": {
      "background.ts": "import {\n  AdditiveBlending,\n  BufferAttribute,\n  BufferGeometry,\n  DoubleSide,\n  Group,\n  Mesh,\n  MeshBasicNodeMaterial,\n  PlaneGeometry,\n} from 'three/webgpu';\nimport { color, exp, float, mix, sin, uniform, uv, vec2 } from 'three/tsl';\n\n/**\n * Scene-local backdrop for living-pearl.ts; no lights, textures, noise, or\n * renderer changes. The pearl remains the brightest and most detailed object.\n *\n * Integration:\n *   import { createPearlHabitat } from './background.ts';\n *   const habitat = createPearlHabitat();\n *   scene.add(habitat.group);\n *   // update(frame), after time.value has been updated:\n *   habitat.update(time.value);\n *   // dispose():\n *   habitat.dispose();\n *\n * Include this file in the complete submitted source bundle. This proposal has\n * not been built in Studio. Keep the existing dark scene.background and motes.\n */\nexport function createPearlHabitat() {\n  const group = new Group();\n  const clock = uniform(0);\n  const audioPulse = uniform(0);\n  const planeGeometry = new PlaneGeometry(24, 15);\n  const planeMaterial = new MeshBasicNodeMaterial({ depthWrite: false });\n  const p = uv().sub(0.5).mul(vec2(1.6, 1));\n\n  // Only trigonometric fields: broad drifting folds, with no recursive noise\n  // expansion. Named variables keep generated WGSL compact.\n  const warp = sin(p.y.mul(5.2).add(clock.mul(0.055))).mul(0.105).toVar();\n  const leftDistance = p.x.add(0.34).add(warp).add(audioPulse.mul(0.035)).toVar();\n  const rightDistance = p.x.sub(0.38).sub(warp.mul(0.7)).sub(audioPulse.mul(0.035)).toVar();\n  const leftVeil = exp(leftDistance.mul(leftDistance).mul(-38)).toVar();\n  const rightVeil = exp(rightDistance.mul(rightDistance).mul(-24)).toVar();\n  const leftThreads = sin(leftDistance.mul(93).add(p.y.mul(9)).add(clock.mul(0.09)))\n    .mul(0.5).add(0.5).pow(5).mul(0.24).add(0.76);\n  const rightThreads = sin(rightDistance.mul(67).sub(p.y.mul(12)).sub(clock.mul(0.07)))\n    .mul(0.5).add(0.5).pow(4).mul(0.2).add(0.8);\n  const verticalFade = exp(p.y.mul(p.y).mul(-2.7));\n  const radius = p.mul(vec2(1.05, 1.4)).length().toVar();\n  const centralShelter = float(1).sub(exp(radius.mul(radius).mul(-18)).mul(0.91));\n  const lowMist = exp(p.y.add(0.29).pow(2).mul(-24))\n    .mul(exp(p.x.mul(p.x).mul(-1.9)));\n  const base = mix(color('#010309'), color('#10102b'), radius.mul(1.4).clamp(0, 1));\n  planeMaterial.colorNode = base\n    .add(color('#0c7f80').mul(leftVeil).mul(leftThreads).mul(0.32))\n    .add(color('#69377c').mul(rightVeil).mul(rightThreads).mul(0.38))\n    .add(color('#193958').mul(lowMist).mul(0.26))\n    .mul(verticalFade.mul(0.6).add(0.4))\n    .mul(centralShelter.mul(0.75).add(0.25)).mul(audioPulse.mul(1.2).add(0.85));\n  const plane = new Mesh(planeGeometry, planeMaterial);\n  plane.position.set(0, 0, -7);\n  plane.renderOrder = -20;\n  group.add(plane);\n\n  const membranes = new Group();\n  group.add(membranes);\n  const membraneGeometries: BufferGeometry[] = [];\n  const membraneMaterials: MeshBasicNodeMaterial[] = [];\n\n  // Real tapered ribbons frame the outer edges, like enormous translucent gills.\n  // Their depth stays behind the subject. Each has just 84 triangles.\n  for (let i = 0; i < 6; i++) {\n    const side = i < 3 ? -1 : 1;\n    const layer = i % 3;\n    const segments = 42;\n    const positions: number[] = [];\n    const coordinates: number[] = [];\n    const indices: number[] = [];\n    for (let j = 0; j <= segments; j++) {\n      const t = j / segments;\n      const y = (t - 0.5) * 9;\n      const arch = Math.sin(t * Math.PI);\n      const x = side * (3.0 + layer * 0.61 - arch * 0.52\n        + Math.sin(t * 7.4 + layer * 0.9) * 0.17);\n      const width = Math.pow(arch, 1.1) * (0.28 + layer * 0.08);\n      const z = -3.7 - layer * 0.65 + Math.sin(t * 5 + layer) * 0.27;\n      positions.push(x - width, y, z, x + width, y, z);\n      coordinates.push(0, t, 1, t);\n      if (j < segments) {\n        const k = j * 2;\n        indices.push(k, k + 1, k + 2, k + 1, k + 3, k + 2);\n      }\n    }\n    const geometry = new BufferGeometry();\n    geometry.setAttribute('position', new BufferAttribute(new Float32Array(positions), 3));\n    geometry.setAttribute('uv', new BufferAttribute(new Float32Array(coordinates), 2));\n    geometry.setIndex(indices);\n    const material = new MeshBasicNodeMaterial({\n      transparent: true,\n      depthWrite: false,\n      side: DoubleSide,\n      blending: AdditiveBlending,\n    });\n    const edgeFade = sin(uv().x.mul(Math.PI)).clamp(0, 1).pow(1.8);\n    const endFade = sin(uv().y.mul(Math.PI)).clamp(0, 1).pow(0.7);\n    const ribs = sin(uv().y.mul(112).add(uv().x.mul(5)).add(clock.mul(0.08)))\n      .mul(0.5).add(0.5).pow(8);\n    material.colorNode = color(side < 0 ? '#28cbb8' : '#9d57d0');\n    material.opacityNode = edgeFade.mul(endFade).mul(ribs.mul(0.055).add(0.035));\n    const mesh = new Mesh(geometry, material);\n    mesh.renderOrder = -10 + layer;\n    membranes.add(mesh);\n    membraneGeometries.push(geometry);\n    membraneMaterials.push(material);\n  }\n\n  return {\n    group,\n    update(timeSeconds: number, bass = 0, mids = 0) {\n      clock.value = timeSeconds;\n      audioPulse.value = Math.max(0, Math.min(1, bass));\n      group.position.x = Math.sin(timeSeconds * 0.9) * mids * 0.7;\n      membranes.scale.x = 1 + bass * 0.12;\n      membranes.scale.y = 1 + bass * 0.025;\n      membranes.rotation.z = Math.sin(timeSeconds * 0.055) * 0.014;\n      membranes.position.y = Math.sin(timeSeconds * 0.07) * 0.045;\n    },\n    dispose() {\n      planeGeometry.dispose();\n      planeMaterial.dispose();\n      for (const geometry of membraneGeometries) geometry.dispose();\n      for (const material of membraneMaterials) material.dispose();\n    },\n  };\n}\n\r\n\r\n",
      "echo-tentacles.ts": "import {\n  AdditiveBlending,\n  BufferAttribute,\n  BufferGeometry,\n  DoubleSide,\n  DynamicDrawUsage,\n  Group,\n  Mesh,\n  MeshBasicNodeMaterial,\n  Vector3, Color,\n} from 'three/webgpu';\nimport { attribute, sin, uv } from 'three/tsl';\n\n/**\n * Bounded, real temporal echoes of the CPU-deformed body geometry.\n *\n * const echoes = createEchoTentacles(body);\n * scene.add(echoes.group); // Scene sibling, never a child of body/organism.\n *\n * After deform(), body rotations, and organism transforms in update(frame):\n *   echoes.update(frame.timeSeconds);\n * Use Lux scene time, NOT scaled life time: speed zero still allows an edited\n * shape to propagate into its trail while playback runs. Paused time freezes it.\n * reset(): echoes.reset();\n * dispose(): echoes.dispose();\n *\n * Root samples come from actual geometry positions, including image morphs.\n * This is geometry history, not renderer feedback or a synchronized fake wave.\n * Standalone proposal; build and visually inspect after integration.\n */\nexport function createEchoTentacles(body: Mesh) {\n  const group = new Group();\n  const count = 12;\n  const segments = 224;\n  const rate = 30;\n  const capacity = 182;\n  const stride = count * 3;\n  const history = new Float32Array(capacity * stride);\n  const previous = new Float32Array(stride);\n  const current = new Float32Array(stride);\n  const anchorIndices = new Uint32Array(count);\n  const directions = new Float32Array(count * 2);\n  const geometries: BufferGeometry[] = [];\n  const attributes: BufferAttribute[] = [];\n  const materials: MeshBasicNodeMaterial[] = [];\n  const point = new Vector3();\n  const centers = new Float32Array((segments + 1) * 3);\n  const widths = new Float32Array(segments + 1);\n  const smoothed = new Float32Array((segments + 1) * 3);\n  let previousTime = Number.NaN;\n  let oldestTick = 0;\n  let latestTick = 0;\n\n    const material = new MeshBasicNodeMaterial({\n      transparent: true,\n      depthWrite: false,\n      side: DoubleSide,\n      blending: AdditiveBlending,\n    });\n    material.colorNode = attribute('trailColor', 'vec3');\n    const crossFade = sin(uv().x.mul(Math.PI)).clamp(0, 1).pow(2.0);\n    // Subtle longitudinal ghost lines and a disappearing end.\n    const strand = sin(uv().x.mul(Math.PI * 5)).pow(2).mul(0.3).add(0.7);\n    material.opacityNode = crossFade.mul(strand).mul(uv().y.oneMinus().pow(0.85)).mul(0.32);\n\n  const source = body.geometry.getAttribute('position');\n  const rest = body.geometry.getAttribute('restPosition') ?? source;\n  for (let i = 0; i < count; i++) {\n    // Full crown with a slight bottom bias, deliberately uneven lengths.\n    const angle = (i / count) * Math.PI * 2 + 0.12;\n    const dx = Math.cos(angle);\n    const dy = Math.sin(angle);\n    directions[i * 2] = dx;\n    directions[i * 2 + 1] = dy;\n    let best = -Infinity;\n    for (let v = 0; v < rest.count; v++) {\n      const x = rest.getX(v);\n      const y = rest.getY(v);\n      const z = rest.getZ(v);\n      const length = Math.hypot(x, y, z) || 1;\n      const score = (x * dx * 0.94 + y * dy * 0.94 - z * 0.34) / length;\n      if (score > best) {\n        best = score;\n        anchorIndices[i] = v;\n      }\n    }\n\n    const positions = new Float32Array((segments + 1) * 2 * 3);\n    const coordinates = new Float32Array((segments + 1) * 2 * 2);\n    const indices: number[] = [];\n    for (let j = 0; j <= segments; j++) {\n      coordinates.set([0, j / segments, 1, j / segments], j * 4);\n      if (j < segments) {\n        const k = j * 2;\n        indices.push(k, k + 1, k + 2, k + 1, k + 3, k + 2);\n      }\n    }\n    const palette = ['#42b8ac', '#ad83d1', '#d78391', '#d4b783'];\n    const startColor = new Color(palette[i % 4]);\n    const endColor = new Color(palette[(i + 1) % 4]);\n    const colors = new Float32Array((segments + 1) * 6);\n    for (let j = 0; j <= segments; j++) {\n      const t = j / segments;\n      const r = startColor.r + (endColor.r - startColor.r) * t;\n      const g = startColor.g + (endColor.g - startColor.g) * t;\n      const b = startColor.b + (endColor.b - startColor.b) * t;\n      colors.set([r, g, b, r, g, b], j * 6);\n    }\n    const geometry = new BufferGeometry();\n    geometry.setAttribute('trailColor', new BufferAttribute(colors, 3));\n    const attribute = new BufferAttribute(positions, 3).setUsage(DynamicDrawUsage);\n    geometry.setAttribute('position', attribute);\n    geometry.setAttribute('uv', new BufferAttribute(coordinates, 2));\n    geometry.setIndex(indices);\n    const mesh = new Mesh(geometry, material);\n    mesh.frustumCulled = false;\n    group.add(mesh);\n    geometries.push(geometry);\n    attributes.push(attribute);\n    if (i === 0) materials.push(material);\n  }\n\n  function capture() {\n    body.updateWorldMatrix(true, false);\n    const position = body.geometry.getAttribute('position');\n    for (let i = 0; i < count; i++) {\n      const v = anchorIndices[i];\n      point.set(position.getX(v), position.getY(v), position.getZ(v));\n      point.applyMatrix4(body.matrixWorld);\n      current[i * 3] = point.x;\n      current[i * 3 + 1] = point.y;\n      current[i * 3 + 2] = point.z;\n    }\n  }\n\n  function initialize(t: number) {\n    latestTick = Math.floor(t * rate);\n    oldestTick = latestTick - capacity + 1;\n    for (let i = 0; i < capacity; i++) history.set(current, i * stride);\n    previous.set(current);\n    previousTime = t;\n  }\n\n  function historySample(sample: number, channel: number) {\n    const bounded = Math.max(oldestTick, Math.min(latestTick, sample));\n    return history[((bounded % capacity + capacity) % capacity) * stride + channel];\n  }\n\n  function historyValue(target: number, channel: number) {\n    const tick = Math.max(oldestTick, Math.min(latestTick, target));\n    const low = Math.floor(tick);\n    const a = historySample(low - 1, channel);\n    const b = historySample(low, channel);\n    const c = historySample(low + 1, channel);\n    const d = historySample(low + 2, channel);\n    const f = tick - low;\n    return b + 0.5 * f * (c - a + f * (2 * a - 5 * b + 4 * c - d + f * (3 * (b - c) + d - a)));\n  }\n\n  return {\n    group,\n    update(t: number) {\n      capture();\n      if (!Number.isFinite(previousTime) || t < previousTime || t - previousTime > 6) {\n        initialize(t);\n      } else if (t === previousTime) {\n        // Paused edits change only the newest endpoint, never advance history.\n        history.set(current, ((latestTick % capacity + capacity) % capacity) * stride);\n      } else {\n        const nextTick = Math.floor(t * rate);\n        for (let tick = latestTick + 1; tick <= nextTick; tick++) {\n          const alpha = Math.max(0, Math.min(1, (tick / rate - previousTime) / (t - previousTime)));\n          const offset = ((tick % capacity + capacity) % capacity) * stride;\n          for (let k = 0; k < stride; k++) {\n            history[offset + k] = previous[k] + (current[k] - previous[k]) * alpha;\n          }\n        }\n        latestTick = nextTick;\n        oldestTick = latestTick - capacity + 1;\n      }\n\n      for (let i = 0; i < count; i++) {\n        const dx = directions[i * 2];\n        const dy = directions[i * 2 + 1];\n        const length = 2.35 + (i % 4) * 0.28;\n        const channel = i * 3;\n        const attribute = attributes[i];\n        for (let j = 0; j <= segments; j++) {\n          const s = j / segments;\n          const delayedTick = t * rate - s * 5.4 * rate;\n          const hx = j === 0 ? current[channel] : historyValue(delayedTick, channel);\n          const hy = j === 0 ? current[channel + 1] : historyValue(delayedTick, channel + 1);\n          const hz = j === 0 ? current[channel + 2] : historyValue(delayedTick, channel + 2);\n          // The lateral shape comes from prior surface positions. The slow\n          // bend is spatial shaping, not the source of temporal propagation.\n          const curl = Math.sin(s * 5.8 + i * 0.7) * s * 0.31;\n          const x = hx + dx * length * s - dy * curl;\n          const y = hy + dy * length * s + dx * curl - s * s * 0.55;\n          const z = Math.min(-0.3, hz) - 0.55 - s * 2.6;\n          const width = (0.035 + (i % 3) * 0.01) * Math.pow(1 - s, 0.7)\n            * (0.85 + Math.hypot(hx, hy) * 0.24);\n          centers[j * 3] = x;\n          centers[j * 3 + 1] = y;\n          centers[j * 3 + 2] = z;\n          widths[j] = width;\n        }\n        // Smooth the sampled historical centerline before orienting its ribbon.\n        for (let pass = 0; pass < 4; pass++) {\n          smoothed.set(centers);\n          for (let j = 1; j < segments; j++) {\n            for (let axis = 0; axis < 3; axis++) {\n              centers[j * 3 + axis] = (smoothed[(j - 1) * 3 + axis]\n                + 2 * smoothed[j * 3 + axis] + smoothed[(j + 1) * 3 + axis]) * 0.25;\n            }\n          }\n        }\n        for (let j = 0; j <= segments; j++) {\n          const before = Math.max(0, j - 1) * 3;\n          const after = Math.min(segments, j + 1) * 3;\n          const tx = centers[after] - centers[before];\n          const ty = centers[after + 1] - centers[before + 1];\n          const inverse = 1 / Math.max(0.00001, Math.hypot(tx, ty));\n          const nx = -ty * inverse;\n          const ny = tx * inverse;\n          const x = centers[j * 3];\n          const y = centers[j * 3 + 1];\n          const z = centers[j * 3 + 2];\n          attribute.setXYZ(j * 2, x - nx * widths[j], y - ny * widths[j], z);\n          attribute.setXYZ(j * 2 + 1, x + nx * widths[j], y + ny * widths[j], z);\n        }\n        attribute.needsUpdate = true;\n      }\n      previous.set(current);\n      previousTime = t;\n    },\n    reset() {\n      previousTime = Number.NaN;\n    },\n    dispose() {\n      for (const geometry of geometries) geometry.dispose();\n      for (const material of materials) material.dispose();\n    },\n  };\n}\n\r\n\r\n\r\n",
      "kaleidoscope.ts": "import { defineComponent } from '@lux/visual-sdk';\nimport {\n  DataTexture,\n  Mesh,\n  MeshBasicNodeMaterial,\n  OrthographicCamera,\n  PlaneGeometry,\n  Scene,\n  Texture, Vector2,\n} from 'three/webgpu';\nimport { abs, atan, cos, float, mix, mod, sin, texture, uniform, uv, vec2 } from 'three/tsl';\n\n/**\n * SDK0.4 image leaf. Wire scene.image -> kaleidoscope.image, then use its image\n * as root output. Expose kaleidoAmount, kaleidoCycle, kaleidoPeriod, and sectors.\n * Cycle off = manual Amount; cycle on = occasional eased mirror excursion.\n * Uses the same linear/premultiplied image and render-target Y convention as the\n * shipped Gaussian Blur component. No texture copies, pixel reads, or feedback.\n * Source proposal only: validate in the composed Studio scene before delivery.\n */\nexport default defineComponent({\n  metadata: {\n    declarationVersion: 1,\n    key: 'effects/pearl-kaleidoscope',\n    label: 'Kaleidoscope Dream',\n    description: 'The whole scene gently folds into a radial mirror, lingers, and returns to its original view.',\n    tags: ['mirror', 'kaleidoscope', 'effect'],\n    inputs: {\n      image: {\n        type: { kind: 'image', colorSpace: 'linear-srgb', alphaMode: 'premultiplied' },\n        label: 'Scene',\n        description: 'Complete scene image to mirror.',\n      },\n    },\n    outputs: {\n      image: {\n        type: { kind: 'image', colorSpace: 'linear-srgb', alphaMode: 'premultiplied' },\n        label: 'Image',\n        description: 'Scene with a smoothly animated mirror transformation.',\n      },\n    },\n    controls: {\n      kaleidoDuration: { type: 'number', label: 'Dream duration', group: 'Mirror', default: 24, min: 8, max: 90, step: 1, unit: 's' },\n      kaleidoMotion: { type: 'number', label: 'Dream motion', group: 'Mirror', default: 0.7, min: 0, max: 1, step: 0.01 },\n      kaleidoAmount: {\n        type: 'number', label: 'Mirror strength', group: 'Mirror',\n        default: 1, min: 0, max: 1, step: 0.01,\n      },\n      kaleidoCycle: {\n        type: 'boolean', label: 'Occasional dream', group: 'Mirror', default: true,\n      },\n      kaleidoPeriod: {\n        type: 'number', label: 'Normal gap', group: 'Mirror',\n        default: 36, min: 12, max: 120, step: 1, unit: 's',\n      },\n      sectors: {\n        type: 'number', label: 'Mirror petals', group: 'Mirror',\n        default: 6, min: 3, max: 10, step: 1,\n      },\n    },\n    controlDescriptions: {\n      kaleidoDuration: 'Seconds for smooth entry, an extended mirrored hold and smooth return.',\n      kaleidoMotion: 'Amount of gentle rotation, drift and breathing zoom during the mirrored view.',\n      kaleidoAmount: 'Maximum mirror strength in automatic mode, or direct strength with Occasional dream off.',\n      kaleidoCycle: 'Leave the scene normal for most of each interval, then smoothly enter and leave a radial mirror.',\n      kaleidoPeriod: 'Normal-view pause in scene-clock seconds between mirrored excursions.',\n      sectors: 'Number of mirrored radial petals; rounded to a whole number.',\n    },\n    lifecycle: { state: 'stateful', reset: 'seed' },\n  },\n  async create(context) {\n    const variantSeed = context.random() * Math.PI * 2;\n    const fallback = new DataTexture(new Uint8Array([0, 0, 0, 0]), 1, 1);\n    fallback.needsUpdate = true;\n    const strength = uniform(0);\n    const aspect = uniform(1);\n    const spin = uniform(0);\n    const sourceAngle = uniform(variantSeed);\n    const zoom = uniform(1);\n    const drift = uniform(new Vector2(0, 0));\n    const sectorCount = uniform(6);\n    const coordinates = uv().flipY();\n    const p = coordinates.sub(0.5).mul(vec2(aspect, 1)).toVar();\n    const radius = p.length().mul(zoom).toVar();\n    const sectorAngle = float(Math.PI * 2).div(sectorCount).toVar();\n    const angle = atan(p.y, p.x).add(Math.PI * 2).add(spin);\n    const folded = abs(mod(angle.add(sectorAngle.mul(0.5)), sectorAngle)\n      .sub(sectorAngle.mul(0.5)));\n    // Sample an upper diagonal of the pearl; alternating reflected wedges stay\n    // continuous at their borders. Aspect correction keeps the petals round.\n    const sampleAngle = folded.add(sourceAngle);\n    const mirrored = vec2(cos(sampleAngle), sin(sampleAngle))\n      .mul(radius).div(vec2(aspect, 1)).add(0.5).add(drift).clamp(0.001, 0.999);\n    const warpedCoordinates = mix(coordinates, mirrored, strength);\n    const originalSample = texture(fallback, coordinates);\n    const warpedSample = texture(fallback, warpedCoordinates);\n    const geometry = new PlaneGeometry(2, 2);\n    const material = new MeshBasicNodeMaterial({ depthTest: false, depthWrite: false });\n    // RGBA remains premultiplied. No extra alpha multiplication or gamma pass.\n    material.fragmentNode = mix(originalSample, warpedSample, strength);\n    material.toneMapped = false;\n    const scene = new Scene();\n    scene.add(new Mesh(geometry, material));\n    const camera = new OrthographicCamera(-1, 1, 1, -1, 0, 1);\n\n    function ease(value: number) {\n      const x = Math.max(0, Math.min(1, value));\n      return x * x * x * (x * (x * 6 - 15) + 10);\n    }\n\n    return {\n      update(frame) {\n        let envelope = 1;\n        if (frame.controls.kaleidoCycle) {\n          const total = frame.controls.kaleidoPeriod + frame.controls.kaleidoDuration;\n          const local = ((frame.timeSeconds % total) - frame.controls.kaleidoPeriod) / frame.controls.kaleidoDuration;\n          envelope = ease(local / 0.2) * (1 - ease((local - 0.8) / 0.2));\n        }\n        const cycleLength = frame.controls.kaleidoPeriod + frame.controls.kaleidoDuration;\n        const episode = Math.floor(frame.timeSeconds / cycleLength);\n        sourceAngle.value = variantSeed + episode * 2.399963229728653 + frame.timeSeconds * 0.025 * frame.controls.kaleidoMotion;\n        spin.value = frame.timeSeconds * 0.06 * frame.controls.kaleidoMotion;\n        zoom.value = 1 + Math.sin(frame.timeSeconds * 0.19) * 0.08 * frame.controls.kaleidoMotion;\n        drift.value.set(Math.sin(frame.timeSeconds * 0.13) * 0.025 * frame.controls.kaleidoMotion, Math.cos(frame.timeSeconds * 0.17) * 0.025 * frame.controls.kaleidoMotion);\n        strength.value = frame.controls.kaleidoAmount * envelope;\n        sectorCount.value = Math.round(frame.controls.sectors);\n      },\n      async evaluate(inputs, evaluation) {\n        const image = inputs.image.texture as Texture;\n        originalSample.value = image;\n        warpedSample.value = image;\n        aspect.value = inputs.image.width / inputs.image.height;\n        return { image: await evaluation.render(scene, camera) };\n      },\n      reset() {\n        strength.value = 0;\n      },\n      dispose() {\n        geometry.dispose();\n        material.dispose();\n        fallback.dispose();\n      },\n    };\n  },\n});\n\r\n\r\n\r\n",
      "spectral-waves.ts": "import { uniform, uv, sin } from 'three/tsl';\nimport {\n  AdditiveBlending, BufferAttribute, BufferGeometry, DoubleSide,\n  DynamicDrawUsage, Group, Mesh, MeshBasicNodeMaterial,\n} from 'three/webgpu';\n\n// Four related voices per audio band form a smoothly sampled spectral veil.\nexport function createSpectralWaves() {\n  const group = new Group();\n  const segments = 640;\n  const geometries: BufferGeometry[] = [];\n  const materials: MeshBasicNodeMaterial[] = [];\n  const attributes: BufferAttribute[] = [];\n  const glowAttributes: BufferAttribute[] = [];\n  const glowMaterials: MeshBasicNodeMaterial[] = [];\n  const glowLevels = Array.from({ length: 12 }, () => uniform(0));\n  const colors = ['#66d5c5', '#bb91e0', '#e6b87f'];\n  const spectrumHistory = Array.from({ length: 48 }, () => new Float32Array(128));\n  const centerY = new Float32Array(segments + 1);\n  const strokeWidths = new Float32Array(segments + 1);\n  let spectrumCursor = 0;\n  let spectrumTime = -1;\n  function sampleSpectrum(data: Float32Array, s: number) {\n    const p = Math.max(0, Math.min(127, s * 127));\n    const i = Math.floor(p);\n    const f = p - i;\n    const a = data[Math.max(0, i - 1)];\n    const b = data[i];\n    const c = data[Math.min(127, i + 1)];\n    const d = data[Math.min(127, i + 2)];\n    return Math.max(0, Math.min(1, b + 0.5 * f * (c - a + f * (2 * a - 5 * b + 4 * c - d + f * (3 * (b - c) + d - a)))));\n  }\n  for (let strand = 0; strand < 12; strand++) {\n    const band = strand % 3;\n    const voice = Math.floor(strand / 3);\n    const geometry = new BufferGeometry();\n    const positions = new BufferAttribute(new Float32Array((segments + 1) * 6), 3).setUsage(DynamicDrawUsage);\n    const indices: number[] = [];\n    for (let i = 0; i < segments; i++) {\n      const n = i * 2;\n      indices.push(n, n + 1, n + 2, n + 1, n + 3, n + 2);\n    }\n    geometry.setAttribute('position', positions);\n    geometry.setIndex(indices);\n    const haloGeometry = new BufferGeometry();\n    const haloPositions = new BufferAttribute(new Float32Array((segments + 1) * 6), 3).setUsage(DynamicDrawUsage);\n    haloGeometry.setAttribute('position', haloPositions);\n    haloGeometry.setIndex(indices);\n    const haloUv = new Float32Array((segments + 1) * 4);\n    for (let i = 0; i <= segments; i++) haloUv.set([0, i / segments, 1, i / segments], i * 4);\n    haloGeometry.setAttribute('uv', new BufferAttribute(haloUv, 2));\n    const haloMaterial = new MeshBasicNodeMaterial({ color: voice === 1 && band === 0 ? '#ef8d98' : colors[band], transparent: true, opacity: 0, side: DoubleSide, blending: AdditiveBlending, depthWrite: false });\n    const haloLevel = glowLevels[strand];\n    haloMaterial.opacity = 1;\n    haloMaterial.opacityNode = sin(uv().x.mul(Math.PI)).pow(2).mul(haloLevel);\n\n    const halo = new Mesh(haloGeometry, haloMaterial);\n    halo.position.z = -2.21 - band * 0.14 - voice * 0.035;\n    halo.frustumCulled = false;\n    group.add(halo);\n    geometries.push(haloGeometry);\n    glowAttributes.push(haloPositions);\n    glowMaterials.push(haloMaterial);\n    const material = new MeshBasicNodeMaterial({\n      color: voice === 1 && band === 0 ? '#ef8d98' : colors[band], transparent: true, opacity: 0,\n      side: DoubleSide, blending: AdditiveBlending, depthWrite: false,\n    });\n    const mesh = new Mesh(geometry, material);\n    mesh.position.z = -2.2 - band * 0.14 - voice * 0.035;\n    mesh.frustumCulled = false;\n    group.add(mesh);\n    geometries.push(geometry);\n    materials.push(material);\n    attributes.push(positions);\n  }\n  return {\n    group,\n    update(time: number, bass: number, mids: number, highs: number, voiceCount = 4, spectrum?: readonly number[], strength = 1) {\n      const energies = [bass, mids, highs];\n      const hasSpectrum = !!spectrum && spectrum.length > 3;\n      if (hasSpectrum && time !== spectrumTime) {\n        spectrumCursor = (spectrumCursor + 1) % spectrumHistory.length;\n        const target = spectrumHistory[spectrumCursor];\n        for (let k = 0; k < 128; k++) {\n          let sum = 0;\n          for (let offset = -2; offset <= 2; offset++) {\n            const at = Math.round(Math.max(0, Math.min(127, k + offset)) * (spectrum.length - 1) / 127);\n            sum += Math.max(0, Math.min(1, spectrum[at]));\n          }\n          target[k] = sum / 5;\n        }\n        if (spectrumTime < 0 || time < spectrumTime) for (const row of spectrumHistory) row.set(target);\n        spectrumTime = time;\n      }\n      for (let strand = 0; strand < 12; strand++) {\n        const visible = strand < Math.round(voiceCount);\n        group.children[strand * 2].visible = visible;\n        group.children[strand * 2 + 1].visible = visible;\n        if (!visible) continue;\n        const band = strand % 3;\n        const voice = Math.floor(strand / 3);\n        const energy = Math.sqrt(Math.max(0, Math.min(1, energies[band])));\n        const positions = attributes[strand];\n        const weight = hasSpectrum ? (strand === 0 ? 1 : 0.45 / (1 + strand * 0.3)) : (voice === 0 ? 1 : 0.48 - voice * 0.075);\n        const trace = spectrumHistory[(spectrumCursor - strand * 3 + spectrumHistory.length) % spectrumHistory.length];\n        const brightness = hasSpectrum ? Math.sqrt(Math.max(...trace)) : energy;\n        materials[strand].opacity = Math.min(0.8, brightness * 1.15) * weight * strength;\n        glowLevels[strand].value = brightness * 0.2 * weight * strength;\n        const haloPositions = glowAttributes[strand];\n        const frequency = (2.3 + band * 1.9) * (1 + voice * 0.137);\n        for (let i = 0; i <= segments; i++) {\n          const s = i / segments;\n          const x = (s - 0.5) * 11;\n          const envelope = Math.pow(Math.sin(s * Math.PI), 0.65);\n          const phase = x * frequency - time * (1.1 + band * 0.35 + voice * 0.09) + voice * 1.3;\n          const y = hasSpectrum ? -0.55 + sampleSpectrum(trace, s) * 1.6 * envelope - strand * 0.045 * envelope\n            : (Math.sin(phase) + Math.sin(phase * 1.618 + time * 0.4) * 0.16) * energy * (1.1 - band * 0.15) * envelope\n            + Math.sin(x * 0.6 + time * 0.13 + voice * 0.7) * 0.12 + (band - 1) * 0.1 + (voice - 1.5) * 0.1 * envelope;\n          const width = (0.018 + energy * 0.032) * envelope * (voice === 0 ? 1 : 0.5);\n          centerY[i] = y;\n          strokeWidths[i] = width;\n        }\n        const dx = 11 / segments;\n        for (let i = 0; i <= segments; i++) {\n          const previous = Math.max(0, i - 1);\n          const next = Math.min(segments, i + 1);\n          const derivative = (centerY[next] - centerY[previous]) / Math.max(dx, (next - previous) * dx);\n          const curvature = i === 0 || i === segments ? 0 : Math.abs(centerY[next] - 2 * centerY[i] + centerY[previous]) / (dx * dx * Math.pow(1 + derivative * derivative, 1.5));\n          const radius = curvature > 0.00001 ? 1 / curvature : 1000;\n          const width = Math.min(strokeWidths[i], radius * 0.3);\n          const haloWidth = Math.min(strokeWidths[i] * 5, radius * 0.7);\n          const inverse = 1 / Math.hypot(1, derivative);\n          const nx = -derivative * inverse;\n          const ny = inverse;\n          const x = (i / segments - 0.5) * 11;\n          const y = centerY[i];\n          positions.setXYZ(i * 2, x - nx * width, y - ny * width, 0);\n          positions.setXYZ(i * 2 + 1, x + nx * width, y + ny * width, 0);\n          haloPositions.setXYZ(i * 2, x - nx * haloWidth, y - ny * haloWidth, 0);\n          haloPositions.setXYZ(i * 2 + 1, x + nx * haloWidth, y + ny * haloWidth, 0);\n        }\n        positions.needsUpdate = true;\n        haloPositions.needsUpdate = true;\n      }\n    },\n    dispose() {\n      for (const geometry of geometries) geometry.dispose();\n      for (const material of materials) material.dispose();\n      for (const material of glowMaterials) material.dispose();\n    },\n  };\n}\n\r\n\r\n\r\n\r\n\r\n\r\n",
      "visual.ts": "import { defineVisual } from '@lux/visual-sdk';\nimport world from './world-component.ts';\nimport mirror from './kaleidoscope.ts';\nexport default defineVisual({\n  label: 'Living Pearl',\n  definitions: { world, mirror },\n  nodes: [{ id: 'world', definition: 'world' }, { id: 'mirror', definition: 'mirror' }],\n  edges: [{ id: 'habitat-to-mirror', from: { nodeId: 'world', portId: 'image' }, to: { nodeId: 'mirror', portId: 'image' }, delay: 'none' }],\n  output: { nodeId: 'mirror', portId: 'image' },\n  expose: [\n    { id: 'waveMode', nodeId: 'world', controlId: 'waveMode' },\n    { id: 'kaleidoDuration', nodeId: 'mirror', controlId: 'kaleidoDuration' },\n    { id: 'kaleidoMotion', nodeId: 'mirror', controlId: 'kaleidoMotion' },\n    { id: 'autoCopies', nodeId: 'world', controlId: 'autoCopies' },\n    { id: 'copyCycle', nodeId: 'world', controlId: 'copyCycle' },\n    { id: 'kickPulse', nodeId: 'world', controlId: 'kickPulse' },\n    { id: 'shockwaves', nodeId: 'world', controlId: 'shockwaves' },\n    { id: 'burstCount', nodeId: 'world', controlId: 'burstCount' },\n    { id: 'spectrumAngle', nodeId: 'world', controlId: 'spectrumAngle' },\n    { id: 'crossSpectrum', nodeId: 'world', controlId: 'crossSpectrum' },\n    { id: 'crossSpectrumAngle', nodeId: 'world', controlId: 'crossSpectrumAngle' },\n    { id: 'crossSpectrumStrength', nodeId: 'world', controlId: 'crossSpectrumStrength' },\n    { id: 'waveCount', nodeId: 'world', controlId: 'waveCount' },\n    { id: 'copies', nodeId: 'world', controlId: 'copies' },\n    { id: 'copySize', nodeId: 'world', controlId: 'copySize' },\n    { id: 'orbitSpread', nodeId: 'world', controlId: 'orbitSpread' },\n    { id: 'scalePulse', nodeId: 'world', controlId: 'scalePulse' },\n    { id: 'bassEnergy', nodeId: 'world', controlId: 'bassEnergy' },\n    { id: 'midsEnergy', nodeId: 'world', controlId: 'midsEnergy' },\n    { id: 'highsEnergy', nodeId: 'world', controlId: 'highsEnergy' },\n    { id: 'textureMix', nodeId: 'world', controlId: 'textureMix' },\n    { id: 'foldMorph', nodeId: 'world', controlId: 'foldMorph' },\n    { id: 'autoMorph', nodeId: 'world', controlId: 'autoMorph' },\n    { id: 'morphPeriod', nodeId: 'world', controlId: 'morphPeriod' },\n    { id: 'spikeHeight', nodeId: 'world', controlId: 'spikeHeight' },\n    { id: 'noiseScale', nodeId: 'world', controlId: 'noiseScale' },\n    { id: 'sharpness', nodeId: 'world', controlId: 'sharpness' },\n    { id: 'motionSpeed', nodeId: 'world', controlId: 'motionSpeed' },\n    { id: 'breath', nodeId: 'world', controlId: 'breath' },\n    { id: 'roughness', nodeId: 'world', controlId: 'roughness' },\n    { id: 'glow', nodeId: 'world', controlId: 'glow' },\n    { id: 'kaleidoAmount', nodeId: 'mirror', controlId: 'kaleidoAmount' },\n    { id: 'kaleidoCycle', nodeId: 'mirror', controlId: 'kaleidoCycle' },\n    { id: 'kaleidoPeriod', nodeId: 'mirror', controlId: 'kaleidoPeriod' },\n    { id: 'sectors', nodeId: 'mirror', controlId: 'sectors' },\n  ],\n});\n\r\n\r\n",
      "world-component.ts": "import { createSpectralWaves } from './spectral-waves.ts';\nimport { createEchoTentacles } from './echo-tentacles.ts';\nimport { createPearlHabitat } from './background.ts';\nimport { defineComponent } from '@lux/visual-sdk';\nimport {\n  Scene, Color, Mesh, SphereGeometry, MeshStandardNodeMaterial,\n  MeshBasicNodeMaterial, PerspectiveCamera, AmbientLight, DirectionalLight,\n  Group, AdditiveBlending, BufferAttribute, DynamicDrawUsage,\n  DataTexture, SRGBColorSpace, RGBAFormat, UnsignedByteType, RepeatWrapping, LinearFilter,\n} from 'three/webgpu';\nimport {\n  uniform, attribute, sin, mix, color, normalWorld, positionWorld,\n  cameraPosition, abs, pow, texture,\n} from 'three/tsl';\n\nexport default defineComponent({\n  metadata: {\n    declarationVersion: 1,\n    key: 'scenes/living-pearl',\n    label: 'Living Pearl Habitat',\n    description: 'Image-textured organic pearl, delayed geometry tentacles, spectral veil and audio-driven habitat.',\n    tags: ['organic', 'audio', 'pearl'],\n    inputs: {},\n    outputs: { image: { type: { kind: 'image', colorSpace: 'linear-srgb', alphaMode: 'premultiplied' }, label: 'Habitat', description: 'Complete living pearl habitat before post processing.' } },\n    controls: {\n      waveMode: { type: 'enum', label: 'Wave style', default: 'waves', options: [{ id: 'waves', label: 'Flowing waves' }, { id: 'spectrum', label: 'Measured FFT' }] },\n      autoCopies: { type: 'boolean', label: 'Evolving count', default: true },\n      copyCycle: { type: 'number', label: 'Companion cycle', group: 'Companions', default: 28, min: 8, max: 90, step: 1 },\n      kickPulse: { type: 'number', label: 'Kick pulse', group: 'Music', default: 0, min: 0, max: 1, step: 0.01 },\n      shockwaves: { type: 'boolean', label: 'Blob shockwaves', default: true },\n      burstCount: { type: 'number', label: 'Shockwave blobs', group: 'Companions', default: 18, min: 4, max: 32, step: 1 },\n      spectrumAngle: { type: 'number', label: 'Wave angle', group: 'Spectrum', default: 0, min: -180, max: 180, step: 1, unit: 'deg' },\n      crossSpectrum: { type: 'boolean', label: 'Crossing spectrum', default: true },\n      crossSpectrumAngle: { type: 'number', label: 'Crossing angle', group: 'Spectrum', default: 90, min: -180, max: 180, step: 1, unit: 'deg' },\n      crossSpectrumStrength: { type: 'number', label: 'Crossing strength', group: 'Spectrum', default: 0.5, min: 0, max: 1, step: 0.01 },\n      waveCount: { type: 'number', label: 'Wave voices', group: 'Spectrum', default: 4, min: 1, max: 12, step: 1 },\n      copies: { type: 'number', label: 'Copies', group: 'Companions', default: 4, min: 0, max: 12, step: 1 },\n      copySize: { type: 'number', label: 'Copy size', group: 'Companions', default: 0.23, min: 0.1, max: 0.5, step: 0.01 },\n      orbitSpread: { type: 'number', label: 'Orbit spread', group: 'Companions', default: 2.1, min: 1.4, max: 3.5, step: 0.05 },\n    scalePulse: { type: 'number', label: 'Scale pulse', group: 'Life', default: 0.2, min: 0, max: 0.6, step: 0.01 },\n    bassEnergy: { type: 'number', label: 'Bass energy', group: 'Spectrum', default: 0, min: 0, max: 1, step: 0.01 },\n    midsEnergy: { type: 'number', label: 'Mids energy', group: 'Spectrum', default: 0, min: 0, max: 1, step: 0.01 },\n    highsEnergy: { type: 'number', label: 'Highs energy', group: 'Spectrum', default: 0, min: 0, max: 1, step: 0.01 },\n    textureMix: { type: 'number', label: 'Image skin', group: 'Skin', default: 0.85, min: 0, max: 1, step: 0.01 },\n    foldMorph: { type: 'number', label: 'Fold morph', group: 'Life', default: 1, min: 0, max: 1, step: 0.01 },\n    autoMorph: { type: 'boolean', label: 'Collapse cycle', default: true },\n    morphPeriod: { type: 'number', label: 'Collapse period', group: 'Life', default: 18, min: 4, max: 90, step: 0.5 },\n    spikeHeight: { type: 'number', label: 'Fold depth', group: 'Body', default: 0.85, min: 0, max: 1.4, step: 0.01 },\n    noiseScale: { type: 'number', label: 'Fold scale', group: 'Body', default: 3.4, min: 1, max: 7, step: 0.1 },\n    sharpness: { type: 'number', label: 'Fold definition', group: 'Body', default: 3.2, min: 0.5, max: 5, step: 0.05 },\n    motionSpeed: { type: 'number', label: 'Life speed', group: 'Life', default: 0.28, min: 0, max: 1.5, step: 0.01 },\n    breath: { type: 'number', label: 'Breathing', group: 'Life', default: 0.65, min: 0, max: 1, step: 0.01 },\n    roughness: { type: 'number', label: 'Skin roughness', group: 'Skin', default: 0.38, min: 0.12, max: 0.8, step: 0.01 },\n    glow: { type: 'number', label: 'Inner glow', group: 'Skin', default: 0.65, min: 0, max: 2, step: 0.01 },\n    },\n    controlDescriptions: {\n      waveMode: 'Flowing waves restores the musical sine ribbons. Measured FFT displays real frequency magnitudes.',\n      autoCopies: 'Living Pearl autoCopies control.',\n      copyCycle: 'Living Pearl copyCycle control.',\n      kickPulse: 'Living Pearl kickPulse control.',\n      shockwaves: 'Living Pearl shockwaves control.',\n      burstCount: 'Living Pearl burstCount control.',\n      spectrumAngle: 'Living Pearl spectrumAngle control.',\n      crossSpectrum: 'Living Pearl crossSpectrum control.',\n      crossSpectrumAngle: 'Living Pearl crossSpectrumAngle control.',\n      crossSpectrumStrength: 'Living Pearl crossSpectrumStrength control.',\n      waveCount: 'Number of visible wave voices. Four keeps the band response legible.',\n      copies: 'Number of smaller companion pearls.',\n      copySize: 'Companion size relative to the main pearl.',\n      orbitSpread: 'Distance of the drifting companions from the main pearl.',\n      scalePulse: 'Living Pearl scalePulse control.',\n      bassEnergy: 'Living Pearl bassEnergy control.',\n      midsEnergy: 'Living Pearl midsEnergy control.',\n      highsEnergy: 'Living Pearl highsEnergy control.',\n      textureMix: 'Living Pearl textureMix control.',\n      foldMorph: 'Living Pearl foldMorph control.',\n      autoMorph: 'Living Pearl autoMorph control.',\n      morphPeriod: 'Living Pearl morphPeriod control.',\n      spikeHeight: 'Living Pearl spikeHeight control.',\n      noiseScale: 'Living Pearl noiseScale control.',\n      sharpness: 'Living Pearl sharpness control.',\n      motionSpeed: 'Living Pearl motionSpeed control.',\n      breath: 'Living Pearl breath control.',\n      roughness: 'Living Pearl roughness control.',\n      glow: 'Living Pearl glow control.',\n    },\n    lifecycle: { state: 'stateful', reset: 'seed' },\n  },\n  async create(context) {\n    // Seed once; reset samples the same field at Lux time zero.\n    const permutation = new Uint16Array(512);\n    for (let i = 0; i < 256; i++) permutation[i] = i;\n    for (let i = 255; i > 0; i--) {\n      const j = Math.floor(context.random() * (i + 1));\n      const swap = permutation[i];\n      permutation[i] = permutation[j];\n      permutation[j] = swap;\n    }\n    for (let i = 0; i < 256; i++) permutation[i + 256] = permutation[i];\n    const sample = new Float64Array(4);\n\n    // Improved gradient noise and its exact spatial derivative. This bounded\n    // CPU pass avoids tripling a large GPU noise graph for finite differences.\n    function noiseWithGradient(x: number, y: number, z: number) {\n      const ix = Math.floor(x);\n      const iy = Math.floor(y);\n      const iz = Math.floor(z);\n      const fx = x - ix;\n      const fy = y - iy;\n      const fz = z - iz;\n      const ux = fx * fx * fx * (fx * (fx * 6 - 15) + 10);\n      const uy = fy * fy * fy * (fy * (fy * 6 - 15) + 10);\n      const uz = fz * fz * fz * (fz * (fz * 6 - 15) + 10);\n      const dx = 30 * fx * fx * (fx - 1) * (fx - 1);\n      const dy = 30 * fy * fy * (fy - 1) * (fy - 1);\n      const dz = 30 * fz * fz * (fz - 1) * (fz - 1);\n      let value = 0;\n      let gradientX = 0;\n      let gradientY = 0;\n      let gradientZ = 0;\n      for (let a = 0; a < 2; a++) {\n        const wx = a ? ux : 1 - ux;\n        const dwx = a ? dx : -dx;\n        const hashX = permutation[(ix & 255) + a];\n        for (let b = 0; b < 2; b++) {\n          const wy = b ? uy : 1 - uy;\n          const dwy = b ? dy : -dy;\n          const hashY = permutation[hashX + (iy & 255) + b];\n          for (let c = 0; c < 2; c++) {\n            const wz = c ? uz : 1 - uz;\n            const dwz = c ? dz : -dz;\n            const h = permutation[hashY + (iz & 255) + c] & 15;\n            const signU = (h & 1) ? -1 : 1;\n            const signV = (h & 2) ? -1 : 1;\n            let gx = h < 8 ? signU : 0;\n            let gy = h < 8 ? 0 : signU;\n            let gz = 0;\n            if (h < 4) gy += signV;\n            else if (h === 12 || h === 14) gx += signV;\n            else gz += signV;\n            const dot = gx * (fx - a) + gy * (fy - b) + gz * (fz - c);\n            const weight = wx * wy * wz;\n            value += dot * weight;\n            gradientX += gx * weight + dot * dwx * wy * wz;\n            gradientY += gy * weight + dot * wx * dwy * wz;\n            gradientZ += gz * weight + dot * wx * wy * dwz;\n          }\n        }\n      }\n      sample[0] = value;\n      sample[1] = gradientX;\n      sample[2] = gradientY;\n      sample[3] = gradientZ;\n    }\n\n    const pixels = context.images.get('assets/organic-skin.jpg');\n    if (!pixels) throw Error('Missing organic skin image');\n    const skinTexture = new DataTexture(pixels.data, pixels.width, pixels.height, RGBAFormat, UnsignedByteType);\n    skinTexture.colorSpace = SRGBColorSpace;\n    skinTexture.flipY = true;\n    skinTexture.wrapS = RepeatWrapping;\n    skinTexture.minFilter = LinearFilter;\n    skinTexture.magFilter = LinearFilter;\n    skinTexture.generateMipmaps = false;\n    skinTexture.needsUpdate = true;\n    const imageMix = uniform(0.85);\n    const time = uniform(0);\n    const glow = uniform(0.65);\n    const roughness = uniform(0.38);\n    const geometry = new SphereGeometry(1, 128, 88);\n    const position = geometry.getAttribute('position') as BufferAttribute;\n    const normal = geometry.getAttribute('normal') as BufferAttribute;\n    position.setUsage(DynamicDrawUsage);\n    normal.setUsage(DynamicDrawUsage);\n    const rest = new Float32Array(position.array);\n    // Canonical rest directions make duplicate seam and pole vertices agree.\n    for (let i = 0; i < rest.length; i += 3) {\n      let x = Math.abs(rest[i]) < 0.000001 ? 0 : rest[i];\n      let y = Math.abs(rest[i + 1]) < 0.000001 ? 0 : rest[i + 1];\n      let z = Math.abs(rest[i + 2]) < 0.000001 ? 0 : rest[i + 2];\n      const length = Math.hypot(x, y, z);\n      rest[i] = x / length;\n      rest[i + 1] = y / length;\n      rest[i + 2] = z / length;\n    }\n    const fields = new Float32Array(position.count);\n    const fieldAttribute = new BufferAttribute(fields, 1).setUsage(DynamicDrawUsage);\n    geometry.setAttribute('livingField', fieldAttribute);\n    geometry.setAttribute('restPosition', new BufferAttribute(rest, 3));\n    geometry.computeBoundingSphere();\n    geometry.boundingSphere!.radius = 2.2;\n\n    let previousTime = Number.NaN;\n    let previousMorph = Number.NaN;\n    let previousDepth = Number.NaN;\n    let previousScale = Number.NaN;\n    let previousSharpness = Number.NaN;\n    let previousBreath = Number.NaN;\n    function deform(t: number, depth: number, scale: number, sharpness: number, breath: number, morph: number) {\n      if (t === previousTime && depth === previousDepth && scale === previousScale &&\n          sharpness === previousSharpness && breath === previousBreath && morph === previousMorph) return;\n      previousTime = t;\n      previousMorph = morph;\n      previousDepth = depth;\n      previousScale = scale;\n      previousSharpness = sharpness;\n      previousBreath = breath;\n      const exponent = sharpness * 0.55;\n      const breathing = Math.sin(t * 1.9) * breath * 0.055;\n      for (let i = 0; i < position.count; i++) {\n        const index = i * 3;\n        const x = rest[index];\n        const y = rest[index + 1];\n        const z = rest[index + 2];\n        noiseWithGradient(x * scale + t * 0.24, y * scale - t * 0.19, z * scale + t * 0.13);\n        const field = sample[0];\n        const remapped = Math.max(0.001, Math.min(0.999, field * 0.5 + 0.5));\n        const folds = Math.pow(remapped, exponent);\n        const foldSlope = depth * 0.65 * exponent * Math.pow(remapped, exponent - 1) * 0.5;\n        const ripplePhase = y * 23 + field * 8 - t * 2;\n        const ripple = Math.sin(ripplePhase) * 0.012;\n        const rippleSlope = Math.cos(ripplePhase) * 0.012;\n        const radius = 1 + morph * (depth * 0.65 * folds + ripple + breathing);\n        const slope = morph * (foldSlope + rippleSlope * 8);\n        const gx = sample[1] * scale * slope;\n        const gy = sample[2] * scale * slope + morph * rippleSlope * 23;\n        const gz = sample[3] * scale * slope;\n        // Exact normal of p(n) = radius(n) * n: remove the radial part of\n        // the height gradient, then subtract its tangent component / radius.\n        const radialGradient = gx * x + gy * y + gz * z;\n        const nx = x - (gx - radialGradient * x) / radius;\n        const ny = y - (gy - radialGradient * y) / radius;\n        const nz = z - (gz - radialGradient * z) / radius;\n        const inverseLength = 1 / Math.hypot(nx, ny, nz);\n        position.setXYZ(i, x * radius, y * radius, z * radius);\n        normal.setXYZ(i, nx * inverseLength, ny * inverseLength, nz * inverseLength);\n        fields[i] = field;\n      }\n      position.needsUpdate = true;\n      normal.needsUpdate = true;\n      fieldAttribute.needsUpdate = true;\n    }\n    deform(0, 0.85, 3.4, 3.2, 0.65, 1);\n\n    const field = attribute('livingField', 'float');\n    const restPosition = attribute('restPosition', 'vec3');\n    const material = new MeshStandardNodeMaterial({\n      metalness: 0.2,\n      roughness: 0.38,\n      flatShading: false,\n    });\n    const facing = abs(normalWorld.dot(cameraPosition.sub(positionWorld).normalize()));\n    const rim = pow(facing.oneMinus(), 2.6);\n    const fine = sin(restPosition.x.mul(67).add(restPosition.y.mul(43)).add(restPosition.z.mul(57)));\n    const skin = field.mul(0.65).add(0.57).add(fine.mul(0.035)).clamp(0, 1);\n    material.colorNode = mix(\n      mix(color('#302044'), color('#bba1ce'), skin),\n      color('#7bc6bc'),\n      rim.mul(0.37),\n    );\n    material.colorNode = mix(material.colorNode, texture(skinTexture).rgb.mul(0.85), imageMix);\n    const seams = abs(sin(field.mul(19).add(time.mul(0.45)))).pow(24);\n    material.emissiveNode = color('#36c9b1').mul(seams.mul(glow).mul(0.19))\n      .add(color('#8276bd').mul(rim).mul(glow).mul(0.12));\n    material.roughnessNode = fine.mul(0.022).add(roughness).clamp(0.12, 0.85);\n    const body = new Mesh(geometry, material);\n    const organism = new Group();\n    organism.add(body);\n    const scene = new Scene();\n    const habitat = createPearlHabitat();\n    scene.add(habitat.group);\n    scene.background = new Color('#03050c');\n    const spectrum = createSpectralWaves();\n    scene.add(spectrum.group);\n    const crossingSpectrum = createSpectralWaves();\n    crossingSpectrum.group.scale.setScalar(0.68);\n    scene.add(crossingSpectrum.group);\n    const echoes = createEchoTentacles(body);\n    scene.add(echoes.group);\n    scene.add(organism, new AmbientLight('#a0aac8', 0.5));\n    // Three broad, restrained studio directions: warm key, cool rim, low fill.\n    const key = new DirectionalLight('#ffeadb', 2.5);\n    key.position.set(-3, 4, 5);\n    const edge = new DirectionalLight('#66cdbc', 2.7);\n    edge.position.set(3, 1, -2);\n    const fill = new DirectionalLight('#9089d4', 0.9);\n    fill.position.set(3, -2, 3);\n    scene.add(key, edge, fill);\n    const moteGeometry = new SphereGeometry(0.009, 6, 4);\n    const moteMaterial = new MeshBasicNodeMaterial({ color: '#67b5c2', transparent: true, opacity: 0.28, blending: AdditiveBlending, depthWrite: false });\n    const motes = new Group();\n    for (let i = 0; i < 24; i++) {\n      const mote = new Mesh(moteGeometry, moteMaterial);\n      const angle = context.random() * Math.PI * 2;\n      const radius = 1.7 + context.random() * 1.5;\n      const height = (context.random() - 0.5) * 4.6;\n      mote.position.set(Math.cos(angle) * radius, height, Math.sin(angle) * radius);\n      mote.scale.setScalar(0.3 + context.random() * 1.1);\n      motes.add(mote);\n    }\n    scene.add(motes);\n    const companions: Mesh[] = [];\n    for (let i = 0; i < 12; i++) {\n      const companion = new Mesh(geometry, material);\n      scene.add(companion);\n      companions.push(companion);\n    }\n    const burstBlobs: Mesh[] = [];\n    for (let i = 0; i < 32; i++) {\n      const particle = new Mesh(geometry, material);\n      particle.visible = false;\n      scene.add(particle);\n      burstBlobs.push(particle);\n    }\n    let burstStart = -Infinity;\n    let lastBurst = -Infinity;\n    let kickCount = 0;\n    let previousKick = 0;\n    const camera = new PerspectiveCamera(38, context.settings.width / context.settings.height, 0.1, 30);\n    camera.position.set(0, 0.15, 6.15);\n    camera.lookAt(0, 0, 0);\n    return {\n      update(frame) {\n        time.value = frame.timeSeconds * frame.controls.motionSpeed;\n        habitat.update(time.value, frame.controls.bassEnergy, frame.controls.midsEnergy);\n        imageMix.value = frame.controls.textureMix;\n        glow.value = frame.controls.glow;\n        roughness.value = frame.controls.roughness;\n        const cycle = frame.controls.autoMorph ? 0.5 + 0.5 * Math.cos(frame.timeSeconds * Math.PI * 2 / frame.controls.morphPeriod) : 1;\n        const morph = frame.controls.foldMorph * cycle * cycle * (3 - 2 * cycle);\n        deform(time.value, frame.controls.spikeHeight, frame.controls.noiseScale, frame.controls.sharpness, frame.controls.breath, morph);\n        body.scale.setScalar(1 + frame.controls.bassEnergy * frame.controls.scalePulse);\n        body.rotation.y = time.value * 0.28;\n        body.rotation.z = Math.sin(time.value * 0.35) * 0.12;\n        organism.position.y = Math.sin(time.value * 0.7) * 0.07;\n        motes.rotation.y = time.value * -0.06;\n        motes.rotation.z = Math.sin(time.value * 0.2) * 0.05;\n        for (let i = 0; i < companions.length; i++) {\n          const companion = companions[i];\n          const breathingCount = frame.controls.autoCopies ? 0.5 + 0.5 * Math.cos(frame.timeSeconds * Math.PI * 2 / frame.controls.copyCycle) : 1;\n          const birth = Math.max(0, Math.min(1, frame.controls.copies * breathingCount - i));\n          const emergence = birth * birth * (3 - 2 * birth);\n          companion.visible = emergence > 0.0001;\n          const angle = i * Math.PI * 2 / Math.max(1, frame.controls.copies) + Math.PI * 0.25 + frame.timeSeconds * 0.07;\n          companion.position.set(Math.cos(angle) * frame.controls.orbitSpread * emergence, Math.sin(angle) * frame.controls.orbitSpread * 0.68 * emergence, -0.8 + Math.sin(angle * 1.7) * 0.35 * emergence);\n          companion.scale.setScalar(frame.controls.copySize * emergence * (1 + frame.controls.bassEnergy * 0.12));\n          companion.rotation.set(Math.sin(time.value * 0.2 + i) * 0.2, time.value * 0.2 + i * 0.8, i * 0.4);\n        }\n        if (frame.controls.kickPulse > previousKick + 0.08) {\n          kickCount++;\n          if (frame.controls.shockwaves && kickCount % 3 === 0 && frame.timeSeconds - lastBurst > 8) {\n            burstStart = frame.timeSeconds;\n            lastBurst = frame.timeSeconds;\n          }\n        }\n        previousKick = frame.controls.kickPulse;\n        const burstAge = frame.timeSeconds - burstStart;\n        const burstPhase = Math.max(0, Math.min(1, burstAge / 3));\n        for (let i = 0; i < burstBlobs.length; i++) {\n          const particle = burstBlobs[i];\n          particle.visible = burstAge >= 0 && burstAge < 3 && i < Math.round(frame.controls.burstCount);\n          const a = i * Math.PI * 2 / frame.controls.burstCount + (Number.isFinite(burstStart) ? burstStart * 0.2 : 0);\n          const radius = burstPhase * 10;\n          particle.position.set(Math.cos(a) * radius, Math.sin(a) * radius * 0.82, -0.9 - burstPhase * 0.8);\n          particle.scale.setScalar(0.19 * Math.pow(Math.sin(burstPhase * Math.PI), 1.3));\n          particle.rotation.y = a + time.value;\n        }\n        echoes.update(frame.timeSeconds);\n        const spectrumFrame = (frame as unknown as { audioSpectrum?: { available: boolean; magnitudes: readonly number[] } }).audioSpectrum;\n        spectrum.group.rotation.z = frame.controls.spectrumAngle * Math.PI / 180;\n        spectrum.update(frame.timeSeconds, frame.controls.bassEnergy, frame.controls.midsEnergy, frame.controls.highsEnergy, frame.controls.waveCount, frame.controls.waveMode === 'spectrum' && spectrumFrame?.available ? spectrumFrame.magnitudes : undefined);\n        crossingSpectrum.group.visible = frame.controls.crossSpectrum;\n        crossingSpectrum.group.rotation.z = frame.controls.crossSpectrumAngle * Math.PI / 180;\n        crossingSpectrum.update(frame.timeSeconds, frame.controls.bassEnergy, frame.controls.midsEnergy, frame.controls.highsEnergy, frame.controls.waveCount, frame.controls.waveMode === 'spectrum' && spectrumFrame?.available ? spectrumFrame.magnitudes : undefined, frame.controls.crossSpectrumStrength);\n      },\n      async evaluate(_inputs, evaluation) {\n        return { image: await evaluation.render(scene, camera) };\n      },\n      reset() {\n        time.value = 0;\n        previousTime = Number.NaN;\n        echoes.reset();\n        burstStart = -Infinity;\n        lastBurst = -Infinity;\n        previousKick = 0;\n        kickCount = 0;\n      },\n      dispose() {\n        crossingSpectrum.dispose();\n        spectrum.dispose();\n        echoes.dispose();\n        habitat.dispose();\n        geometry.dispose();\n        skinTexture.dispose();\n        material.dispose();\n        moteGeometry.dispose();\n        moteMaterial.dispose();\n      },\n    };\n  },\n});\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n"
    },
