{
  "format": "lux-scene",
  "version": 3,
  "source": {
    "sourceVersion": 2,
    "sdkVersion": "0.2.0",
    "entry": "collision-story.ts",
    "files": {
      "cinematic-atmosphere.ts": "import {\n  AdditiveBlending,\n  CircleGeometry,\n  Group,\n  Mesh,\n  MeshBasicNodeMaterial,\n  PerspectiveCamera,\n  PlaneGeometry,\n  RingGeometry,\n  Scene,\n  Vector3,\n} from 'three/webgpu';\nimport { float, mix, smoothstep, uniform, uv, vec2, vec3 } from 'three/tsl';\n\nexport interface CinematicAtmosphere {\n  /** Call after the camera and solar-system transforms have been updated. */\n  update(\n    timeSeconds: number,\n    reveal: number,\n    tension: number,\n    flareStrength: number,\n    nebulaStrength: number,\n  ): void;\n  dispose(): void;\n}\n\n/**\n * A restrained camera-space flare for a bright record at world origin.\n * It is intentionally independent of the star field and contains no scene assets.\n */\nexport function createAtmosphere(\n  _scene: Scene,\n  camera: PerspectiveCamera,\n): CinematicAtmosphere {\n  const layer = new Group();\n  const anchor = new Group();\n  const coreGeometry = new CircleGeometry(1, 64);\n  const streakGeometry = new PlaneGeometry(1, 1);\n  const ringGeometry = new RingGeometry(0.74, 1, 64);\n  const fade = uniform(0);\n  const materials: MeshBasicNodeMaterial[] = [];\n  const origin = new Vector3();\n  const projected = new Vector3();\n  const viewPoint = new Vector3();\n\n  camera.add(layer);\n  layer.add(anchor);\n\n  function material(\n    colorA: [number, number, number],\n    colorB: [number, number, number],\n    shape: number,\n  ): MeshBasicNodeMaterial {\n    const result = new MeshBasicNodeMaterial();\n    result.colorNode = mix(vec3(...colorA), vec3(...colorB), uv().x);\n    const r = float(1).sub(smoothstep(0.12, 0.5, uv().sub(vec2(0.5)).length()));\n    const line = float(1).sub(smoothstep(0.0, 0.5, uv().y.sub(0.5).abs())).pow(7)\n      .mul(float(1).sub(smoothstep(0.05, 0.5, uv().x.sub(0.5).abs())));\n    result.opacityNode = (shape === 1 ? line.mul(0.23) : r.pow(shape === 0 ? 2 : 4).mul(shape === 0 ? 0.6 : 0.14)).mul(fade);\n    result.transparent = true;\n    result.blending = AdditiveBlending;\n    result.depthTest = false;\n    result.depthWrite = false;\n    result.toneMapped = false;\n    materials.push(result);\n    return result;\n  }\n\n  const radial = float(1).sub(smoothstep(0.12, 0.5, uv().sub(vec2(0.5)).length()));\n  const core = new Mesh(\n    coreGeometry,\n    material([1.0, 0.38, 0.72], [0.22, 0.82, 1.0], 0),\n  );\n  core.renderOrder = 20;\n  core.visible = false;\n  anchor.add(core);\n\n  const streakMask = float(1).sub(smoothstep(0.0, 0.5, uv().y.sub(0.5).abs()));\n  const streak = new Mesh(\n    streakGeometry,\n    material([1.0, 0.18, 0.52], [0.2, 0.8, 1.0], 1),\n  );\n  streak.renderOrder = 19;\n  streak.visible = false;\n  anchor.add(streak);\n\n  const ghostA = new Mesh(\n    coreGeometry,\n    material([0.24, 0.85, 1.0], [0.8, 0.28, 1.0], 2),\n  );\n  ghostA.renderOrder = 18;\n  layer.add(ghostA);\n\n  const ghostRing = new Mesh(\n    ringGeometry,\n    material([0.1, 0.72, 1.0], [1.0, 0.26, 0.66], 3),\n  );\n  ghostRing.renderOrder = 18;\n  layer.add(ghostRing);\n\n  return {\n    update(timeSeconds, reveal, tension, flareStrength, _nebulaStrength) {\n      origin.set(0, 0, 0);\n      viewPoint.copy(origin).applyMatrix4(camera.matrixWorldInverse);\n      projected.copy(origin).project(camera);\n      const edge = Math.max(Math.abs(projected.x), Math.abs(projected.y));\n      const onScreen = viewPoint.z < 0 && projected.z > -1 && projected.z < 1 && edge < 1.08;\n      const edgeFade = Math.max(0, Math.min(1, (1.08 - edge) / 0.18));\n      const intensity = onScreen\n        ? Math.max(0, Math.min(1, reveal)) * Math.max(0, flareStrength) * edgeFade\n        : 0;\n      // Keep the sun's artwork clear: only faint displaced lens ghosts remain.\n      fade.value = intensity * Math.min(1, Math.hypot(projected.x, projected.y) * 2) * 0.35;\n      layer.visible = intensity > 0.0005;\n\n      const distance = 0.72;\n      const halfHeight = Math.tan((camera.fov * Math.PI) / 360) * distance;\n      const halfWidth = halfHeight * camera.aspect;\n      const breathing = 1 + Math.sin(timeSeconds * 0.7) * 0.025;\n      const pressure = 1 + Math.max(0, tension) * 0.16;\n      anchor.position.set(projected.x * halfWidth, projected.y * halfHeight, -distance);\n      core.scale.setScalar(halfHeight * 0.09 * breathing * pressure);\n      streak.scale.set(halfWidth * 0.56 * pressure, halfHeight * 0.012 * breathing, 1);\n\n      ghostA.position.set(\n        projected.x * halfWidth * -0.32,\n        projected.y * halfHeight * -0.32,\n        -distance - 0.002,\n      );\n      ghostA.scale.setScalar(halfHeight * 0.038 * (1 + tension * 0.08));\n      ghostRing.position.set(\n        projected.x * halfWidth * 0.22,\n        projected.y * halfHeight * 0.22,\n        -distance - 0.003,\n      );\n      ghostRing.scale.setScalar(halfHeight * 0.075 * (1 + tension * 0.12));\n      ghostRing.rotation.z = timeSeconds * 0.035;\n    },\n    dispose() {\n      layer.removeFromParent();\n      coreGeometry.dispose();\n      streakGeometry.dispose();\n      ringGeometry.dispose();\n      for (const entry of materials) entry.dispose();\n    },\n  };\n}\n\r\n\r\n",
      "collision-aftermath.ts": "import {\n  AdditiveBlending,\n  CircleGeometry,\n  Group,\n  Mesh,\n  MeshBasicNodeMaterial,\n  PerspectiveCamera,\n  PlaneGeometry,\n  RingGeometry,\n  Scene,\n} from 'three/webgpu';\nimport { float, mix, sin, smoothstep, uniform, uv, vec2, vec3 } from 'three/tsl';\n\nexport interface CollisionAftermath {\n  update(\n    timeSeconds: number,\n    burstProgress: number,\n    collapseProgress: number,\n    blackHoleProgress: number,\n    energy: number,\n  ): void;\n  reset(): void;\n  dispose(): void;\n}\n\nconst clamp = (value: number) => Math.max(0, Math.min(1, value));\n\n/**\n * A camera-facing origin effect: colored collision remains become an endlessly\n * moving accretion disc, while the centre stays genuinely black and legible.\n */\nexport function createAftermath(scene: Scene, camera: PerspectiveCamera): CollisionAftermath {\n  const root = new Group();\n  const burst = new Group();\n  const singularity = new Group();\n  const shellGeometry = new RingGeometry(0.74, 1, 96);\n  const discGeometry = new RingGeometry(0.42, 1.12, 128);\n  const coreGeometry = new CircleGeometry(0.43, 96);\n  const photonGeometry = new RingGeometry(0.445, 0.49, 128);\n  const arcGeometry = new RingGeometry(0.84, 1.12, 112, 1, 0.14, Math.PI * 0.72);\n  const filamentGeometry = new PlaneGeometry(1, 1);\n  const burstGain = uniform(0);\n  const holeGain = uniform(0);\n  const clock = uniform(0);\n  const materials: MeshBasicNodeMaterial[] = [];\n\n  scene.add(root);\n  root.add(burst, singularity);\n\n  const shellMaterial = new MeshBasicNodeMaterial();\n  const shellUv = uv().sub(vec2(0.5));\n  const shellRadius = shellUv.length();\n  const shellEdge = smoothstep(0.34, 0.395, shellRadius)\n    .mul(float(1).sub(smoothstep(0.465, 0.5, shellRadius)));\n  const shellPulse = sin(uv().x.mul(26).add(uv().y.mul(9)).add(clock.mul(1.8))).mul(0.18).add(0.82);\n  shellMaterial.colorNode = mix(vec3(0.08, 0.82, 1), vec3(1, 0.16, 0.32), uv().x);\n  shellMaterial.opacityNode = shellEdge.mul(shellPulse).mul(burstGain).mul(0.34);\n  shellMaterial.transparent = true;\n  shellMaterial.blending = AdditiveBlending;\n  shellMaterial.depthWrite = false;\n  shellMaterial.toneMapped = false;\n  materials.push(shellMaterial);\n\n  const shellA = new Mesh(shellGeometry, shellMaterial);\n  const shellB = new Mesh(shellGeometry, shellMaterial);\n  const shellC = new Mesh(shellGeometry, shellMaterial);\n  shellB.rotation.z = 1.2;\n  shellC.rotation.z = -0.8;\n  burst.add(shellA, shellB, shellC);\n\n  const filamentMaterial = new MeshBasicNodeMaterial();\n  const filamentMask = float(1).sub(smoothstep(0.0, 0.5, uv().y.sub(0.5).abs()));\n  filamentMaterial.colorNode = mix(vec3(0.12, 0.86, 1), vec3(1, 0.34, 0.08), uv().x);\n  filamentMaterial.opacityNode = filamentMask.pow(5).mul(burstGain).mul(0.14);\n  filamentMaterial.transparent = true;\n  filamentMaterial.blending = AdditiveBlending;\n  filamentMaterial.depthWrite = false;\n  filamentMaterial.toneMapped = false;\n  materials.push(filamentMaterial);\n  const filaments: Mesh[] = [];\n  for (let index = 0; index < 12; index += 1) {\n    const filament = new Mesh(filamentGeometry, filamentMaterial);\n    filament.rotation.z = (index / 12) * Math.PI * 2;\n    burst.add(filament);\n    filaments.push(filament);\n  }\n\n  const discMaterial = new MeshBasicNodeMaterial();\n  const discUv = uv();\n  const discPoint = discUv.sub(vec2(0.5));\n  const discRadius = discPoint.length();\n  const innerEdge = smoothstep(0.185, 0.245, discRadius);\n  const outerEdge = float(1).sub(smoothstep(0.435, 0.5, discRadius));\n  const discShape = innerEdge.mul(outerEdge);\n  const swirlA = sin(discPoint.x.mul(44).add(discPoint.y.mul(25)).sub(clock.mul(2.2)));\n  const swirlB = sin(discPoint.y.mul(52).sub(discPoint.x.mul(18)).add(clock.mul(1.35)));\n  const flow = swirlA.mul(0.18).add(swirlB.mul(0.12)).add(0.74);\n  const hotBand = smoothstep(0.19, 0.28, discRadius)\n    .mul(float(1).sub(smoothstep(0.3, 0.43, discRadius)));\n  discMaterial.colorNode = mix(\n    mix(vec3(0.03, 0.82, 1), vec3(0.6, 0.08, 0.9), discUv.x),\n    mix(vec3(1, 0.28, 0.05), vec3(0.92, 0.06, 0.26), discUv.x),\n    hotBand.mul(0.86),\n  );\n  discMaterial.opacityNode = discShape.mul(flow).mul(holeGain).mul(0.72);\n  discMaterial.transparent = true;\n  discMaterial.blending = AdditiveBlending;\n  discMaterial.depthWrite = false;\n  discMaterial.toneMapped = false;\n  materials.push(discMaterial);\n  const disc = new Mesh(discGeometry, discMaterial);\n  disc.renderOrder = 20;\n  singularity.add(disc);\n\n  const coreMaterial = new MeshBasicNodeMaterial({ color: 0x000002 });\n  coreMaterial.transparent = true; coreMaterial.opacity = 1; coreMaterial.depthTest = false;\n  coreMaterial.depthWrite = false;\n  coreMaterial.toneMapped = false;\n  materials.push(coreMaterial);\n  const core = new Mesh(coreGeometry, coreMaterial);\n  core.position.z = 0.012;\n  core.renderOrder = 1000;\n  singularity.add(core);\n\n  const photonMaterial = new MeshBasicNodeMaterial();\n  const photonPulse = sin(uv().x.mul(34).add(uv().y.mul(11)).sub(clock.mul(3.8))).mul(0.16).add(0.84);\n  photonMaterial.colorNode = mix(vec3(0.2, 0.9, 1), vec3(1, 0.34, 0.07), uv().x);\n  photonMaterial.opacityNode = photonPulse.mul(holeGain).mul(0.92);\n  photonMaterial.transparent = true;\n  photonMaterial.blending = AdditiveBlending;\n  photonMaterial.depthTest = false;\n  photonMaterial.depthWrite = false;\n  photonMaterial.toneMapped = false;\n  materials.push(photonMaterial);\n  const photonRing = new Mesh(photonGeometry, photonMaterial);\n  photonRing.position.z = 0.016;\n  photonRing.renderOrder = 1001;\n  singularity.add(photonRing);\n\n  const arcMaterial = new MeshBasicNodeMaterial();\n  const arcPoint = uv().sub(vec2(0.5));\n  const arcRadius = arcPoint.length();\n  const arcEdge = smoothstep(0.375, 0.42, arcRadius)\n    .mul(float(1).sub(smoothstep(0.47, 0.5, arcRadius)));\n  const arcPulse = sin(uv().x.mul(18).add(clock.mul(1.1))).mul(0.18).add(0.82);\n  arcMaterial.colorNode = mix(vec3(0.18, 0.9, 1), vec3(1, 0.2, 0.12), uv().x);\n  arcMaterial.opacityNode = arcEdge.mul(arcPulse).mul(holeGain).mul(0.4);\n  arcMaterial.transparent = true;\n  arcMaterial.blending = AdditiveBlending;\n  arcMaterial.depthWrite = false;\n  arcMaterial.toneMapped = false;\n  materials.push(arcMaterial);\n  const arc = new Mesh(arcGeometry, arcMaterial);\n  arc.scale.set(1.12, 0.3, 1);\n  arc.position.set(0, 0.2, 0.02);\n  arc.renderOrder = 32;\n  singularity.add(arc);\n\n  return {\n    update(timeSeconds, burstProgress, collapseProgress, blackHoleProgress, energy) {\n      const burstAmount = clamp(burstProgress);\n      const collapseAmount = clamp(collapseProgress);\n      const holeAmount = clamp(blackHoleProgress);\n      const energyAmount = Math.max(0, Math.min(2, energy));\n      clock.value = timeSeconds;\n      root.quaternion.copy(camera.quaternion);\n\n      const burstEnvelope = Math.sin(burstAmount * Math.PI) * (1 - collapseAmount * 0.7);\n      burstGain.value = burstEnvelope * energyAmount;\n      burst.visible = burstGain.value > 0.0005;\n      const shellScale = 0.65 + burstAmount * 3.4 + Math.sin(timeSeconds * 1.3) * 0.04;\n      shellA.scale.setScalar(shellScale);\n      shellB.scale.setScalar(shellScale * 0.76);\n      shellC.scale.setScalar(shellScale * 1.18);\n      shellA.rotation.z = timeSeconds * 0.08;\n      shellB.rotation.z = 1.2 - timeSeconds * 0.055;\n      shellC.rotation.z = -0.8 + timeSeconds * 0.035;\n      for (let index = 0; index < filaments.length; index += 1) {\n        const phase = index / filaments.length;\n        const filament = filaments[index];\n        filament.position.set(\n          Math.cos(phase * Math.PI * 2) * shellScale * 0.92,\n          Math.sin(phase * Math.PI * 2) * shellScale * 0.92,\n          -0.004,\n        );\n        filament.rotation.z = phase * Math.PI * 2 + timeSeconds * 0.09;\n        filament.scale.set(shellScale * (0.38 + phase * 0.18), 0.015 + burstAmount * 0.025, 1);\n      }\n\n      holeGain.value = holeAmount * (0.45 + energyAmount * 0.35);\n      singularity.visible = holeGain.value > 0.0005;\n      const radius = 1.28 + collapseAmount * 0.22 + Math.sin(timeSeconds * 0.54) * 0.018;\n      singularity.scale.setScalar(radius);\n      disc.rotation.z = timeSeconds * 0.10;\n      arc.rotation.z = -timeSeconds * 0.11;\n      core.scale.setScalar(0.85 + Math.sin(timeSeconds * 0.7) * 0.018);\n      photonRing.scale.setScalar(1 + Math.sin(timeSeconds * 1.7) * 0.025);\n    },\n    reset() {\n      root.visible = true;\n      burst.visible = false;\n      singularity.visible = false;\n      burstGain.value = 0;\n      holeGain.value = 0;\n    },\n    dispose() {\n      root.removeFromParent();\n      shellGeometry.dispose();\n      discGeometry.dispose();\n      coreGeometry.dispose();\n      photonGeometry.dispose();\n      arcGeometry.dispose();\n      filamentGeometry.dispose();\n      for (const material of materials) material.dispose();\n    },\n  };\n}\n",
      "collision-story.ts": "import { createFlareRig } from './flare-rig.ts';\nimport { createGaussianBlur } from './gaussian-blur.ts';\nimport { createPlanetVisitor, type VisitTarget } from './planet-visitor.ts';\nimport { defineVisual } from '@lux/visual-sdk';\r\nimport { createRecordComets } from './record-comets.ts';\nimport { createOrbitalComet } from './comet-orbits.ts';\nimport { createAftermath } from './collision-aftermath.ts';\nimport {\n  AdditiveBlending, AmbientLight, BufferGeometry, Material, CircleGeometry, Color, CylinderGeometry,\n  DataTexture, DirectionalLight, DoubleSide, Group, LinearFilter, Mesh, InstancedMesh, Object3D,\n  MeshBasicNodeMaterial, MeshStandardNodeMaterial, PerspectiveCamera,\n  PlaneGeometry, RGBAFormat, Scene, SRGBColorSpace, TorusGeometry, UnsignedByteType, Vector3, Quaternion,\n} from 'three/webgpu';\nimport { uv, vec3, smoothstep, float, mix, uniform, sin, cos, fract } from 'three/tsl';\nimport { createPolish, type OrbitTrail } from './solar-polish.ts';\nimport { createAtmosphere } from './cinematic-atmosphere.ts';\n\nexport default defineVisual({\n  controls: {\n    visitorActivity: { type: 'number', label: 'Saucer visits', default: 1, min: 0, max: 1, step: 1, group: 'Alien visitor' },\n    visitorPeriod: { type: 'number', label: 'Visit interval', default: 48, min: 35, max: 60, step: 1, unit: 's', group: 'Alien visitor' },\n    visitorSize: { type: 'number', label: 'Saucer size', default: 0.28, min: 0.08, max: 0.6, step: 0.01, group: 'Alien visitor' },\n    visitorPreview: { type: 'number', label: 'Visit preview (-1 auto)', description: '.15 approach · .28 hover · .43 landed and flag · .6 departure. -1 resumes timed visits.', default: -1, min: -1, max: 1, step: 0.01, group: 'Alien visitor' },\n    hippoSize: { type: 'number', label: 'Hippo size', description: 'Logo size relative to vinyl diameter. Both systems; bind audio or an LFO here to pulse only the logos.', default: 0.55, min: 0.2, max: 0.9, step: 0.005, group: 'Record artwork' },\n    alienTint: { type: 'number', label: 'Alien tint strength', description: '0 preserves the generated mint/lilac artwork. Higher values gently tint the logo, never the black vinyl.', default: 0, min: 0, max: 1, step: 0.01, group: 'Record artwork' },\n    alienHue: { type: 'number', label: 'Alien tint hue', description: 'Hue wheel: 0 red, .17 yellow, .33 green, .5 cyan, .67 blue, .83 magenta.', default: 0.43, min: 0, max: 1, step: 0.005, group: 'Record artwork' },\n    phaseMode: { type: 'number', label: 'Playback: 0 normal · 1 story · 2 loop · 3 scrub · 4 continue', description: '0 returns to the original solar system. Switch to 1 to trigger arrival and play the whole story. 4 plays from the selected beat through the ending.', default: 0, min: 0, max: 4, step: 1, group: 'Story transport' },\n    phaseSelect: { type: 'number', label: 'Beat (1–6)', description: '1 Arrival · 2 Orbit and tidal distortion · 3 Planetary chaos · 4 Solar inspiral · 5 Kilonova · 6 Black hole', default: 2, min: 1, max: 6, step: 1, group: 'Phase workshop' },\n    phasePosition: { type: 'number', label: 'Scrub within phase', description: 'Mode 3: hold the story at this point while the records keep spinning.', default: 0, min: 0, max: 1, step: 0.001, group: 'Phase workshop' },\n    phaseSeconds: { type: 'number', label: 'Seconds per phase', default: 12, min: 3, max: 60, step: 0.5, unit: 's', group: 'Phase workshop' },\n    phaseReplay: { type: 'number', label: 'Replay opening / story / beat (change value)', description: 'Change to replay. Mode 1 restarts arrival; modes 2–4 restart the selected beat. Mode 0 replays the full-screen record opening.', default: 0, min: 0, max: 10000, step: 1, group: 'Phase workshop' },\n    tidalStretch: { type: 'number', label: 'Orbit stretching', default: 0.65, min: 0, max: 1.5, step: 0.01, group: 'Beat 2 · Orbit and distortion' },\n    tidalSkew: { type: 'number', label: 'Orbit skew and buckling', default: 0.28, min: 0, max: 0.8, step: 0.01, group: 'Beat 2 · Orbit and distortion' },\n    tidalBreak: { type: 'number', label: 'Path breakup', default: 0.7, min: 0, max: 1, step: 0.01, group: 'Beat 2 · Orbit and distortion' },\n    storyDuration: { type: 'number', label: 'Story duration', default: 110, min: 35, max: 240, step: 1, unit: 's', group: 'Story transport' },\n    automatic: { type: 'number', label: 'Auto reveal (0 = manual)', default: 1, min: 0, max: 1, step: 1, group: 'Reveal' },\n    reveal: { type: 'number', label: 'Manual reveal', default: 1, min: 0, max: 1, step: 0.01, group: 'Reveal' },\n    duration: { type: 'number', label: 'Reveal duration', default: 12, min: 3, max: 30, step: 0.5, unit: 's', group: 'Reveal' },\n    hold: { type: 'number', label: 'Opening hold', default: 3, min: 0, max: 15, step: 0.5, unit: 's', group: 'Reveal' },\n    rpm: { type: 'number', label: 'Record spin', default: 8.7, min: -45, max: 45, step: 0.1, unit: 'RPM', group: 'Motion' },\n    orbitSpeed: { type: 'number', label: 'Orbit speed', default: 0.65, min: -3, max: 3, step: 0.01, group: 'Motion' },\n    tilt: { type: 'number', label: 'System tilt', default: 0.85, min: 0, max: 1.35, step: 0.01, unit: 'rad', group: 'Composition' },\n    spread: { type: 'number', label: 'Orbit spread', default: 1, min: 0.4, max: 3.5, step: 0.01, group: 'Composition' },\n    size: { type: 'number', label: 'Record size', default: 0.97, min: 0.3, max: 1.5, step: 0.01, group: 'Composition' },\n    planetSize: { type: 'number', label: 'Planet size', default: 1, min: 0.3, max: 1.8, step: 0.01, group: 'Composition' },\n    corona: { type: 'number', label: 'Corona glow', default: 0.8, min: 0, max: 8, step: 0.01, group: 'Light' },\n    pulse: { type: 'number', label: 'Sun pulse', default: 0.3, min: 0, max: 4, step: 0.01, group: 'Light' },\n    pulseSpeed: { type: 'number', label: 'Pulse speed', default: 0.7, min: 0, max: 3, step: 0.01, group: 'Light' },\n    featureStarDensity: { type: 'number', label: 'Feature star density', default: 6, min: 0, max: 12, step: 0.1, description: 'Number of diffraction stars across the fixed sky. Zero hides them; fractional values gently reveal the next star.', group: 'Cosmos' },\n    featureStarScale: { type: 'number', label: 'Feature star scale', default: 0.65, min: 0.1, max: 2, step: 0.01, description: 'Scales all feature stars together, preserving their size distribution.', group: 'Cosmos' },\n    featureStarOpacity: { type: 'number', label: 'Feature star opacity', default: 0.65, min: 0, max: 1, step: 0.01, description: 'Fades all diffraction stars together. Zero hides them.', group: 'Cosmos' },\n    featureStarVariance: { type: 'number', label: 'Feature star size variance', default: 0.5, min: 0, max: 2, step: 0.01, description: 'Zero gives equal sizes. Higher values spread the same stable stars between tiny points and larger diffraction stars.', group: 'Cosmos' },\n    stars: { type: 'number', label: 'Starlight', default: 0.8, min: 0, max: 2, step: 0.01, group: 'Cosmos' },\n    moonSpread: { type: 'number', label: 'Moon orbit spread', default: 1, min: 0.6, max: 4, step: 0.01, group: 'Composition' },\n    moonSpeed: { type: 'number', label: 'Moon orbit speed', default: 0.65, min: -3, max: 3, step: 0.01, group: 'Motion' },\n    sunAudioGain: { type: 'number', label: 'Sun expansion gain', description: 'Multiplies kick and bass driven record expansion; 1 is the original response.', default: 2, min: 0, max: 12, step: 0.05, group: 'Audio response' },\n    coronaAudioGain: { type: 'number', label: 'Corona brightness gain', description: 'Multiplies audio-driven corona brightness independently of its idle brightness.', default: 2, min: 0, max: 12, step: 0.05, group: 'Audio response' },\n    coronaSpreadGain: { type: 'number', label: 'Corona expansion gain', description: 'Multiplies audio-driven halo expansion.', default: 2, min: 0, max: 12, step: 0.05, group: 'Audio response' },\n    alienCamera: { type: 'number', label: 'Alien close-up shots', default: 1, min: 0, max: 1, step: 1, group: 'Camera' },\n    tourShot: { type: 'number', label: 'Shot preview (-1 auto)', description: '0 first planet; 1 second planet and landing; 2 alien portrait; 3–4 planets. Use Tour preview to move through the shot.', default: -1, min: -1, max: 4, step: 1, group: 'Camera' },\n    kick: { type: 'number', label: 'Kick flare', description: 'Bind Kick audio here: sun flash and a small expansion.', default: 0, min: 0, max: 1, step: 0.01, group: 'Audio response' },\n    bass: { type: 'number', label: 'Bass breathing', description: 'Bind Bass audio here: gentle orbit expansion and sun breathing.', default: 0, min: 0, max: 1, step: 0.01, group: 'Audio response' },\n    mids: { type: 'number', label: 'Midrange motion', description: 'Bind Mids audio here: additional orbit inclination.', default: 0, min: 0, max: 1, step: 0.01, group: 'Audio response' },\n    highs: { type: 'number', label: 'Treble shimmer', description: 'Bind Highs audio here: brighter stars, wakes, and vinyl highlights.', default: 0, min: 0, max: 1, step: 0.01, group: 'Audio response' },\n    trails: { type: 'number', label: 'Planet trails', default: 0.65, min: 0, max: 2, step: 0.01, group: 'Light' },\n    cameraMotion: { type: 'number', label: 'Cinematic camera', default: 1, min: 0, max: 1, step: 0.01, group: 'Camera' },\n    phraseLength: { type: 'number', label: 'Camera phrase length', default: 48, min: 20, max: 120, step: 1, unit: 's', group: 'Camera' },\n    closeup: { type: 'number', label: 'Planet close-ups', default: 0.92, min: 0, max: 1, step: 0.01, group: 'Camera' },\n    cameraPhase: { type: 'number', label: 'Tour preview (-1 = auto)', default: -1, min: -1, max: 1, step: 0.01, group: 'Camera' },\n    lensFlare: { type: 'number', label: 'Lens flare', default: 0.55, min: 0, max: 1.5, step: 0.01, group: 'Light' },\n    nebula: { type: 'number', label: 'Nebula detail', default: 0.8, min: 0, max: 2, step: 0.01, group: 'Cosmos' },\n    cometActivity: { type: 'number', label: 'Flyby comets', default: 1, min: 0, max: 1, step: 1, group: 'Comets' },\n    cometInterval: { type: 'number', label: 'Flyby interval', default: 55, min: 40, max: 180, step: 1, unit: 's', group: 'Comets' },\n    cometSize: { type: 'number', label: 'Record head size', default: 1, min: 0.2, max: 3, step: 0.01, group: 'Comets' },\n    cometTrailSize: { type: 'number', label: 'Trail width', default: 1.5, min: 0.3, max: 4, step: 0.01, group: 'Comets' },\n    cometTrailLength: { type: 'number', label: 'Trail length', default: 1.25, min: 0.3, max: 3, step: 0.01, group: 'Comets' },\n    cometBrightness: { type: 'number', label: 'Comet brightness', default: 1, min: 0, max: 3, step: 0.01, group: 'Comets' },\n    orbitalComet: { type: 'number', label: 'Elliptical comet', default: 1, min: 0, max: 1, step: 1, group: 'Comets' },\n    orbitalPreview: { type: 'number', label: 'Orbit preview (-1 auto)', description: 'Inspect the elliptical comet around its orbit. Periapsis is near 0.13; the shed plume opens afterward.', default: -1, min: -1, max: 1, step: 0.005, group: 'Comets' },\n    orbitalPeriod: { type: 'number', label: 'Elliptical orbit period', default: 85, min: 25, max: 180, step: 1, unit: 's', group: 'Comets' },\n  },\n  async create(context) {\n    const pixels = context.images.get('assets/record.png');\n    if (!pixels) throw Error('Missing record artwork');\n    const texture = new DataTexture(pixels.data, pixels.width, pixels.height, RGBAFormat, UnsignedByteType);\n    texture.colorSpace = SRGBColorSpace;\n    texture.flipY = true;\n    texture.minFilter = LinearFilter;\n    texture.magFilter = LinearFilter;\n    texture.needsUpdate = true;\n    const polish = createPolish(texture);\n    const scene = new Scene();\n    scene.background = new Color(0x000000);\n    const world = new Group();\n    scene.add(world);\n    const incomingWorld = new Group();\n    scene.add(incomingWorld);\n    scene.add(new AmbientLight(0xb8c7ff, 1.7));\n    const light = new DirectionalLight(0xa8efff, 4);\n    light.position.set(2, 4, 6);\n    scene.add(light);\n    const pinkLight = new DirectionalLight(0xff45c7, 2.5);\n    pinkLight.position.set(-4, -2, 3);\n    scene.add(pinkLight);\n    const camera = new PerspectiveCamera(42, context.settings.width / context.settings.height, 0.1, 80);\n    camera.position.z = 2.72;\n    scene.add(camera);\n    const atmosphere = createAtmosphere(scene, camera);\n    // A sparse fixed sky: camera translation leaves these directions unchanged.\n    const featureStars = [\n      [-0.23, 0.22, -1, 0.055, 0.62, '#d9eaff'],\n      [0.35, 0.12, -1, 0.043, 0.42, '#fff0d7'],\n      [-0.42, -0.18, -1, 0.035, 0.34, '#e4edff'],\n      [0.08, 0.33, -1, 0.046, 0.48, '#eff5ff'],\n      [0.28, -0.27, -1, 0.033, 0.36, '#ffe6ca'],\n      [-0.07, -0.36, -1, 0.04, 0.40, '#d4eaff'],\n      [0.48, 0.30, -1, 0.05, 0.42, '#e7efff'],\n      [-0.55, 0.07, -1, 0.032, 0.38, '#ffedda'],\n      [0.51, -0.12, -1, 0.047, 0.40, '#dceaff'],\n      [-0.32, -0.30, -1, 0.037, 0.35, '#fff1de'],\n      [0.02, 0.12, -1, 0.053, 0.42, '#e9f0ff'],\n      [-0.13, 0.46, -1, 0.034, 0.36, '#ffe8d5'],\n    ].map(([x, y, z, size, brightness, tint]) => {\n      const rig = createFlareRig('diffraction');\n      scene.add(rig.root);\n      return { rig, direction: new Vector3(Number(x), Number(y), Number(z)).normalize(), size: Number(size), brightness: Number(brightness), tint: new Color(String(tint)), light: new Vector3() };\n    });\n    const skyOptical = createFlareRig('optical');\n    scene.add(skyOptical.root);\n    const flarePoint = new Vector3();\n    const bodyPoint = new Vector3();\n    const bodyScale = new Vector3();\n    const bodyView = new Vector3();\n    const flareGhostOffsets = [1, 1.28, 0.82, 0.58, 0.29, -0.02, -0.34];\n    const flareGhostSizes = [1, 0.38, 0.15, 0.26, 0.70, 0.16, 0.43];\n    const opticalLayers = [1, 1, 1, 1, 1, 1, 1];\r\n    const comets = createRecordComets(scene, camera, texture);\n    const orbitalComet = createOrbitalComet(scene, camera, texture);\n    const aftermath = createAftermath(scene, camera);\n    const storyCamera = new Vector3();\n    const storyTarget = new Vector3();\n    const cinematicTarget = new Vector3();\n    const planetPosition = new Vector3();\n    const cameraOffset = new Vector3();\n    const visitorSunObstacle = { position: new Vector3(), radius: 1.7 };\n    const alienShotPosition = new Vector3();\n    const alienShotTarget = new Vector3();\n    const faceNormal = new Vector3();\n    const faceUp = new Vector3();\n    const recordOrientation = new Quaternion();\n    const orbitOrientation = new Quaternion();\n    const geometries: BufferGeometry[] = [];\n    const materials: Material[] = [];\n    // Three depth layers give the pullback real star parallax.\n    const starGain = uniform(0);\n    const starGeometry = new PlaneGeometry(1, 1);\n    const starMaterial = new MeshBasicNodeMaterial();\n    const starRadius = uv().sub(0.5).length().mul(2);\n    starMaterial.opacityNode = float(1).sub(smoothstep(0.05, 1, starRadius)).pow(3).mul(starGain);\n    starMaterial.transparent = true;\n    starMaterial.blending = AdditiveBlending;\n    starMaterial.depthWrite = false;\n    starMaterial.toneMapped = false;\n    geometries.push(starGeometry);\n    materials.push(starMaterial);\n    const starBatches: InstancedMesh[] = [];\n    const dummy = new Object3D();\n    for (let layer = 0; layer < 3; layer++) {\n      const stars = new InstancedMesh(starGeometry, starMaterial, 480);\n      for (let i = 0; i < 480; i++) {\n        dummy.position.set((context.random() - 0.5) * 74, (context.random() - 0.5) * 44, -9 - layer * 12 - context.random() * 7);\n        const size = (0.13 + Math.pow(context.random(), 5) * 0.15) * (1 + layer * 0.4);\n        dummy.scale.setScalar(size);\n        dummy.updateMatrix();\n        stars.setMatrixAt(i, dummy.matrix);\n        const tint = context.random();\n        stars.setColorAt(i, new Color().setRGB(0.55 + tint * 0.45, 0.64 + tint * 0.24, 1));\n      }\n      stars.instanceMatrix.needsUpdate = true;\n      if (stars.instanceColor) stars.instanceColor.needsUpdate = true;\n      stars.frustumCulled = false;\n      scene.add(stars);\n      starBatches.push(stars);\n    }\n    const nebulaGain = uniform(0);\n    const nebulaClock = uniform(0);\n    const nebulaGeometry = new PlaneGeometry(1, 1);\n    geometries.push(nebulaGeometry);\n    for (let i = 0; i < 3; i++) {\n      const nebulaMaterial = new MeshBasicNodeMaterial({ color: [0x50219b, 0x07516a, 0x391667][i] });\n      const cloudUv = uv().mul(5).add(i * 3.1);\n      const cloudNoise = sin(cloudUv.x.mul(1.7).add(sin(cloudUv.y.mul(2.1).add(nebulaClock.mul(0.03))))).mul(cos(cloudUv.y.mul(1.3).sub(nebulaClock.mul(0.012)))).mul(0.5).add(0.5);\n      const fineNoise = sin(cloudUv.x.mul(7.1).add(cloudNoise.mul(4)).add(cos(cloudUv.y.mul(5.3)))).mul(0.5).add(0.5);\n      const wisps = smoothstep(0.25, 0.8, cloudNoise.mul(0.7).add(fineNoise.mul(0.3)));\n      nebulaMaterial.opacityNode = float(1).sub(smoothstep(0, 0.6, uv().sub(0.5).length())).pow(2).mul(wisps).mul(nebulaGain);\n      nebulaMaterial.transparent = true;\n      nebulaMaterial.blending = AdditiveBlending;\n      nebulaMaterial.depthWrite = false;\n      nebulaMaterial.toneMapped = false;\n      const cloud = new Mesh(nebulaGeometry, nebulaMaterial);\n      cloud.position.set([-13, 12, 4][i], [7, -6, 12][i], -42);\n      cloud.scale.set(60, 30, 1);\n      cloud.rotation.z = [-0.5, -0.4, 0.6][i];\n      scene.add(cloud);\n      materials.push(nebulaMaterial);\n    }\n    const discGeometry = new CircleGeometry(1, 192);\n    const bodyGeometry = new CylinderGeometry(1, 1, 0.035, 128);\n    const rimGeometry = new TorusGeometry(0.996, 0.008, 6, 192);\n    geometries.push(discGeometry, bodyGeometry, rimGeometry);\n    const faceMaterial = new MeshBasicNodeMaterial();\n    faceMaterial.map = texture;\n    faceMaterial.side = DoubleSide;\n    faceMaterial.toneMapped = false;\n    // Separate artwork lets the logo breathe without scaling the record or grooves.\n    function imageTexture(assetPath: string) {\n      const image = context.images.get(assetPath);\n      if (!image) throw Error('Missing image: ' + assetPath);\n      const result = new DataTexture(image.data, image.width, image.height, RGBAFormat, UnsignedByteType);\n      result.colorSpace = SRGBColorSpace;\n      result.flipY = true;\n      result.minFilter = LinearFilter;\n      result.magFilter = LinearFilter;\n      result.needsUpdate = true;\n      return result;\n    }\n    const vinylTexture = imageTexture('assets/vinyl.png');\n    const hippoTexture = imageTexture('assets/hippo-original.png');\n    const alienTexture = imageTexture('assets/hippo-alien.png');\n    faceMaterial.map = vinylTexture;\n    const logoGeometry = new PlaneGeometry(2, 2);\n    geometries.push(logoGeometry);\n    const hippoMaterial = new MeshBasicNodeMaterial({ map: hippoTexture, transparent: true, depthWrite: false, side: DoubleSide });\n    const alienMaterial = new MeshBasicNodeMaterial({ map: alienTexture, transparent: true, depthWrite: false, side: DoubleSide });\n    hippoMaterial.toneMapped = false;\n    alienMaterial.toneMapped = false;\n    hippoMaterial.alphaTest = 0.02;\n    alienMaterial.alphaTest = 0.02;\n    materials.push(hippoMaterial, alienMaterial);\n    const logoMeshes: Mesh[] = [];\n    const alienTintColor = new Color();\n    const bodyMaterial = new MeshStandardNodeMaterial({ color: 0x11111c, metalness: 0.8, roughness: 0.3 });\n    const rimMaterial = new MeshStandardNodeMaterial({ color: 0x657585, metalness: 0.95, roughness: 0.24 });\n    materials.push(faceMaterial, bodyMaterial, rimMaterial);\n    function makeRecord(warm = false) {\n      const group = new Group();\n      const body = new Mesh(bodyGeometry, bodyMaterial);\n      body.rotation.x = Math.PI / 2;\n      group.add(body);\n      const front = new Mesh(discGeometry, faceMaterial);\n      front.position.z = 0.019;\n      group.add(front);\n      const back = new Mesh(discGeometry, faceMaterial);\n      back.position.z = -0.019;\n      back.rotation.y = Math.PI;\n      group.add(back);\n      const logoFront = new Mesh(logoGeometry, warm ? alienMaterial : hippoMaterial);\n      logoFront.position.z = 0.024;\n      logoFront.renderOrder = 3;\n      const logoBack = new Mesh(logoGeometry, warm ? alienMaterial : hippoMaterial);\n      logoBack.position.z = -0.024;\n      logoBack.renderOrder = 3;\n      logoBack.rotation.y = Math.PI;\n      logoFront.scale.setScalar(0.55);\n      logoBack.scale.setScalar(0.55);\n      group.add(logoFront, logoBack);\n      logoMeshes.push(logoFront, logoBack);\n      group.add(new Mesh(rimGeometry, rimMaterial));\n      if (!warm) polish.addRecordGlint(group, { phase: context.random() * Math.PI * 2 });\n      return group;\n    }\n    const sun = makeRecord();\n    // Separate opening opacity from every other record in the system.\n    const openingVinyl: Material[] = [];\n    const openingLogos: Material[] = [];\n    const openingBlur = createGaussianBlur(hippoTexture, true);\n    const openingOpacity = uniform(0);\n    sun.children.forEach((child, index) => {\n      if (!(child instanceof Mesh) || index > 5) return;\n      const material = (child.material as Material).clone();\n      material.transparent = true;\n      child.material = material;\n      if (index === 3 || index === 4) {\n        const logoMaterial = material as MeshBasicNodeMaterial;\n        logoMaterial.map = null;\n        logoMaterial.colorNode = openingBlur.node.rgb.div(openingBlur.node.a.max(0.00001));\n        logoMaterial.opacityNode = openingBlur.node.a.mul(openingOpacity);\n        logoMaterial.alphaTest = 0.001;\n        logoMaterial.depthWrite = false;\n      }\n      materials.push(material);\n      (index === 3 || index === 4 ? openingLogos : openingVinyl).push(material);\n    });\n    world.add(sun);\n\n    // A smooth emissive halo, attached to the record's plane.\n    const haloGeometry = new PlaneGeometry(4.4, 4.4);\n    geometries.push(haloGeometry);\n    const haloMaterial = new MeshBasicNodeMaterial();\n    const haloGain = uniform(0);\n    const haloInnerRadius = uniform(1);\n    const radius = uv().sub(0.5).length().mul(4.4);\n    const inner = smoothstep(haloInnerRadius.mul(0.9), haloInnerRadius.mul(1.015), radius);\n    const outer = float(1).sub(smoothstep(haloInnerRadius, 2.12, radius));\n    const haloShape = inner.mul(outer.pow(3));\n    haloMaterial.colorNode = mix(vec3(0.35, 0.04, 0.95), vec3(0.04, 0.85, 1), uv().x);\n    haloMaterial.opacityNode = haloShape.mul(haloGain);\n    haloMaterial.transparent = false;\n    haloMaterial.depthTest = false;\n    haloMaterial.blending = AdditiveBlending;\n    haloMaterial.depthWrite = false;\n    haloMaterial.side = DoubleSide;\n    haloMaterial.toneMapped = false;\n    materials.push(haloMaterial);\n    const halo = new Mesh(haloGeometry, haloMaterial);\n    halo.position.z = -0.06;\n    halo.renderOrder = -100;\n    world.add(halo);\n    const incomingSun = makeRecord(true);\n    incomingWorld.add(incomingSun);\n    const incomingHaloGain = uniform(0);\n    const incomingHaloMaterial = new MeshBasicNodeMaterial();\n    incomingHaloMaterial.colorNode = mix(vec3(0.35, 0.17, 0.6), vec3(0.18, 0.7, 0.48), uv().x);\n    incomingHaloMaterial.opacityNode = smoothstep(0.9, 1.015, radius).mul(float(1).sub(smoothstep(1, 2.12, radius)).pow(3)).mul(incomingHaloGain);\n    incomingHaloMaterial.transparent = false;\n    incomingHaloMaterial.depthTest = false;\n    incomingHaloMaterial.blending = AdditiveBlending;\n    incomingHaloMaterial.depthWrite = false;\n    incomingHaloMaterial.side = DoubleSide;\n    incomingHaloMaterial.toneMapped = false;\n    materials.push(incomingHaloMaterial);\n    const incomingHalo = new Mesh(haloGeometry, incomingHaloMaterial);\n    incomingHalo.renderOrder = -100;\n    incomingHalo.position.z = -0.06;\n    incomingWorld.add(incomingHalo);\n    const warmOrbitColors = [0xa6e5c9, 0xb7a2e8, 0xe5bbc9, 0x8ccfcd];\n    const pathFracture = uniform(0);\n    const warpedPaths: { geometry: TorusGeometry; base: Float32Array }[] = [];\n    const pathMask = mix(float(1), float(1).sub(smoothstep(float(0.93).sub(pathFracture.mul(0.8)), float(1).sub(pathFracture.mul(0.8)), sin(uv().x.mul(69)).mul(0.5).add(0.5))), pathFracture.clamp(0, 1));\n    const warmPathGain = uniform(0.38);\n    const warmRings: { mesh: Mesh; material: MeshBasicNodeMaterial }[] = [];\n    for (let i = 0; i < 4; i++) {\n      const geometry = new TorusGeometry(1.7 + i * 0.72, 0.008, 6, 160);\n      const material = new MeshBasicNodeMaterial({ color: warmOrbitColors[i], transparent: true, opacity: 0.42 });\n      material.depthWrite = false;\n      material.opacityNode = warmPathGain.mul(pathMask);\n      material.toneMapped = false;\n      const mesh = new Mesh(geometry, material);\n      mesh.rotation.x = (i % 2 ? -0.17 : 0.22);\n      incomingWorld.add(mesh);\n      warpedPaths.push({ geometry, base: new Float32Array(geometry.getAttribute('position').array) });\n      warmRings.push({ mesh, material });\n      geometries.push(geometry);\n      materials.push(material);\n    }\n    const warmPlanets: { record: Group; moon: Group | null; radius: number; angle: number; size: number }[] = [];\n    for (let i = 0; i < 7; i++) {\n      const record = makeRecord(true);\n      incomingWorld.add(record);\n      const moon = i % 2 === 0 ? makeRecord(true) : null;\n      if (moon) incomingWorld.add(moon);\n      warmPlanets.push({ record, moon, radius: 1.7 + (i % 4) * 0.72, angle: i * 2.399, size: 0.23 + (i % 3) * 0.065 });\n    }\n\n    const orbitRadii = [1.8, 2.65, 3.55, 4.5, 5.45];\n    const orbitColors = [0x36d5ed, 0xa76cff, 0xf454be, 0x5498ff, 0x55ead0];\n    const orbitDirection = uniform(1);\n    const orbits: { group: Group; material: MeshBasicNodeMaterial; gain: { value: number }; angles: { value: number }[]; gaps: { value: number }[] }[] = [];\n    for (let i = 0; i < orbitRadii.length; i++) {\n      const group = new Group();\n      world.add(group);\n      const geometry = new TorusGeometry(orbitRadii[i], 0.008, 6, 256);\n      const material = new MeshBasicNodeMaterial({ color: orbitColors[i], transparent: true, opacity: 0.65 });\n      const ringGain = uniform(0);\n      const angleA = uniform(0);\n      const angleB = uniform(0);\n      const gapA = uniform(0.1);\n      const gapB = uniform(0.1);\n      const theta = uv().x.mul(Math.PI * 2);\n      const deltaA = fract(angleA.sub(theta).mul(1 / (Math.PI * 2)).add(0.5)).sub(0.5).mul(Math.PI * 2).mul(orbitDirection);\n      const deltaB = fract(angleB.sub(theta).mul(1 / (Math.PI * 2)).add(0.5)).sub(0.5).mul(Math.PI * 2).mul(orbitDirection);\n      const wakeA = float(1).sub(smoothstep(gapA, gapA.mul(1.45), deltaA.abs()));\n      const wakeB = float(1).sub(smoothstep(gapB, gapB.mul(1.45), deltaB.abs()));\n      material.depthWrite = false;\n      material.opacityNode = ringGain.mul(float(1).sub(wakeA)).mul(float(1).sub(wakeB)).mul(pathMask);\n      material.toneMapped = false;\n      geometries.push(geometry);\n      materials.push(material);\n      group.add(new Mesh(geometry, material));\n      warpedPaths.push({ geometry, base: new Float32Array(geometry.getAttribute('position').array) });\n      orbits.push({ group, material, gain: ringGain, angles: [angleA, angleB], gaps: [gapA, gapB] });\n    }\n    const planets: { record: Group; anchor: Group; angle: number; orbit: number; size: number; trail: OrbitTrail }[] = [];\n    const moons: { record: Group; parent: Group; radius: number; phase: number; speed: number; size: number }[] = [];\n    const orbitIndices = [0, 1, 1, 2, 2, 3, 3, 4, 4];\n    const startingAngles = [0.5, 1.8, 4.6, 2.7, 5.7, 0.7, 3.8, 2.1, 5.2];\n    for (let i = 0; i < orbitIndices.length; i++) {\n      const record = makeRecord();\n      const anchor = new Group();\n      anchor.add(record);\n      orbits[orbitIndices[i]].group.add(anchor);\n      const planetSize = [0.25, 0.36, 0.23,