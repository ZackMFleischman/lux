 0.35);\n          planet.anchor.position.set(Math.cos(planet.angle) * r * (1 + warp * c.tidalStretch) + Math.cos(planet.angle * 2) * r * warp * c.tidalSkew, Math.sin(planet.angle) * r * (1 - warp * c.tidalStretch * 0.4) + Math.sin(planet.angle * 3) * r * warp * c.tidalSkew * 0.45, Math.sin(planet.angle * 2) * r * warp * c.tidalSkew * 0.2);\n          planet.anchor.scale.setScalar(c.planetSize * ease((progress - 0.35) / 0.65));\n          planet.record.rotation.set(0.12 * Math.sin(planet.angle), 0.1 * Math.cos(planet.angle), spin * (1.2 + i * 0.19));\n          planet.record.scale.setScalar(planet.size * (1 - blackHole * 0.58));\n        }\n        for (const moon of moons) {\n          const angle = moon.phase + moonClock * moon.speed; moon.parent.scale.setScalar(c.moonSpread * (1 - blackHole * 0.72));\n          moon.record.position.set(Math.cos(angle) * moon.radius, Math.sin(angle) * moon.radius, 0.02);\n          moon.record.scale.setScalar(moon.size / c.moonSpread * (1 - blackHole * 0.75));\n          moon.record.rotation.z = spin * 1.8;\n        }\n        warmPathGain.value = 0.38 * orbitFade;\n        for (let i = 0; i < warmPlanets.length; i++) {\n          const planet = warmPlanets[i];\n          planet.angle = i * 2.399 + visualTime * (0.17 + i * 0.008) * c.orbitSpeed;\n          const r = planet.radius * (1 - blackHole) + (2 + i * 0.25) * blackHole + scatter * (4.5 + i * 0.3);\n          planet.record.position.set(Math.cos(planet.angle) * r * (1 + warp * c.tidalStretch) + Math.cos(planet.angle * 2) * r * warp * c.tidalSkew, Math.sin(planet.angle) * r * (1 - warp * c.tidalStretch * 0.4) + Math.sin(planet.angle * 3) * r * warp * c.tidalSkew * 0.45, Math.sin(planet.angle * 2) * r * warp * c.tidalSkew * 0.2);\n          planet.record.rotation.set(0.12, -0.08, -spin * (0.7 + i * 0.11));\n          planet.record.scale.setScalar(planet.size * (1 - blackHole * 0.52));\n          if (planet.moon) {\n            planet.moon.position.copy(planet.record.position); planet.moon.position.x += Math.cos(visualTime * 0.6 + i) * 0.5 * c.moonSpread * (1 - blackHole * 0.65); planet.moon.position.y += Math.sin(visualTime * 0.6 + i) * 0.5 * c.moonSpread * (1 - blackHole * 0.65); planet.moon.position.z += 0.08;\n            planet.moon.rotation.z = spin * 1.5;\n            planet.moon.scale.setScalar(0.075 * (1 - blackHole * 0.75));\n          }\n        }\n        world.updateMatrixWorld(true);\n        const subject = planets[[7, 3, 5, 8, 1][phraseIndex % 5]];\n        subject.anchor.getWorldPosition(planetPosition);\n        const tracking = arrival * (1 - departure) * c.cameraMotion * reveal * Math.min(1, c.closeup * 2);\n        cinematicTarget.copy(planetPosition).multiplyScalar(tracking);\n        const drift = c.cameraMotion * reveal;\n        const yaw = Math.sin(tourTime * Math.PI * 2 / (c.phraseLength * 2.7)) * 0.48 * drift;\n        const pitch = Math.sin(tourTime * Math.PI * 2 / (c.phraseLength * 1.8)) * 0.13 * drift;\n        // Widen the lens during the approach while compensating the dolly distance.\n        // Foreground moons separate from their parent without a sudden scale snap.\n        camera.fov = 42 + visit * 13;\n        camera.updateProjectionMatrix();\n        const lensCompensation = Math.tan(21 * Math.PI / 180) / Math.tan(camera.fov * Math.PI / 360);\n        const wideDistance = openingDistance * (1 - reveal) + 17.12 * reveal;\n        const closeDistance = 4.1 + c.planetSize * 0.5;\n        const distance = (wideDistance * (1 - visit) + closeDistance * visit) * lensCompensation;\n        cameraOffset.set(Math.sin(yaw) * Math.cos(pitch), Math.sin(pitch), Math.cos(yaw) * Math.cos(pitch));\n        // Move toward the face normal, not toward an edge-on view of a tilted disc.\n        subject.record.getWorldQuaternion(recordOrientation);\n        subject.anchor.getWorldQuaternion(orbitOrientation);\n        faceNormal.set(0, 0, 1).applyQuaternion(recordOrientation);\n        faceUp.set(0, 1, 0).applyQuaternion(orbitOrientation);\n        cameraOffset.lerp(faceNormal, tracking).normalize().multiplyScalar(distance);\n        camera.up.set(0, 1, 0).lerp(faceUp, tracking).normalize();\n        camera.position.copy(cinematicTarget).add(cameraOffset);\n        camera.lookAt(cinematicTarget);\n        // Take over gently as the intruder appears; frame both systems through merger.\n        const storyCameraWeight = ease((story - 0.055) / 0.16);\n        const storyYaw = 0.12 * Math.sin(visualTime * 0.045) + inspiral * 0.25;\n        const storyDistance = 23 - inspiral * 8 + scatter * 6 - blackHole * 3;\n        storyTarget.set(3.3 * (1 - encounter), 0, 0);\n        storyCamera.set(storyTarget.x + Math.sin(storyYaw) * storyDistance, 2.5 - blackHole * 1.2, Math.cos(storyYaw) * storyDistance);\n        camera.position.lerp(storyCamera, storyCameraWeight);\n        camera.up.lerp(faceUp.set(0, 1, 0), storyCameraWeight).normalize();\n        cinematicTarget.lerp(storyTarget, storyCameraWeight);\n        camera.fov = camera.fov * (1 - storyCameraWeight) + 46 * storyCameraWeight;\n        camera.updateProjectionMatrix();\n        camera.lookAt(cinematicTarget);\n        camera.updateMatrixWorld(true);\n        atmosphere.update(visualTime, glowReveal, tension, c.lensFlare * (0.7 + c.kick * 0.3 + c.highs * 0.2) * sunFade, c.nebula);\n        const cometTime = Math.max(0, tourTime - c.phraseLength);\n        const cometReveal = unfold * ease(cometTime / 8);\n        comets.update({ timeSeconds: cometTime, reveal: cometReveal, interval: c.cometInterval, size: c.cometSize, brightness: c.cometBrightness, highs: 0, trailSize: c.cometTrailSize, trailLength: c.cometTrailLength, activity: c.cometActivity * (1 - encounter), sunRadius: c.size * (1 + 0.08 * c.sunAudioGain) });\n        orbitalComet.update(c.orbitalPreview < 0 ? cometTime : c.orbitalPreview * c.orbitalPeriod, c.orbitalPreview < 0 ? cometReveal : unfold, c.orbitalPeriod, c.cometTrailSize, c.cometBrightness, c.cometSize, c.orbitalComet * (1 - encounter), c.cometTrailLength, c.size * (1 + 0.08 * c.sunAudioGain));\n        scene.updateMatrixWorld(true);\n        for (let i = 0; i < visitTargets.length; i++) {\n          const record = planets[visitOrder[i]].record;\n          const target = visitTargets[i];\n          record.getWorldPosition(target.position);\n          record.getWorldQuaternion(visitOrientation);\n          record.getWorldScale(visitScale);\n          target.radius = Math.min(Math.abs(visitScale.x), Math.abs(visitScale.y));\n          target.logoTop = target.radius * c.hippoSize * 0.98;\n          target.normal.set(0, 0, 1).applyQuaternion(visitOrientation);\n          target.surfaceUp.set(0, 1, 0).applyQuaternion(visitOrientation);\n          // Local +Z is the pilot-facing side; aim it toward the viewer along the surface.\n          target.up.subVectors(camera.position, target.position);\n          target.up.addScaledVector(target.normal, -target.up.dot(target.normal));\n          if (target.up.lengthSq() < 0.001) target.up.copy(camera.up);\n          target.up.normalize();\n          // Keep the surface origin centered so either landing face uses its own signed normal.\n        }\n        sun.getWorldPosition(visitorSunObstacle.position);\n        visitorSunObstacle.radius = c.size * (1 + c.sunAudioGain * 0.08);\n        visitor.update(visitorTime, frame.deltaSeconds, visitTargets, visitorGate, c.visitorPeriod, c.visitorSize, 0.65 + calmHighs * 0.18, visitorSunObstacle);\n        // Conservative screen-space occlusion keeps luminous overlays off vinyl.\n        const flareBodies = [sun, ...planets.map(p => p.record), ...moons.map(m => m.record)];\n        if (story > 0) flareBodies.push(incomingSun, ...warmPlanets.map(p => p.record));\n        const projectedBodies = flareBodies.map(body => {\n          body.getWorldPosition(bodyPoint);\n          bodyView.copy(bodyPoint).applyMatrix4(camera.matrixWorldInverse);\n          body.getWorldScale(bodyScale);\n          bodyPoint.project(camera);\n          return { x: bodyPoint.x * camera.aspect, y: bodyPoint.y,\n            radius: Math.max(Math.abs(bodyScale.x), Math.abs(bodyScale.y)) / (Math.max(0.01, -bodyView.z) * Math.tan(camera.fov * Math.PI / 360)), front: bodyView.z < 0 };\n        });\n        const clearAt = (x: number, y: number, radius: number) => {\n          let visibility = 1;\n          for (const body of projectedBodies) {\n            if (!body.front) continue;\n            const clearance = Math.hypot(x * camera.aspect - body.x, y - body.y) - body.radius - radius;\n            visibility *= ease(clearance / 0.06);\n          }\n          return visibility;\n        };\n        const skyReveal = ease((progress - 0.70) / 0.30) * (1 - burst * 0.8);\n        for (let starIndex = 0; starIndex < featureStars.length; starIndex++) {\n          const star = featureStars[starIndex];\n          const starSize = 0.1032 * c.featureStarScale * Math.exp(Math.log(star.size / 0.043) * c.featureStarVariance * 2);\n          const densityFade = ease(c.featureStarDensity - starIndex);\n          star.light.copy(camera.position).addScaledVector(star.direction, 60);\n          flarePoint.copy(star.light).project(camera);\n          star.rig.update(camera, star.light, { scale: starSize,\n            brightness: star.brightness * 1.8 * Math.min(1.4, c.stars), tint: star.tint,\n            visibility: skyReveal * c.featureStarOpacity * densityFade * clearAt(flarePoint.x, flarePoint.y, starSize * 0.6), secondarySpikes: 0.035 });\n        }\n        const opticalStar = featureStars[0];\n        flarePoint.copy(opticalStar.light).project(camera);\n        const opticalClear = clearAt(flarePoint.x, flarePoint.y, 0.025);\n        for (let i = 0; i < flareGhostOffsets.length; i++) {\n          opticalLayers[i] = clearAt(flarePoint.x * flareGhostOffsets[i], flarePoint.y * flareGhostOffsets[i], 0.26 * flareGhostSizes[i]);\n        }\n        const offCenter = ease((Math.hypot(flarePoint.x, flarePoint.y) - 0.35) / 0.35);\n        skyOptical.update(camera, opticalStar.light, { scale: 0.26, brightness: 0.75 * Math.min(2, c.lensFlare),\n          visibility: skyReveal * ease(c.featureStarDensity) * offCenter * opticalClear, tint: opticalStar.tint, ghosts: 0.55, streak: 0, layerVisibility: opticalLayers });\n        aftermath.update(visualTime, burst, collapse, blackHole, 0.7 + c.bass * 0.12 + c.highs * 0.08);\n      },\n      render(target) {\n        return context.renderer.render(scene, camera, target);\n      },\n      reset() {\n        resetToOpening = true;\n        resetMode = rawMode;\n        resetReplay = rawReplay;\n        visitor.reset();\n        phaseEpoch = -1;\n        lastAutomaticReveal = 1;\n        heldReveal = 0;\r\n        comets.reset();\n        orbitalComet.reset();\n        aftermath.reset();\n        calmBass = 0;\n        calmMids = 0;\n        calmHighs = 0;\n        spin = 0;\n        moonClock = 0;\n        for (let i = 0; i < planets.length; i++) planets[i].angle = startingAngles[i];\n        for (let i = 0; i < warmPlanets.length; i++) warmPlanets[i].angle = i * 2.399;\n      },\n      dispose() {\n        visitor.dispose();\n        texture.dispose();\n        vinylTexture.dispose();\n        hippoTexture.dispose();\n        alienTexture.dispose();\n        polish.dispose();\n        atmosphere.dispose();\n        for (const star of featureStars) star.rig.dispose();\n        skyOptical.dispose();\r\n        comets.dispose();\n        orbitalComet.dispose();\n        aftermath.dispose();\n        for (const stars of starBatches) stars.dispose();\n        for (const geometry of geometries) geometry.dispose();\n        for (const material of materials) material.dispose();\n      },\n    };\n  },\n});\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n",
      "comet-orbits.ts": "import {\n  AdditiveBlending,\n  Color,\n  InstancedMesh,\n  Object3D,\n  BufferAttribute,\n  BufferGeometry,\n  CircleGeometry,\n  DataTexture,\n  DoubleSide,\n  Euler,\n  Group,\n  Mesh,\n  MeshBasicNodeMaterial,\n  PerspectiveCamera,\n  PlaneGeometry,\n  Quaternion,\n  Scene,\n  Vector3,\n} from 'three/webgpu';\nimport { float, mix, smoothstep, uniform, uv, vec2, vec3 } from 'three/tsl';\n\nexport interface OrbitalComet {\n  update(\n    timeSeconds: number,\n    reveal: number,\n    period: number,\n    trailSize: number,\n    brightness: number,\n    size: number,\n    activity: number,\n    trailLength: number,\n    sunRadius?: number,\n  ): void;\n  reset(): void;\n  dispose(): void;\n}\n\nconst tau = Math.PI * 2;\nconst clamp = (value: number, low = 0, high = 1) => Math.max(low, Math.min(high, value));\n\n/**\n * A high-eccentricity, sun-focused record comet. The trail samples prior points\n * on the same orbit, so it remains a fixed world-space passage through the system.\n */\nexport function createOrbitalComet(\n  scene: Scene,\n  camera: PerspectiveCamera,\n  texture: DataTexture,\n): OrbitalComet {\n  const root = new Group();\n  const head = new Group();\n  const orbitRotation = new Quaternion().setFromEuler(new Euler(0.72, -0.34, 0.48));\n  const semiMajor = 9;\n  const eccentricity = 0.78;\n  const minorFactor = Math.sqrt(1 - eccentricity * eccentricity);\n  let orbitScale = 1;\n  const samples = 72;\n  const headGeometry = new CircleGeometry(1, 96);\n  const tailGeometry = new BufferGeometry();\n  const tailPositions = new Float32Array((samples + 1) * 6);\n  const tailUvs = new Float32Array((samples + 1) * 4);\n  const indices: number[] = [];\n  const gain = uniform(0);\n  const clock = uniform(0);\n  const materials: MeshBasicNodeMaterial[] = [];\n  const current = new Vector3();\n  const previous = new Vector3();\n  const next = new Vector3();\n  const tangent = new Vector3();\n  const cameraLine = new Vector3();\n  const side = new Vector3();\n  const outward = new Vector3();\n\n  for (let index = 0; index <= samples; index += 1) {\n    const t = index / samples;\n    tailUvs.set([t, 0, t, 1], index * 4);\n    if (index < samples) {\n      const offset = index * 2;\n      indices.push(offset, offset + 1, offset + 2, offset + 1, offset + 3, offset + 2);\n    }\n  }\n  tailGeometry.setAttribute('position', new BufferAttribute(tailPositions, 3));\n  tailGeometry.setAttribute('uv', new BufferAttribute(tailUvs, 2));\n  tailGeometry.setIndex(indices);\n\n  const face = new MeshBasicNodeMaterial({ map: texture, side: DoubleSide });\n  face.toneMapped = false;\n  const record = new Mesh(headGeometry, face);\n  head.add(record);\n\n  const glow = new MeshBasicNodeMaterial();\n  const radial = float(1).sub(smoothstep(0.14, 0.5, uv().sub(vec2(0.5)).length()));\n  glow.colorNode = mix(vec3(0.18, 0.8, 1), vec3(1, 0.25, 0.65), uv().x);\n  glow.opacityNode = radial.pow(3).mul(gain).mul(0.42);\n  glow.transparent = true;\n  glow.blending = AdditiveBlending;\n  glow.depthWrite = false;\n  glow.toneMapped = false;\n  materials.push(glow);\n  const glowMesh = new Mesh(new PlaneGeometry(2.8, 2.8), glow);\n  glowMesh.position.z = -0.01;\n  head.add(glowMesh);\n\n  const tailMaterial = new MeshBasicNodeMaterial();\n  const crossFade = float(1).sub(smoothstep(0.05, 1, uv().y.sub(0.5).abs().mul(2))).pow(2);\n  const endFade = float(1).sub(smoothstep(0.22, 1, uv().x));\n  tailMaterial.colorNode = mix(vec3(0.12, 0.76, 1), vec3(0.65, 0.08, 0.94), uv().x);\n  tailMaterial.opacityNode = crossFade.mul(endFade).mul(gain).mul(0.42);\n  tailMaterial.transparent = true;\n  tailMaterial.blending = AdditiveBlending;\n  tailMaterial.depthWrite = false;\n  tailMaterial.side = DoubleSide;\n  tailMaterial.toneMapped = false;\n  materials.push(tailMaterial);\n  const tail = new Mesh(tailGeometry, tailMaterial);\n  tail.frustumCulled = false;\n\n  scene.add(root);\n  root.add(tail, head);\n\n  function pointAt(timeSeconds: number, periodSeconds: number, target: Vector3): Vector3 {\n    const mean = ((timeSeconds / periodSeconds) * tau - 0.8) % tau;\n    const normalizedMean = mean < 0 ? mean + tau : mean;\n    let eccentric = normalizedMean;\n    for (let iteration = 0; iteration < 8; iteration += 1) {\n      const residual = eccentric - eccentricity * Math.sin(eccentric) - normalizedMean;\n      eccentric -= residual / (1 - eccentricity * Math.cos(eccentric));\n    }\n    target.set(\n      semiMajor * (Math.cos(eccentric) - eccentricity),\n      semiMajor * minorFactor * Math.sin(eccentric),\n      0,\n    );\n    return target.applyQuaternion(orbitRotation).multiplyScalar(orbitScale);\n  }\n\n  return {\n    update(timeSeconds, reveal, period, trailSize, brightness, size, activity, trailLength, sunRadius = 1.5) {\n      orbitScale = Math.max(1, (sunRadius + 0.17 * clamp(size, 0.2, 3) + 0.55) / (semiMajor * (1 - eccentricity)));\n      const periodSeconds = Math.max(10, period);\n      const visible = clamp(reveal) * clamp(activity);\n      root.visible = visible > 0.0005;\n      if (!root.visible) return;\n      const intensity = visible * clamp(brightness, 0, 2.5);\n      gain.value = intensity;\n      clock.value = timeSeconds;\n      pointAt(timeSeconds, periodSeconds, current);\n      pointAt(timeSeconds - 0.015, periodSeconds, previous);\n      tangent.subVectors(current, previous).normalize();\n\n      head.position.copy(current);\n      head.quaternion.copy(camera.quaternion);\n      head.rotateZ(timeSeconds * 0.8 + 0.3);\n      head.rotateX(0.12);\n      head.scale.setScalar(0.17 * clamp(size, 0.2, 3));\n\n      const tailSeconds = Math.min(periodSeconds * 0.23, 7.5) * clamp(trailLength, 0.3, 3);\n      const widthScale = clamp(trailSize, 0.2, 3);\n      for (let index = 0; index <= samples; index += 1) {\n        const age = (index / samples) * tailSeconds;\n        pointAt(timeSeconds - age, periodSeconds, current);\n        pointAt(timeSeconds - age - 0.012, periodSeconds, previous);\n        pointAt(timeSeconds - age + 0.012, periodSeconds, next);\n        tangent.subVectors(next, previous).normalize();\n        cameraLine.subVectors(camera.position, current).normalize();\n        side.crossVectors(tangent, cameraLine).normalize();\n        if (side.lengthSq() < 0.0001) side.set(0, 1, 0).applyQuaternion(orbitRotation);\n        outward.copy(current).normalize();\n        const trail = index / samples;\n        const dustBias = trail * trail * 0.3;\n        current.addScaledVector(outward, dustBias);\n        current.addScaledVector(cameraLine, -0.08 * clamp(size, 0.2, 3));\n        const width = (0.018 + trail * trail * 0.2) * widthScale;\n        const offset = index * 6;\n        tailPositions[offset] = current.x - side.x * width;\n        tailPositions[offset + 1] = current.y - side.y * width;\n        tailPositions[offset + 2] = current.z - side.z * width;\n        tailPositions[offset + 3] = current.x + side.x * width;\n        tailPositions[offset + 4] = current.y + side.y * width;\n        tailPositions[offset + 5] = current.z + side.z * width;\n      }\n      (tailGeometry.getAttribute('position') as BufferAttribute).needsUpdate = true;\n    },\n    reset() {\n      root.visible = false;\n      gain.value = 0;\n    },\n    dispose() {\n      root.removeFromParent();\n      headGeometry.dispose();\n      tailGeometry.dispose();\n      face.dispose();\n      glowMesh.geometry.dispose();\n      for (const material of materials) material.dispose();\n    },\n  };\n}\n",
      "flag.ts": "import { CylinderGeometry, DataTexture, DoubleSide, Group, LinearFilter, Mesh, MeshBasicNodeMaterial, PlaneGeometry, RGBAFormat, SRGBColorSpace, UnsignedByteType } from 'three/webgpu';\nimport { positionLocal, sin, uniform, uv, vec3 } from 'three/tsl';\nimport { pilotPixels } from './pilot-pixels.ts';\n\nexport function createAlienFlag() {\n  const root = new Group();\n  const clock = uniform(0);\n  const poleGeometry = new CylinderGeometry(0.018, 0.025, 1.5, 12);\n  const clothGeometry = new PlaneGeometry(0.88, 0.66, 20, 12);\n  clothGeometry.translate(0.44, 1.08, 0);\n  const poleMaterial = new MeshBasicNodeMaterial({ color: 0xb9d9e2 });\n  const pole = new Mesh(poleGeometry, poleMaterial);\n  pole.position.y = 0.75;\n  root.add(pole);\n  const wave = sin(positionLocal.x.mul(9).sub(clock.mul(2.6))).mul(uv().x.pow(1.5)).mul(0.095);\n  const clothMaterial = new MeshBasicNodeMaterial({ color: 0xd1eee7, side: DoubleSide });\n  clothMaterial.positionNode = positionLocal.add(vec3(0, wave.mul(0.17), wave));\n  root.add(new Mesh(clothGeometry, clothMaterial));\n  const texture = new DataTexture(pilotPixels(), 192, 192, RGBAFormat, UnsignedByteType);\n  texture.colorSpace = SRGBColorSpace;\n  texture.flipY = true;\n  texture.minFilter = LinearFilter;\n  texture.magFilter = LinearFilter;\n  texture.needsUpdate = true;\n  const emblemMaterial = new MeshBasicNodeMaterial({ map: texture, transparent: true, alphaTest: 0.02, side: DoubleSide });\n  emblemMaterial.positionNode = positionLocal.add(vec3(0, wave.mul(0.17), wave.add(0.005)));\n  const emblemGeometry = new PlaneGeometry(0.6, 0.6, 20, 12);\n  emblemGeometry.translate(0.45, 1.08, 0);\n  // Identical displacement coordinates keep the emblem attached to the cloth.\n  const emblemWave = sin(positionLocal.x.mul(9).sub(clock.mul(2.6))).mul(positionLocal.x.div(0.88).pow(1.5)).mul(0.095);\n  emblemMaterial.positionNode = positionLocal.add(vec3(0, emblemWave.mul(0.17), emblemWave.add(0.005)));\n  root.add(new Mesh(emblemGeometry, emblemMaterial));\n  const backEmblemMaterial = emblemMaterial.clone();\n  backEmblemMaterial.positionNode = positionLocal.add(vec3(0, emblemWave.mul(0.17), emblemWave.sub(0.008)));\n  root.add(new Mesh(emblemGeometry, backEmblemMaterial));\n  return {\n    root,\n    update(time: number, deployed: number, size: number) {\n      clock.value = time;\n      root.visible = deployed > 0.001;\n      root.scale.set(size, size * deployed, size);\n    },\n    dispose() {\n      root.removeFromParent();\n      poleGeometry.dispose();\n      clothGeometry.dispose();\n      emblemGeometry.dispose();\n      poleMaterial.dispose();\n      clothMaterial.dispose();\n      emblemMaterial.dispose();\n      backEmblemMaterial.dispose();\n      texture.dispose();\n    },\n  };\n}\n",
      "flare-rig.ts": "import {\n  AdditiveBlending, Color, Group, Mesh, MeshBasicNodeMaterial,\n  PlaneGeometry, Vector3, Vector4, PerspectiveCamera, OrthographicCamera,\n} from 'three/webgpu';\nimport { uniform, uv, wgslFn } from 'three/tsl';\n\n// Screen-space photometric shapes: no textures, temporal noise, or frame allocations.\nconst diffraction = wgslFn(`\nfn diffraction(st: vec2f, shape: vec4f, tint: vec3f) -> vec4f {\n  let p = (st - 0.5) * 2.0;\n  let cs = cos(shape.z); let sn = sin(shape.z);\n  let q = vec2f(cs*p.x-sn*p.y, sn*p.x+cs*p.y);\n  let r = length(q);\n  var rays = 0.0;\n  for (var i = 0; i < 3; i = i + 1) {\n    let a = 1.5707963 + f32(i)*1.04719755;\n    let along = abs(dot(q,vec2f(cos(a),sin(a))));\n    let across = abs(dot(q,vec2f(-sin(a),cos(a))));\n    let width = max(0.0018 + 0.0035*exp(-along*7.0), fwidth(across)*0.7);\n    rays += exp(-across/width) * pow(max(0.0,1.0-along),2.4) * 0.72;\n    rays += exp(-across/(width*4.0)) * exp(-along*9.0) * 0.075;\n  }\n  let horizontal = exp(-abs(q.y)/0.0025) * pow(max(0.0,1.0-abs(q.x)*2.4),2.0);\n  rays += horizontal * shape.y;\n  let coreWidth = max(0.0067, fwidth(r)*0.65);\n  let core = exp(-r*r/(coreWidth*coreWidth))*2.6;\n  let halo = exp(-r*36.0)*0.15;\n  let ring = exp(-pow((r-0.038)/0.004,2.0))*0.024;\n  let edge = 1.0-smoothstep(0.85,0.99,r);\n  let energy = (rays + core + halo + ring)*shape.x*edge;\n  let rgb = mix(tint,vec3f(1.0),exp(-r*90.0)*0.88)*energy;\n  return vec4f(rgb, clamp(energy,0.0,1.0));\n}`);\n\nconst optical = wgslFn(`\nfn optical(st: vec2f, shape: vec4f, tint: vec3f) -> vec4f {\n  let p = (st-0.5)*2.0;\n  let r = length(p);\n  var energy = 0.0;\n  if (shape.y < 0.5) {\n    energy = exp(-r*r/0.0006)*2.0 + exp(-r*13.0)*0.16;\n    energy += exp(-abs(p.y)/0.005)*pow(max(0.0,1.0-abs(p.x)),3.0)*shape.z;\n  } else {\n    let angle = atan2(p.y,p.x);\n    let sector = angle + 0.52359878;\n    let folded = sector - floor(sector/1.04719755)*1.04719755 - 0.52359878;\n    let polygon = mix(r,r*cos(folded),shape.w);\n    let edge = exp(-pow((polygon-0.65)/0.11,2.0));\n    let fill = (1.0-smoothstep(0.35,0.80,polygon))*0.035;\n    let arc = exp(-pow((r-0.71)/0.035,2.0))*(0.45+0.55*p.y);\n    energy = edge*0.13 + fill + arc*0.10;\n  }\n  energy *= shape.x*(1.0-smoothstep(0.86,0.99,r));\n  return vec4f(tint*energy,clamp(energy,0.0,1.0));\n}`);\n\nexport type FlareOptions = {\n  brightness?: number; visibility?: number; scale?: number; tint?: Color;\n  rotation?: number; secondarySpikes?: number; ghosts?: number; streak?: number; layerVisibility?: number[];\n};\n\nexport function createFlareRig(kind: 'optical' | 'diffraction') {\n  const root = new Group();\n  const geometry = new PlaneGeometry(2, 2);\n  const defaultTint = new Color('#c7ddff');\n  const shapes = Array.from({ length: kind === 'optical' ? 7 : 1 }, () => uniform(new Vector4()));\n  const tints = shapes.map(() => uniform(defaultTint.clone()));\n  const materials = shapes.map((shape, i) => {\n    const material = new MeshBasicNodeMaterial({\n      transparent: true, blending: AdditiveBlending, depthTest: false,\n      depthWrite: false, toneMapped: false, premultipliedAlpha: true,\n    });\n    material.fragmentNode = (kind === 'optical' ? optical : diffraction)(uv(), shape, tints[i]);\n    return material;\n  });\n  const meshes = materials.map(material => {\n    const mesh = new Mesh(geometry, material);\n    mesh.frustumCulled = false;\n    mesh.renderOrder = 1000;\n    root.add(mesh);\n    return mesh;\n  });\n  const point = new Vector3();\n  const cameraPosition = new Vector3();\n  const right = new Vector3();\n  const up = new Vector3();\n  const forward = new Vector3();\n  const direction = new Vector3();\n  const spectral = [new Color('#ffffff'), new Color('#f0cddd'), new Color('#bfdcd0'), new Color('#c4ceef'), new Color('#e5d4c4'), new Color('#c2d9ea'), new Color('#e3c5dc')];\n  const ghostLocations = [0, -0.28, 0.18, 0.42, 0.71, 1.02, 1.34];\n  const ghostSizes = [1, 0.38, 0.15, 0.26, 0.70, 0.16, 0.43];\n  return {\n    root,\n    // Camera must have an updated world matrix. worldLight can be camera.position\n    // plus a fixed sky direction; translation then cannot disturb constellations.\n    update(camera: PerspectiveCamera | OrthographicCamera, worldLight: Vector3, options: FlareOptions = {}) {\n      camera.updateMatrixWorld();\n      point.copy(worldLight).project(camera);\n      camera.getWorldPosition(cameraPosition);\n      camera.getWorldDirection(forward);\n      const inFront = direction.copy(worldLight).sub(cameraPosition).dot(forward) > 0;\n      const edge = Math.max(0, Math.min(1, (1.22 - Math.max(Math.abs(point.x), Math.abs(point.y))) / 0.20));\n      const energy = (options.brightness ?? 1) * (options.visibility ?? 1) * edge;\n      root.visible = inFront && energy > 0.00001;\n      if (!root.visible) return;\n      for (let i = 0; i < tints.length; i++) tints[i].value.copy(options.tint ?? defaultTint).multiply(spectral[i]);\n      right.set(1, 0, 0).applyQuaternion(camera.quaternion);\n      up.set(0, 1, 0).applyQuaternion(camera.quaternion);\n      const distance = Math.max(camera.near * 4, 1);\n      const halfHeight = camera instanceof PerspectiveCamera\n        ? Math.tan(camera.fov * Math.PI / 360) * distance\n        : (camera.top - camera.bottom) / (2 * camera.zoom);\n      const aspect = camera instanceof PerspectiveCamera ? camera.aspect : (camera.right - camera.left) / (camera.top - camera.bottom);\n      for (let i = 0; i < meshes.length; i++) {\n        const mesh = meshes[i];\n        const location = 1 - ghostLocations[i];\n        mesh.position.copy(cameraPosition).addScaledVector(forward, distance)\n          .addScaledVector(right, point.x * halfHeight * aspect * location)\n          .addScaledVector(up, point.y * halfHeight * location);\n        mesh.quaternion.copy(camera.quaternion);\n        mesh.scale.setScalar(halfHeight * (options.scale ?? 0.28) * ghostSizes[i]);\n        shapes[i].value.set(\n          energy * (options.layerVisibility?.[i] ?? 1) * (i === 0 ? 1 : (options.ghosts ?? 0.55) * 1.5),\n          kind === 'optical' ? (i === 0 ? 0 : 1) : (options.secondarySpikes ?? 0.12),\n          kind === 'optical' ? (options.streak ?? 0.08) : (options.rotation ?? 0), i === 4 || i === 2 ? 0 : 0.72,\n        );\n      }\n    },\n    dispose() {\n      geometry.dispose();\n      for (const material of materials) material.dispose();\n      root.removeFromParent();\n      root.clear();\n    },\n  };\n}\n",
      "gaussian-blur.ts": "import { Texture, Vector2 } from 'three/webgpu';\nimport { texture, uniform, uv, vec2, vec4 } from 'three/tsl';\n\n// Gaussian-weighted RGBA blur. Accumulate premultiplied alpha to avoid dark fringes.\nexport function createGaussianBlur(image: Texture, straightAlpha = false, flipY = false) {\n  const radius = uniform(new Vector2(0, 0));\n  const coordinates = flipY ? uv().flipY() : uv();\n  const weights = [1, 6, 15, 20, 15, 6, 1];\n  const samples: ReturnType<typeof texture>[] = [];\n  let result = texture(image, coordinates).mul(0);\n  for (let y = -3; y <= 3; y++) {\n    for (let x = -3; x <= 3; x++) {\n      const sample = texture(image, coordinates.add(radius.mul(vec2(x / 3, y / 3))));\n      samples.push(sample);\n      const rgba = straightAlpha ? vec4(sample.rgb.mul(sample.a), sample.a) : sample;\n      result = result.add(rgba.mul(weights[x + 3] * weights[y + 3] / 4096));\n    }\n  }\n  return {\n    node: result,\n    radius,\n    bind(image: Texture) { for (const sample of samples) sample.value = image; },\n  };\n}\n",
      "pilot-pixels.ts": "// Embedded 192px RGBA pilot from the generated alien PNG. Library v1 has no asset envelope.\nconst pixels = '';\nexport function pilotPixels() {\n  const data = new Uint8Array(pixels.length / 2);\n  for (let i = 0; i < data.length; i++) data[i] = parseInt(pixels.slice(i * 2, i * 2 + 2), 16);\n  return data;\n}\n",
      "planet-visitor.ts": "import { AdditiveBlending, BufferAttribute, BufferGeometry, Color, DoubleSide, Mesh, InstancedMesh, MeshBasicNodeMaterial, Object3D, PerspectiveCamera, PlaneGeometry, Matrix4, Quaternion, Scene, Vector3 } from 'three/webgpu';\nimport { float, mix, smoothstep, uniform, uv, vec3 } from 'three/tsl';\nimport { createAlienSaucer } from './saucer.ts';\nimport { createAlienFlag } from './flag.ts';\n\nexport interface VisitTarget {\n  /** Stable target identity; array order may change. */\n  id: string;\n  /** World-space landing point on the visible record surface. */\n  position: Vector3;\n  /** World-space surface normal, pointing out of the visible face. */\n  normal: Vector3;\n  /** World-space tangent chosen to keep the pilot facing the camera. */\n  up: Vector3;\n  /** World-space record radius. */\n  radius: number;\n  surfaceUp: Vector3;\n  logoTop: number;\n}\n\nconst clamp = (v: number) => Math.max(0, Math.min(1, v));\nconst ease = (v: number) => { const x = clamp(v); return x * x * x * (x * (x * 6 - 15) + 10); };\n\n/**\n * Standalone SDK 0.2/0.4 scene adapter. Call AFTER planet world matrices update.\n * enabled is a 0..1 scene-controlled gate; use 0 during disruptive story beats.\n * Target vectors are read, never mutated. Source library entry stays independent.\n */\nexport function createPlanetVisitor(scene: Scene, camera: PerspectiveCamera) {\n  const craft = createAlienSaucer();\n  scene.add(craft.root);\n  // Use the scene's existing lighting; do not add a second scene-wide light rig.\n  const flags = Array.from({ length: 6 }, () => createAlienFlag());\n  const flagIds: string[] = flags.map(() => '');\n  const flagTimes: number[] = flags.map(() => -1);\n  const flagSides: number[] = flags.map(() => 1);\n  for (const flag of flags) { scene.add(flag.root); flag.root.visible = false; }\n  const normal = new Vector3();\n  const tangent = new Vector3();\n  const right = new Vector3();\n  const basis = new Matrix4();\n  const pose = new Quaternion();\n  const desiredPose = new Quaternion();\n  const desiredPosition = new Vector3();\n  const presentationUp = new Vector3();\n  const presentationFront = new Vector3();\n  const presentationRight = new Vector3();\n  let poseReady = false;\n  let flightClock = 0;\n  const launchPosition = new Vector3();\n  const exitPosition = new Vector3();\n  const wanderCenter = new Vector3();\n  const flightRight = new Vector3();\n  const flightUp = new Vector3();\n  const flightPose = new Quaternion();\n  const flightNormal = new Vector3();\n  const arcStart = new Vector3();\n  const arcEnd = new Vector3();\n  const arcAxis = new Vector3();\n  let launchAngle = 0;\n  let launchRadius = 20;\n  function safeArc(from: Vector3, to: Vector3, t: number, clearance: number, out: Vector3) {\n    arcStart.copy(from).sub(wanderCenter);\n    arcEnd.copy(to).sub(wanderCenter);\n    const ra = Math.max(clearance, arcStart.length());\n    const rb = Math.max(clearance, arcEnd.length());\n    arcStart.normalize(); arcEnd.normalize();\n    const dot = Math.max(-1, Math.min(1, arcStart.dot(arcEnd)));\n    const angle = Math.acos(dot);\n    arcAxis.copy(arcEnd).addScaledVector(arcStart, -dot);\n    if (arcAxis.lengthSq() < 0.000001) {\n      arcAxis.copy(flightNormal).addScaledVector(arcStart, -flightNormal.dot(arcStart));\n      if (arcAxis.lengthSq() < 0.000001) arcAxis.set(0, 1, 0).addScaledVector(arcStart, -arcStart.y);\n    }\n    arcAxis.normalize();\n    out.copy(arcStart).multiplyScalar(Math.cos(angle * t)).addScaledVector(arcAxis, Math.sin(angle * t));\n    out.normalize().multiplyScalar(ra + (rb - ra) * t).add(wanderCenter);\n  }\n  const visited = new Set<string>();\n  let currentId = '';\n  let landingSide = 1;\n  const landingView = new Vector3();\n  let lastVisit = -1;\n  let visibility = 0;\n  let flagClock = 0;\n  const flightPosition = new Vector3();\n  const landingPosition = new Vector3();\n  const trailGeometry = new PlaneGeometry(1, 1);\n  const trailMaterial = new MeshBasicNodeMaterial({ color: 0xffffff, transparent: true, blending: AdditiveBlending, depthWrite: false });\n  trailMaterial.opacityNode = float(1).sub(smoothstep(0.05, 0.5, uv().sub(0.5).length())).pow(2).mul(0.55);\n  trailMaterial.toneMapped = false;\n  const sparkColor = new Color();\n  const sparks = new InstancedMesh(trailGeometry, trailMaterial, 96);\n  sparks.frustumCulled = false;\n  scene.add(sparks);\n  const history = Array.from({ length: 96 }, () => ({ position: new Vector3(), time: -100 }));\n  const dummy = new Object3D();\n  let nextSpark = 0;\n  let lastSparkTime = -1;\n  const ribbonGeometry = new BufferGeometry();\n  const ribbonPositions = new Float32Array(96 * 6);\n  const ribbonUV = new Float32Array(96 * 4);\n  const ribbonIndices: number[] = [];\n  for (let i = 0; i < 96; i++) {\n    ribbonUV.set([i / 95, 0, i / 95, 1], i * 4);\n    if (i < 95) { const k = i * 2; ribbonIndices.push(k, k + 1, k + 2, k + 1, k + 3, k + 2); }\n  }\n  ribbonGeometry.setAttribute('position', new BufferAttribute(ribbonPositions, 3));\n  ribbonGeometry.setAttribute('uv', new BufferAttribute(ribbonUV, 2));\n  ribbonGeometry.setIndex(ribbonIndices);\n  const ribbonGain = uniform(0);\n  const ribbonMaterial = new MeshBasicNodeMaterial({ transparent: true, blending: AdditiveBlending, depthWrite: false, side: DoubleSide });\n  ribbonMaterial.colorNode = mix(mix(vec3(0.45, 1, 0.88), vec3(0.35, 0.22, 1), smoothstep(0, 0.55, uv().x)), vec3(1, 0.25, 0.45), smoothstep(0.4, 1, uv().x));\n  ribbonMaterial.opacityNode = float(1).sub(uv().y.sub(0.5).abs().mul(2)).pow(2).mul(float(1).sub(uv().x).pow(1.5)).mul(ribbonGain);\n  ribbonMaterial.toneMapped = false;\n  const ribbon = new Mesh(ribbonGeometry, ribbonMaterial);\n  ribbon.frustumCulled = false;\n  scene.add(ribbon);\n  const ribbonSide = new Vector3();\n  const ribbonTangent = new Vector3();\n  const ribbonSight = new Vector3();\n\n  function orient(target: VisitTarget, side = 1) {\n    normal.copy(target.normal).normalize().multiplyScalar(side);\n    tangent.copy(target.up).addScaledVector(normal, -target.up.dot(normal));\n    if (tangent.lengthSq() < 0.0001) {\n      tangent.set(Math.abs(normal.y) < 0.9 ? 0 : 1, Math.abs(normal.y) < 0.9 ? 1 : 0, 0);\n      tangent.addScaledVector(normal, -tangent.dot(normal));\n    }\n    tangent.normalize();\n    right.crossVectors(normal, tangent).normalize();\n    basis.makeBasis(right, normal, tangent);\n    pose.setFromRotationMatrix(basis);\n  }\n\n  return {\n    root: craft.root,\n    update(time: number, delta: number, targets: VisitTarget[], enabled = 1, period = 48, size = 0.28, engine = 0.8, sunObstacle?: { position: Vector3; radius: number }) {\n      flagClock += Math.max(0, delta);\n      const cycle = Math.max(35, Math.min(60, period));\n      if (enabled > 0.5) flightClock += Math.max(0, delta);\n      const visit = Math.floor(flightClock / cycle);\n      const phase = (flightClock % cycle) / cycle;\n      if (visit !== lastVisit && enabled > 0.5) {\n        lastVisit = visit;\n        const available = targets.filter(item => !visited.has(item.id));\n        currentId = available.length ? available[visit % available.length].id : '';\n        const selected = available.find(item => item.id === currentId);\n        landingSide = selected && landingView.subVectors(camera.position, selected.position).dot(selected.normal) < 0 ? -1 : 1;\n        wanderCenter.copy(sunObstacle?.position ?? new Vector3());\n        const distance = Math.max(12, camera.position.distanceTo(wanderCenter));\n        const height = Math.tan(camera.fov * Math.PI / 360) * distance;\n        const side = visit % 2 ? -1 : 1;\n        flightRight.set(1, 0, 0).applyQuaternion(camera.quaternion);\n        flightUp.set(0, 1, 0).applyQuaternion(camera.quaternion);\n        flightPose.copy(camera.quaternion);\n        flightNormal.crossVectors(flightRight, flightUp).normalize();\n        launchPosition.copy(wanderCenter).addScaledVector(flightRight, side * height * camera.aspect * 2.5).addScaledVector(flightUp, height * 0.35);\n        exitPosition.copy(wanderCenter).addScaledVector(flightRight, -side * height * camera.aspect * 3).addScaledVector(flightUp, height * 1.5);\n        arcStart.copy(launchPosition).sub(wanderCenter);\n        launchAngle = Math.atan2(arcStart.dot(flightUp), arcStart.dot(flightRight));\n        launchRadius = arcStart.length();\n        poseReady = false;\n        for (const point of history) point.time = -100;\n      }\n      const target = targets.find(item => item.id === currentId);\n      const flightSeed = visit;\n      visibility += (clamp(enabled) - visibility) * (1 - Math.exp(-Math.max(0, delta) * 3));\n      const reveal = 1;\n      craft.root.visible = !!target && phase < 0.97 && reveal * visibility > 0.001;\n      if (target && craft.root.visible) {\n        // Choose the visible surface at approach, after any camera tour has settled.\n        if (phase < 0.40) landingSide = landingView.subVectors(camera.position, target.position).dot(target.normal) < 0 ? -1 : 1;\n        orient(target, landingSide);\n        const craftSize = Math.min(size, target.radius * 0.42) * 0.5;\n        const approach = ease(phase / 0.15);\n        const departure = ease((phase - 0.72) / 0.23);\n        const landingWeight = ease((phase - 0.40) / 0.18) * (1 - ease((phase - 0.72) / 0.15));\n        const gear = ease((phase - 0.48) / 0.10) * (1 - ease((phase - 0.73) / 0.07));\n        landingPosition.copy(target.position).addScaledVector(normal, craftSize * 0.74);\n        const squiggle = phase * Math.PI * 2;\n        const clearance = Math.max(2.4, (sunObstacle?.radius ?? 1.7) + craftSize * 2 + 0.6);\n        const angle = launchAngle + squiggle * 1.6 + Math.sin(squiggle * 4) * 0.22 + Math.sin(squiggle * 9) * 0.07;\n        const radius = Math.max(clearance + 0.8, 4.5 + Math.sin(squiggle * 5 + flightSeed) * 0.7);\n        const flightRadius = launchRadius * (1 - approach) + radius * approach;\n        flightPosition.copy(wanderCenter)\n          .addScaledVector(flightRight, Math.cos(angle) * flightRadius)\n          .addScaledVector(flightUp, Math.sin(angle) * flightRadius)\n          .addScaledVector(flightNormal, Math.sin(squiggle * 3) * 0.8 * approach);\n        // Both approach and departure stay on an exterior arc, never a chord through the sun.\n        safeArc(flightPosition, landingPosition, landingWeight, clearance, desiredPosition);\n        if (phase >= 0.72) safeArc(landingPosition, exitPosition, departure, clearance, desiredPosition);\n        desiredPose.copy(flightPose).slerp(pose, landingWeight);\n        if (!poseReady) { craft.root.position.copy(desiredPosition); craft.root.quaternion.copy(desiredPose); poseReady = true; }\n        craft.root.position.copy(desiredPosition);\n        craft.root.quaternion.slerp(desiredPose, 1 - Math.exp(-Math.max(0, delta) * 5));\n        craft.root.scale.setScalar(craftSize * visibility);\n        craft.update(time, Math.sin(squiggle * 7) * 0.12 * (1 - gear), 1 - departure, 1, engine, 0, 0.43, gear);\n        craft.faceCamera(camera);\n        if (time - lastSparkTime > 0.012 && landingWeight < 0.95) {\n          history[nextSpark].position.copy(craft.root.position);\n          history[nextSpark].time = time;\n          nextSpark = (nextSpark + 1) % history.length;\n          lastSparkTime = time;\n        }\n        if (phase >= 0.63 && phase < 0.72 && enabled > 0.5 && !visited.has(target.id)) {\n          visited.add(target.id);\n          const slot = flagIds.indexOf('');\n          if (slot >= 0) { flagIds[slot] = target.id; flagTimes[slot] = flagClock; flagSides[slot] = landingSide; }\n        }\n      }\n      sparks.visible = enabled > 0.01;\n      for (let i = 0; i < history.length; i++) {\n        const age = time - history[i].time;\n        const life = age >= 0 && age < 1.8 ? Math.pow(1 - age / 1.8, 1.6) : 0;\n        dummy.position.copy(history[i].position);\n        dummy.position.x += Math.sin(i * 13.7) * age * 0.04;\n        dummy.position.y += Math.cos(i * 7.1) * age * 0.04;\n        dummy.quaternion.copy(camera.quaternion);\n        dummy.scale.setScalar(life * (0.06 + age * 0.07) * visibility);\n        sparkColor.setHSL(0.46 + Math.min(1, Math.max(0, age) / 1.8) * 0.4 + Math.sin(i * 2.4) * 0.035, 0.85, 0.54 * life);\n        sparks.setColorAt(i, sparkColor);\n        dummy.updateMatrix();\n        sparks.setMatrixAt(i, dummy.matrix);\n      }\n      sparks.instanceMatrix.needsUpdate = true;\n      if (sparks.instanceColor) sparks.instanceColor.needsUpdate = true;\n      ribbonGain.value = visibility * (0.3 + engine * 0.25);\n      ribbon.visible = enabled > 0.01;\n      for (let i = 0; i < 96; i++) {\n        const point = history[(nextSpark - 1 - i + history.length * 2) % history.length];\n        const next = history[(nextSpark - 2 - i + history.length * 2) % history.length];\n        const age = time - point.time;\n        ribbonTangent.subVectors(point.position, next.position).normalize();\n        ribbonSight.subVectors(camera.position, point.position).normalize();\n        ribbonSide.crossVectors(ribbonTangent, ribbonSight).normalize();\n        const width = age >= 0 && age < 1.8 ? (0.018 + age * 0.055) * Math.pow(1 - age / 1.8, 0.5) : 0;\n        const k = i * 6;\n        ribbonPositions[k] = point.position.x - ribbonSide.x * width;\n        ribbonPositions[k + 1] = point.position.y - ribbonSide.y * width;\n        ribbonPositions[k + 2] = point.position.z - ribbonSide.z * width;\n        ribbonPositions[k + 3] = point.position.x + ribbonSide.x * width;\n        ribbonPositions[k + 4] = point.position.y + ribbonSide.y * width;\n        ribbonPositions[k + 5] = point.position.z + ribbonSide.z * width;\n      }\n      let validPoints = 0;\n      for (let i = 0; i < 96; i++) {\n        const age = time - history[(nextSpark - 1 - i + history.length * 2) % history.length].time;\n        if (age < 0 || age >= 1.8) break;\n        validPoints++;\n      }\n      ribbonGeometry.setDrawRange(0, Math.max(0, validPoints - 1) * 6);\n      (ribbonGeometry.getAttribute('position') as BufferAttribute).needsUpdate = true;\n      for (let i = 0; i < flags.length; i++) {\n        const destination = targets.find(item => item.id === flagIds[i]);\n        if (!destination || flagTimes[i] < 0) { flags[i].root.visible = false; continue; }\n        orient({ ...destination, up: destination.surfaceUp }, flagSides[i]);\n        const flagSize = Math.min(size * 0.65, destination.radius * 0.24);\n        flags[i].root.position.copy(destination.position).addScaledVector(destination.surfaceUp, destination.logoTop).addScaledVector(normal, 0.012);\n        flags[i].root.quaternion.copy(pose);\n        flags[i].update(time, ease((flagClock - flagTimes[i]) / 0.9), flagSize * visibility);\n      }\n    },\n    reset() {\n      currentId = '';\n      flightClock = 0;\n      visited.clear();\n      poseReady = false;\n      for (const point of history) point.time = -100;\n      lastSparkTime = -1;\n      lastVisit = -1;\n      visibility = 0;\n      craft.root.visible = false;\n      for (let i = 0; i < flags.length; i++) { flagIds[i] = ''; flagTimes[i] = -1; flags[i].root.visible = false; }\n    },\n    dispose() { ribbon.removeFromParent(); ribbonGeometry.dispose(); ribbonMaterial.dispose(); sparks.removeFromParent(); trailGeometry.dispose(); trailMaterial.dispose(); craft.dispose(); for (const flag of flags) flag.dispose(); },\n  };\n}\n\r\n",
      "record-comets.ts": "import {\n  AdditiveBlending, BufferAttribute, BufferGeometry, CircleGeometry, Color,\n  DataTexture, DoubleSide, Group, InstancedMesh, LinearFilter, Mesh,\n  MeshBasicNodeMaterial, Object3D, PerspectiveCamera, PlaneGeometry,\n  Quaternion, Scene, TorusGeometry, Vector3,\n} from 'three/webgpu';\nimport { float, mix, sin, smoothstep, uniform, uv, vec3 } from 'three/tsl';\n\nexport interface CometSettings {\n  /** Seconds since the opening reveal completed. Use the Lux scene clock. */\n  timeSeconds: number;\n  reveal: number;\n  /** Average opportunity spacing. Default 55; deliberately sparse. */\n  interval?: number;\n  size?: number;\n  brightness?: number;\n  /** Set zero to hide. This changes intensity, not the deterministic schedule. */\n  activity?: number;\n  /** Optional existing Highs control, 0..1. Light response, never spawn rate. */\n  highs?: number;\n  trailSize?: number;\n  trailLength?: number;\n  sunRadius?: number;\n}\n\nconst clamp = (x: number, low = 0, high = 1) => Math.max(low, Math.min(high, x));\nconst smooth = (x: number) => { const t = clamp(x); return t * t * (3 - 2 * t); };\nconst hash = (n: number) => { const x = Math.sin(n * 127.1 + 311.7) * 43758.5453; return x - Math.floor(x); };\n\n/** Pure timing helper, also useful for selecting an offline preview moment. */\nexport function cometPassAt(timeSeconds: number, interval = 55) {\n  const period = Math.max(40, interval);\n  const clock = Math.max(0, timeSeconds);\n  const event = Math.floor(clock / period);\n  const delay = event === 0 ? 18 : 10 + hash(event + 3) * 10;\n  const duration = 9 + hash(event + 9) * 3;\n  const age = clock - event * period - delay;\n  return { event, age, duration, active: timeSeconds >= 0 && age >= 0 };\n}\n\n/**\n * One rare flyby at a time: the supplied hippo vinyl, a cyan ion filament,\n * a curved violet dust fan, and sparse luminous grains. No external assets.\n * Owns its meshes/materials; never disposes the caller's record texture.\n */\nexport function createRecordComets(scene: Scene, camera: PerspectiveCamera, texture: DataTexture) {\n  const root = new Group();\n  root.visible = false;\n  scene.add(root);\n  const record = new Group();\n  root.add(record);\n  const geometry = new CircleGeometry(1, 96);\n  const face = new MeshBasicNodeMaterial({ map: texture, side: DoubleSide });\n  face.toneMapped = false;\n  const disc = new Mesh(geometry, face);\n  record.add(disc);\n  const rimGeometry = new TorusGeometry(0.997, 0.013, 6, 96);\n  const rimMaterial = new MeshBasicNodeMaterial({ color: 0xaeeaff });\n  rimMaterial.toneMapped = false;\n  record.add(new Mesh(rimGeometry, rimMaterial));\n\n  const gain = uniform(0);\n  const clock = uniform(0);\n  const headGain = uniform(0);\n  const headGeometry = new PlaneGeometry(5, 5);\n  const headMaterial = new MeshBasicNodeMaterial();\n  const headRadius = uv().sub(0.5).length().mul(5);\n  headMaterial.colorNode = mix(vec3(0.28, 0.05, 1), vec3(0.12, 0.88, 1), uv().x);\n  headMaterial.opacityNode = float(1).sub(smoothstep(0.72, 2.4, headRadius)).pow(3).mul(headGain);\n  headMaterial.transparent = true;\n  headMaterial.blending = AdditiveBlending;\n  headMaterial.depthWrite = false;\n  headMaterial.toneMapped = false;\n  const headGlow = new Mesh(headGeometry, headMaterial);\n  headGlow.position.z = -0.025;\n  record.add(headGlow);\n\n  const samples = 96;\n  function makeRibbon(kind: number) {\n    const vertices = new Float32Array((samples + 1) * 6);\n    const texcoords = new Float32Array((samples + 1) * 4);\n    const indices: number[] = [];\n    for (let i = 0; i <= samples; i++) {\n      const along = i / samples;\n      texcoords.set([along, 0, along, 1], i * 4);\n      if (i < samples) {\n        const a = i * 2;\n        indices.push(a, a + 1, a + 2, a + 1, a + 3, a + 2);\n      }\n    }\n    const ribbonGeometry = new BufferGeometry();\n    const position = new BufferAttribute(vertices, 3);\n    ribbonGeometry.setAttribute('position', position);\n    ribbonGeometry.setAttribute('uv', new BufferAttribute(texcoords, 2));\n    ribbonGeometry.setIndex(indices);\n    const material = new MeshBasicNodeMaterial();\n    const cross = uv().y.sub(0.5).abs().mul(2);\n    const crossFade = float(1).sub(smoothstep(0, 1, cross)).pow(kind === 1 ? 3 : 1.7);\n    const endFade = float(1).sub(smoothstep(0.38, 1, uv().x));\n    const filament = sin(uv().x.mul(38).sub(clock.mul(3.2)).add(uv().y.mul(8))).mul(0.07).add(0.93);\n    material.colorNode = kind === 0\n      ? mix(vec3(0.22, 0.85, 1), vec3(0.48, 0.045, 0.85), uv().x)\n      : kind === 1\n        ? mix(vec3(0.85, 0.97, 1), vec3(0.1, 0.6, 1), uv().x)\n        : mix(vec3(0.85, 0.25, 0.7), vec3(0.2, 0.05, 0.7), uv().x);\n    material.opacityNode = crossFade.mul(endFade).mul(filament).mul(gain).mul(kind === 1 ? 0.8 : kind === 0 ? 0.34 : 0.16);\n    material.transparent = true;\n    material.blending = AdditiveBlending;\n    material.depthWrite = false;\n    material.side = DoubleSide;\n    material.toneMapped = false;\n    const mesh = new Mesh(ribbonGeometry, material);\n    mesh.frustumCulled = false;\n    root.add(mesh);\n    return { mesh, geometry: ribbonGeometry, material, vertices, position, kind };\n  }\n  const ribbons = [makeRibbon(0), makeRibbon(1), makeRibbon(2)];\n  const grainGeometry = new PlaneGeometry(1, 1);\n  const grainMaterial = new MeshBasicNodeMaterial();\n  grainMaterial.opacityNode = float(1).sub(smoothstep(0, 0.5, uv().sub(0.5).length())).pow(3).mul(gain);\n  grainMaterial.transparent = true;\n  grainMaterial.blending = AdditiveBlending;\n  grainMaterial.depthWrite = false;\n  grainMaterial.toneMapped = false;\n  const grains = new InstancedMesh(grainGeometry, grainMaterial, 84);\n  grains.frustumCulled = false;\n  root.add(grains);\n\n  const origin = new Vector3();\n  const right = new Vector3();\n  const up = new Vector3();\n  const forward = new Vector3();\n  const birthRotation = new Quaternion();\n  const p = new Vector3();\n  const next = new Vector3();\n  const tangent = new Vector3();\n  const sight = new Vector3();\n  const side = new Vector3();\n  const grainDummy = new Object3D();\n  const grainColor = new Color();\n  let eventId = -1;\n  let passStart = 0;\n  let passDuration = 10;\n  let exitAge = -1;\n  let retired = false;\n  const projectedHead = new Vector3();\n  const viewHead = new Vector3();\n  let viewHeight = 6;\n  let direction = 1;\n  let slope = 0.3;\n  let bend = 0.4;\n  let impact = 0;\n  let depth = 0;\n  let clearance = 2.5;\n\n  function path(t: number, target: Vector3) {\n    // Fast near periapsis, slower on either side; monotonic and continuous.\n    const x = t * 2 - 1;\n    const stretch = x + 0.13 * Math.sin(Math.PI * x);\n    const px = stretch * viewHeight * camera.aspect * 1.38 * direction;\n    const py = viewHeight * (impact + slope * stretch + bend * stretch * stretch);\n    const pz = viewHeight * (depth * 0.25 + Math.sin(t * Math.PI) * 0.13);\n    return target.copy(origin).addScaledVector(right, px).addScaledVector(up, py).addScaledVector(forward, pz);\n  }\n\n  return {\n    update(settings: CometSettings) {\n      let pass = cometPassAt(settings.timeSeconds, settings.interval);\n      // Finish this flyby even if another scheduled opportunity arrives during its fade.\n      if (eventId >= 0 && !retired) pass = { event: eventId, age: settings.timeSeconds - passStart, duration: passDuration, active: true };\n      const visible = clamp(settings.reveal) * clamp(settings.activity ?? 1);\n      root.visible = pass.active && visible > 0.001;\n      if (!root.visible) return;\n      if (eventId !== pass.event) {\n        eventId = pass.event;\n        passStart = settings.timeSeconds - pass.age;\n        passDuration = pass.duration;\n        exitAge = -1;\n        retired = false;\n        // Fix the flyby's frame at entry: the comet does not stick to a moving camera.\n        camera.getWorldQuaternion(birthRotation);\n        right.set(1, 0, 0).applyQuaternion(birthRotation);\n        up.set(0, 1, 0).applyQuaternion(birthRotation);\n        forward.set(0, 0, -1).applyQuaternion(birthRotation);\n        const distance = clamp(camera.position.length(), 5, 20);\n        origin.copy(camera.position).addScaledVector(forward, distance);\n        viewHeight = Math.tan(camera.fov * Math.PI / 360) * distance;\n        direction = hash(eventId + 19) > 0.5 ? 1 : -1;\n        slope = (hash(eventId + 21) - 0.5) * 0.7;\n        bend = (hash(eventId + 27) - 0.5) * 0.7;\n        impact = (hash(eventId + 39) - 0.5) * 0.7;\n        depth = hash(eventId + 44) - 0.5;\n        // Choose one smooth birth-frame curve; never push individual samples around the sun.\n        const safeRadius = (settings.sunRadius ?? 1.5) + viewHeight * 0.064 * clamp(settings.size ?? 1, 0.2, 3) + 0.7;\n        const crossing = -origin.dot(right) / (viewHeight * camera.aspect * 1.38 * direction);\n        const sideOfSun = hash(eventId + 39) > 0.5 ? 1 : -1;\n        impact = -origin.dot(up) / viewHeight + sideOfSun * safeRadius * 1.35 / viewHeight - slope * crossing - bend * crossing * crossing;\n      }\n      if (retired) { root.visible = false; return; }\n      clearance = (settings.sunRadius ?? 1.5) + viewHeight * 0.064 * clamp(settings.size ?? 1, 0.2, 3) + 0.55;\n      const age = pass.age;\n      const phase = age / pass.duration;\n      const tailSeconds = 3.6 * clamp(settings.trailLength ?? 1.25, 0.3, 3);\n      const headSize = viewHeight * 0.064 * clamp(settings.size ?? 1, 0.2, 3);\n      path(phase, record.position);\n      projectedHead.copy(record.position).project(camera);\n      viewHead.copy(record.position).applyMatrix4(camera.matrixWorldInverse);\n      const screenRadius = headSize / (Math.max(0.01, -viewHead.z) * Math.tan(camera.fov * Math.PI / 360));\n      const headOnScreen = viewHead.z < -camera.near && viewHead.z > -camera.far\n        && Math.abs(projectedHead.x) <= 1 + screenRadius / camera.aspect + 0.04\n        && Math.abs(projectedHead.y) <= 1 + screenRadius + 0.04;\n      if (headOnScreen) exitAge = -1;\n      else if (phase >= 1 && exitAge < 0) exitAge = age;\n      const tailFade = exitAge < 0 ? 1 : 1 - smooth((age - exitAge) / Math.max(4, tailSeconds));\n      if (tailFade <= 0) { retired = true; root.visible = false; return; }\n      const envelope = smooth(age / 1.2) * tailFade;\n      const brightness = clamp(settings.brightness ?? 1, 0, 3);\n      const intensity = envelope * visible * visible * brightness;\n      gain.value = intensity;\n      clock.value = settings.timeSeconds;\n      headGain.value = intensity * 0.7;\n      // Keep the vinyl attached for the entire flyby; only retire after it clears the live camera.\n      record.visible = true;\n      record.quaternion.copy(birthRotation);\n      record.rotateX(0.12 * Math.sin(age * 0.8));\n      record.rotateZ(-age * 2.6 + eventId * 1.2);\n      record.scale.setScalar(headSize);\n\n      const trailSize = clamp(settings.trailSize ?? 1.45, 0.3, 4);\n      for (const ribbon of ribbons) {\n        for (let i = 0; i <= samples; i++) {\n          const tail = i / samples;\n          const samplePhase = (age - tail * tailSeconds) / pass.duration;\n          path(samplePhase, p);\n          path(samplePhase + 0.002, next);\n          tangent.subVectors(next, p).normalize();\n          sight.subVectors(camera.position, p).normalize();\n          side.crossVectors(tangent, sight).normalize();\n          // Broad dust gently separates from the narrow blue ion tail.\n          const curl = Math.sin(tail * 7 + eventId) * tail * tail;\n          p.addScaledVector(up, viewHeight * tail * tail * (ribbon.kind === 2 ? 0.2 : 0.025));\n          p.addScaledVector(side, viewHeight * curl * (ribbon.kind === 2 ? 0.06 : 0.014));\n          p.addScaledVector(sight, -headSize * 0.3);\n          const width = trailSize * viewHeight * (ribbon.kind === 1 ? 0.004 : ribbon.kind === 0 ? 0.028 + tail * 0.07 : 0.045 + tail * 0.18);\n          const grow = smooth((age - tail * tailSeconds) / 0.8);\n          const offset = i * 6;\n          ribbon.vertices[offset] = p.x - side.x * width * grow;\n          ribbon.vertices[offset + 1] = p.y - side.y * width * grow;\n          ribbon.vertices[offset + 2] = p.z - side.z * width * grow;\n          ribbon.vertices[offset + 3] = p.x + side.x * width * grow;\n          ribbon.vertices[offset + 4] = p.y + side.y * width * grow;\n          ribbon.vertices[offset + 5] = p.z + side.z * width * grow;\n        }\n        ribbon.position.needsUpdate = true;\n      }\n      for (let i = 0; i < 84; i++) {\n        const tail = (i + hash(i + 8)) / 84;\n        path((age - tail * tailSeconds) / pass.duration, p);\n        const scatter = viewHeight * tail * 0.17 * trailSize;\n        p.addScaledVector(up, (hash(i + 31) - 0.5) * scatter + tail * tail * viewHeight * 0.1);\n        p.addScaledVector(right, (hash(i + 93) - 0.5) * scatter);\n        grainDummy.position.copy(p);\n        grainDummy.quaternion.copy(camera.quaternion);\n        const fade = Math.pow(1 - tail, 1.8) * smooth((age - tail * tailSeconds) / 0.8);\n        grainDummy.scale.setScalar(viewHeight * (0.004 + hash(i + 4) * 0.009) * fade);\n        grainDummy.updateMatrix();\n        grains.setMatrixAt(i, grainDummy.matrix);\n        grainColor.setRGB((0.35 + tail * 0.3) * fade, (0.9 - tail * 0.5) * fade, fade);\n        grains.setColorAt(i, grainColor);\n      }\n      grains.instanceMatrix.needsUpdate = true;\n      if (grains.instanceColor) grains.instanceColor.needsUpdate = true;\n    },\n    reset() {\n      eventId = -1;\n      exitAge = -1;\n      retired = false;\n      root.visible = false;\n    },\n    dispose() {\n      root.removeFromParent();\n      for (const ribbon of ribbons) { ribbon.geometry.dispose(); ribbon.material.dispose(); }\n      geometry.dispose(); face.dispose(); rimGeometry.dispose(); rimMaterial.dispose();\n      headGeometry.dispose(); headMaterial.dispose();\n      grains.dispose(); grainGeometry.dispose(); grainMaterial.dispose();\n    },\n  };\n}\n\r\n",
      "saucer.ts": "import {\n  AdditiveBlending, AmbientLight, Color, CylinderGeometry, DataTexture,\n  EquirectangularReflectionMapping, DirectionalLight, DoubleSide, Group, LinearFilter, Mesh,\n  MeshBasicNodeMaterial, MeshStandardNodeMaterial, PlaneGeometry,\n  PerspectiveCamera, Quaternion, RGBAFormat, SphereGeometry, SRGBColorSpace, TorusGeometry, UnsignedByteType,\n} from 'three/webgpu';\nimport { float, smoothstep, uniform, uv, vec3 } from 'three/tsl';\nimport { pilotPixels } from './pilot-pixels.ts';\n\n/** Scene-local primitive as well as the Library image component's craft. */\nexport function createAlienSaucer() {\n  const root = new Group();\n  const hull = new Group();\n  root.add(hull);\n  const sphere = new SphereGeometry(1, 48, 24);\n  const ring = new TorusGeometry(1.18, 0.045, 10, 80);\n  const domeGeometry = new SphereGeometry(0.73, 40, 24, 0, Math.PI * 2, 0, Math.PI / 2);\n  const arcGeometry = new TorusGeometry(0.73, 0.012, 6, 64, Math.PI);\n  const plane = new PlaneGeometry(1, 1);\n  const beamGeometry = new CylinderGeometry(0.12, 0.85, 1.65, 40, 1, true);\n  const metal = new MeshStandardNodeMaterial({ color: 0x8c9dae, metalness: 0.96, roughness: 0.17 });\n  const lowerMetal = new MeshStandardNodeMaterial({ color: 0x59697b, metalness: 0.94, roughness: 0.22 });\n  // Studio softboxes reflected in the physical metal, local to this craft.\n  const envPixels = new Uint8Array(256 * 128 * 4);\n  for (let y = 0; y < 128; y++) for (let x = 0; x < 256; x++) {\n    const u = x / 256, v = y / 128;\n    const box = Math.exp(-Math.pow((u - 0.24) / 0.09, 8) - Math.pow((v - 0.32) / 0.17, 8));\n    const strip = Math.exp(-Math.pow((u - 0.73) / 0.035, 6) - Math.pow((v - 0.48) / 0.28, 8));\n    const k = (y * 256 + x) * 4;\n    envPixels[k] = Math.min(255, 24 + box * 220 + strip * 130);\n    envPixels[k + 1] = Math.min(255, 30 + box * 220 + strip * 180);\n    envPixels[k + 2] = Math.min(255, 44 + box * 210 + strip * 210);\n    envPixels[k + 3] = 255;\n  }\n  const environment = new DataTexture(envPixels, 256, 128, RGBAFormat, UnsignedByteType);\n  environment.mapping = EquirectangularReflectionMapping;\n  environment.colorSpace = SRGBColorSpace;\n  environment.needsUpdate = true;\n  metal.envMap = environment;\n  lowerMetal.envMap = environment;\n  metal.envMapIntensity = 1.35;\n  lowerMetal.envMapIntensity = 1.15;\n  const glow = new MeshBasicNodeMaterial({ color: 0x88ffe2 });\n  glow.toneMapped = false;\n  const glass = new MeshBasicNodeMaterial({ color: 0xb0ffe9, transparent: true, opacity: 0.025, depthWrite: false, side: DoubleSide });\n  const shine = new MeshBasicNodeMaterial({ color: 0xd8fff5, transparent: true, opacity: 0.15, depthWrite: false });\n  const body = new Mesh(sphere, metal);\n  body.scale.set(1.25, 0.19, 0.78);\n  hull.add(body);\n  const bottom = new Mesh(sphere, lowerMetal);\n  bottom.scale.set(0.94, 0.24, 0.62);\n  bottom.position.y = -0.09;\n  hull.add(bottom);\n  const rim = new Mesh(ring, glow);\n  rim.rotation.x = Math.PI / 2;\n  rim.scale.y = 0.66;\n  hull.add(rim);\n  const dome = new Mesh(domeGeometry, glass);\n  dome.position.y = 0.12;\n  dome.scale.z = 0.68;\n  dome.renderOrder = 4;\n  hull.add(dome);\n  const arch = new Mesh(arcGeometry, shine);\n  arch.position.set(0, 0.12, 0.03);\n  hull.add(arch);\n  const gleam = new Mesh(arcGeometry, shine);\n  gleam.scale.set(0.38, 0.93, 1);\n  gleam.position.set(-0.13, 0.12, 0.37);\n  hull.add(gleam);\n\n  const texture = new DataTexture(pilotPixels(), 192, 192, RGBAFormat, UnsignedByteType);\n  texture.colorSpace = SRGBColorSpace;\n  texture.flipY = true;\n  texture.minFilter = LinearFilter;\n  texture.magFilter = LinearFilter;\n  texture.needsUpdate = true;\n  const pilotMaterial = new MeshBasicNodeMaterial({ map: texture, transparent: true, alphaTest: 0.02, side: DoubleSide });\n  pilotMaterial.toneMapped = false;\n  const pilot = new Mesh(plane, pilotMaterial);\n  pilot.position.set(0, 0.55, 0.46);\n  pilot.scale.setScalar(1.05);\n  hull.add(pilot);\n  const pilotParentPose = new Quaternion();\n  const pilotCameraPose = new Quaternion();\n  const lamps: Mesh[] = [];\n  for (let i = 0; i < 9; i++) {\n    const angle = Math.PI * 2 * i / 9;\n    const lamp = new Mesh(sphere, glow);\n    lamp.position.set(Math.cos(angle) * 1.09, -0.025, Math.sin(angle) * 0.67);\n    lamp.scale.set(0.065, 0.04, 0.045);\n    hull.add(lamp);\n    lamps.push(lamp);\n  }\n  const legGeometry = new CylinderGeometry(0.028, 0.038, 0.5, 12);\n  const legs: { pivot: Group; direction: number }[] = [];\n  for (let i = 0; i < 3; i++) {\n    const direction = i === 0 ? -1 : 1;\n    const pivot = new Group();\n    pivot.position.set(i === 0 ? -0.65 : i === 1 ? 0.65 : 0, -0.17, i === 2 ? -0.46 : 0.32);\n    const strut = new Mesh(legGeometry, metal);\n    strut.position.y = -0.25;\n    pivot.add(strut);\n    const joint = new Mesh(sphere, lowerMetal);\n    joint.scale.setScalar(0.065);\n    pivot.add(joint);\n    const foot = new Mesh(sphere, metal);\n    foot.scale.set(0.14, 0.045, 0.11);\n    foot.position.y = -0.5;\n    pivot.add(foot);\n    hull.add(pivot);\n    legs.push({ pivot, direction });\n  }\n  const beamGain = uniform(0);\n  const beamMaterial = new MeshBasicNodeMaterial({ transparent: true, blending: AdditiveBlending, depthWrite: false, side: DoubleSide });\n  beamMaterial.colorNode = vec3(0.22, 1, 0.77);\n  beamMaterial.opacityNode = uv().y.pow(1.8).mul(beamGain).mul(0.16);\n  const beam = new Mesh(beamGeometry, beamMaterial);\n  beam.position.y = -1;\n  root.add(beam);\n  const exhaustGain = uniform(0);\n  const exhaustMaterial = new MeshBasicNodeMaterial({ transparent: true, blending: AdditiveBlending, depthWrite: false });\n  exhaustMaterial.colorNode = vec3(0.25, 0.82, 1);\n  exhaustMaterial.opacityNode = float(1).sub(smoothstep(0.02, 0.5, uv().sub(0.5).length())).pow(2).mul(exhaustGain);\n  const exhaust = new Mesh(plane, exhaustMaterial);\n  exhaust.position.set(0, -0.24, 0.2);\n  exhaust.scale.set(1.35, 0.55, 1);\n  hull.add(exhaust);\n  const key = new DirectionalLight(0xd7eaff, 3.5);\n  key.position.set(-3, 5, 6);\n  const fill = new DirectionalLight(0xc5a3ff, 2);\n  fill.position.set(3, 1, 2);\n  const lighting = new Group();\n  lighting.add(key, fill, new AmbientLight(0xffffff, 1.3));\n  const tint = new Color();\n  return {\n    root,\n    lighting,\n    update(time: number, banking: number, hover: number, pilotSize: number, engine: number, beamStrength: number, hue: number, landingGear = 0) {\n      const gear = Math.max(0, Math.min(1, landingGear));\n      for (const leg of legs) {\n        leg.pivot.rotation.z = leg.direction * (1.45 * (1 - gear) + 0.25 * gear);\n        leg.pivot.visible = gear > 0.005;\n      }\n      hull.rotation.z = banking;\n      hull.rotation.y = Math.sin(time * 0.7) * 0.1 * (1 - gear);\n      hull.position.y = Math.sin(time * 2.3) * 0.045 * hover * (1 - gear);\n      pilot.scale.setScalar(1.05 * pilotSize);\n      glow.color.copy(tint.setHSL(hue, 0.55, 0.42));\n      exhaustGain.value = engine * (0.2 + 0.04 * Math.sin(time * 4));\n      beamGain.value = hover * beamStrength;\n      beam.visible = beamGain.value > 0.001;\n      for (let i = 0; i < lamps.length; i++) {\n        lamps[i].scale.setScalar(0.046 + 0.013 * (1 + Math.sin(time * 3 - i * 0.7)));\n      }\n    },\n    faceCamera(camera: PerspectiveCamera) {\n      // Counter the ship/landing transform only for its flat pilot artwork.\n      hull.updateWorldMatrix(true, false);\n      hull.getWorldQuaternion(pilotParentPose).invert();\n      camera.getWorldQuaternion(pilotCameraPose);\n      pilot.quaternion.copy(pilotParentPose).multiply(pilotCameraPose);\n    },\n    dispose() {\n      root.removeFromParent();\n      lighting.removeFromParent();\n      for (const geometry of [sphere, ring, domeGeometry, arcGeometry, plane, beamGeometry, legGeometry]) geometry.dispose();\n      for (const material of [metal, lowerMetal, glow, glass, shine, pilotMaterial, beamMaterial, exhaustMaterial]) material.dispose();\n      texture.dispose();\n      environment.dispose();\n    },\n  };\n}\n",
      "solar-polish.ts": "import {\n  AdditiveBlending,\n  CircleGeometry,\n  DataTexture,\n  Group,\n  Mesh,\n  MeshBasicNodeMaterial,\n  PlaneGeometry,\n} from 'three/webgpu';\nimport { float, mix, sin, smoothstep, uniform, uv, vec2, vec3 } from 'three/tsl';\n\nexport interface RecordGlintOptions {\n  /** A small phase offset keeps neighbouring records from catching together. */\n  phase?: number;\n  /** The vinyl face radius, in the record group's local units. */\n  radius?: number;\n}\n\nexport interface OrbitTrailOptions {\n  /** Radius of the orbit this trail follows, in the orbit group's local units. */\n  radius: number;\n  /** Length of the wake in radians. */\n  length?: number;\n  /** Cyan, violet, or planet-matched trail colour. */\n  color?: number;\n  /** Number of small arc marks; 20 is deliberately light on geometry. */\n  segments?: number;\n}\n\nexport interface OrbitTrail {\n  /** Parent this to the matching orbit group. */\n  group: Group;\n  /** Put the bright head of the wake at this orbit angle. */\n  setAngle(angle: number): void;\n}\n\nexport interface SolarPolish {\n  addRecordGlint(record: Group, options?: RecordGlintOptions): Mesh;\n  createOrbitTrail(options: OrbitTrailOptions): OrbitTrail;\n  /** Call once per frame with the scene clock and its eased reveal value. */\n  update(timeSeconds: number, reveal: number, trails: number, highs: number): void;\n  /** Removes and disposes only polish-owned objects. The caller owns texture. */\n  dispose(): void;\n}\n\n/**\n * Lightweight finish work for the solar-record composition.\n *\n * The texture is intentionally shared but never disposed here: it belongs to the\n * record scene. Every object returned or created is local to this module.\n */\nexport function createPolish(texture: DataTexture): SolarPolish {\n  const glintGeometry = new CircleGeometry(0.982, 96);\n  const trailSegmentGeometry = new PlaneGeometry(1, 1);\n  const clock = uniform(0);\n  const revealUniform = uniform(0);\n  const trailGain = uniform(0);\n  const glintGain = uniform(0);\n  const ownedMeshes: Mesh[] = [];\n  const ownedGroups: Group[] = [];\n  const ownedMaterials: MeshBasicNodeMaterial[] = [];\n\n  function addRecordGlint(record: Group, options: RecordGlintOptions = {}): Mesh {\n    const phase = uniform(options.phase ?? 0);\n    const radius = options.radius ?? 1;\n    const material = new MeshBasicNodeMaterial();\n    material.map = texture;\n    material.transparent = true;\n    material.blending = AdditiveBlending;\n    material.depthWrite = false;\n    material.toneMapped = false;\n\n    const localUv = uv();\n    const radialMask = float(1).sub(\n      smoothstep(0.38, 0.5, localUv.sub(vec2(0.5)).length()),\n    ).mul(smoothstep(0.19, 0.29, localUv.sub(vec2(0.5)).length()));\n    const sweep = sin(\n      localUv.x.mul(10).add(localUv.y.mul(4)).add(clock.mul(0.82)).add(phase),\n    ).mul(0.5).add(0.5).pow(13);\n    material.colorNode = mix(\n      vec3(0.16, 0.74, 1.0),\n      vec3(1.0, 0.22, 0.72),\n      localUv.y.add(sin(clock.mul(0.32).add(phase)).mul(0.14)).clamp(0, 1),\n    );\n    material.opacityNode = radialMask.mul(sweep).mul(glintGain).mul(0.038);\n\n    const glint = new Mesh(glintGeometry, material);\n    glint.scale.setScalar(radius);\n    glint.position.z = 0.022;\n    glint.renderOrder = 2;\n    record.add(glint);\n    ownedMeshes.push(glint);\n    ownedMaterials.push(material);\n    return glint;\n  }\n\n  function createOrbitTrail(options: OrbitTrailOptions): OrbitTrail {\n    const group = new Group();\n    const material = new MeshBasicNodeMaterial({ color: options.color ?? 0x73e9ff });\n    material.transparent = true;\n    material.blending = AdditiveBlending;\n    material.depthWrite = false;\n    material.toneMapped = false;\n    material.opacityNode = trailGain.mul(0.5);\n    const count = Math.max(16, Math.min(24, Math.round(options.segments ?? 20)));\n    const length = options.length ?? 0.62;\n    const radius = options.radius;\n\n    for (let index = 0; index < count; index += 1) {\n      const t = index / count;\n      const arcAngle = -length * (1 - t);\n      const segment = new Mesh(trailSegmentGeometry, material);\n      const segmentLength = (radius * length / count) * 0.74;\n      const width = 0.010 * (0.18 + t * t * 0.82);\n      segment.position.set(Math.cos(arcAngle) * radius, Math.sin(arcAngle) * radius, 0.034);\n      segment.rotation.z = arcAngle + Math.PI / 2;\n      segment.scale.set(segmentLength, width, 1);\n      segment.renderOrder = 1;\n      group.add(segment);\n      ownedMeshes.push(segment);\n    }\n\n    ownedGroups.push(group);\n    ownedMaterials.push(material);\n    return {\n      group,\n      setAngle(angle: number) {\n        group.rotation.z = angle;\n      },\n    };\n  }\n\n  return {\n    addRecordGlint,\n    createOrbitTrail,\n    update(timeSeconds: number, reveal: number, trails: number, highs: number) {\n      clock.value = timeSeconds;\n      revealUniform.value = Math.max(0, Math.min(1, reveal));\n      trailGain.value = revealUniform.value * trails * (1 + highs);\n      glintGain.value = revealUniform.value * (1 + highs * 0.25);\n    },\n    dispose() {\n      for (const mesh of ownedMeshes) mesh.removeFromParent();\n      for (const group of ownedGroups) group.removeFromParent();\n      for (const material of ownedMaterials) material.dispose();\n      glintGeometry.dispose();\n      trailSegmentGeometry.dispose();\n    },\n  };\n}\n\r\n"
    },
