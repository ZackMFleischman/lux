        "default": true,
        "description": "Restart from the top after the final tableau (1:12.5). Otherwise hold the last pose.",
        "group": "Timeline",
        "changeCost": "live"
      },
      {
        "id": "outline",
        "type": "number",
        "label": "Ink weight",
        "default": 0.022,
        "min": 0,
        "max": 0.06,
        "step": 0.001,
        "description": "Thickness of the cartoon ink outline, in stage metres.",
        "group": "Look",
        "changeCost": "live"
      },
      {
        "id": "haze",
        "type": "number",
        "label": "Stage haze",
        "default": 0.75,
        "min": 0,
        "max": 2,
        "step": 0.01,
        "description": "Visibility of the spotlight beams in the theatre haze.",
        "group": "Look",
        "changeCost": "live"
      }
    ],
    "schemaHash": "8ae9f76245ad1ef368c0bcd085a3fe7c9bb1cb28ed4e5d305a7d2fe55f0ad251",
    "values": {
