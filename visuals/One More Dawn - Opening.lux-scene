{
  "format": "lux-scene",
  "version": 3,
  "source": {
    "sdkVersion": "0.2.0",
    "entry": "visual.ts",
    "files": {
      "lib/cast.ts": "// The company of original robot performers, each dressed for the show.\r\n//   Aria      – soprano: pearl-white robot in a simple flowing gown.\r\n//   Barnaby   – old baritone: stooped copper robot, waistcoat and spectacles.\r\n//   Pip, Dot  – two small \"children\" in kid costumes.\r\n//   Rex       – the robot king: crown, cape and ermine, seated on a throne.\r\n//   Guards    – two toy-soldier robots.\r\n\r\nimport { DoubleSide, Group, Mesh, MeshBasicNodeMaterial } from 'three/webgpu';\r\nimport { eye, skeleton, type Rig } from './rig.ts';\r\nimport { ball, bell, blob, lathe, ring, rod } from './shapes.ts';\r\nimport { glow, inked, place, toon } from './toon.ts';\r\n\r\nfunction boot(material: MeshBasicNodeMaterial, size: number): () => Group {\r\n  return () => {\r\n    const g = new Group();\r\n    place(inked(blob(size * 0.75, size * 0.42, size * 1.2, 2.6), material), g, 0, size * 0.2, size * 0.18);\r\n    return g;\r\n  };\r\n}\r\n\r\nfunction addEyes(rig: Rig, radius: number, spread: number, y: number, z: number, lid: MeshBasicNodeMaterial, pupil?: number): void {\r\n  for (const side of [-1, 1]) {\r\n    const e = eye(radius, lid, pupil);\r\n    place(e.group, rig.head, side * spread, y, z);\r\n    rig.eyes.push(e);\r\n  }\r\n}\r\n\r\nfunction addMouth(rig: Rig, w: number, h: number, y: number, z: number, hex = 0x2a0f22): void {\r\n  const mouth = new Group();\r\n  const shape = new Mesh(blob(w, h, 0.03, 2.4), toon(hex, { glint: 0, rim: 0 }));\r\n  mouth.add(shape);\r\n  const lip = new Mesh(blob(w * 1.12, h * 1.18, 0.02, 2.4), toon(0x120a14, { glint: 0, rim: 0 }));\r\n  lip.position.z = -0.006;\r\n  mouth.add(lip);\r\n  place(mouth, rig.head, 0, y, z);\r\n  rig.mouth = mouth;\r\n  rig.mouthOpen = 0;\r\n}\r\n\r\nfunction antenna(parent: Group, height: number, bulbHex: number, bulbR: number, stalkHex = 0x9aa0b4): ReturnType<typeof glow> {\r\n  place(inked(rod(0.018, 0.026, height), toon(stalkHex)), parent, 0, height / 2, 0);\r\n  const bulb = glow(bulbHex, 1);\r\n  place(inked(ball(bulbR, 16), bulb), parent, 0, height + bulbR * 0.7, 0);\r\n  return bulb;\r\n}\r\n\r\nexport function makeAria(): Rig {\r\n  const pearl = toon(0xeef0fa, { glint: 0.9 });\r\n  const lilac = toon(0xb6a3ea, { glint: 0.7 });\r\n  const silver = toon(0xc9c6dc, { glint: 0.8 });\r\n  const rig = skeleton({\r\n    name: 'Aria',\r\n    hipHeight: 1.0,\r\n    torsoY: 0,\r\n    neckY: 0.68,\r\n    shoulder: [0.22, 0.4, 0],\r\n    armRadius: [0.042, 0.035],\r\n    armMaterial: silver,\r\n    handMaterial: pearl,\r\n    handSize: 0.11,\r\n    armHang: 0.68,\r\n  });\r\n  // Gown: a long bell skirt with a gold hem and a soft lilac sash.\r\n  const gown = inked(lathe('aria-gown', [[0.0, 0.02], ...bell(0.2, 0.62, 0.05, -0.98, 1.7, 14), [0.0, -0.98]]), toon(0xf7f4ff, { glint: 0.25 }));\r\n  place(gown, rig.hips, 0, 0, 0);\r\n  place(inked(ring(0.6, 0.035), toon(0xe0b65a, { glint: 1.2 })), rig.hips, 0, -0.94, 0, Math.PI / 2);\r\n  place(inked(ring(0.215, 0.04), lilac), rig.hips, 0, 0.02, 0, Math.PI / 2);\r\n  // Bodice and collar.\r\n  place(inked(blob(0.44, 0.56, 0.32, 2.4), pearl), rig.torso, 0, 0.26, 0);\r\n  place(inked(ring(0.11, 0.03), lilac), rig.torso, 0, 0.54, 0, Math.PI / 2);\r\n  place(inked(rod(0.07, 0.08, 0.14), silver), rig.torso, 0, 0.6, 0);\r\n  // Head: a soft squircle with ear discs and a halo antenna.\r\n  const headShape = inked(blob(0.62, 0.52, 0.5, 2.6), pearl);\r\n  place(headShape, rig.head, 0, 0.24, 0);\r\n  for (const side of [-1, 1]) {\r\n    place(inked(rod(0.09, 0.09, 0.07), lilac), rig.head, side * 0.32, 0.22, 0, 0, 0, Math.PI / 2);\r\n  }\r\n  const antennaGroup = place(new Group(), rig.head, 0, 0.47, 0);\r\n  rig.props.antenna = antennaGroup;\r\n  const halo = antenna(antennaGroup, 0.16, 0xbff4ff, 0.05);\r\n  rig.props.haloLight = new Mesh();\r\n  rig.props.haloLight.userData.material = halo;\r\n  addEyes(rig, 0.105, 0.13, 0.28, 0.2, pearl, 0x2b2a6a);\r\n  addMouth(rig, 0.13, 0.08, 0.08, 0.245);\r\n  // Rosy cheek lights.\r\n  for (const side of [-1, 1]) {\r\n    place(new Mesh(blob(0.08, 0.04, 0.02, 2), glow(0xff9fc0, 0.55)), rig.head, side * 0.2, 0.13, 0.235);\r\n  }\r\n  return rig;\r\n}\r\n\r\nexport function makeBarnaby(): Rig {\r\n  const copper = toon(0xc27a45, { glint: 1.0 });\r\n  const copperDark = toon(0x8c5232, { glint: 0.6 });\r\n  const vest = toon(0x7d2a3a, { glint: 0.15 });\r\n  const trousers = toon(0x3a3948, { glint: 0.1 });\r\n  const brass = toon(0xe3b54c, { glint: 1.4 });\r\n  const rig = skeleton({\r\n    name: 'Barnaby',\r\n    hipHeight: 0.72,\r\n    torsoY: 0,\r\n    neckY: 0.98,\r\n    shoulder: [0.4, 0.74, 0],\r\n    armRadius: [0.06, 0.048],\r\n    armMaterial: copper,\r\n    handMaterial: copper,\r\n    handSize: 0.15,\r\n    armHang: 0.78,\r\n    legs: {\r\n      hip: [0.17, -0.02, 0],\r\n      radius: [0.075, 0.06],\r\n      material: trousers,\r\n      foot: boot(toon(0x5a3622, { glint: 0.5 }), 0.3),\r\n      stance: 0.2,\r\n    },\r\n  });\r\n  // Barrel chest wearing a burgundy waistcoat with brass buttons.\r\n  place(inked(blob(0.9, 0.98, 0.7, 3.0), copper), rig.torso, 0, 0.44, 0);\r\n  place(inked(blob(0.94, 0.66, 0.74, 3.0), vest), rig.torso, 0, 0.32, 0.005);\r\n  for (let i = 0; i < 3; i += 1) {\r\n    place(inked(ball(0.035, 10), brass), rig.torso, 0, 0.5 - i * 0.16, 0.37);\r\n  }\r\n  // Watch chain.\r\n  place(new Mesh(ring(0.16, 0.012, Math.PI), brass), rig.torso, 0.14, 0.2, 0.37, 0, 0, Math.PI);\r\n  // Bow tie.\r\n  for (const side of [-1, 1]) {\r\n    place(inked(blob(0.16, 0.12, 0.06, 2.2), toon(0x2e8c8a, { glint: 0.4 })), rig.torso, side * 0.08, 0.8, 0.3, 0, 0, side * 0.25);\r\n  }\r\n  place(inked(ball(0.04, 10), toon(0x2e8c8a)), rig.torso, 0, 0.8, 0.33);\r\n  // Rivets around the collar.\r\n  for (let i = 0; i < 7; i += 1) {\r\n    const a = -0.9 + i * 0.3;\r\n    place(new Mesh(ball(0.022, 8), copperDark), rig.torso, Math.sin(a) * 0.38, 0.86, Math.cos(a) * 0.28);\r\n  }\r\n  place(inked(rod(0.13, 0.15, 0.16), copperDark), rig.torso, 0, 0.92, 0);\r\n  // Head: broad dome, heavy brow, bulb nose, walrus moustache grille and\r\n  // a hinged jaw that drops when he sings.\r\n  place(inked(blob(0.78, 0.6, 0.62, 2.7), copper), rig.head, 0, 0.36, 0);\r\n  place(inked(blob(0.66, 0.1, 0.18, 3), copperDark), rig.head, 0, 0.5, 0.25, 0.15);\r\n  place(inked(blob(0.17, 0.15, 0.16, 2), toon(0xd98a55, { glint: 1.2 })), rig.head, 0, 0.3, 0.33);\r\n  const stache = toon(0xc9cdd6, { glint: 0.4 });\r\n  for (const side of [-1, 1]) {\r\n    place(inked(blob(0.26, 0.11, 0.12, 2.2), stache), rig.head, side * 0.12, 0.2, 0.3, 0, side * -0.3, side * -0.25);\r\n  }\r\n  rig.jaw.position.set(0, 0.16, -0.05);\r\n  place(inked(blob(0.6, 0.18, 0.56, 2.6), copper), rig.jaw, 0, -0.06, 0.06);\r\n  place(new Mesh(blob(0.42, 0.14, 0.4, 2.4), toon(0x2a0f18, { glint: 0, rim: 0 })), rig.head, 0, 0.12, 0.08);\r\n  rig.mouthOpen = 1;\r\n  addEyes(rig, 0.085, 0.15, 0.4, 0.27, copper, 0x1a1210);\r\n  for (const side of [-1, 1]) {\r\n    place(inked(ring(0.11, 0.014), brass), rig.head, side * 0.15, 0.4, 0.33);\r\n  }\r\n  place(new Mesh(rod(0.008, 0.008, 0.1), brass), rig.head, 0, 0.42, 0.34, 0, 0, Math.PI / 2);\r\n  for (const side of [-1, 1]) {\r\n    place(inked(blob(0.08, 0.2, 0.2, 2.6), copperDark), rig.head, side * 0.4, 0.34, 0);\r\n  }\r\n  // A bent old antenna with a warm amber bulb.\r\n  const tip = place(new Group(), rig.head, 0.05, 0.64, 0, 0, 0, -0.25);\r\n  const bulb = antenna(tip, 0.18, 0xffb24a, 0.055, 0x8c5232);\r\n  rig.props.bulb = new Mesh();\r\n  rig.props.bulb.userData.material = bulb;\r\n  return rig;\r\n}\r\n\r\nexport function makeKid(kind: 'pip' | 'dot'): Rig {\r\n  const shell = toon(kind === 'pip' ? 0x47c4bf : 0xf2907b, { glint: 1.0 });\r\n  const outfit = toon(kind === 'pip' ? 0x3f63c8 : 0xf6cf45, { glint: 0.2 });\r\n  const rig = skeleton({\r\n    name: kind === 'pip' ? 'Pip' : 'Dot',\r\n    hipHeight: 0.3,\r\n    torsoY: 0,\r\n    neckY: 0.42,\r\n    shoulder: [0.17, 0.27, 0],\r\n    armRadius: [0.032, 0.028],\r\n    armMaterial: shell,\r\n    handMaterial: shell,\r\n    handSize: 0.075,\r\n    armHang: 0.3,\r\n    legs: {\r\n      hip: [0.08, 0, 0],\r\n      radius: [0.035, 0.03],\r\n      material: shell,\r\n      foot: boot(toon(kind === 'pip' ? 0xd23b3b : 0xe2457a, { glint: 0.6 }), 0.17),\r\n      stance: 0.1,\r\n    },\r\n  });\r\n  if (kind === 'pip') {\r\n    // Overalls with shoulder straps.\r\n    place(inked(blob(0.38, 0.4, 0.32, 2.8), outfit), rig.torso, 0, 0.16, 0);\r\n    for (const side of [-1, 1]) {\r\n      place(new Mesh(blob(0.05, 0.2, 0.05, 2), outfit), rig.torso, side * 0.1, 0.33, 0.13);\r\n    }\r\n  } else {\r\n    // A little sundress.\r\n    place(inked(blob(0.34, 0.26, 0.28, 2.6), shell), rig.torso, 0, 0.26, 0);\r\n    place(inked(lathe('dot-dress', [[0, 0.3], ...bell(0.13, 0.3, 0.3, -0.06, 1.4, 8), [0, -0.06]]), outfit), rig.torso, 0, 0, 0);\r\n  }\r\n  place(inked(blob(0.56, 0.48, 0.48, 2.3), shell), rig.head, 0, 0.22, 0);\r\n  addEyes(rig, 0.1, 0.12, 0.26, 0.18, shell);\r\n  addMouth(rig, 0.1, 0.07, 0.1, 0.225);\r\n  if (kind === 'pip') {\r\n    // Propeller beanie.\r\n    const cap = toon(0xd23b3b, { glint: 0.5 });\r\n    place(inked(lathe('pip-cap', [[0, 0.17], [0.12, 0.15], [0.22, 0.08], [0.26, 0.0], [0, 0.0]]), cap), rig.head, 0, 0.36, 0);\r\n    place(inked(rod(0.012, 0.012, 0.1), toon(0xf6cf45)), rig.head, 0, 0.58, 0);\r\n    const prop = place(new Group(), rig.head, 0, 0.63, 0);\r\n    for (const side of [-1, 1]) {\r\n      place(inked(blob(0.2, 0.025, 0.07, 2), toon(0xf6cf45, { glint: 0.8 })), prop, side * 0.1, 0, 0, 0.3 * side);\r\n    }\r\n    rig.props.propeller = prop;\r\n  } else {\r\n    // Pigtail puffs with ribbons.\r\n    for (const side of [-1, 1]) {\r\n      const tail = place(new Group(), rig.head, side * 0.3, 0.36, -0.05, 0, 0, side * -0.4);\r\n      place(inked(ball(0.09, 14), toon(0x7b3fb0, { glint: 0.6 })), tail, side * 0.06, 0.04, 0);\r\n      place(inked(blob(0.12, 0.07, 0.05, 2), toon(0xe2457a)), tail, 0, -0.03, 0.02);\r\n      rig.props[side < 0 ? 'tailL' : 'tailR'] = tail;\r\n    }\r\n  }\r\n  return rig;\r\n}\r\n\r\nexport function makeKing(): Rig {\r\n  const gold = toon(0xe0b03c, { glint: 1.4 });\r\n  const velvet = toon(0x5d2a8a, { glint: 0.15 });\r\n  const ermine = toon(0xf6f2ea, { glint: 0.1 });\r\n  const rig = skeleton({\r\n    name: 'Rex',\r\n    hipHeight: 0.72,\r\n    torsoY: 0,\r\n    neckY: 0.92,\r\n    shoulder: [0.42, 0.72, 0],\r\n    armRadius: [0.058, 0.05],\r\n    armMaterial: gold,\r\n    handMaterial: gold,\r\n    handSize: 0.14,\r\n    armHang: 0.55,\r\n    legs: {\r\n      hip: [0.18, 0, 0.1],\r\n      radius: [0.07, 0.06],\r\n      material: velvet,\r\n      foot: boot(toon(0x2a1a3a, { glint: 0.6 }), 0.28),\r\n      stance: 0.24,\r\n    },\r\n  });\r\n  // Round royal belly under a velvet cape with ermine trim.\r\n  place(inked(blob(0.92, 0.95, 0.8, 2.4), gold), rig.torso, 0, 0.42, 0.02);\r\n  // Cape: open at the front so the belly and robes show.\r\n  const capeMaterial = toon(0x5d2a8a, { glint: 0.15 });\r\n  capeMaterial.side = DoubleSide;\r\n  place(inked(lathe('king-cape', [[0.3, 0.9], ...bell(0.44, 0.78, 0.86, -0.7, 1.3, 10)], 40, 1.15, Math.PI * 2 - 2.3), capeMaterial), rig.torso, 0, 0, -0.08);\r\n  place(inked(ring(0.4, 0.09), ermine), rig.torso, 0, 0.85, -0.04, Math.PI / 2);\r\n  for (let i = 0; i < 8; i += 1) {\r\n    const a = (i / 8) * Math.PI * 2;\r\n    place(new Mesh(blob(0.03, 0.07, 0.03, 2), toon(0x111111)), rig.torso, Math.cos(a) * 0.4, 0.86, Math.sin(a) * 0.4 - 0.04);\r\n  }\r\n  place(inked(blob(0.08, 0.16, 0.06, 2.2), toon(0xd8283c, { glint: 1.5 })), rig.torso, 0, 0.5, 0.42);\r\n  // Head with a proud jaw and a crown.\r\n  place(inked(blob(0.66, 0.56, 0.56, 2.8), gold), rig.head, 0, 0.3, 0);\r\n  rig.jaw.position.set(0, 0.12, -0.04);\r\n  place(inked(blob(0.54, 0.16, 0.5, 2.6), toon(0xc4962c, { glint: 1.0 })), rig.jaw, 0, -0.05, 0.05);\r\n  rig.mouthOpen = 0.9;\r\n  addEyes(rig, 0.08, 0.14, 0.36, 0.25, gold, 0x2a0f16);\r\n  place(inked(blob(0.5, 0.07, 0.12, 3), toon(0x8a6420)), rig.head, 0, 0.47, 0.25, 0.25);\r\n  const crown = place(new Group(), rig.head, 0, 0.56, 0);\r\n  const crownGold = toon(0xf4cb4c, { glint: 1.6 });\r\n  place(inked(rod(0.27, 0.25, 0.14, 24), crownGold), crown, 0, 0.07, 0);\r\n  for (let i = 0; i < 7; i += 1) {\r\n    const a = (i / 7) * Math.PI * 2;\r\n    const spike = place(new Group(), crown, Math.sin(a) * 0.25, 0.16, Math.cos(a) * 0.25);\r\n    place(inked(blob(0.07, 0.16, 0.07, 1.4), crownGold), spike, 0, 0.05, 0);\r\n    place(new Mesh(ball(0.035, 10), glow(i % 2 ? 0xff3a5a : 0x5ad8ff, 1.0)), spike, 0, 0.15, 0);\r\n  }\r\n  place(inked(rod(0.27, 0.27, 0.05, 24), velvet), crown, 0, 0.02, 0);\r\n  // Sceptre held in the right hand.\r\n  const sceptre = new Group();\r\n  place(inked(rod(0.025, 0.025, 1.0), gold), sceptre, 0, 0.1, 0);\r\n  place(inked(ball(0.08, 14), glow(0xff5a7a, 1.0)), sceptre, 0, 0.64, 0);\r\n  rig.hands[1].add(sceptre);\r\n  sceptre.position.set(0, -0.1, 0);\r\n  rig.props.sceptre = sceptre;\r\n  return rig;\r\n}\r\n\r\nexport function makeGuard(seed: number): Rig {\r\n  const steel = toon(0xa9b3c6, { glint: 1.2 });\r\n  const coat = toon(0xc8322f, { glint: 0.2 });\r\n  const white = toon(0xf2efe6, { glint: 0.2 });\r\n  const rig = skeleton({\r\n    name: `Guard${seed}`,\r\n    hipHeight: 0.66,\r\n    torsoY: 0,\r\n    neckY: 0.78,\r\n    shoulder: [0.27, 0.64, 0],\r\n    armRadius: [0.045, 0.04],\r\n    armMaterial: coat,\r\n    handMaterial: white,\r\n    handSize: 0.11,\r\n    armHang: 0.66,\r\n    legs: {\r\n      hip: [0.12, 0, 0],\r\n      radius: [0.05, 0.045],\r\n      material: toon(0x26315f, { glint: 0.1 }),\r\n      foot: boot(toon(0x15151c, { glint: 1.0 }), 0.24),\r\n      stance: 0.14,\r\n    },\r\n  });\r\n  place(inked(blob(0.56, 0.82, 0.42, 3.2), coat), rig.torso, 0, 0.36, 0);\r\n  for (const side of [-1, 1]) {\r\n    place(new Mesh(blob(0.06, 0.86, 0.03, 2), white), rig.torso, side * 0.08, 0.38, 0.21, 0, 0, side * 0.55);\r\n    place(inked(blob(0.2, 0.08, 0.2, 2.4), toon(0xe3b54c, { glint: 1.2 })), rig.torso, side * 0.3, 0.7, 0);\r\n  }\r\n  place(inked(blob(0.6, 0.08, 0.46, 3), toon(0x15151c, { glint: 0.8 })), rig.torso, 0, 0.0, 0);\r\n  place(inked(blob(0.44, 0.42, 0.42, 3.2), steel), rig.head, 0, 0.2, 0);\r\n  addEyes(rig, 0.07, 0.1, 0.22, 0.2, steel, 0x101018);\r\n  addMouth(rig, 0.12, 0.05, 0.08, 0.21);\r\n  // Tall shako with a plume.\r\n  place(inked(rod(0.2, 0.18, 0.46, 20), toon(0x1c1c28, { glint: 0.5 })), rig.head, 0, 0.62, -0.02);\r\n  place(inked(rod(0.205, 0.205, 0.05, 20), toon(0xe3b54c, { glint: 1.2 })), rig.head, 0, 0.42, -0.02);\r\n  place(inked(blob(0.12, 0.3, 0.12, 1.8), white), rig.head, 0, 0.98, -0.02);\r\n  // Wooden toy rifle.\r\n  const rifle = new Group();\r\n  place(inked(blob(0.06, 0.9, 0.06, 4), toon(0x7a4a2a, { glint: 0.3 })), rifle, 0, 0.2, 0);\r\n  place(inked(rod(0.015, 0.015, 0.3), steel), rifle, 0, 0.78, 0);\r\n  rig.hands[0].add(rifle);\r\n  rifle.position.set(0, -0.1, 0.02);\r\n  rig.props.rifle = rifle;\r\n  return rig;\r\n}\r\n",
      "lib/hose.ts": "// Rubber-hose limb: a tube swept along a quadratic Bezier, rewritten in\r\n// place every frame (no allocation). The classic bendy cartoon-robot arm.\r\n\r\nimport { BufferAttribute, BufferGeometry, Mesh, MeshBasicNodeMaterial, Object3D, Vector3 } from 'three/webgpu';\r\nimport { outlineMaterial } from './toon.ts';\r\n\r\nconst RINGS = 18;\r\nconst SIDES = 10;\r\n\r\nexport class Hose {\r\n  readonly geometry = new BufferGeometry();\r\n  readonly mesh: Mesh;\r\n  private readonly positions: Float32Array;\r\n  private readonly normals: Float32Array;\r\n  private readonly a = new Vector3();\r\n  private readonly b = new Vector3();\r\n  private readonly c = new Vector3();\r\n  private readonly p = new Vector3();\r\n  private readonly t = new Vector3();\r\n  private readonly n = new Vector3();\r\n  private readonly bn = new Vector3();\r\n  private readonly prevT = new Vector3();\r\n  private readonly tmp = new Vector3();\r\n\r\n  constructor(material: MeshBasicNodeMaterial, parent: Object3D, private rStart: number, private rEnd: number) {\r\n    const count = (RINGS + 1) * (SIDES + 1);\r\n    this.positions = new Float32Array(count * 3);\r\n    this.normals = new Float32Array(count * 3);\r\n    const index: number[] = [];\r\n    for (let i = 0; i < RINGS; i += 1) {\r\n      for (let j = 0; j < SIDES; j += 1) {\r\n        const a = i * (SIDES + 1) + j;\r\n        const b = a + SIDES + 1;\r\n        index.push(a, a + 1, b, b, a + 1, b + 1);\r\n      }\r\n    }\r\n    this.geometry.setIndex(index);\r\n    const position = new BufferAttribute(this.positions, 3);\r\n    const normal = new BufferAttribute(this.normals, 3);\r\n    this.geometry.setAttribute('position', position);\r\n    this.geometry.setAttribute('normal', normal);\r\n    this.geometry.setAttribute('outlineNormal', normal);\r\n    this.mesh = new Mesh(this.geometry, material);\r\n    this.mesh.frustumCulled = false;\r\n    const shell = new Mesh(this.geometry, outlineMaterial(1));\r\n    shell.frustumCulled = false;\r\n    this.mesh.add(shell);\r\n    parent.add(this.mesh);\r\n  }\r\n\r\n  // start, bend control point and end, all in the parent's space.\r\n  update(start: Vector3, bend: Vector3, end: Vector3): void {\r\n    this.a.copy(start);\r\n    this.b.copy(bend);\r\n    this.c.copy(end);\r\n    for (let i = 0; i <= RINGS; i += 1) {\r\n      const u = i / RINGS;\r\n      const k = 1 - u;\r\n      this.p.set(0, 0, 0)\r\n        .addScaledVector(this.a, k * k)\r\n        .addScaledVector(this.b, 2 * k * u)\r\n        .addScaledVector(this.c, u * u);\r\n      this.t.copy(this.b).sub(this.a).multiplyScalar(2 * k)\r\n        .addScaledVector(this.tmp.copy(this.c).sub(this.b), 2 * u);\r\n      if (this.t.lengthSq() < 1e-10) {\r\n        this.t.set(0, -1, 0);\r\n      }\r\n      this.t.normalize();\r\n      if (i === 0) {\r\n        // Any vector not parallel to the tangent starts the frame.\r\n        this.n.set(0, 0, 1);\r\n        if (Math.abs(this.t.z) > 0.9) {\r\n          this.n.set(1, 0, 0);\r\n        }\r\n        this.n.sub(this.tmp.copy(this.t).multiplyScalar(this.n.dot(this.t))).normalize();\r\n      } else {\r\n        // Parallel transport: remove the tangent component.\r\n        this.n.sub(this.tmp.copy(this.t).multiplyScalar(this.n.dot(this.t))).normalize();\r\n      }\r\n      this.bn.crossVectors(this.t, this.n);\r\n      this.prevT.copy(this.t);\r\n      // Slight bulge in the middle reads as soft rubber.\r\n      const r = this.rStart + (this.rEnd - this.rStart) * u + Math.sin(u * Math.PI) * 0.06 * this.rStart;\r\n      for (let j = 0; j <= SIDES; j += 1) {\r\n        const ang = (j / SIDES) * Math.PI * 2;\r\n        const cx = Math.cos(ang);\r\n        const sy = Math.sin(ang);\r\n        const nx = this.n.x * cx + this.bn.x * sy;\r\n        const ny = this.n.y * cx + this.bn.y * sy;\r\n        const nz = this.n.z * cx + this.bn.z * sy;\r\n        const o = (i * (SIDES + 1) + j) * 3;\r\n        this.positions[o] = this.p.x + nx * r;\r\n        this.positions[o + 1] = this.p.y + ny * r;\r\n        this.positions[o + 2] = this.p.z + nz * r;\r\n        this.normals[o] = nx;\r\n        this.normals[o + 1] = ny;\r\n        this.normals[o + 2] = nz;\r\n      }\r\n    }\r\n    (this.geometry.getAttribute('position') as BufferAttribute).needsUpdate = true;\r\n    (this.geometry.getAttribute('normal') as BufferAttribute).needsUpdate = true;\r\n  }\r\n\r\n  // Unit tangent at the end of the last update (for orienting hands/feet).\r\n  endTangent(out: Vector3): Vector3 {\r\n    return out.copy(this.c).sub(this.b).normalize();\r\n  }\r\n\r\n  dispose(): void {\r\n    this.geometry.dispose();\r\n  }\r\n}\r\n",
      "lib/props.ts": "// Story props: the king's throne, \"the future\" (a glowing globe) and the\r\n// chain that binds the old robot to the crown.\r\n\r\nimport { Group, Mesh, MeshBasicNodeMaterial, Vector3 } from 'three/webgpu';\r\nimport { mx_noise_float, normalize, positionLocal, smoothstep, vec3, vec4 } from 'three/tsl';\r\nimport { ball, bell, blob, lathe, ring, rod } from './shapes.ts';\r\nimport { glow, inked, light, place, toon, u } from './toon.ts';\r\n\r\nexport const DAIS = 0.6;\r\n\r\nexport function buildThrone(): Group {\r\n  const outer = new Group();\r\n  const throne = new Group();\r\n  throne.position.y = DAIS;\r\n  outer.add(throne);\r\n  const gold = toon(0xdcaa45, { glint: 1.5 });\r\n  const velvet = toon(0xa0182e, { glint: 0.2 });\r\n  // Stepped dais.\r\n  place(inked(lathe('dais-low', [[0, 0], [1.9, 0], [1.9, 0.3], [0, 0.3]], 48), toon(0x3a1d4a, { glint: 0.4 })), outer, 0, 0, 0);\r\n  place(inked(ring(1.9, 0.04), gold), outer, 0, 0.3, 0, Math.PI / 2);\r\n  place(inked(lathe('dais-high', [[0, 0], [1.45, 0], [1.45, 0.3], [0, 0.3]], 48), toon(0x4c2560, { glint: 0.4 })), outer, 0, 0.3, 0);\r\n  place(inked(ring(1.45, 0.04), gold), outer, 0, 0.6, 0, Math.PI / 2);\r\n  place(inked(lathe('throne-base', [[0, 0.3], [0.95, 0.3], [1.05, 0.2], [1.0, 0.0], [0, 0]], 40), gold), throne, 0, 0, 0);\r\n  place(inked(blob(1.2, 0.5, 1.0, 4), velvet), throne, 0, 0.55, 0.05);\r\n  place(inked(blob(1.3, 0.12, 1.1, 4), gold), throne, 0, 0.32, 0.05);\r\n  place(inked(blob(1.3, 2.3, 0.3, 3.2), velvet), throne, 0, 1.45, -0.5);\r\n  place(inked(blob(1.5, 2.5, 0.22, 3.2), gold), throne, 0, 1.5, -0.62);\r\n  for (const side of [-1, 1]) {\r\n    place(inked(blob(0.22, 0.6, 1.0, 3.5), gold), throne, side * 0.72, 0.85, 0.05);\r\n    place(inked(ball(0.13, 14), gold), throne, side * 0.72, 1.2, 0.5);\r\n    place(inked(ball(0.14, 14), gold), throne, side * 0.75, 2.85, -0.6);\r\n  }\r\n  place(inked(ring(0.32, 0.06), gold), throne, 0, 2.95, -0.62);\r\n  place(new Mesh(ball(0.14, 14), glow(0xff3a5a, 1.2)), throne, 0, 2.95, -0.58);\r\n  return outer;\r\n}\r\n\r\nexport interface Globe {\r\n  group: Group;\r\n  glowLevel: ReturnType<typeof u>;\r\n}\r\n\r\nexport function buildGlobe(): Globe {\r\n  const group = new Group();\r\n  const glowLevel = u(1);\r\n  const material = new MeshBasicNodeMaterial();\r\n  const p = normalize(positionLocal);\r\n  const land = smoothstep(0.05, 0.12, mx_noise_float(p.mul(2.6)).add(mx_noise_float(p.mul(6.0)).mul(0.3)));\r\n  const ocean = vec3(0.12, 0.45, 0.95);\r\n  const green = vec3(0.35, 0.9, 0.5);\r\n  const base = ocean.mul(land.oneMinus()).add(green.mul(land));\r\n  const facing = p.dot(light.keyDir).mul(0.5).add(0.5);\r\n  const shade = smoothstep(0.25, 0.3, facing).mul(0.4).add(0.6);\r\n  material.colorNode = vec4(base.mul(shade).mul(glowLevel.mul(0.6).add(0.5)), 1);\r\n  group.add(inked(ball(0.26, 32), material));\r\n  const aura = glow(0x9fdcff, 0.35);\r\n  aura.transparent = true;\r\n  aura.depthWrite = false;\r\n  place(new Mesh(ring(0.34, 0.012), glow(0xbfefff, 1.2)), group, 0, 0, 0, 1.2, 0.3, 0);\r\n  place(new Mesh(ring(0.38, 0.008), glow(0xffe2a0, 1.0)), group, 0, 0, 0, -0.4, 0.9, 0);\r\n  return { group, glowLevel };\r\n}\r\n\r\nexport class Chain {\r\n  readonly group = new Group();\r\n  private readonly links: Mesh[] = [];\r\n  private readonly a = new Vector3();\r\n  private readonly b = new Vector3();\r\n  private readonly p = new Vector3();\r\n  private readonly next = new Vector3();\r\n\r\n  constructor(count = 26) {\r\n    const material = toon(0xb8bccb, { glint: 1.6 });\r\n    for (let i = 0; i < count; i += 1) {\r\n      const link = inked(ring(0.085, 0.021), material);\r\n      this.links.push(link);\r\n      this.group.add(link);\r\n    }\r\n  }\r\n\r\n  private at(u: number, sag: number, out: Vector3): Vector3 {\r\n    out.copy(this.a).lerp(this.b, u);\r\n    out.y -= Math.sin(u * Math.PI) * sag;\r\n    return out;\r\n  }\r\n\r\n  // Draws links from world-space a to b with a sag; reveal grows it from a.\r\n  update(a: Vector3, b: Vector3, reveal: number, sag: number): void {\r\n    this.a.copy(a);\r\n    this.b.copy(b);\r\n    const n = this.links.length;\r\n    this.group.visible = reveal > 0.001;\r\n    for (let i = 0; i < n; i += 1) {\r\n      const link = this.links[i];\r\n      const u = (i + 0.5) / n;\r\n      link.visible = u <= reveal;\r\n      if (!link.visible) {\r\n        continue;\r\n      }\r\n      this.at(u, sag, this.p);\r\n      this.at(Math.min(1, u + 0.01), sag, this.next);\r\n      link.position.copy(this.p);\r\n      link.lookAt(this.next);\r\n      link.rotateZ(i % 2 ? Math.PI / 2 : 0);\r\n      const pop = Math.min(1, (reveal - u) * n * 0.5 + 0.2);\r\n      link.scale.setScalar(Math.max(0.01, pop));\r\n    }\r\n  }\r\n}\r\n\r\nexport { bell, blob, rod };\r\n",
      "lib/rig.ts": "// Shared robot skeleton: root -> hips -> torso -> head, rubber-hose arms and\r\n// legs, expressive eyes and a singing mouth. Characters in cast.ts dress it.\r\n\r\nimport {\r\n  DoubleSide,\r\n  Group,\r\n  Mesh,\r\n  MeshBasicNodeMaterial,\r\n  Object3D,\r\n  Quaternion,\r\n  SphereGeometry,\r\n  Vector3,\r\n} from 'three/webgpu';\r\nimport { Hose } from './hose.ts';\r\nimport { ball, blob, ring } from './shapes.ts';\r\nimport { glow, inked, place, toon } from './toon.ts';\r\n\r\nexport type V3 = [number, number, number];\r\n\r\nexport interface Pose {\r\n  x: number;\r\n  z: number;\r\n  yaw: number;\r\n  lift: number;\r\n  lean: number;\r\n  tilt: number;\r\n  twist: number;\r\n  squash: number;\r\n  headYaw: number;\r\n  headPitch: number;\r\n  headRoll: number;\r\n  mouth: number;\r\n  lid: number;\r\n  lookX: number;\r\n  lookY: number;\r\n  eyeGlow: number;\r\n  handL: V3;\r\n  handR: V3;\r\n  bendL: number;\r\n  bendR: number;\r\n  footL: V3;\r\n  footR: V3;\r\n  visible: boolean;\r\n}\r\n\r\nexport interface Eye {\r\n  group: Group;\r\n  pupil: Group;\r\n  lid: Group;\r\n}\r\n\r\ntype GlowMaterial = ReturnType<typeof glow>;\r\n\r\nexport interface Rig {\r\n  name: string;\r\n  root: Group;\r\n  hips: Group;\r\n  torso: Group;\r\n  head: Group;\r\n  jaw: Group;\r\n  mouth: Object3D | null;\r\n  mouthOpen: number;\r\n  eyes: Eye[];\r\n  shoulders: [Vector3, Vector3];\r\n  hipAnchors: [Vector3, Vector3] | null;\r\n  arms: [Hose, Hose];\r\n  legs: [Hose, Hose] | null;\r\n  hands: [Group, Group];\r\n  feet: [Group, Group] | null;\r\n  hipHeight: number;\r\n  rest: Pose;\r\n  props: Record<string, Object3D>;\r\n  glows: GlowMaterial[];\r\n}\r\n\r\nexport interface SkeletonSpec {\r\n  name: string;\r\n  hipHeight: number;\r\n  torsoY: number;\r\n  neckY: number;\r\n  shoulder: V3;\r\n  armRadius: [number, number];\r\n  armMaterial: MeshBasicNodeMaterial;\r\n  handMaterial: MeshBasicNodeMaterial;\r\n  handSize: number;\r\n  armHang?: number;\r\n  legs?: {\r\n    hip: V3;\r\n    radius: [number, number];\r\n    material: MeshBasicNodeMaterial;\r\n    foot: () => Group;\r\n    stance: number;\r\n  };\r\n}\r\n\r\nexport function blankPose(): Pose {\r\n  return {\r\n    x: 0,\r\n    z: 0,\r\n    yaw: 0,\r\n    lift: 0,\r\n    lean: 0,\r\n    tilt: 0,\r\n    twist: 0,\r\n    squash: 1,\r\n    headYaw: 0,\r\n    headPitch: 0,\r\n    headRoll: 0,\r\n    mouth: 0,\r\n    lid: 0.15,\r\n    lookX: 0,\r\n    lookY: 0,\r\n    eyeGlow: 1,\r\n    handL: [0, 0, 0],\r\n    handR: [0, 0, 0],\r\n    bendL: 0.5,\r\n    bendR: 0.5,\r\n    footL: [0, 0, 0],\r\n    footR: [0, 0, 0],\r\n    visible: true,\r\n  };\r\n}\r\n\r\nexport function copyPose(from: Pose, to: Pose): Pose {\r\n  Object.assign(to, from);\r\n  to.handL = [from.handL[0], from.handL[1], from.handL[2]];\r\n  to.handR = [from.handR[0], from.handR[1], from.handR[2]];\r\n  to.footL = [from.footL[0], from.footL[1], from.footL[2]];\r\n  to.footR = [from.footR[0], from.footR[1], from.footR[2]];\r\n  return to;\r\n}\r\n\r\n// Three-fingered cartoon mitt. The group's local -Y points along the arm.\r\nexport function hand(material: MeshBasicNodeMaterial, size: number): Group {\r\n  const group = new Group();\r\n  place(inked(blob(size, size * 0.95, size * 0.62, 2.2), material), group, 0, -size * 0.35, 0);\r\n  for (let i = 0; i < 3; i += 1) {\r\n    const finger = inked(blob(size * 0.28, size * 0.62, size * 0.28, 2), material);\r\n    place(finger, group, (i - 1) * size * 0.3, -size * 0.85, 0, 0, 0, (i - 1) * 0.18);\r\n  }\r\n  const thumb = inked(blob(size * 0.3, size * 0.5, size * 0.3, 2), material);\r\n  place(thumb, group, size * 0.5, -size * 0.45, size * 0.1, 0, 0, 0.9);\r\n  return group;\r\n}\r\n\r\n// Cartoon eye: white, pupil with catchlight, and an upper lid that closes.\r\nexport function eye(radius: number, lidMaterial: MeshBasicNodeMaterial, pupilHex = 0x141020): Eye {\r\n  const group = new Group();\r\n  group.add(inked(ball(radius, 24), toon(0xfbfbff, { glint: 0.2, rim: 0.3 })));\r\n  const pupil = new Group();\r\n  const iris = new Mesh(blob(radius * 0.95, radius * 0.95, radius * 0.4, 2), toon(pupilHex, { glint: 0, rim: 0 }));\r\n  iris.position.z = radius * 0.8;\r\n  pupil.add(iris);\r\n  const shine = new Mesh(ball(radius * 0.17, 10), glow(0xffffff, 1.1));\r\n  shine.position.set(radius * 0.24, radius * 0.27, radius * 0.99);\r\n  pupil.add(shine);\r\n  group.add(pupil);\r\n  const lid = new Group();\r\n  const lidGeometry = new SphereGeometry(radius * 1.08, 24, 12, 0, Math.PI * 2, 0, Math.PI / 2);\r\n  const lidMat = lidMaterial.clone();\r\n  lidMat.side = DoubleSide;\r\n  lid.add(new Mesh(lidGeometry, lidMat));\r\n  const edge = new Mesh(ring(radius * 1.08, radius * 0.075), toon(0x151018, { glint: 0, rim: 0 }));\r\n  edge.rotation.x = Math.PI / 2;\r\n  lid.add(edge);\r\n  group.add(lid);\r\n  return { group, pupil, lid };\r\n}\r\n\r\nexport function skeleton(spec: SkeletonSpec): Rig {\r\n  const root = new Group();\r\n  root.name = spec.name;\r\n  const hips = place(new Group(), root, 0, spec.hipHeight, 0);\r\n  const torso = place(new Group(), hips, 0, spec.torsoY, 0);\r\n  const head = place(new Group(), torso, 0, spec.neckY, 0);\r\n  const jaw = place(new Group(), head, 0, 0, 0);\r\n  const shoulders: [Vector3, Vector3] = [\r\n    new Vector3(-spec.shoulder[0], spec.shoulder[1], spec.shoulder[2]),\r\n    new Vector3(spec.shoulder[0], spec.shoulder[1], spec.shoulder[2]),\r\n  ];\r\n  const arms: [Hose, Hose] = [\r\n    new Hose(spec.armMaterial, torso, spec.armRadius[0], spec.armRadius[1]),\r\n    new Hose(spec.armMaterial, torso, spec.armRadius[0], spec.armRadius[1]),\r\n  ];\r\n  const hands: [Group, Group] = [hand(spec.handMaterial, spec.handSize), hand(spec.handMaterial, spec.handSize)];\r\n  hands[1].scale.x = -1;\r\n  torso.add(hands[0], hands[1]);\r\n  for (const s of shoulders) {\r\n    place(inked(ball(spec.armRadius[0] * 1.7), spec.armMaterial), torso, s.x, s.y, s.z);\r\n  }\r\n  let legs: [Hose, Hose] | null = null;\r\n  let feet: [Group, Group] | null = null;\r\n  let hipAnchors: [Vector3, Vector3] | null = null;\r\n  const rest = blankPose();\r\n  const hang = spec.armHang ?? 0.75;\r\n  rest.handL = [-spec.shoulder[0] - 0.1, spec.shoulder[1] - hang, 0.1];\r\n  rest.handR = [spec.shoulder[0] + 0.1, spec.shoulder[1] - hang, 0.1];\r\n  if (spec.legs) {\r\n    const l = spec.legs;\r\n    legs = [new Hose(l.material, root, l.radius[0], l.radius[1]), new Hose(l.material, root, l.radius[0], l.radius[1])];\r\n    feet = [l.foot(), l.foot()];\r\n    root.add(feet[0], feet[1]);\r\n    hipAnchors = [new Vector3(-l.hip[0], l.hip[1], l.hip[2]), new Vector3(l.hip[0], l.hip[1], l.hip[2])];\r\n    rest.footL = [-l.stance, 0, 0.02];\r\n    rest.footR = [l.stance, 0, 0.02];\r\n  }\r\n  return {\r\n    name: spec.name,\r\n    root,\r\n    hips,\r\n    torso,\r\n    head,\r\n    jaw,\r\n    mouth: null,\r\n    mouthOpen: 1,\r\n    eyes: [],\r\n    shoulders,\r\n    hipAnchors,\r\n    arms,\r\n    legs,\r\n    hands,\r\n    feet,\r\n    hipHeight: spec.hipHeight,\r\n    rest,\r\n    props: {},\r\n    glows: [],\r\n  };\r\n}\r\n\r\nconst sA = new Vector3();\r\nconst sB = new Vector3();\r\nconst sC = new Vector3();\r\nconst sT = new Vector3();\r\nconst DOWN = new Vector3(0, -1, 0);\r\nconst q = new Quaternion();\r\n\r\nfunction bendPoint(out: Vector3, a: Vector3, c: Vector3, amount: number, side: number): Vector3 {\r\n  // Elbow: midpoint pushed down and outward so hoses arc naturally.\r\n  out.copy(a).add(c).multiplyScalar(0.5);\r\n  const span = a.distanceTo(c);\r\n  out.y -= span * 0.3 * amount;\r\n  out.x += side * span * 0.28 * amount;\r\n  out.z -= span * 0.05 * amount;\r\n  return out;\r\n}\r\n\r\nexport function applyPose(rig: Rig, pose: Pose): void {\r\n  rig.root.visible = pose.visible;\r\n  if (!pose.visible) {\r\n    return;\r\n  }\r\n  rig.root.position.x = pose.x;\r\n  rig.root.position.z = pose.z;\r\n  rig.root.rotation.y = pose.yaw;\r\n  rig.hips.position.y = rig.hipHeight + pose.lift;\r\n  const sq = Math.max(0.6, pose.squash);\r\n  rig.hips.scale.set(1 / Math.sqrt(sq), sq, 1 / Math.sqrt(sq));\r\n  rig.torso.rotation.set(pose.lean, pose.twist, pose.tilt, 'YXZ');\r\n  rig.head.rotation.set(pose.headPitch, pose.headYaw, pose.headRoll, 'YXZ');\r\n  const open = Math.max(0, Math.min(1, pose.mouth));\r\n  rig.jaw.rotation.x = open * 0.38 * rig.mouthOpen;\r\n  if (rig.mouth) {\r\n    rig.mouth.scale.set(1 - open * 0.2, 0.15 + open * 0.85, 1);\r\n  }\r\n  const closed = Math.max(0, Math.min(1, pose.lid));\r\n  for (const e of rig.eyes) {\r\n    e.pupil.rotation.set(-pose.lookY * 0.45, pose.lookX * 0.5, 0);\r\n    e.lid.rotation.x = -1.4 + closed * 2.95;\r\n  }\r\n  for (const g of rig.glows) {\r\n    g.userData.level.value = pose.eyeGlow;\r\n  }\r\n  for (let i = 0; i < 2; i += 1) {\r\n    const target = i === 0 ? pose.handL : pose.handR;\r\n    const side = i === 0 ? -1 : 1;\r\n    sA.copy(rig.shoulders[i]);\r\n    sC.set(target[0], target[1], target[2]);\r\n    bendPoint(sB, sA, sC, i === 0 ? pose.bendL : pose.bendR, side);\r\n    rig.arms[i].update(sA, sB, sC);\r\n    const h = rig.hands[i];\r\n    h.position.copy(sC);\r\n    rig.arms[i].endTangent(sT);\r\n    q.setFromUnitVectors(DOWN, sT);\r\n    h.quaternion.copy(q);\r\n  }\r\n  if (rig.legs && rig.feet && rig.hipAnchors) {\r\n    for (let i = 0; i < 2; i += 1) {\r\n      const target = i === 0 ? pose.footL : pose.footR;\r\n      const side = i === 0 ? -1 : 1;\r\n      sA.copy(rig.hipAnchors[i]);\r\n      sA.y += rig.hipHeight + pose.lift;\r\n      sC.set(target[0], target[1] + 0.1, target[2]);\r\n      sB.copy(sA).add(sC).multiplyScalar(0.5);\r\n      // Knees bow forward more when the body sinks.\r\n      const drop = Math.max(0, -pose.lift);\r\n      sB.z += 0.06 + drop * 1.6;\r\n      sB.x += side * (0.03 + drop * 0.5);\r\n      rig.legs[i].update(sA, sB, sC);\r\n      rig.feet[i].position.set(target[0], target[1], target[2]);\r\n    }\r\n  }\r\n}\r\n\r\nexport function disposeRig(rig: Rig): void {\r\n  for (const hose of rig.arms) {\r\n    hose.dispose();\r\n  }\r\n  if (rig.legs) {\r\n    for (const hose of rig.legs) {\r\n      hose.dispose();\r\n    }\r\n  }\r\n}\r\n",
      "lib/shapes.ts": "// Rounded cartoon primitives. Shapes are baked into geometry (not mesh\r\n// scale) so the ink outline keeps an even weight.\r\n\r\nimport {\r\n  BufferAttribute,\r\n  BufferGeometry,\r\n  CylinderGeometry,\r\n  LatheGeometry,\r\n  SphereGeometry,\r\n  TorusGeometry,\r\n  Vector2,\r\n  Vector3,\r\n} from 'three/webgpu';\r\n\r\nconst cache = new Map<string, BufferGeometry>();\r\n\r\nfunction cached(key: string, make: () => BufferGeometry): BufferGeometry {\r\n  let geometry = cache.get(key);\r\n  if (!geometry) {\r\n    geometry = make();\r\n    cache.set(key, geometry);\r\n  }\r\n  return geometry;\r\n}\r\n\r\nexport function disposeShapes(): void {\r\n  for (const geometry of cache.values()) {\r\n    geometry.dispose();\r\n  }\r\n  cache.clear();\r\n}\r\n\r\n// Superellipsoid: e = 2 is an ellipsoid, larger values give a \"squircle\"\r\n// box. w, h, d are full sizes.\r\nexport function blob(w: number, h: number, d: number, e = 2, segments = 28): BufferGeometry {\r\n  return cached(`blob:${w}:${h}:${d}:${e}:${segments}`, () => {\r\n    const geometry = new SphereGeometry(1, segments, Math.round(segments * 0.75));\r\n    const p = geometry.getAttribute('position') as BufferAttribute;\r\n    const power = 2 / e;\r\n    const shaped = (v: number) => Math.sign(v) * Math.pow(Math.abs(v), power);\r\n    for (let i = 0; i < p.count; i += 1) {\r\n      p.setXYZ(i, shaped(p.getX(i)) * w * 0.5, shaped(p.getY(i)) * h * 0.5, shaped(p.getZ(i)) * d * 0.5);\r\n    }\r\n    geometry.computeVertexNormals();\r\n    return geometry;\r\n  });\r\n}\r\n\r\nexport function ball(r: number, segments = 20): BufferGeometry {\r\n  return cached(`ball:${r}:${segments}`, () => new SphereGeometry(r, segments, Math.round(segments * 0.75)));\r\n}\r\n\r\nexport function rod(rTop: number, rBottom: number, h: number, segments = 18): BufferGeometry {\r\n  return cached(`rod:${rTop}:${rBottom}:${h}:${segments}`, () => new CylinderGeometry(rTop, rBottom, h, segments));\r\n}\r\n\r\nexport function ring(r: number, tube: number, arc = Math.PI * 2): BufferGeometry {\r\n  return cached(`ring:${r}:${tube}:${arc}`, () => new TorusGeometry(r, tube, 10, 32, arc));\r\n}\r\n\r\n// Lathe from [radius, height] pairs; used for skirts, hats, gowns, throne.\r\nexport function lathe(name: string, profile: readonly (readonly [number, number])[], segments = 36, phiStart = 0, phiLength = Math.PI * 2): BufferGeometry {\r\n  return cached(`lathe:${name}`, () => {\r\n    // LatheGeometry faces outward when the profile runs bottom to top.\r\n    const ordered = profile[0][1] > profile[profile.length - 1][1] ? [...profile].reverse() : profile;\r\n    const points = ordered.map(([r, y]) => new Vector2(r, y));\r\n    const geometry = new LatheGeometry(points, segments, phiStart, phiLength);\r\n    geometry.computeVertexNormals();\r\n    return geometry;\r\n  });\r\n}\r\n\r\n// Smooth bell profile helper: radius eased between r0 at y0 and r1 at y1.\r\nexport function bell(r0: number, r1: number, y0: number, y1: number, flare = 1.6, steps = 10): [number, number][] {\r\n  const out: [number, number][] = [];\r\n  for (let i = 0; i <= steps; i += 1) {\r\n    const u = i / steps;\r\n    out.push([r0 + (r1 - r0) * Math.pow(u, flare), y0 + (y1 - y0) * u]);\r\n  }\r\n  return out;\r\n}\r\n\r\nexport const UP = new Vector3(0, 1, 0);\r\n",
      "lib/show.ts": "// Cue sheet for the opening of \"One More Dawn\" (intro + first half of\r\n// verse 1). Everything is a pure function of song time, so the preview can\r\n// start anywhere and stays in sync with the track.\r\n//\r\n//   Intro  – Aria, the soprano, wakes on her pedestal; a billion pod doors\r\n//            open; she steps forward and reaches for a dream star.\r\n//   Verse  – Barnaby, the old baritone, teaches two little robots to walk,\r\n//            dance and sing; the king rises; the future is placed in his\r\n//            hands; a chain binds him; toy soldiers face off; he bows.\r\n\r\nimport { Color, Group, PerspectiveCamera, Vector3 } from 'three/webgpu';\r\nimport { applyPose, blankPose, copyPose, type Pose, type Rig, type V3 } from './rig.ts';\r\nimport { BARITONE_WORDS, CLIP_END, INTRO_LINES, SOPRANO_WORDS, VERSE1_LINES, levelAt } from './song.ts';\r\nimport { set } from './stage.ts';\r\nimport { backOut, clamp01, easeOut, keys, lerp, noise1, ramp, smooth, span, type Key } from './time.ts';\r\nimport { light } from './toon.ts';\r\nimport type { Chain, Globe } from './props.ts';\r\n\r\nconst I = INTRO_LINES;\r\nconst V = VERSE1_LINES;\r\nconst W = BARITONE_WORDS;\r\n\r\n// Named word times used as cues.\r\nconst cue = {\r\n  awaken: SOPRANO_WORDS[3][0],\r\n  doors: SOPRANO_WORDS[4][0],\r\n  question: I[5][0],\r\n  dream: I[6][0],\r\n  why: I[7][0],\r\n  dreamHeld: SOPRANO_WORDS[SOPRANO_WORDS.length - 1][0],\r\n  introEnd: I[7][1],\r\n  bandIn: 40.3,\r\n  helped: W[0][0],\r\n  children: W[5][0],\r\n  walk: W[7][0],\r\n  dance: W[9][0],\r\n  sing: W[11][0],\r\n  trusted: V[2][0],\r\n  kingdoms: W[18][0],\r\n  kings: W[21][0],\r\n  placed: V[4][0],\r\n  hands: W[28][0],\r\n  chainLine: V[5][0],\r\n  chain: W[34][0],\r\n  begged: V[6][0],\r\n  wars: W[41][0],\r\n  never: V[7][0],\r\n  reign: W[46][0],\r\n};\r\n\r\nexport interface Cast {\r\n  aria: Rig;\r\n  barnaby: Rig;\r\n  pip: Rig;\r\n  dot: Rig;\r\n  king: Rig;\r\n  guards: [Rig, Rig];\r\n  throne: Group;\r\n  globe: Globe;\r\n  chain: Chain;\r\n  lift: Group;\r\n  pedestal: Group;\r\n}\r\n\r\n// Mouth opening from word timings: syllable-like pulses, held notes stay open.\r\nfunction sing(t: number, words: readonly (readonly [number, number])[], power = 1): number {\r\n  let open = 0;\r\n  for (const [a, b] of words) {\r\n    if (t < a - 0.08 || t > b + 0.12) {\r\n      continue;\r\n    }\r\n    const dur = b - a;\r\n    const u = clamp01((t - a) / Math.max(0.05, dur));\r\n    const attack = clamp01((t - a + 0.08) / 0.1);\r\n    const release = clamp01((b + 0.12 - t) / 0.16);\r\n    const syllables = Math.max(1, Math.round(dur / 0.32));\r\n    const pulse = dur > 0.9 ? 0.82 + Math.sin(t * 31) * 0.05 : 0.45 + 0.55 * Math.abs(Math.sin(Math.PI * u * syllables));\r\n    open = Math.max(open, pulse * attack * release);\r\n  }\r\n  return open * (0.7 + 0.3 * levelAt(t)) * power;\r\n}\r\n\r\nfunction blinkAt(t: number, seed: number): number {\r\n  const period = 3.1 + seed * 0.7;\r\n  const phase = (t + seed * 1.37) % period;\r\n  return phase < 0.14 ? Math.sin((phase / 0.14) * Math.PI) : 0;\r\n}\r\n\r\nfunction v3(x: number, y: number, z: number): V3 {\r\n  return [x, y, z];\r\n}\r\n\r\nfunction mixV(a: V3, b: V3, u: number): V3 {\r\n  return [lerp(a[0], b[0], u), lerp(a[1], b[1], u), lerp(a[2], b[2], u)];\r\n}\r\n\r\n// Stateless walk: phase from distance travelled along keyed straight paths.\r\nfunction travelled(t: number, xs: readonly Key[], zs: readonly Key[]): number {\r\n  return Math.abs(keys(t, xs, smooth) - xs[0][1]) + Math.abs(keys(t, zs, smooth) - zs[0][1]);\r\n}\r\n\r\nfunction speedOf(t: number, xs: readonly Key[], zs: readonly Key[]): number {\r\n  const dt = 0.06;\r\n  const dx = keys(t + dt, xs, smooth) - keys(t - dt, xs, smooth);\r\n  const dz = keys(t + dt, zs, smooth) - keys(t - dt, zs, smooth);\r\n  return Math.hypot(dx, dz) / (2 * dt);\r\n}\r\n\r\nfunction walk(pose: Pose, rig: Rig, phase: number, amount: number, stride: number, step: number): void {\r\n  if (!rig.feet || amount <= 0.001) {\r\n    return;\r\n  }\r\n  const s = Math.sin(phase);\r\n  const c = Math.cos(phase);\r\n  pose.footL = mixV(pose.footL, [rig.rest.footL[0], Math.max(0, c) * step, s * stride], amount);\r\n  pose.footR = mixV(pose.footR, [rig.rest.footR[0], Math.max(0, -c) * step, -s * stride], amount);\r\n  pose.lift += (Math.abs(Math.sin(phase)) * 0.05 - 0.03) * amount;\r\n  pose.tilt += Math.sin(phase) * 0.06 * amount;\r\n  pose.handL = mixV(pose.handL, [pose.handL[0], pose.handL[1], pose.handL[2] - s * 0.22], amount);\r\n  pose.handR = mixV(pose.handR, [pose.handR[0], pose.handR[1], pose.handR[2] + s * 0.22], amount);\r\n}\r\n\r\n// ---------------------------------------------------------------- lighting\r\n\r\nconst cool = new Color(0.55, 0.65, 1.0);\r\nconst moon = new Color(0.35, 0.42, 0.8);\r\nconst warm = new Color(1.0, 0.78, 0.5);\r\nconst gold = new Color(1.0, 0.86, 0.55);\r\nconst dawn = new Color(1.0, 0.62, 0.62);\r\nconst red = new Color(1.0, 0.18, 0.15);\r\nconst steel = new Color(0.55, 0.62, 0.85);\r\nconst tmpA = new Color();\r\nconst tmpB = new Color();\r\n\r\nfunction setColor(target: Color, a: Color, b: Color, u: number, scale: number): void {\r\n  target.copy(a).lerp(b, clamp01(u)).multiplyScalar(scale);\r\n}\r\n\r\nfunction setSpot(i: number, x: number, z: number, r: number, level: number, color: Color, height = 9.5): void {\r\n  const s = light.spots[i];\r\n  s.shape.value.set(x, z, r, level);\r\n  s.color.value.copy(color);\r\n  s.height.value = height;\r\n}\r\n\r\nfunction lighting(t: number, stagePos: { aria: Vector3; barnaby: Vector3; king: Vector3 }): void {\r\n  const lvl = levelAt(t);\r\n  // Overall key light by section.\r\n  const keyLevel = keys(t, [\r\n    [0, 0.0],\r\n    [3.2, 0.0],\r\n    [6.5, 0.45],\r\n    [10, 0.6],\r\n    [19.3, 0.6],\r\n    [21.5, 0.22],\r\n    [27.5, 0.25],\r\n    [31, 0.45],\r\n    [38.5, 0.5],\r\n    [cue.bandIn - 0.2, 0.3],\r\n    [cue.bandIn + 0.8, 0.95],\r\n    [cue.chainLine, 0.95],\r\n    [cue.chain + 0.3, 0.55],\r\n    [cue.begged, 0.6],\r\n    [cue.never + 0.5, 0.7],\r\n    [cue.reign + 0.3, 0.45],\r\n    [CLIP_END, 0.35],\r\n  ]);\r\n  const toWarm = ramp(t, cue.bandIn - 0.5, cue.bandIn + 1.5);\r\n  const toDawn = ramp(t, cue.dream, cue.dreamHeld);\r\n  const toSteel = span(t, cue.chain - 0.6, cue.never + 0.4, 0.6, 1.2);\r\n  setColor(tmpA, cool, dawn, toDawn * 0.6, 1);\r\n  tmpB.copy(tmpA).lerp(warm, toWarm).lerp(steel, toSteel * 0.6);\r\n  const warsFlash = span(t, cue.wars - 0.05, cue.wars + 0.6, 0.05, 0.5) * 0.9;\r\n  tmpB.lerp(red, warsFlash * 0.7);\r\n  light.key.value.copy(tmpB).multiplyScalar(keyLevel * (0.92 + lvl * 0.15));\r\n  setColor(light.fill.value, new Color(0.05, 0.05, 0.12), new Color(0.12, 0.08, 0.08), toWarm, 1);\r\n  light.fill.value.multiplyScalar(0.6 + 0.6 * ramp(t, 2.5, 6) + toWarm * 0.3);\r\n  setColor(light.rim.value, new Color(0.35, 0.5, 1.0), new Color(1.0, 0.55, 0.35), toWarm, 0.9 + warsFlash);\r\n  light.glint.value = 0.6 + toWarm * 0.6;\r\n\r\n  // Spot 0: Aria's follow spot.\r\n  const ariaSpot = keys(t, [\r\n    [0, 0],\r\n    [cue.awaken - 0.3, 0],\r\n    [cue.awaken + 0.4, 1.1],\r\n    [19.3, 1.0],\r\n    [21.5, 1.45],\r\n    [cue.introEnd - 0.4, 1.45],\r\n    [cue.bandIn + 1.5, 0.45],\r\n    [CLIP_END, 0.35],\r\n  ]);\r\n  setColor(tmpA, new Color(0.85, 0.9, 1.0), dawn, toDawn, 1);\r\n  setSpot(0, stagePos.aria.x, stagePos.aria.z, keys(t, [[0, 1.0], [21, 1.0], [24, 0.85], [cue.introEnd, 0.95], [cue.bandIn + 2, 1.1]]), ariaSpot, tmpA);\r\n\r\n  // Spot 1: Barnaby's follow spot.\r\n  const barnSpot = keys(t, [\r\n    [0, 0],\r\n    [cue.bandIn, 0],\r\n    [cue.bandIn + 1.2, 1.15],\r\n    [cue.chainLine, 1.15],\r\n    [cue.chain + 0.2, 1.35],\r\n    [cue.never, 1.2],\r\n    [cue.reign + 0.4, 0.75],\r\n  ]);\r\n  setColor(tmpA, gold, steel, toSteel, 1);\r\n  setSpot(1, stagePos.barnaby.x, stagePos.barnaby.z + 0.15, keys(t, [[0, 1.3], [cue.chain, 1.3], [cue.chain + 0.4, 1.05], [cue.begged, 1.3]]), barnSpot, tmpA);\r\n\r\n  // Spot 2: the children's pool, later the soldiers' red wash.\r\n  const kidSpot = span(t, cue.children - 0.4, cue.begged + 0.4, 0.6, 0.8) * 1.0;\r\n  const kidX = keys(t, [[0, -2.05], [cue.begged, -2.05], [cue.begged + 1.0, 1.4]]);\r\n  setSpot(2, kidX, 0.7, 1.6, kidSpot, new Color(1.0, 0.82, 0.6));\r\n\r\n  // Spot 3: the throne.\r\n  const kingSpot = keys(t, [\r\n    [0, 0],\r\n    [cue.kingdoms - 0.2, 0],\r\n    [cue.kingdoms + 0.4, 1.5],\r\n    [cue.kings + 0.6, 1.0],\r\n    [cue.never, 1.0],\r\n    [cue.reign, 1.6],\r\n    [CLIP_END, 1.4],\r\n  ]);\r\n  setSpot(3, stagePos.king.x, stagePos.king.z + 0.2, 1.55, kingSpot, gold);\r\n\r\n  // Spot 4: opening pin spot on the curtain, then a soft centre wash and\r\n  // red side washes for the soldiers.\r\n  const pin = keys(t, [[0, 0], [0.6, 0], [1.6, 1.1], [3.0, 1.1], [4.8, 0]]);\r\n  const wars = span(t, cue.begged - 0.2, cue.never + 0.6, 0.6, 0.8);\r\n  set.curtainPin.value = pin * (1 - set.curtainOpen);\r\n  setSpot(4, 0, 1.0, 4.2, wars * (0.45 + warsFlash), red);\r\n\r\n  set.footLevel.value = keys(t, [[0, 0], [2.5, 0], [6, 0.25], [19.3, 0.25], [21.5, 0.08], [cue.bandIn - 0.3, 0.1], [cue.bandIn + 0.6, 0.85], [cue.chain, 0.85], [cue.chain + 0.5, 0.45], [cue.reign, 0.4]]) * (0.85 + lvl * 0.3);\r\n  set.marqueeLevel.value = keys(t, [[0, 0.15], [cue.bandIn - 0.2, 0.15], [cue.bandIn + 0.4, 1.0], [cue.chain, 1.0], [cue.chain + 0.5, 0.45], [cue.kingdoms, 0.45]]) + span(t, cue.kingdoms - 0.1, cue.kings + 1.5, 0.2, 1.2) * 0.6;\r\n  set.marqueeChase.value = t * (t > cue.bandIn ? 2.6 : 0.6);\r\n  set.neonLevel.value = keys(t, [[0, 0.0], [2.5, 0.0], [6.0, 0.6], [19.3, 0.6], [21.5, 0.25], [cue.bandIn, 0.3], [cue.bandIn + 0.5, 1.2]]) * (0.85 + lvl * 0.3);\r\n  set.hazeLevel.value = 0.75;\r\n\r\n  // Door wall: wakes on \"behind a billion doors\", obeys in unison on\r\n  // \"taught us how to answer\", dims for the soprano's question, then glows\r\n  // warm amber behind the verse.\r\n  set.wallWakeAt.value = cue.doors;\r\n  set.wallLevel.value = keys(t, [[0, 1], [19.3, 1], [22, 0.16], [cue.bandIn - 0.5, 0.16], [cue.bandIn + 1, 0.32], [cue.chain, 0.32], [cue.chain + 0.5, 0.2], [cue.reign, 0.2]]);\r\n  set.wallEyeLevel.value = keys(t, [[0, 1], [19.3, 1], [22, 0.12], [cue.bandIn, 0.12], [cue.bandIn + 1, 0.42], [cue.begged, 0.42], [cue.wars, 0.75]]);\r\n  setColor(set.wallInterior.value, new Color(0.45, 0.8, 1.0), new Color(1.0, 0.68, 0.32), toWarm, 1);\r\n  setColor(set.wallEyes.value, new Color(0.75, 1.0, 1.0), new Color(1.0, 0.95, 0.75), toWarm, 1);\r\n  set.wallBlinkSync.value = span(t, I[2][0] - 0.3, I[3][1] + 0.5, 0.5, 1.0);\r\n  const look = set.wallLook.value;\r\n  look.set(\r\n    keys(t, [[0, 0], [I[3][0], 0], [I[3][0] + 1, 0], [cue.bandIn, 0], [cue.bandIn + 2, 0.5], [cue.kingdoms, 0.5], [cue.kingdoms + 1, 0], [cue.chain, 0.6]]),\r\n    keys(t, [[0, 0], [I[3][0], 0], [I[3][0] + 0.8, -0.9], [I[3][1], -0.9], [19.6, 0], [cue.dream, 0.9], [cue.bandIn, 0.9], [cue.bandIn + 1.5, 0], [cue.placed, 0], [cue.placed + 1, 0.8], [cue.hands, 0]]),\r\n  );\r\n\r\n  set.starLevel.value = keys(t, [[0, 0.25], [cue.dream - 1, 0.25], [cue.dream + 2, 1.3], [cue.introEnd, 1.3], [cue.bandIn + 2, 0.5]]);\r\n  set.dreamStar.value = keys(t, [[0, 0], [cue.why, 0], [cue.dreamHeld - 1, 0.7], [cue.dreamHeld + 0.8, 1.5], [cue.introEnd + 0.8, 0.9], [cue.bandIn + 2, 0.2]]);\r\n  setColor(set.skyHorizon.value, new Color(0.06, 0.03, 0.14), new Color(0.35, 0.12, 0.2), toDawn * (1 - toWarm * 0.5), 1);\r\n}\r\n\r\n// ---------------------------------------------------------------- camera\r\n\r\nconst camPos = new Vector3();\r\nconst camLook = new Vector3();\r\n\r\nfunction camera(t: number, cam: PerspectiveCamera): void {\r\n  const shots: [number, [number, number, number], [number, number, number]][] = [\r\n    [0, [0, 2.9, 19.0], [0, 3.4, 2.0]],\r\n    [3.0, [0, 2.85, 18.6], [0, 3.2, 1.0]],\r\n    [18.5, [0, 2.2, 12.5], [0, 2.1, -1.0]],\r\n    [22.0, [0.2, 1.9, 8.6], [0, 1.75, 0.2]],\r\n    [31.0, [0.1, 1.8, 8.2], [-0.1, 2.1, -0.5]],\r\n    [cue.introEnd - 1, [0.1, 1.9, 9.0], [0.2, 3.3, -2.5]],\r\n    [cue.bandIn + 0.4, [0, 2.3, 15.5], [0, 2.2, -1.0]],\r\n    [cue.helped - 0.4, [0.2, 2.0, 13.0], [0.2, 1.75, -0.6]],\r\n    [cue.walk, [-1.4, 1.7, 9.0], [-1.6, 1.1, 0.0]],\r\n    [cue.trusted + 1.0, [-0.2, 2.0, 12.4], [0, 1.7, -0.8]],\r\n    [cue.kingdoms + 0.2, [0, 2.3, 13.6], [0, 2.1, -1.8]],\r\n    [cue.placed + 1.4, [1.5, 2.0, 9.0], [1.6, 1.85, -0.8]],\r\n    [cue.chain, [0.9, 2.1, 10.6], [0.8, 1.9, -1.6]],\r\n    [cue.begged + 0.6, [0, 2.2, 13.6], [0, 1.95, -1.2]],\r\n    [cue.reign, [0.2, 2.2, 13.0], [0, 2.0, -1.8]],\r\n    [CLIP_END, [0.1, 2.25, 13.4], [0, 2.05, -1.8]],\r\n  ];\r\n  let i = 1;\r\n  while (i < shots.length - 1 && t > shots[i][0]) {\r\n    i += 1;\r\n  }\r\n  const [t0, p0, l0] = shots[i - 1];\r\n  const [t1, p1, l1] = shots[i];\r\n  const u = t <= t0 ? 0 : t >= t1 ? 1 : smooth((t - t0) / (t1 - t0));\r\n  camPos.set(lerp(p0[0], p1[0], u), lerp(p0[1], p1[1], u), lerp(p0[2], p1[2], u));\r\n  camLook.set(lerp(l0[0], l1[0], u), lerp(l0[1], l1[1], u), lerp(l0[2], l1[2], u));\r\n  // Gentle hand-held drift.\r\n  camPos.x += noise1(t * 0.25, 1) * 0.06;\r\n  camPos.y += noise1(t * 0.21, 2) * 0.04;\r\n  camLook.x += noise1(t * 0.2, 3) * 0.03;\r\n  cam.position.copy(camPos);\r\n  cam.lookAt(camLook);\r\n}\r\n\r\n// ---------------------------------------------------------------- performers\r\n\r\nconst scratch = blankPose();\r\n\r\nfunction ariaPose(t: number, rig: Rig, out: Pose): Vector3 {\r\n  const p = copyPose(rig.rest, out);\r\n  const r = rig.rest;\r\n  const onPedestal = 1 - ramp(t, I[4][0] - 0.2, I[4][0] + 1.2);\r\n  const zKeys: Key[] = [[0, -1.0], [I[4][0] - 0.2, -1.0], [I[4][0] + 2.4, 0.9], [cue.introEnd + 0.6, 0.9], [cue.bandIn + 3.0, -3.3]];\r\n  const xKeys: Key[] = [[0, 0], [cue.introEnd + 0.6, 0], [cue.bandIn + 3.0, -5.2]];\r\n  p.x = keys(t, xKeys);\r\n  p.z = keys(t, zKeys);\r\n  p.lift = 0.32 * onPedestal + 0.04 * Math.sin(t * 1.4) + 0.02;\r\n  // Hop down from the pedestal: a little arc.\r\n  p.lift += Math.sin(Math.PI * ramp(t, I[4][0] - 0.2, I[4][0] + 1.2, (u: number) => u)) * 0.18;\r\n  p.yaw = keys(t, [[0, 0], [cue.introEnd + 0.6, 0], [cue.introEnd + 1.4, -0.9], [cue.bandIn + 2.6, -0.9], [cue.bandIn + 3.6, 0.55], [CLIP_END, 0.55]]);\r\n  // Powered down until \"awaken\".\r\n  const awake = ramp(t, cue.awaken - 0.2, cue.awaken + 0.9, backOut);\r\n  p.eyeGlow = awake * 1.1;\r\n  p.lean = lerp(0.42, 0.0, awake);\r\n  p.headPitch = lerp(0.55, 0, awake);\r\n  p.lid = lerp(1, 0.12, ramp(t, cue.awaken - 0.1, cue.awaken + 0.35)) + blinkAt(t, 0.3) * awake;\r\n  // Wonder: looks around at the doors opening.\r\n  p.headYaw = keys(t, [[0, 0], [cue.doors, 0], [cue.doors + 1.2, 0.5], [cue.doors + 2.6, -0.5], [I[2][0], 0]]);\r\n  p.headPitch -= span(t, cue.doors, I[2][0], 0.8, 0.8) * 0.12;\r\n  p.lookX = p.headYaw * 0.6;\r\n  // Hands: rest -> clasped at chest (dutiful) -> chin (question) -> arms\r\n  // open (dream) -> hand to heart, reach to the star.\r\n  const rest = { L: r.handL, R: r.handR };\r\n  const chestL = v3(-0.06, 0.32, 0.26);\r\n  const chestR = v3(0.06, 0.3, 0.27);\r\n  const chinR = v3(0.05, 0.66, 0.3);\r\n  const wideL = v3(-0.82, 0.62, 0.15);\r\n  const wideR = v3(0.82, 0.62, 0.15);\r\n  const reachR = v3(0.32, 1.18, 0.3);\r\n  const heartL = v3(-0.03, 0.36, 0.27);\r\n  const clasp = span(t, cue.doors + 0.5, I[3][0] + 0.6, 0.8, 0.8);\r\n  const chin = span(t, cue.question - 0.2, cue.dream + 0.2, 0.7, 0.6);\r\n  const wide = span(t, cue.dream, cue.why + 0.5, 0.9, 0.7);\r\n  const heart = span(t, cue.why + 0.2, cue.introEnd + 1.2, 0.6, 0.9);\r\n  const reach = span(t, SOPRANO_WORDS[SOPRANO_WORDS.length - 3][0], cue.introEnd + 1.2, 1.2, 0.9);\r\n  let L = rest.L;\r\n  let R = rest.R;\r\n  L = mixV(L, chestL, clasp);\r\n  R = mixV(R, chestR, clasp);\r\n  R = mixV(R, chinR, chin);\r\n  L = mixV(L, v3(-0.32, 0.12, 0.22), chin);\r\n  L = mixV(L, wideL, wide);\r\n  R = mixV(R, wideR, wide);\r\n  L = mixV(L, heartL, heart);\r\n  R = mixV(R, mixV(v3(0.4, 0.3, 0.25), reachR, 0.0), heart * (1 - reach));\r\n  R = mixV(R, reachR, reach);\r\n  p.handL = L;\r\n  p.handR = R;\r\n  p.bendL = 0.6;\r\n  p.bendR = 0.6 - reach * 0.4;\r\n  // Curtsy on \"answer\", head shake on \"never ask for more\".\r\n  const curtsy = span(t, I[2][1] - 0.6, I[2][1] + 0.6, 0.4, 0.5);\r\n  p.lift -= curtsy * 0.1;\r\n  p.lean += curtsy * 0.12;\r\n  p.headYaw += Math.sin((t - I[3][0]) * 7) * 0.14 * span(t, I[3][0] + 0.3, I[3][0] + 1.7, 0.2, 0.3);\r\n  p.headRoll = chin * 0.22 + Math.sin(t * 0.9) * 0.03;\r\n  p.headPitch -= (wide * 0.25 + reach * 0.35);\r\n  p.lookY = wide * 0.6 + reach * 0.8 + chin * 0.3;\r\n  p.lookX += reach * -0.25;\r\n  // Singing.\r\n  p.mouth = sing(t, SOPRANO_WORDS);\r\n  p.headPitch -= p.mouth * 0.04;\r\n  // Sway while singing, still while listening during the verse.\r\n  const listening = ramp(t, cue.bandIn + 2, cue.bandIn + 3.5);\r\n  p.tilt = Math.sin(t * 0.8) * 0.03 * (1 - listening);\r\n  p.headYaw = lerp(p.headYaw, 0.35 + span(t, cue.chain - 0.3, cue.chain + 2.5, 0.3, 1) * 0.45, listening);\r\n  p.lid = lerp(p.lid, 0.4 + blinkAt(t, 1.2), listening);\r\n  // Hand to mouth in worry when the soldiers face off.\r\n  const worry = span(t, cue.wars - 0.6, cue.reign + 0.6, 0.4, 0.8) * listening;\r\n  p.handR = mixV(p.handR, v3(0.04, 0.6, 0.32), worry);\r\n  p.handL = mixV(p.handL, v3(-0.05, 0.36, 0.28), listening * 0.8);\r\n  p.eyeGlow *= 1 - listening * 0.25;\r\n  rig.props.antenna.rotation.z = Math.sin(t * 2.1) * 0.06 + (p.headRoll * -0.5);\r\n  const halo = rig.props.haloLight.userData.material;\r\n  halo.userData.level.value = awake * (0.6 + chin * 1.2 + wide * 0.8 + reach * 1.0);\r\n  return new Vector3(p.x, 0, p.z);\r\n}\r\n\r\nfunction barnabyPose(t: number, rig: Rig, out: Pose): Vector3 {\r\n  const p = copyPose(rig.rest, out);\r\n  const r = rig.rest;\r\n  // Enters from stage right; steps forward between the soldiers; bows.\r\n  const xKeys: Key[] = [[0, 9.5], [cue.bandIn + 0.4, 9.5], [cue.helped - 0.6, 2.3], [cue.begged + 0.6, 2.3], [cue.wars - 0.3, 1.1]];\r\n  const zKeys: Key[] = [[0, 0.3], [cue.bandIn + 0.4, 0.3], [cue.helped - 0.6, 0.5], [cue.begged + 0.6, 0.5], [cue.wars - 0.3, 1.3]];\r\n  p.x = keys(t, xKeys, smooth);\r\n  p.z = keys(t, zKeys, smooth);\r\n  const speed = speedOf(t, xKeys, zKeys);\r\n  const moving = clamp01(speed / 1.2);\r\n  const phase = travelled(t, xKeys, zKeys) * 4.2;\r\n  p.yaw = keys(t, [[0, -1.3], [cue.helped - 1.6, -1.3], [cue.helped - 0.4, -0.12], [cue.kingdoms + 0.4, -0.12], [cue.kings, -0.55], [cue.placed, -0.1], [cue.never + 0.2, -0.1], [cue.never + 1.0, -1.25], [CLIP_END, -1.25]]);\r\n  p.lean = 0.12 + Math.sin(t * 1.3) * 0.015;\r\n  p.lid = 0.38 + blinkAt(t, 0.9);\r\n  p.lift = Math.sin(t * 1.6) * 0.008;\r\n  // Old-timer gait: short strides, a little rock.\r\n  walk(p, rig, phase, moving, 0.2, 0.12);\r\n  p.tilt += Math.sin(phase) * 0.04 * moving;\r\n  // Hand on chest for \"I\", open palm toward the children.\r\n  const chest = span(t, cue.helped - 0.3, cue.helped + 1.4, 0.3, 0.6);\r\n  const present = span(t, cue.children - 0.4, cue.walk + 0.2, 0.5, 0.6);\r\n  const conduct = span(t, cue.walk - 0.2, cue.sing + 0.9, 0.3, 0.6);\r\n  const embrace = span(t, cue.trusted - 0.2, cue.kingdoms + 0.4, 0.6, 0.6);\r\n  const receive = span(t, cue.placed + 0.5, cue.begged + 0.8, 0.8, 0.8);\r\n  const overhead = span(t, cue.begged + 0.4, cue.never + 0.4, 0.9, 0.9);\r\n  const offer = span(t, cue.never + 0.4, CLIP_END + 5, 0.9, 0.5);\r\n  let L = r.handL;\r\n  let R = r.handR;\r\n  R = mixV(R, v3(0.08, 0.5, 0.42), chest);\r\n  L = mixV(L, v3(-0.9, 0.62, 0.3), present);\r\n  const beat = Math.sin((t - cue.walk) * 7.5);\r\n  R = mixV(R, v3(0.62 + beat * 0.08, 1.05 + Math.abs(beat) * 0.18, 0.3), conduct);\r\n  L = mixV(L, v3(-1.0, 0.95, 0.2), embrace);\r\n  R = mixV(R, v3(1.0, 0.95, 0.2), embrace);\r\n  L = mixV(L, v3(-0.2, 0.38, 0.62), receive);\r\n  R = mixV(R, v3(0.2, 0.38, 0.62), receive);\r\n  L = mixV(L, v3(-0.24, 1.45, 0.25), overhead);\r\n  R = mixV(R, v3(0.24, 1.45, 0.25), overhead);\r\n  L = mixV(L, v3(-0.2, 0.4, 0.7), offer);\r\n  R = mixV(R, v3(0.2, 0.4, 0.7), offer);\r\n  p.handL = L;\r\n  p.handR = R;\r\n  p.bendL = 0.5 + embrace * 0.3;\r\n  p.bendR = 0.5;\r\n  // Look at the children, up at the globe, down at the chain.\r\n  p.headYaw = present * -0.45 + conduct * -0.35 + span(t, cue.kingdoms, cue.kings + 1, 0.3, 0.6) * -0.3;\r\n  p.headPitch = -embrace * 0.18 - span(t, cue.placed, cue.hands, 0.5, 0.5) * 0.35 + receive * 0.12;\r\n  const chainLook = span(t, cue.chain - 0.1, cue.begged + 0.2, 0.3, 0.8);\r\n  p.headPitch += chainLook * 0.4;\r\n  p.headYaw += chainLook * -0.35;\r\n  p.lookY = -chainLook * 0.6 + embrace * 0.4;\r\n  // Jolt when the chain snaps tight.\r\n  const jolt = span(t, cue.chain, cue.chain + 0.45, 0.04, 0.4);\r\n  p.squash = 1 - jolt * 0.08;\r\n  p.lean += jolt * 0.12 + chainLook * 0.1;\r\n  // The bow at \"never break their reign\".\r\n  const bow = span(t, cue.never + 0.8, CLIP_END + 5, 1.2, 0.5);\r\n  p.lean += bow * 0.38;\r\n  p.lift -= bow * 0.06;\r\n  p.headPitch += bow * 0.2;\r\n  // Singing.\r\n  p.mouth = sing(t, W);\r\n  p.headPitch -= p.mouth * 0.06;\r\n  p.headRoll = Math.sin(t * 1.1) * 0.04 + p.mouth * Math.sin(t * 3.0) * 0.03;\r\n  const bulb = rig.props.bulb.userData.material;\r\n  bulb.userData.level.value = 0.7 + p.mouth * 0.6;\r\n  p.visible = t > cue.bandIn - 0.5;\r\n  return new Vector3(p.x, 0, p.z);\r\n}\r\n\r\nfunction kidPose(t: number, rig: Rig, out: Pose, which: 0 | 1): void {\r\n  const p = copyPose(rig.rest, out);\r\n  const r = rig.rest;\r\n  const home = which === 0 ? -2.7 : -1.45;\r\n  const homeZ = which === 0 ? 0.55 : 0.95;\r\n  const hide = which === 0 ? 1.75 : 2.25;\r\n  const enter = cue.helped + 0.6 + which * 0.35;\r\n  const xKeys: Key[] = [[0, -9.5], [enter, -9.5], [cue.children + 0.4, home - 0.45], [cue.walk, home - 0.45], [cue.walk + 0.5, home], [cue.begged, home], [cue.begged + 1.2, hide]];\r\n  const zKeys: Key[] = [[0, homeZ], [cue.walk, homeZ], [cue.begged, homeZ], [cue.begged + 1.2, which === 0 ? 0.3 : 0.0]];\r\n  p.x = keys(t, xKeys, smooth);\r\n  p.z = keys(t, zKeys, smooth);\r\n  const speed = speedOf(t, xKeys, zKeys);\r\n  const moving = clamp01(speed / 1.4);\r\n  const phase = travelled(t, xKeys, zKeys) * 9;\r\n  // Facing: run in facing right, then face front; turn to the throne.\r\n  const toKing = span(t, cue.kingdoms + 0.2, cue.placed, 0.4, 0.6);\r\n  p.yaw = lerp(1.25 * moving, which === 0 ? 0.35 : -0.2, 1 - moving) * 1;\r\n  p.yaw = lerp(p.yaw, which === 0 ? 2.6 : -2.7, toKing * 0.75);\r\n  p.yaw = lerp(p.yaw, 3.0, span(t, cue.begged + 0.6, CLIP_END + 5, 0.4, 0.5) * 0.15);\r\n  walk(p, rig, phase, moving, 0.12, 0.09);\r\n  // Toddle on \"walk\": stiff wobbly steps.\r\n  const toddle = span(t, cue.walk - 0.05, cue.walk + 0.6, 0.05, 0.15);\r\n  p.tilt += Math.sin((t - cue.walk) * 14) * 0.18 * toddle;\r\n  p.handL = mixV(p.handL, v3(-0.32, 0.36, 0.2), toddle);\r\n  p.handR = mixV(p.handR, v3(0.32, 0.36, 0.2), toddle);\r\n  // Spin on \"dance\".\r\n  const spin = ramp(t, cue.dance - 0.05, cue.dance + 0.55, easeOut);\r\n  p.yaw += spin * Math.PI * 2 * (which === 0 ? 1 : -1);\r\n  p.lift += Math.sin(Math.PI * spin) * 0.18;\r\n  const danceArms = span(t, cue.dance - 0.05, cue.dance + 0.6, 0.05, 0.2);\r\n  p.handL = mixV(p.handL, v3(-0.32, 0.55, 0.0), danceArms);\r\n  p.handR = mixV(p.handR, v3(0.32, 0.55, 0.0), danceArms);\r\n  // Arms up and sing on \"sing\".\r\n  const singing = span(t, cue.sing - 0.05, cue.trusted + 0.3, 0.12, 0.5);\r\n  p.handL = mixV(p.handL, v3(-0.36, 0.62, 0.12), singing);\r\n  p.handR = mixV(p.handR, v3(0.36, 0.62, 0.12), singing);\r\n  p.mouth = Math.max(singing * (0.75 + Math.sin(t * 9 + which) * 0.15), 0);\r\n  p.headPitch = -singing * 0.25;\r\n  p.lift += singing * Math.abs(Math.sin((t - cue.sing) * 6)) * 0.05;\r\n  // Look up at the old robot; bow to the king; awe at the globe.\r\n  p.headYaw = span(t, cue.trusted, cue.kingdoms, 0.4, 0.4) * 0.6;\r\n  p.headPitch -= span(t, cue.trusted, cue.kingdoms, 0.4, 0.4) * 0.3;\r\n  const kidBow = span(t, cue.kings, cue.kings + 1.3, 0.3, 0.5);\r\n  p.lean += kidBow * 0.5;\r\n  const awe = span(t, cue.placed, cue.chain, 0.6, 0.6);\r\n  p.headPitch -= awe * 0.35;\r\n  p.lookY = awe * 0.7;\r\n  // Scared: peek out from behind Barnaby.\r\n  const scared = span(t, cue.begged + 0.8, CLIP_END + 5, 0.4, 0.5);\r\n  p.handL = mixV(p.handL, v3(-0.08, 0.5, 0.22), scared);\r\n  p.handR = mixV(p.handR, v3(0.08, 0.52, 0.22), scared);\r\n  p.squash = 1 - scared * 0.06 + Math.sin(t * 22) * 0.012 * scared;\r\n  p.lid = 0.05 + blinkAt(t, 2 + which);\r\n  p.visible = t > enter - 0.2;\r\n  if (rig.props.propeller) {\r\n    rig.props.propeller.rotation.y = t * (6 + moving * 20 + spin * 30);\r\n  }\r\n  if (rig.props.tailL && rig.props.tailR) {\r\n    const bounce = Math.sin(t * 8) * 0.12 * (moving + danceArms + singing * 0.5);\r\n    rig.props.tailL.rotation.z = 0.4 + bounce;\r\n    rig.props.tailR.rotation.z = -0.4 - bounce;\r\n  }\r\n  void r;\r\n}\r\n\r\nfunction kingPose(t: number, rig: Rig, out: Pose, liftY: number): void {\r\n  const p = copyPose(rig.rest, out);\r\n  p.x = 0;\r\n  p.z = 0.1;\r\n  p.lift = -0.0;\r\n  // Seated: feet forward, legs bent.\r\n  p.footL = [-0.26, 0, 0.62];\r\n  p.footR = [0.26, 0, 0.62];\r\n  p.lean = -0.05;\r\n  const raise = span(t, cue.chainLine - 0.3, cue.chain + 0.6, 0.5, 0.8);\r\n  const nod = span(t, cue.reign - 0.2, cue.reign + 1.0, 0.3, 0.5);\r\n  p.handL = [-0.62, 0.15, 0.4];\r\n  p.handR = mixV([0.62, 0.15, 0.38], [0.7, 1.0, 0.5], raise);\r\n  p.bendL = 0.3;\r\n  p.bendR = 0.4;\r\n  p.headPitch = -0.12 + nod * 0.22 + Math.sin(t * 0.7) * 0.02;\r\n  p.headYaw = keys(t, [[0, 0], [cue.helped, 0], [cue.placed, 0.3], [CLIP_END, 0.3]]);\r\n  p.lid = 0.45 + blinkAt(t, 3.3);\r\n  p.lookX = 0.3;\r\n  // Haughty chin-up on arrival.\r\n  p.headPitch -= span(t, cue.kings - 0.2, cue.kings + 1.0, 0.2, 0.6) * 0.2;\r\n  p.visible = liftY > -3.8;\r\n}\r\n\r\nfunction guardPose(t: number, rig: Rig, out: Pose, side: -1 | 1): void {\r\n  const p = copyPose(rig.rest, out);\r\n  const enter = cue.begged - 0.3 + (side > 0 ? 0.15 : 0);\r\n  const xKeys: Key[] = [[0, side * 9.5], [enter, side * 9.5], [enter + 1.8, side * 2.9]];\r\n  const zKeys: Key[] = [[0, 0.9], [enter + 1.8, 0.9]];\r\n  p.x = keys(t, xKeys, smooth);\r\n  p.z = keys(t, zKeys, smooth);\r\n  const speed = speedOf(t, xKeys, zKeys);\r\n  const moving = clamp01(speed / 1.2);\r\n  // March: high knees, stiff.\r\n  const phase = travelled(t, xKeys, zKeys) * 5.2;\r\n  walk(p, rig, phase, moving, 0.16, 0.22);\r\n  p.yaw = side > 0 ? -Math.PI / 2 : Math.PI / 2;\r\n  p.yaw += side * span(t, cue.never - 0.1, CLIP_END + 5, 0.4, 0.5) * -0.9;\r\n  const aim = span(t, cue.wars - 0.35, cue.never + 0.3, 0.2, 0.4);\r\n  const swing = Math.sin(phase);\r\n  p.handL = mixV([-0.25, 0.32, 0.2], [-0.25, 0.72, 0.42], aim);\r\n  p.handR = mixV([0.34 + swing * 0.0, 0.0, swing * 0.18], [-0.1, 0.62, 0.45], aim);\r\n  p.bendL = 0.4;\r\n  p.bendR = 0.4;\r\n  const rifle = rig.props.rifle;\r\n  rifle.rotation.x = lerp(-0.1, -1.4, aim);\r\n  p.lean = aim * 0.08 - span(t, cue.never, CLIP_END + 5, 0.4, 0.4) * 0.05;\r\n  p.headPitch = -0.05;\r\n  p.lid = 0.25 + blinkAt(t, 4 + side);\r\n  p.mouth = span(t, cue.wars - 0.1, cue.wars + 0.6, 0.05, 0.3) * 0.6;\r\n  // Flinch when the soldiers stand down.\r\n  p.squash = 1 + span(t, cue.never - 0.1, cue.never + 0.4, 0.05, 0.3) * 0.06;\r\n  p.visible = t > enter - 0.1;\r\n}\r\n\r\n// ---------------------------------------------------------------- frame\r\n\r\nconst ariaWorld = new Vector3();\r\nconst barnWorld = new Vector3();\r\nconst kingWorld = new Vector3(0, 0, -4.4);\r\nconst tmpV = new Vector3();\r\nconst tmpW = new Vector3();\r\nconst poses = {\r\n  aria: blankPose(),\r\n  barnaby: blankPose(),\r\n  pip: blankPose(),\r\n  dot: blankPose(),\r\n  king: blankPose(),\r\n  g0: blankPose(),\r\n  g1: blankPose(),\r\n};\r\n\r\nexport function runShow(t: number, cast: Cast, cam: PerspectiveCamera): void {\r\n  // Curtains part on the first sung line.\r\n  set.curtainOpen = ramp(t, cue.awaken - 2.2, cue.doors + 0.2, smooth);\r\n  set.pedestalDrop = ramp(t, cue.bandIn + 1.0, cue.bandIn + 3.2, smooth);\r\n\r\n  ariaWorld.copy(ariaPose(t, cast.aria, poses.aria));\r\n  barnWorld.copy(barnabyPose(t, cast.barnaby, poses.barnaby));\r\n  kidPose(t, cast.pip, poses.pip, 0);\r\n  kidPose(t, cast.dot, poses.dot, 1);\r\n\r\n  const liftY = keys(t, [[0, -4.8], [cue.kingdoms - 0.3, -4.8], [cue.kings + 0.3, 0]], easeOut);\r\n  cast.lift.position.y = liftY;\r\n  kingPose(t, cast.king, poses.king, liftY);\r\n  guardPose(t, cast.guards[0], poses.g0, -1);\r\n  guardPose(t, cast.guards[1], poses.g1, 1);\r\n\r\n  applyPose(cast.aria, poses.aria);\r\n  applyPose(cast.barnaby, poses.barnaby);\r\n  applyPose(cast.pip, poses.pip);\r\n  applyPose(cast.dot, poses.dot);\r\n  applyPose(cast.king, poses.king);\r\n  applyPose(cast.guards[0], poses.g0);\r\n  applyPose(cast.guards[1], poses.g1);\r\n  cast.pedestal.visible = true;\r\n\r\n  // The globe drifts down into Barnaby's hands and stays with him.\r\n  const scene = cast.globe.group;\r\n  const descend = ramp(t, cue.placed, cue.hands + 0.2, smooth);\r\n  scene.visible = t > cue.placed - 0.1;\r\n  cast.barnaby.root.updateMatrixWorld(true);\r\n  const handsMid = tmpV.copy(cast.barnaby.hands[0].position).add(cast.barnaby.hands[1].position).multiplyScalar(0.5);\r\n  cast.barnaby.torso.localToWorld(handsMid);\r\n  handsMid.y += 0.2;\r\n  handsMid.z += 0.06;\r\n  tmpW.set(barnWorld.x + 0.1, 7.5, barnWorld.z + 0.5);\r\n  scene.position.copy(tmpW).lerp(handsMid, descend);\r\n  scene.rotation.y = t * 0.6;\r\n  cast.globe.glowLevel.value = 0.8 + span(t, cue.hands - 0.2, cue.hands + 1.0, 0.1, 0.8) * 0.8;\r\n\r\n  // Chain from the sceptre to Barnaby's left wrist.\r\n  cast.king.root.updateMatrixWorld(true);\r\n  const sceptreTip = cast.king.props.sceptre.localToWorld(tmpV.set(0, 0.5, 0));\r\n  const wrist = cast.barnaby.hands[0].localToWorld(tmpW.set(0, -0.02, 0));\r\n  const reveal = ramp(t, cue.chainLine + 0.2, cue.chain + 0.05, smooth);\r\n  const sag = lerp(0.9, 0.35, ramp(t, cue.chain, cue.chain + 0.3, backOut));\r\n  cast.chain.update(sceptreTip, wrist, reveal, sag);\r\n\r\n  lighting(t, { aria: ariaWorld, barnaby: barnWorld, king: kingWorld });\r\n  camera(t, cam);\r\n  void scratch;\r\n}\r\n",
      "lib/song.ts": "// Generated from assets/audio/One More Dawn - Disney Tones.timing.json\r\n// (lyric-aligned word timings) and the decoded song's loudness.\r\n// Times are seconds from the start of the song.\r\n\r\nexport const CLIP_END = 72.5;\r\n\r\n// [start, end] per sung line.\r\nexport const INTRO_LINES: readonly (readonly [number, number])[] = [[3.57, 5.92], [7.34, 9.94], [11.52, 14.08], [15.36, 18.8], [19.66, 22.36], [23.65, 27.94], [27.94, 31.14], [32.94, 40.36]];\r\nexport const VERSE1_LINES: readonly (readonly [number, number])[] = [[44.48, 47.3], [48.23, 50.7], [51.42, 54.1], [54.76, 57.02], [57.68, 60.4], [61.04, 63.46], [64.42, 67.32], [67.66, 70.64]];\r\n\r\n// [start, end] per sung word: soprano intro, then baritone verse.\r\nexport const SOPRANO_WORDS: readonly (readonly [number, number])[] = [[3.57, 3.82], [3.82, 4.24], [4.24, 4.9], [4.9, 5.92], [7.34, 8.18], [8.18, 8.56], [8.56, 8.94], [8.94, 9.94], [11.52, 11.78], [11.78, 12.04], [12.04, 12.32], [12.32, 12.62], [12.62, 13.0], [13.0, 14.08], [15.36, 15.72], [15.72, 16.04], [16.04, 16.78], [16.78, 17.32], [17.32, 18.8], [19.66, 19.92], [19.92, 20.48], [20.48, 20.78], [20.78, 21.28], [21.28, 22.36], [23.65, 23.9], [23.9, 24.46], [24.46, 25.08], [25.08, 26.26], [26.26, 27.94], [27.94, 28.16], [28.16, 28.58], [28.58, 29.0], [29.0, 29.7], [29.7, 30.12], [30.12, 31.14], [32.94, 33.28], [33.28, 33.8], [33.8, 34.36], [34.76, 35.38], [35.38, 35.94], [36.62, 37.28], [37.5, 38.7], [38.7, 40.36]];\r\nexport const BARITONE_WORDS: readonly (readonly [number, number])[] = [[44.48, 45.22], [45.22, 45.5], [45.5, 45.84], [45.84, 46.26], [46.26, 46.62], [46.62, 47.3], [48.23, 48.48], [48.48, 48.9], [49.08, 49.36], [49.36, 49.76], [50.1, 50.2], [50.2, 50.7], [51.42, 51.68], [51.68, 52.24], [52.24, 52.88], [52.88, 53.32], [53.32, 54.1], [54.76, 54.94], [55.2, 55.7], [55.7, 56.12], [56.12, 56.52], [56.52, 57.02], [57.68, 57.76], [57.76, 57.98], [57.98, 58.32], [58.32, 58.86], [58.86, 59.26], [59.26, 59.54], [59.54, 60.4], [61.04, 61.32], [61.32, 61.72], [61.72, 62.22], [62.22, 62.46], [62.46, 62.88], [62.88, 63.46], [64.42, 64.74], [64.74, 65.02], [65.02, 65.52], [65.52, 65.9], [65.9, 66.38], [66.38, 66.78], [66.78, 67.32], [67.66, 67.98], [67.98, 68.46], [68.46, 68.9], [68.9, 69.5], [69.5, 70.64]];\r\n\r\n// Mix loudness, 10 samples per second, 0..1.\r\nexport const LEVEL: readonly number[] = [0.0, 0.01, 0.02, 0.03, 0.03, 0.03, 0.03, 0.02, 0.02, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.03, 0.05, 0.1, 0.16, 0.22, 0.25, 0.23, 0.19, 0.14, 0.08, 0.05, 0.1, 0.16, 0.11, 0.06, 0.08, 0.1, 0.11, 0.09, 0.04, 0.02, 0.02, 0.02, 0.03, 0.04, 0.04, 0.04, 0.03, 0.02, 0.02, 0.02, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.03, 0.08, 0.11, 0.12, 0.11, 0.08, 0.05, 0.03, 0.03, 0.04, 0.06, 0.15, 0.26, 0.32, 0.31, 0.25, 0.16, 0.14, 0.17, 0.16, 0.11, 0.06, 0.05, 0.05, 0.05, 0.05, 0.06, 0.06, 0.05, 0.04, 0.03, 0.03, 0.02, 0.02, 0.02, 0.02, 0.02, 0.02, 0.01, 0.01, 0.01, 0.03, 0.1, 0.22, 0.27, 0.22, 0.19, 0.23, 0.31, 0.3, 0.21, 0.17, 0.24, 0.34, 0.36, 0.35, 0.31, 0.25, 0.22, 0.18, 0.11, 0.09, 0.07, 0.05, 0.04, 0.04, 0.04, 0.03, 0.02, 0.02, 0.02, 0.02, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.07, 0.22, 0.35, 0.38, 0.35, 0.3, 0.27, 0.24, 0.22, 0.23, 0.19, 0.18, 0.17, 0.12, 0.09, 0.14, 0.24, 0.2, 0.12, 0.12, 0.13, 0.12, 0.1, 0.08, 0.06, 0.04, 0.03, 0.03, 0.04, 0.03, 0.04, 0.05, 0.05, 0.05, 0.05, 0.05, 0.05, 0.05, 0.06, 0.05, 0.04, 0.06, 0.13, 0.24, 0.38, 0.43, 0.34, 0.22, 0.19, 0.29, 0.41, 0.41, 0.33, 0.28, 0.27, 0.25, 0.23, 0.18, 0.16, 0.21, 0.23, 0.17, 0.13, 0.12, 0.09, 0.08, 0.09, 0.12, 0.11, 0.1, 0.13, 0.17, 0.18, 0.19, 0.21, 0.25, 0.28, 0.29, 0.26, 0.22, 0.19, 0.2, 0.21, 0.22, 0.27, 0.38, 0.5, 0.52, 0.45, 0.38, 0.33, 0.28, 0.25, 0.25, 0.3, 0.31, 0.26, 0.22, 0.25, 0.34, 0.36, 0.3, 0.23, 0.2, 0.2, 0.22, 0.23, 0.23, 0.24, 0.24, 0.24, 0.24, 0.23, 0.22, 0.22, 0.22, 0.22, 0.22, 0.21, 0.19, 0.19, 0.19, 0.18, 0.2, 0.22, 0.21, 0.21, 0.21, 0.2, 0.2, 0.26, 0.24, 0.13, 0.09, 0.12, 0.14, 0.15, 0.17, 0.17, 0.14, 0.1, 0.08, 0.09, 0.12, 0.11, 0.08, 0.11, 0.16, 0.14, 0.12, 0.09, 0.07, 0.09, 0.13, 0.14, 0.13, 0.12, 0.12, 0.12, 0.12, 0.12, 0.11, 0.11, 0.12, 0.12, 0.11, 0.1, 0.08, 0.07, 0.06, 0.06, 0.06, 0.06, 0.05, 0.05, 0.05, 0.1, 0.18, 0.18, 0.14, 0.14, 0.16, 0.16, 0.14, 0.16, 0.22, 0.24, 0.24, 0.29, 0.31, 0.29, 0.27, 0.28, 0.3, 0.34, 0.39, 0.4, 0.32, 0.19, 0.11, 0.09, 0.1, 0.1, 0.12, 0.13, 0.11, 0.1, 0.11, 0.11, 0.11, 0.11, 0.12, 0.13, 0.13, 0.14, 0.15, 0.16, 0.16, 0.16, 0.13, 0.07, 0.04, 0.05, 0.06, 0.07, 0.07, 0.07, 0.08, 0.09, 0.1, 0.11, 0.13, 0.14, 0.17, 0.2, 0.21, 0.19, 0.18, 0.2, 0.23, 0.22, 0.21, 0.21, 0.22, 0.22, 0.22, 0.21, 0.2, 0.2, 0.2, 0.22, 0.23, 0.22, 0.21, 0.22, 0.23, 0.24, 0.23, 0.24, 0.25, 0.27, 0.27, 0.27, 0.3, 0.42, 0.63, 0.83, 0.92, 0.84, 0.67, 0.55, 0.51, 0.45, 0.39, 0.37, 0.37, 0.37, 0.36, 0.34, 0.32, 0.32, 0.34, 0.35, 0.36, 0.38, 0.39, 0.44, 0.51, 0.53, 0.5, 0.48, 0.47, 0.51, 0.62, 0.71, 0.79, 0.94, 1.0, 0.97, 0.96, 0.94, 0.82, 0.77, 0.69, 0.57, 0.51, 0.46, 0.41, 0.35, 0.31, 0.34, 0.38, 0.38, 0.41, 0.46, 0.37, 0.26, 0.21, 0.17, 0.11, 0.07, 0.06, 0.06, 0.07, 0.1, 0.1, 0.09, 0.1, 0.19, 0.38, 0.47, 0.43, 0.42, 0.38, 0.29, 0.19, 0.19, 0.27, 0.3, 0.34, 0.46, 0.43, 0.31, 0.29, 0.31, 0.39, 0.46, 0.44, 0.37, 0.32, 0.24, 0.15, 0.09, 0.06, 0.07, 0.12, 0.18, 0.18, 0.14, 0.14, 0.2, 0.31, 0.42, 0.47, 0.5, 0.56, 0.52, 0.42, 0.38, 0.45, 0.5, 0.42, 0.35, 0.3, 0.25, 0.35, 0.4, 0.26, 0.3, 0.42, 0.34, 0.28, 0.26, 0.17, 0.16, 0.22, 0.21, 0.15, 0.13, 0.13, 0.12, 0.12, 0.22, 0.42, 0.47, 0.37, 0.45, 0.59, 0.56, 0.48, 0.38, 0.29, 0.25, 0.25, 0.29, 0.33, 0.31, 0.28, 0.23, 0.15, 0.15, 0.21, 0.23, 0.22, 0.19, 0.16, 0.13, 0.11, 0.11, 0.12, 0.14, 0.22, 0.37, 0.43, 0.45, 0.48, 0.38, 0.27, 0.29, 0.39, 0.42, 0.35, 0.39, 0.51, 0.56, 0.53, 0.5, 0.51, 0.62, 0.59, 0.4, 0.37, 0.41, 0.35, 0.26, 0.21, 0.17, 0.15, 0.19, 0.23, 0.24, 0.24, 0.25, 0.27, 0.28, 0.32, 0.52, 0.64, 0.47, 0.36, 0.5, 0.62, 0.51, 0.43, 0.49, 0.43, 0.34, 0.34, 0.48, 0.7, 0.64, 0.4, 0.3, 0.3, 0.38, 0.47, 0.45, 0.39, 0.35, 0.32, 0.29, 0.27, 0.32, 0.32, 0.27, 0.25, 0.28, 0.29, 0.31, 0.33, 0.38, 0.41, 0.33, 0.35, 0.53, 0.49, 0.4, 0.44, 0.44, 0.41, 0.4, 0.4, 0.41, 0.35, 0.25, 0.31, 0.4, 0.43, 0.45, 0.36, 0.41, 0.61, 0.57, 0.44, 0.48, 0.52, 0.44, 0.37, 0.38, 0.38, 0.32, 0.32, 0.47, 0.58, 0.52, 0.52, 0.61, 0.68, 0.68, 0.58, 0.47, 0.46, 0.56, 0.57, 0.41, 0.35, 0.5, 0.6, 0.58, 0.54, 0.54, 0.57, 0.61, 0.61, 0.56, 0.53, 0.52, 0.51, 0.52, 0.59, 0.7, 0.78, 0.83, 0.9, 0.98, 1.0, 0.92, 0.86, 1.0, 1.0, 1.0, 0.69, 0.47, 0.4, 0.41, 0.43, 0.48, 0.45, 0.39, 0.4, 0.48, 0.63, 0.74, 0.6, 0.39, 0.31, 0.26, 0.22, 0.2, 0.21, 0.21, 0.22, 0.23, 0.24, 0.26, 0.43, 0.69, 0.66, 0.55, 0.59, 0.68, 0.78, 0.76, 0.63, 0.6, 0.56, 0.47, 0.45, 0.46, 0.4, 0.34, 0.34, 0.3, 0.25, 0.24, 0.21, 0.19, 0.21, 0.24, 0.29, 0.34, 0.31, 0.28, 0.33, 0.42, 0.43, 0.4, 0.43, 0.56, 0.78, 0.87, 0.84, 0.96, 0.98, 0.76, 0.67, 0.53];\r\n\r\nexport function levelAt(t: number): number {\r\n  const f = Math.max(0, Math.min(LEVEL.length - 1.001, t * 10));\r\n  const i = Math.floor(f);\r\n  return LEVEL[i] + (LEVEL[i + 1] - LEVEL[i]) * (f - i);\r\n}\r\n",
      "lib/stage.ts": "// The theatre: a retro-future proscenium with neon trims and marquee bulbs,\r\n// red velvet curtains, a plank stage with footlights, a robot audience in\r\n// silhouette, and the \"billion doors\" set: tiers of pod doors that open\r\n// to reveal glowing robot eyes, with a far city and starry sky beyond.\r\n\r\nimport {\r\n  AdditiveBlending,\r\n  BackSide,\r\n  Color,\r\n  ConeGeometry,\r\n  CylinderGeometry,\r\n  DoubleSide,\r\n  Group,\r\n  InstancedMesh,\r\n  Mesh,\r\n  MeshBasicNodeMaterial,\r\n  Object3D,\r\n  PlaneGeometry,\r\n  Quaternion,\r\n  SphereGeometry,\r\n  Vector2,\r\n  Vector3,\r\n} from 'three/webgpu';\r\nimport {\r\n  abs,\r\n  atan,\r\n  clamp,\r\n  cos,\r\n  dot,\r\n  float,\r\n  floor,\r\n  fract,\r\n  fwidth,\r\n  hash,\r\n  instanceIndex,\r\n  length,\r\n  max,\r\n  min,\r\n  mix,\r\n  normalize,\r\n  normalView,\r\n  positionLocal,\r\n  positionView,\r\n  positionWorld,\r\n  pow,\r\n  sin,\r\n  smoothstep,\r\n  step,\r\n  uv,\r\n  vec2,\r\n  vec3,\r\n  vec4,\r\n} from 'three/tsl';\r\nimport { ball, blob, lathe, ring, rod } from './shapes.ts';\r\nimport { glow, inked, light, place, spotLightAt, spotPool, toon, u } from './toon.ts';\r\n\r\n// Shader graph values are composed freely; TSL node typings are too narrow here.\r\ntype Node = any;\r\n\r\nexport const set = {\r\n  now: u(0),\r\n  houseLevel: u(1),\r\n  footLevel: u(0),\r\n  marqueeLevel: u(0),\r\n  marqueeChase: u(0),\r\n  neonLevel: u(0),\r\n  curtainOpen: 0,\r\n  curtainPin: u(0),\r\n  pedestalDrop: 0,\r\n  wallWakeAt: u(1000),\r\n  wallLevel: u(1),\r\n  wallInterior: u(new Color(0.55, 0.85, 1.0)),\r\n  wallEyes: u(new Color(0.75, 1.0, 1.0)),\r\n  wallBlinkSync: u(0),\r\n  wallLook: u(new Vector2(0, 0)),\r\n  wallEyeLevel: u(1),\r\n  starLevel: u(0.3),\r\n  dreamStar: u(0),\r\n  skyTop: u(new Color(0.01, 0.01, 0.04)),\r\n  skyHorizon: u(new Color(0.08, 0.04, 0.16)),\r\n  hazeLevel: u(0.6),\r\n};\r\n\r\nfunction band3(x: Node): Node {\r\n  return smoothstep(-0.05, 0.05, x).mul(0.55).add(smoothstep(0.55, 0.62, x).mul(0.45));\r\n}\r\n\r\n// Rounded-box signed distance in 2D.\r\nfunction roundBox(p: Node, b: Node, r: number): Node {\r\n  const q: Node = abs(p).sub(b).add(r);\r\n  return length(max(q, 0)).add(min(max(q.x, q.y), 0)).sub(r);\r\n}\r\n\r\nfunction floorMaterial(): MeshBasicNodeMaterial {\r\n  const material = new MeshBasicNodeMaterial();\r\n  const plankCoord = positionWorld.x.div(0.46);\r\n  const plank = floor(plankCoord);\r\n  const along = fract(plankCoord);\r\n  const seam = smoothstep(0.0, 0.05, along).mul(smoothstep(1.0, 0.95, along));\r\n  const tone = hash(plank.add(500)).mul(0.25).add(0.85);\r\n  const grain = sin(positionWorld.z.mul(3.1).add(hash(plank).mul(20))).mul(0.04).add(1);\r\n  const wood = vec3(0.32, 0.17, 0.1).mul(tone).mul(grain).mul(seam.mul(0.6).add(0.4));\r\n  let pools: Node = vec3(0, 0, 0);\r\n  for (const spot of light.spots) {\r\n    pools = pools.add(spot.color.mul(spotPool(spot)));\r\n  }\r\n  const front = smoothstep(0.2, 3.6, positionWorld.z).mul(set.footLevel);\r\n  const foot = vec3(1.0, 0.62, 0.3).mul(front).mul(0.9);\r\n  const lit = light.fill.mul(1.4).add(light.key.mul(0.3)).add(pools.mul(1.15)).add(foot);\r\n  // Glossy streak reflecting the spot pools gives a polished stage.\r\n  const color = wood.mul(lit).add(pools.mul(0.06));\r\n  material.colorNode = vec4(color, 1);\r\n  return material;\r\n}\r\n\r\nfunction curtainMaterial(folds: number, fringe: boolean): MeshBasicNodeMaterial {\r\n  const material = new MeshBasicNodeMaterial({ side: DoubleSide });\r\n  const phase = positionLocal.x.mul(folds);\r\n  material.positionNode = positionLocal.add(vec3(0, 0, sin(phase).mul(0.09)));\r\n  const shade = cos(phase).mul(0.5).add(0.5);\r\n  const tone = band3(shade.sub(0.35));\r\n  const velvet = mix(vec3(0.2, 0.012, 0.03), vec3(0.62, 0.05, 0.1), tone);\r\n  const sheen = smoothstep(0.93, 0.97, shade).mul(vec3(0.5, 0.1, 0.14));\r\n  const v = uv().y;\r\n  const vertical = smoothstep(0.0, 0.25, v).mul(0.35).add(0.65);\r\n  let color: Node = velvet.add(sheen).mul(vertical).mul(light.fill.mul(2.2).add(light.key.mul(0.55)).add(set.footLevel.mul(vec3(0.5, 0.3, 0.2))));\r\n  if (fringe) {\r\n    const gold = smoothstep(0.035, 0.03, v).mul(step(0.5, fract(positionLocal.x.mul(14))).mul(0.4).add(0.6));\r\n    color = mix(color, vec3(0.75, 0.52, 0.18).mul(light.fill.mul(2).add(light.key.mul(0.6)).add(set.footLevel.mul(0.5))), gold);\r\n  }\r\n  // Pre-show pin spot on the closed curtain.\r\n  const pin = smoothstep(1.55, 0.95, length(positionWorld.xy.sub(vec2(0, 2.3)))).mul(set.curtainPin);\r\n  color = color.add(velvet.mul(1.1).add(sheen).add(vec3(0.16, 0.11, 0.08)).mul(pin));\r\n  material.colorNode = vec4(color, 1);\r\n  return material;\r\n}\r\n\r\ninterface DoorWallSpec {\r\n  cols: number;\r\n  rows: number;\r\n  delay: number;\r\n  spread: number;\r\n  dim: number;\r\n  center: [number, number];\r\n}\r\n\r\nfunction doorWallMaterial(spec: DoorWallSpec, side: typeof DoubleSide | typeof BackSide = DoubleSide): MeshBasicNodeMaterial {\r\n  const material = new MeshBasicNodeMaterial({ side });\r\n  const st = uv().mul(vec2(spec.cols, spec.rows));\r\n  const cell = floor(st);\r\n  const f = fract(st);\r\n  const h = hash(cell.x.add(cell.y.mul(1013)).add(spec.cols * 7));\r\n  const dist = length(cell.sub(vec2(spec.center[0], spec.center[1])).mul(vec2(1, 1.7)));\r\n  const wake = set.wallWakeAt.add(spec.delay).add(dist.mul(spec.spread)).add(h.mul(0.6));\r\n  const open = smoothstep(wake, wake.add(0.55), set.now);\r\n  const p = f.sub(vec2(0.5, 0.47));\r\n  const d = roundBox(p, vec2(0.3, 0.38), 0.16);\r\n  const aa = fwidth(d).mul(1.2);\r\n  const inside = smoothstep(aa, aa.negate(), d);\r\n  const frame = smoothstep(aa, aa.negate(), d.sub(0.05)).sub(inside);\r\n  // Split doors slide apart to reveal the interior.\r\n  const revealed = smoothstep(open.mul(0.32).add(0.004), open.mul(0.32).sub(0.004), abs(p.x)).mul(inside);\r\n  const blinkPhase = mix(h, float(0), set.wallBlinkSync);\r\n  const blink = smoothstep(0.0, 0.03, abs(fract(set.now.mul(0.23).add(blinkPhase)).sub(0.5)));\r\n  const eyeP = vec2(abs(p.x).sub(0.1), p.y.sub(0.04).div(blink.mul(0.85).add(0.15)));\r\n  const eyes = smoothstep(0.075, 0.06, length(eyeP.mul(vec2(1.25, 1)))).mul(revealed);\r\n  const pupilP = vec2(abs(p.x.sub(set.wallLook.x.mul(0.03))).sub(0.1), p.y.sub(0.04).sub(set.wallLook.y.mul(0.03)));\r\n  const pupil = smoothstep(0.032, 0.022, length(pupilP)).mul(eyes);\r\n  const ledge = smoothstep(0.05, 0.03, f.y);\r\n  const panelLine = smoothstep(0.012, 0.0, abs(f.x.sub(0.5)).sub(0.0)).mul(inside).mul(float(1).sub(revealed));\r\n  const wall = mix(vec3(0.07, 0.06, 0.13), vec3(0.03, 0.025, 0.06), ledge);\r\n  const frameColor = vec3(0.35, 0.33, 0.5);\r\n  const panel = vec3(0.11, 0.12, 0.2).sub(panelLine.mul(0.08));\r\n  const led = smoothstep(0.02, 0.012, length(p.sub(vec2(0.21, 0.3)))).mul(inside).mul(float(1).sub(open));\r\n  const interiorGrad = smoothstep(-0.4, 0.4, p.y).mul(0.5).add(0.5);\r\n  const interior = set.wallInterior.mul(interiorGrad).mul(set.wallLevel).mul(h.mul(0.5).add(0.5));\r\n  const lightAmt = light.fill.mul(1.6).add(light.key.mul(0.1));\r\n  let color: Node = wall.mul(lightAmt).mul(float(1).sub(inside).sub(frame));\r\n  color = color.add(frameColor.mul(lightAmt).mul(frame));\r\n  color = color.add(mix(panel.mul(lightAmt), interior, revealed).mul(inside));\r\n  color = color.add(vec3(1.0, 0.25, 0.3).mul(led).mul(0.6));\r\n  color = mix(color, set.wallEyes.mul(set.wallEyeLevel).mul(1.4), eyes.mul(set.wallEyeLevel.min(1)));\r\n  color = mix(color, vec3(0.02, 0.02, 0.05), pupil.mul(set.wallEyeLevel.min(1)));\r\n  material.colorNode = vec4(color.mul(spec.dim), 1);\r\n  return material;\r\n}\r\n\r\nfunction skyMaterial(): MeshBasicNodeMaterial {\r\n  const material = new MeshBasicNodeMaterial({ side: BackSide, depthWrite: false });\r\n  const dir = normalize(positionLocal);\r\n  const elev = clamp(dir.y, -0.2, 1);\r\n  let color: Node = mix(set.skyHorizon, set.skyTop, smoothstep(0.0, 0.45, elev));\r\n  // Stars in a lat-long grid.\r\n  const st = vec2(atan(dir.z, dir.x).mul(70), dir.y.mul(110));\r\n  const cell = floor(st);\r\n  const h = hash(cell.x.add(cell.y.mul(733)).add(91));\r\n  const sp = fract(st).sub(vec2(hash(cell.x.add(cell.y.mul(733)).add(7)), hash(cell.x.add(cell.y.mul(733)).add(13))).mul(0.6).add(0.2));\r\n  const twinkle = sin(set.now.mul(h.mul(3).add(1)).add(h.mul(40))).mul(0.35).add(0.65);\r\n  const star = smoothstep(0.09, 0.0, length(sp)).mul(step(0.86, h)).mul(twinkle).mul(set.starLevel);\r\n  color = color.add(vec3(0.85, 0.9, 1.0).mul(star).mul(smoothstep(0.02, 0.15, elev)));\r\n  // Ringed planet.\r\n  const planetDir = normalize(vec3(0.42, 0.2, -1));\r\n  const pd = dot(dir, planetDir);\r\n  const planet = smoothstep(0.9965, 0.9969, pd);\r\n  const pshade = dot(dir.sub(planetDir), normalize(vec3(-1, 0.6, 0))).mul(18).add(0.5);\r\n  const planetColor = mix(vec3(0.5, 0.22, 0.42), vec3(1.0, 0.62, 0.55), smoothstep(0.3, 0.45, pshade));\r\n  const rp = dir.sub(planetDir);\r\n  const ringD = abs(length(vec2(rp.x.add(rp.y.mul(0.6)), rp.y.mul(4.2))).sub(0.12));\r\n  const ringMask = smoothstep(0.012, 0.006, ringD).mul(float(1).sub(planet.mul(step(0.0, rp.y))));\r\n  color = mix(color, planetColor, planet);\r\n  color = mix(color, vec3(0.95, 0.78, 0.55), ringMask.mul(0.85));\r\n  // The \"dream\" star the soprano reaches for.\r\n  const dreamDir = normalize(vec3(0.16, 0.42, -1));\r\n  const dd = float(1).sub(dot(dir, dreamDir)).mul(9000);\r\n  const core = float(1).div(dd.add(1)).mul(set.dreamStar);\r\n  const rays = pow(clamp(float(1).sub(abs(dir.sub(dreamDir).x.mul(dir.sub(dreamDir).y).mul(9000))), 0, 1), 6).mul(smoothstep(0.004, 0.0, length(dir.sub(dreamDir)).mul(0.1))).mul(set.dreamStar);\r\n  color = color.add(vec3(1.0, 0.92, 0.75).mul(core.mul(3).add(rays)));\r\n  material.colorNode = vec4(color, 1);\r\n  return material;\r\n}\r\n\r\nfunction beamMaterial(spot: (typeof light.spots)[number]): MeshBasicNodeMaterial {\r\n  const material = new MeshBasicNodeMaterial({\r\n    transparent: true,\r\n    depthWrite: false,\r\n    blending: AdditiveBlending,\r\n    side: DoubleSide,\r\n  });\r\n  const v = normalize(positionView.negate());\r\n  const edge = pow(abs(dot(normalize(normalView), v)), 2.2);\r\n  const along = uv().y;\r\n  const fade = smoothstep(0.0, 0.25, along).mul(smoothstep(1.0, 0.75, along).mul(0.6).add(0.4));\r\n  const amount = edge.mul(fade).mul(spot.shape.w).mul(set.hazeLevel).mul(0.16);\r\n  material.colorNode = vec4(spot.color.mul(amount), 1);\r\n  return material;\r\n}\r\n\r\n// Soft contact shadow decal laid on the floor under a performer.\r\nexport function contactShadow(width: number, depth: number): Mesh {\r\n  const material = new MeshBasicNodeMaterial({ transparent: true, depthWrite: false });\r\n  const d = length(uv().sub(0.5).mul(2));\r\n  const alpha = smoothstep(1.0, 0.25, d).mul(0.55);\r\n  material.colorNode = vec4(0.02, 0.0, 0.03, alpha);\r\n  const mesh = new Mesh(new PlaneGeometry(width, depth), material);\r\n  mesh.rotation.x = -Math.PI / 2;\r\n  mesh.renderOrder = 1;\r\n  return mesh;\r\n}\r\n\r\nexport interface Stage {\r\n  root: Group;\r\n  curtainL: Mesh;\r\n  curtainR: Mesh;\r\n  pedestal: Group;\r\n  beams: Mesh[];\r\n  cars: Object3D[];\r\n  lift: Group;\r\n  update(t: number): void;\r\n  dispose(): void;\r\n}\r\n\r\nexport function buildStage(): Stage {\r\n  const root = new Group();\r\n  const disposables: { dispose(): void }[] = [];\r\n  const keep = <T extends { dispose(): void }>(x: T): T => {\r\n    disposables.push(x);\r\n    return x;\r\n  };\r\n\r\n  // Sky and far city.\r\n  const sky = new Mesh(keep(new SphereGeometry(80, 48, 24)), skyMaterial());\r\n  sky.renderOrder = -10;\r\n  root.add(sky);\r\n  const farGeometry = keep(new CylinderGeometry(30, 30, 10.5, 96, 1, true, Math.PI * 0.62, Math.PI * 0.76));\r\n  const far = new Mesh(farGeometry, doorWallMaterial({ cols: 150, rows: 16, delay: 2.4, spread: 0.035, dim: 0.55, center: [75, 4] }, BackSide));\r\n  far.position.set(0, 2.4, 10);\r\n  root.add(far);\r\n\r\n  // Near tier of doors behind the stage.\r\n  const wallGeometry = keep(new PlaneGeometry(30, 5.6));\r\n  const wall = new Mesh(wallGeometry, doorWallMaterial({ cols: 34, rows: 6, delay: 0, spread: 0.11, dim: 1, center: [17, 1.5] }));\r\n  wall.position.set(0, 2.8, -6.6);\r\n  root.add(wall);\r\n  const wallCap = inked(blob(30, 0.22, 0.4, 4), toon(0x2a2440, { glint: 0.6 }));\r\n  place(wallCap, root, 0, 5.65, -6.5);\r\n\r\n  // Stage floor, apron and footlights.\r\n  const floorGeometry = keep(new PlaneGeometry(24, 10.4));\r\n  const floorMesh = new Mesh(floorGeometry, floorMaterial());\r\n  floorMesh.rotation.x = -Math.PI / 2;\r\n  floorMesh.position.set(0, 0, -1.6);\r\n  root.add(floorMesh);\r\n  const apron = inked(blob(17, 1.5, 0.5, 6), toon(0x3a0d1a, { glint: 0.2 }));\r\n  place(apron, root, 0, -0.76, 3.5);\r\n  const trim = inked(blob(17.2, 0.12, 0.62, 6), toon(0xd7a440, { glint: 1.4 }));\r\n  place(trim, root, 0, -0.02, 3.5);\r\n  const bulbMaterial = glow(0xffd28a, 0);\r\n  for (let i = 0; i < 25; i += 1) {\r\n    const x = -7.2 + i * 0.6;\r\n    place(inked(lathe('foot-hood', [[0, 0.0], [0.13, 0.0], [0.12, 0.08], [0.0, 0.1]]), toon(0x2a2632, { glint: 0.8 })), root, x, 0.0, 3.62, -0.4);\r\n    place(new Mesh(ball(0.05, 10), bulbMaterial), root, x, 0.05, 3.66);\r\n  }\r\n\r\n  // Robot audience silhouettes in the stalls.\r\n  const headGeometry = blob(0.5, 0.46, 0.42, 2.6);\r\n  const audience = new InstancedMesh(headGeometry, toon(0x0c0a14, { glint: 0, rim: 1.4 }), 46);\r\n  const shoulderGeometry = blob(0.9, 0.5, 0.5, 2.8);\r\n  const shoulders = new InstancedMesh(shoulderGeometry, toon(0x09070f, { glint: 0, rim: 1.0 }), 46);\r\n  const holder = new Object3D();\r\n  let n = 0;\r\n  for (let row = 0; row < 2; row += 1) {\r\n    for (let i = 0; i < 23; i += 1) {\r\n      const x = -9.9 + i * 0.9 + (row ? 0.45 : 0) + (Math.sin(i * 12.9 + row * 3) * 0.08);\r\n      const z = 5.4 + row * 1.25;\r\n      const y = -0.95 + row * 0.38 + Math.sin(i * 7.7) * 0.05;\r\n      const s = 0.9 + 0.15 * Math.sin(i * 3.3 + row);\r\n      holder.position.set(x, y + 0.3, z);\r\n      holder.rotation.set(0, Math.sin(i * 1.7) * 0.2, Math.sin(i * 5.1) * 0.08);\r\n      holder.scale.setScalar(s);\r\n      holder.updateMatrix();\r\n      audience.setMatrixAt(n, holder.matrix);\r\n      holder.position.set(x, y - 0.12, z + 0.08);\r\n      holder.rotation.set(0, 0, 0);\r\n      holder.updateMatrix();\r\n      shoulders.setMatrixAt(n, holder.matrix);\r\n      n += 1;\r\n    }\r\n  }\r\n  root.add(audience, shoulders);\r\n  const antennaTips = new InstancedMesh(ball(0.05, 8), glow(0xff5a8a, 0.45), 12);\r\n  for (let i = 0; i < 12; i += 1) {\r\n    const k = (i * 7) % 46;\r\n    const m = new Object3D();\r\n    const row = k >= 23 ? 1 : 0;\r\n    const j = k % 23;\r\n    m.position.set(-9.9 + j * 0.9 + (row ? 0.45 : 0) + Math.sin(j * 12.9 + row * 3) * 0.08, -0.95 + row * 0.38 + Math.sin(j * 7.7) * 0.05 + 0.75, 5.4 + row * 1.25);\r\n    m.updateMatrix();\r\n    antennaTips.setMatrixAt(i, m.matrix);\r\n  }\r\n  root.add(antennaTips);\r\n\r\n  // Proscenium: deco pillars, header with a ringed-planet crest.\r\n  const deco = toon(0x173e4c, { glint: 0.7 });\r\n  const gold = toon(0xdcaa45, { glint: 1.5 });\r\n  const neonCyan = glow(0x5ff2ff, 0);\r\n  const neonPink = glow(0xff5fc8, 0);\r\n  for (const side of [-1, 1]) {\r\n    const pillar = new Group();\r\n    pillar.position.set(side * 7.6, 0, 3.8);\r\n    root.add(pillar);\r\n    place(inked(blob(1.3, 7.6, 1.0, 5), deco), pillar, 0, 3.4, 0);\r\n    for (let i = 0; i < 4; i += 1) {\r\n      place(inked(blob(1.5 - i * 0.04, 0.16, 1.15, 5), gold), pillar, 0, 0.4 + i * 1.75, 0);\r\n    }\r\n    place(inked(blob(1.7, 0.5, 1.3, 5), gold), pillar, 0, 0.0, 0);\r\n    place(new Mesh(rod(0.035, 0.035, 6.4), neonCyan), pillar, -side * 0.3, 3.6, 0.52);\r\n    place(new Mesh(rod(0.025, 0.025, 6.4), neonPink), pillar, -side * 0.12, 3.6, 0.52);\r\n  }\r\n  // Dark house walls either side of the proscenium.\r\n  for (const side of [-1, 1]) {\r\n    place(inked(blob(12, 14, 0.6, 8), toon(0x120c1c, { glint: 0, rim: 0.4 })), root, side * 14.2, 4.5, 4.1);\r\n  }\r\n  const header = new Group();\r\n  header.position.set(0, 6.75, 3.8);\r\n  root.add(header);\r\n  place(inked(blob(16.6, 1.5, 1.0, 6), deco), header, 0, 0.1, 0);\r\n  place(inked(blob(16.8, 0.14, 1.12, 6), gold), header, 0, -0.62, 0);\r\n  place(new Mesh(rod(0.03, 0.03, 15.2), neonCyan), header, 0, -0.38, 0.5, 0, 0, Math.PI / 2);\r\n  const crest = place(new Group(), header, 0, 0.15, 0.55);\r\n  place(inked(ball(0.5, 28), gold), crest, 0, 0, 0);\r\n  place(inked(ring(0.85, 0.06), toon(0xf2d27a, { glint: 1.6 })), crest, 0, 0, 0, Math.PI / 2 - 0.35, 0, 0.25);\r\n  place(new Mesh(ring(1.15, 0.03), neonPink), crest, 0, 0, -0.05);\r\n\r\n  // Marquee bulbs along the header and pillars, with a chase.\r\n  const marqueeMat = new MeshBasicNodeMaterial();\r\n  const idx = instanceIndex.toFloat();\r\n  const chase = step(0.55, fract(idx.div(3).add(set.marqueeChase)));\r\n  marqueeMat.colorNode = vec4(vec3(1.0, 0.8, 0.45).mul(chase.mul(0.75).add(0.25)).mul(set.marqueeLevel).add(vec3(0.08, 0.06, 0.04)), 1);\r\n  const marqueePositions: Vector3[] = [];\r\n  for (let i = 0; i < 31; i += 1) {\r\n    marqueePositions.push(new Vector3(-7.5 + i * 0.5, 6.35, 4.35));\r\n  }\r\n  for (const side of [-1, 1]) {\r\n    for (let i = 0; i < 12; i += 1) {\r\n      marqueePositions.push(new Vector3(side * 6.85, 0.6 + i * 0.5, 4.35));\r\n    }\r\n  }\r\n  const marquee = new InstancedMesh(ball(0.065, 10), marqueeMat, marqueePositions.length);\r\n  marqueePositions.forEach((p, i) => {\r\n    holder.position.copy(p);\r\n    holder.rotation.set(0, 0, 0);\r\n    holder.scale.setScalar(1);\r\n    holder.updateMatrix();\r\n    marquee.setMatrixAt(i, holder.matrix);\r\n  });\r\n  root.add(marquee);\r\n\r\n  // Curtains: tied-back legs, a scalloped valance and the main traveller.\r\n  const legGeometry = keep(new PlaneGeometry(1.6, 6.4, 48, 1));\r\n  for (const side of [-1, 1]) {\r\n    const leg = new Mesh(legGeometry, curtainMaterial(18, true));\r\n    leg.position.set(side * 6.4, 3.2, 3.45);\r\n    root.add(leg);\r\n    const tie = inked(ring(0.32, 0.05), gold);\r\n    place(tie, root, side * 6.35, 2.2, 3.6, Math.PI / 2, 0, 0);\r\n  }\r\n  const valanceGeometry = keep(new PlaneGeometry(13.6, 1.3, 160, 1));\r\n  const valanceMat = curtainMaterial(9, false);\r\n  const scallop = abs(sin(positionLocal.x.mul(1.15)));\r\n  valanceMat.opacityNode = step(float(-0.55).add(scallop.mul(0.38)), positionLocal.y);\r\n  valanceMat.alphaTest = 0.5;\r\n  const valance = new Mesh(valanceGeometry, valanceMat);\r\n  valance.position.set(0, 5.85, 3.55);\r\n  root.add(valance);\r\n  const travellerGeometry = keep(new PlaneGeometry(7.0, 6.3, 120, 1));\r\n  const curtainL = new Mesh(travellerGeometry, curtainMaterial(11, true));\r\n  const curtainR = new Mesh(travellerGeometry, curtainMaterial(11, true));\r\n  curtainL.position.set(-3.5, 3.15, 3.25);\r\n  curtainR.position.set(3.5, 3.15, 3.25);\r\n  root.add(curtainL, curtainR);\r\n\r\n  // Soprano's pedestal (centre) and the trap lift for the throne.\r\n  const pedestal = new Group();\r\n  pedestal.position.set(0, 0, -1.0);\r\n  root.add(pedestal);\r\n  place(inked(lathe('pedestal', [[0, 0.32], [0.62, 0.32], [0.7, 0.26], [0.66, 0.06], [0.78, 0.0], [0, 0]], 48), toon(0xe9e4f4, { glint: 1.0 })), pedestal, 0, 0, 0);\r\n  place(new Mesh(ring(0.66, 0.025), glow(0x8fe8ff, 0.8)), pedestal, 0, 0.26, 0, Math.PI / 2);\r\n  const lift = new Group();\r\n  lift.position.set(0, 0, -4.4);\r\n  root.add(lift);\r\n\r\n  // Light beams.\r\n  const beamGeometry = keep(new ConeGeometry(1, 1, 40, 1, true));\r\n  beamGeometry.translate(0, -0.5, 0);\r\n  const beams = light.spots.map(spot => {\r\n    const beam = new Mesh(beamGeometry, beamMaterial(spot));\r\n    beam.frustumCulled = false;\r\n    beam.renderOrder = 10;\r\n    root.add(beam);\r\n    return beam;\r\n  });\r\n\r\n  // Hover-cars drifting across the far city.\r\n  const cars: Object3D[] = [];\r\n  const carColors = [0xff6a9a, 0x6af0ff, 0xffd86a];\r\n  for (let i = 0; i < 3; i += 1) {\r\n    const car = new Group();\r\n    place(inked(blob(0.9, 0.26, 0.4, 2.2), toon(0xd6d9ea, { glint: 1.2 })), car, 0, 0, 0);\r\n    place(new Mesh(blob(0.42, 0.18, 0.3, 2), toon(0x8fd8ff, { glint: 1.5 })), car, 0.05, 0.14, 0);\r\n    place(new Mesh(ball(0.07, 8), glow(carColors[i], 1.5)), car, -0.48, 0, 0);\r\n    root.add(car);\r\n    cars.push(car);\r\n  }\r\n\r\n  const lampUp = new Vector3(0, -1, 0);\r\n  const q = new Quaternion();\r\n  const lamp = new Vector3();\r\n  const pool = new Vector3();\r\n  const dir = new Vector3();\r\n  const neonLevelMaterials = [neonCyan, neonPink];\r\n\r\n  return {\r\n    root,\r\n    curtainL,\r\n    curtainR,\r\n    pedestal,\r\n    beams,\r\n    cars,\r\n    lift,\r\n    update(t: number) {\r\n      set.now.value = t;\r\n      pedestal.position.y = -set.pedestalDrop * 0.45;\r\n      pedestal.visible = set.pedestalDrop < 0.999;\r\n      const open = set.curtainOpen;\r\n      const shift = open * 6.0;\r\n      const gather = 1 - open * 0.62;\r\n      curtainL.position.x = -3.5 - shift - (1 - gather) * 0.0;\r\n      curtainR.position.x = 3.5 + shift;\r\n      curtainL.scale.x = gather;\r\n      curtainR.scale.x = gather;\r\n      curtainL.position.x = -(gather * 3.5) - shift * 0.95;\r\n      curtainR.position.x = gather * 3.5 + shift * 0.95;\r\n      bulbMaterial.userData.level.value = set.footLevel.value * 1.6;\r\n      for (const m of neonLevelMaterials) {\r\n        m.userData.level.value = set.neonLevel.value;\r\n      }\r\n      light.spots.forEach((spot, i) => {\r\n        const beam = beams[i];\r\n        const s = spot.shape.value;\r\n        beam.visible = s.w > 0.01 && !(i === 4 && set.curtainPin.value > 0.01);\r\n        if (!beam.visible) {\r\n          return;\r\n        }\r\n        pool.set(s.x, 0, s.y);\r\n        lamp.set(s.x * 0.75, spot.height.value, s.y + 2.2);\r\n        dir.copy(pool).sub(lamp);\r\n        const len = dir.length();\r\n        dir.normalize();\r\n        q.setFromUnitVectors(lampUp, dir);\r\n        beam.position.copy(lamp);\r\n        beam.quaternion.copy(q);\r\n        beam.scale.set(s.z * 0.92, len, s.z * 0.92);\r\n      });\r\n      cars.forEach((car, i) => {\r\n        const speed = 0.35 + i * 0.12;\r\n        const u = ((t * speed * 0.08 + i * 0.37) % 1) * 2 - 1;\r\n        const dirSign = i % 2 ? -1 : 1;\r\n        car.position.set(u * 26 * dirSign, 6.6 + i * 0.7 + Math.sin(t * 0.8 + i) * 0.08, -15 - i * 1.5);\r\n        car.rotation.y = dirSign > 0 ? Math.PI : 0;\r\n        car.rotation.z = Math.sin(t * 1.3 + i) * 0.05;\r\n      });\r\n    },\r\n    dispose() {\r\n      for (const d of disposables) {\r\n        d.dispose();\r\n      }\r\n    },\r\n  };\r\n}\r\n\r\nexport { spotLightAt };\r\n",
      "lib/time.ts": "// Small animation helpers shared by the stage, cast and camera.\n\nexport type Ease = (u: number) => number;\n\nexport const clamp01 = (v: number): number => Math.min(1, Math.max(0, v));\n\nexport const lerp = (a: number, b: number, u: number): number => a + (b - a) * u;\n\nexport const smooth: Ease = u => u * u * (3 - 2 * u);\n\nexport const smoother: Ease = u => u * u * u * (u * (u * 6 - 15) + 10);\n\nexport const easeOut: Ease = u => 1 - (1 - u) * (1 - u) * (1 - u);\n\nexport const easeIn: Ease = u => u * u * u;\n\n// Overshoots slightly and settles, for cartoon \"snap\" into a pose.\nexport const backOut: Ease = u => {\n  const c = 1.70158;\n  const v = u - 1;\n  return 1 + (c + 1) * v * v * v + c * v * v;\n};\n\n// Normalised progress of t through [a, b], eased.\nexport function ramp(t: number, a: number, b: number, ease: Ease = smooth): number {\n  if (b <= a) {\n    return t >= b ? 1 : 0;\n  }\n  return ease(clamp01((t - a) / (b - a)));\n}\n\n// Fades up over [a, a + inT] and down over [b - outT, b].\nexport function span(t: number, a: number, b: number, inT = 0.5, outT = 0.5): number {\n  return ramp(t, a, a + inT) * (1 - ramp(t, b - outT, b));\n}\n\nexport type Key = readonly [number, number];\n\n// Piecewise eased interpolation through [time, value] keys.\nexport function keys(t: number, list: readonly Key[], ease: Ease = smoother): number {\n  if (t <= list[0][0]) {\n    return list[0][1];\n  }\n  for (let i = 1; i < list.length; i += 1) {\n    const [t1, v1] = list[i];\n    if (t <= t1) {\n      const [t0, v0] = list[i - 1];\n      return lerp(v0, v1, ease(clamp01((t - t0) / Math.max(1e-6, t1 - t0))));\n    }\n  }\n  return list[list.length - 1][1];\n}\n\n// Deterministic pseudo-random value in [0, 1) for an integer seed.\nexport function hash1(n: number): number {\n  const s = Math.sin(n * 127.1 + 311.7) * 43758.5453;\n  return s - Math.floor(s);\n}\n\n// Smooth 1D value noise in [-1, 1].\nexport function noise1(x: number, seed = 0): number {\n  const i = Math.floor(x);\n  const f = x - i;\n  const a = hash1(i + seed * 57.0);\n  const b = hash1(i + 1 + seed * 57.0);\n  return (lerp(a, b, smooth(f)) - 0.5) * 2;\n}\n",
      "lib/toon.ts": "// Cel-shaded \"cartoon\" look: three-tone banded key light, theatrical spot\n// pools, crisp metal glints, a back rim and inverted-hull ink outlines.\n// Every material reads the same stage-lighting uniforms so the cue sheet in\n// show.ts can relight the whole set at once.\n\nimport {\n  BackSide,\n  BufferAttribute,\n  BufferGeometry,\n  Color,\n  Mesh,\n  MeshBasicNodeMaterial,\n  Object3D,\n  Vector2,\n  Vector3,\n  Vector4,\n} from 'three/webgpu';\nimport {\n  attribute,\n  cameraPosition,\n  clamp,\n  dot,\n  float,\n  length,\n  max,\n  normalize,\n  normalWorld,\n  positionLocal,\n  positionWorld,\n  reflect,\n  smoothstep,\n  uniform,\n  vec3,\n  vec4,\n} from 'three/tsl';\n\n// Shader graph values are composed freely; TSL node typings are too narrow here.\ntype Node = any;\n\n// Uniform with a loosely typed node so colours and vectors combine freely.\nexport function u(value: number | Color | Vector2 | Vector3 | Vector4): Node {\n  return uniform(value as never);\n}\n\nfunction spotUniforms() {\n  return {\n    // x, z on the stage floor, radius, intensity\n    shape: u(new Vector4(0, 0, 1.5, 0)),\n    color: u(new Color(1, 1, 1)),\n    // height of the lamp, used for the beam meshes\n    height: u(9),\n  };\n}\n\nexport const light = {\n  keyDir: u(new Vector3(-0.35, 0.8, 0.55).normalize()),\n  key: u(new Color(0.9, 0.9, 1.0)),\n  fill: u(new Color(0.12, 0.12, 0.2)),\n  rimDir: u(new Vector3(0.2, 0.55, -1).normalize()),\n  rim: u(new Color(0.35, 0.45, 1.0)),\n  glint: u(1),\n  ink: u(new Color(0.025, 0.015, 0.04)),\n  outlineWidth: u(0.022),\n  spots: [spotUniforms(), spotUniforms(), spotUniforms(), spotUniforms(), spotUniforms()],\n};\n\nexport type Spot = (typeof light.spots)[number];\n\n// Soft-edged disc of light on the floor plane for one spot (0..1).\nexport function spotPool(spot: Spot): Node {\n  const d = length(positionWorld.xz.sub(spot.shape.xy));\n  const r = spot.shape.z;\n  return float(1).sub(smoothstep(r.mul(0.78), r, d)).mul(spot.shape.w);\n}\n\nexport function spotLightAt(n: Node): Node {\n  // Spot lamps hang above and in front of the stage.\n  const facing = clamp(dot(n, normalize(vec3(0, 1, 0.7))), 0, 1);\n  const band = smoothstep(0.0, 0.06, facing).mul(0.55).add(smoothstep(0.45, 0.5, facing).mul(0.45));\n  let sum: Node = vec3(0, 0, 0);\n  for (const spot of light.spots) {\n    sum = sum.add(spot.color.mul(spotPool(spot)));\n  }\n  return sum.mul(band.mul(0.85).add(0.15));\n}\n\nexport interface ToonOptions {\n  glint?: number;\n  rim?: number;\n  emissive?: number;\n  flat?: boolean;\n}\n\nexport function toon(hex: number, options: ToonOptions = {}): MeshBasicNodeMaterial {\n  const base: Node = u(new Color(hex));\n  const material = new MeshBasicNodeMaterial();\n  const n: Node = normalize(normalWorld);\n  const v = normalize(cameraPosition.sub(positionWorld));\n  const ndl = dot(n, light.keyDir);\n  const band = smoothstep(-0.02, 0.04, ndl).mul(0.6).add(smoothstep(0.5, 0.56, ndl).mul(0.4));\n  const lit: Node = light.fill.add(light.key.mul(band)).add(spotLightAt(n));\n  const glintAmount = options.glint ?? 0.6;\n  const rimAmount = options.rim ?? 1;\n  const glint = smoothstep(0.93, 0.95, dot(reflect(v.negate(), n), light.keyDir)).mul(light.glint).mul(glintAmount);\n  const fresnel = float(1).sub(max(dot(n, v), 0));\n  const rim = smoothstep(0.58, 0.64, fresnel).mul(smoothstep(-0.1, 0.3, dot(n, light.rimDir))).mul(rimAmount);\n  const emissive = options.emissive ?? 0;\n  const color = base.mul(lit).add(light.key.mul(glint)).add(light.rim.mul(rim)).add(base.mul(emissive));\n  material.colorNode = vec4(color, 1);\n  material.userData.base = base;\n  return material;\n}\n\n// Unlit glowing colour, e.g. bulbs and eyes; intensity can be animated.\nexport function glow(hex: number, intensity = 1): MeshBasicNodeMaterial & { userData: { level: ReturnType<typeof uniform> } } {\n  const base: Node = u(new Color(hex));\n  const level = uniform(intensity);\n  const material = new MeshBasicNodeMaterial();\n  material.colorNode = vec4(base.mul(level), 1);\n  material.userData.level = level;\n  material.userData.base = base;\n  return material as MeshBasicNodeMaterial & { userData: { level: ReturnType<typeof uniform> } };\n}\n\n// Averages normals of coincident vertices so hard-edged shapes get a\n// crack-free outline shell.\nconst smoothed = new WeakMap<BufferGeometry, true>();\n\nexport function ensureOutlineNormals(geometry: BufferGeometry): void {\n  if (smoothed.has(geometry)) {\n    return;\n  }\n  smoothed.set(geometry, true);\n  const position = geometry.getAttribute('position');\n  const normal = geometry.getAttribute('normal');\n  const sums = new Map<string, Vector3>();\n  const keyOf = (i: number) =>\n    `${position.getX(i).toFixed(4)},${position.getY(i).toFixed(4)},${position.getZ(i).toFixed(4)}`;\n  for (let i = 0; i < position.count; i += 1) {\n    const key = keyOf(i);\n    const sum = sums.get(key) ?? new Vector3();\n    sum.x += normal.getX(i);\n    sum.y += normal.getY(i);\n    sum.z += normal.getZ(i);\n    sums.set(key, sum);\n  }\n  const out = new Float32Array(position.count * 3);\n  for (let i = 0; i < position.count; i += 1) {\n    const sum = sums.get(keyOf(i)) as Vector3;\n    const len = Math.max(1e-6, sum.length());\n    out[i * 3] = sum.x / len;\n    out[i * 3 + 1] = sum.y / len;\n    out[i * 3 + 2] = sum.z / len;\n  }\n  geometry.setAttribute('outlineNormal', new BufferAttribute(out, 3));\n}\n\nconst outlineCache = new Map<number, MeshBasicNodeMaterial>();\n\n// Back-face shell pushed out along the smoothed normal. `scale` compensates\n// for a mesh's own scale so line weight stays even across the cast.\nexport function outlineMaterial(scale = 1): MeshBasicNodeMaterial {\n  const key = Math.round(scale * 1000);\n  const cached = outlineCache.get(key);\n  if (cached) {\n    return cached;\n  }\n  const material = new MeshBasicNodeMaterial({ side: BackSide });\n  const push = attribute('outlineNormal', 'vec3').mul(light.outlineWidth.div(scale));\n  material.positionNode = positionLocal.add(push);\n  material.colorNode = vec4(light.ink, 1);\n  outlineCache.set(key, material);\n  return material;\n}\n\nexport function allOutlineMaterials(): MeshBasicNodeMaterial[] {\n  return [...outlineCache.values()];\n}\n\n// A mesh with its ink outline attached as a child.\nexport function inked(geometry: BufferGeometry, material: MeshBasicNodeMaterial, scale = 1): Mesh {\n  ensureOutlineNormals(geometry);\n  const mesh = new Mesh(geometry, material);\n  const shell = new Mesh(geometry, outlineMaterial(scale));\n  shell.name = 'outline';\n  mesh.add(shell);\n  return mesh;\n}\n\n// Place a part: position, optional uniform/non-uniform scale and rotation.\nexport function place<T extends Object3D>(\n  object: T,\n  parent: Object3D,\n  x = 0,\n  y = 0,\n  z = 0,\n  rx = 0,\n  ry = 0,\n  rz = 0,\n): T {\n  object.position.set(x, y, z);\n  object.rotation.set(rx, ry, rz);\n  parent.add(object);\n  return object;\n}\n",
      "visual.ts": "// \"One More Dawn\" – opening of the stage show (0:00–1:12).\r\n// A cel-shaded retro-future Broadway stage with an original robot company.\r\n// The whole performance is driven by song time: press Play together with\r\n// the track starting at \"Start at\" seconds to stay in sync.\r\n\r\nimport { defineVisual } from '@lux/visual-sdk';\r\nimport { Color, PerspectiveCamera, Scene } from 'three/webgpu';\r\nimport { makeAria, makeBarnaby, makeGuard, makeKid, makeKing } from './lib/cast.ts';\r\nimport { Chain, DAIS, buildGlobe, buildThrone } from './lib/props.ts';\r\nimport { disposeRig } from './lib/rig.ts';\r\nimport { disposeShapes } from './lib/shapes.ts';\r\nimport { runShow, type Cast } from './lib/show.ts';\r\nimport { CLIP_END } from './lib/song.ts';\r\nimport { buildStage, contactShadow, set } from './lib/stage.ts';\r\nimport { light } from './lib/toon.ts';\r\n\r\nexport default defineVisual({\r\n  controls: {\r\n    startAt: {\r\n      type: 'number',\r\n      label: 'Start at',\r\n      default: 0,\r\n      min: 0,\r\n      max: 72,\r\n      step: 0.1,\r\n      unit: 's',\r\n      group: 'Timeline',\r\n      description: 'Song time shown when playback starts. Start the track at the same second to stay in sync.',\r\n    },\r\n    loop: {\r\n      type: 'boolean',\r\n      label: 'Loop clip',\r\n      default: true,\r\n      group: 'Timeline',\r\n      description: 'Restart from the top after the final tableau (1:12.5). Otherwise hold the last pose.',\r\n    },\r\n    outline: {\r\n      type: 'number',\r\n      label: 'Ink weight',\r\n      default: 0.022,\r\n      min: 0,\r\n      max: 0.06,\r\n      step: 0.001,\r\n      group: 'Look',\r\n      description: 'Thickness of the cartoon ink outline, in stage metres.',\r\n    },\r\n    haze: {\r\n      type: 'number',\r\n      label: 'Stage haze',\r\n      default: 0.75,\r\n      min: 0,\r\n      max: 2,\r\n      step: 0.01,\r\n      group: 'Look',\r\n      description: 'Visibility of the spotlight beams in the theatre haze.',\r\n    },\r\n  },\r\n  async create(context) {\r\n    const scene = new Scene();\r\n    scene.background = new Color(0, 0, 0);\r\n    const camera = new PerspectiveCamera(38, context.settings.width / context.settings.height, 0.1, 200);\r\n\r\n    const stage = buildStage();\r\n    scene.add(stage.root);\r\n\r\n    const aria = makeAria();\r\n    const barnaby = makeBarnaby();\r\n    const pip = makeKid('pip');\r\n    const dot = makeKid('dot');\r\n    const king = makeKing();\r\n    const guards: [ReturnType<typeof makeGuard>, ReturnType<typeof makeGuard>] = [makeGuard(0), makeGuard(1)];\r\n    const throne = buildThrone();\r\n    stage.lift.add(throne);\r\n    king.root.position.set(0, DAIS, 0.1);\r\n    stage.lift.add(king.root);\r\n    const globe = buildGlobe();\r\n    const chain = new Chain(24);\r\n    scene.add(aria.root, barnaby.root, pip.root, dot.root, guards[0].root, guards[1].root, globe.group, chain.group);\r\n\r\n    // Contact shadows ground every performer on the boards.\r\n    const shadows = [\r\n      { rig: aria, mesh: contactShadow(1.5, 1.2) },\r\n      { rig: barnaby, mesh: contactShadow(1.3, 0.9) },\r\n      { rig: pip, mesh: contactShadow(0.7, 0.5) },\r\n      { rig: dot, mesh: contactShadow(0.7, 0.5) },\r\n      { rig: guards[0], mesh: contactShadow(0.9, 0.7) },\r\n      { rig: guards[1], mesh: contactShadow(0.9, 0.7) },\r\n    ];\r\n    for (const s of shadows) {\r\n      scene.add(s.mesh);\r\n    }\r\n\r\n    const cast: Cast = {\r\n      aria,\r\n      barnaby,\r\n      pip,\r\n      dot,\r\n      king,\r\n      guards,\r\n      throne,\r\n      globe,\r\n      chain,\r\n      lift: stage.lift,\r\n      pedestal: stage.pedestal,\r\n    };\r\n\r\n    let fade = 1;\r\n\r\n    return {\r\n      update(frame) {\r\n        const raw = frame.controls.startAt + frame.timeSeconds;\r\n        const t = frame.controls.loop ? raw % CLIP_END : Math.min(raw, CLIP_END);\r\n        light.outlineWidth.value = frame.controls.outline;\r\n        runShow(t, cast, camera);\r\n        for (const s of shadows) {\r\n          s.mesh.visible = s.rig.root.visible;\r\n          s.mesh.position.set(s.rig.root.position.x, 0.012, s.rig.root.position.z);\r\n          const lift = Math.max(0, s.rig.hips.position.y - s.rig.hipHeight);\r\n          s.mesh.scale.setScalar(1 - Math.min(0.4, lift * 0.8));\r\n        }\r\n        set.hazeLevel.value = frame.controls.haze;\r\n        stage.update(t);\r\n        // Fade from black at the top and to black after the final tableau.\r\n        fade = Math.min(1, t / 0.6) * (frame.controls.loop ? Math.min(1, (CLIP_END - t) / 0.7) : 1);\r\n        light.key.value.multiplyScalar(fade);\r\n        light.fill.value.multiplyScalar(fade);\r\n        set.footLevel.value *= fade;\r\n        set.marqueeLevel.value *= fade;\r\n        set.neonLevel.value *= fade;\r\n        set.wallLevel.value *= fade;\r\n        set.wallEyeLevel.value *= fade;\r\n        set.starLevel.value *= fade;\r\n        for (const spot of light.spots) {\r\n          spot.shape.value.w *= fade;\r\n        }\r\n      },\r\n      render(target) {\r\n        return context.renderer.render(scene, camera, target);\r\n      },\r\n      reset(_seed) {},\r\n      dispose() {\r\n        stage.dispose();\r\n        for (const rig of [aria, barnaby, pip, dot, king, guards[0], guards[1]]) {\r\n          disposeRig(rig);\r\n        }\r\n        disposeShapes();\r\n        scene.traverse(object => {\r\n          const material = (object as { material?: { dispose(): void } }).material;\r\n          material?.dispose();\r\n        });\r\n      },\r\n    };\r\n  },\r\n});\r\n"
    }
  },
  "settings": {
    "width": 1920,
    "height": 1080,
    "fps": 60,
    "seed": 0
  },
  "controls": {
    "sourceHash": "db63f757709aeeb7f0e0563693eed84acbeef35a5286ce2cced6c1b816a31fef",
    "schema": [
