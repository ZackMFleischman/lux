{
  "format": "lux-scene",
  "version": 4,
  "source": {
    "sourceVersion": 2,
    "sdkVersion": "0.4.0",
    "entry": "visual.ts",
    "files": {
      "background.ts": "import {\n  AdditiveBlending,\n  BufferAttribute,\n  BufferGeometry,\n  DoubleSide,\n  Group,\n  Mesh,\n  MeshBasicNodeMaterial,\n  PlaneGeometry,\n} from 'three/webgpu';\nimport { color, exp, float, mix, sin, uniform, uv, vec2 } from 'three/tsl';\n\n/**\n * Scene-local backdrop for living-pearl.ts; no lights, textures, noise, or\n * renderer changes. The pearl remains the brightest and most detailed object.\n *\n * Integration:\n *   import { createPearlHabitat } from './background.ts';\n *   const habitat = createPearlHabitat();\n *   scene.add(habitat.group);\n *   // update(frame), after time.value has been updated:\n *   habitat.update(time.value);\n *   // dispose():\n *   habitat.dispose();\n *\n * Include this file in the complete submitted source bundle. This proposal has\n * not been built in Studio. Keep the existing dark scene.background and motes.\n */\nexport function createPearlHabitat() {\n  const group = new Group();\n  const clock = uniform(0);\n  const planeGeometry = new PlaneGeometry(24, 15);\n  const planeMaterial = new MeshBasicNodeMaterial({ depthWrite: false });\n  const p = uv().sub(0.5).mul(vec2(1.6, 1));\n\n  // Only trigonometric fields: broad drifting folds, with no recursive noise\n  // expansion. Named variables keep generated WGSL compact.\n  const warp = sin(p.y.mul(5.2).add(clock.mul(0.055))).mul(0.105).toVar();\n  const leftDistance = p.x.add(0.34).add(warp).toVar();\n  const rightDistance = p.x.sub(0.38).sub(warp.mul(0.7)).toVar();\n  const leftVeil = exp(leftDistance.mul(leftDistance).mul(-38)).toVar();\n  const rightVeil = exp(rightDistance.mul(rightDistance).mul(-24)).toVar();\n  const leftThreads = sin(leftDistance.mul(93).add(p.y.mul(9)).add(clock.mul(0.09)))\n    .mul(0.5).add(0.5).pow(5).mul(0.24).add(0.76);\n  const rightThreads = sin(rightDistance.mul(67).sub(p.y.mul(12)).sub(clock.mul(0.07)))\n    .mul(0.5).add(0.5).pow(4).mul(0.2).add(0.8);\n  const verticalFade = exp(p.y.mul(p.y).mul(-2.7));\n  const radius = p.mul(vec2(1.05, 1.4)).length().toVar();\n  const centralShelter = float(1).sub(exp(radius.mul(radius).mul(-18)).mul(0.91));\n  const lowMist = exp(p.y.add(0.29).pow(2).mul(-24))\n    .mul(exp(p.x.mul(p.x).mul(-1.9)));\n  const base = mix(color('#010309'), color('#10102b'), radius.mul(1.4).clamp(0, 1));\n  planeMaterial.colorNode = base\n    .add(color('#0c7f80').mul(leftVeil).mul(leftThreads).mul(0.32))\n    .add(color('#69377c').mul(rightVeil).mul(rightThreads).mul(0.38))\n    .add(color('#193958').mul(lowMist).mul(0.26))\n    .mul(verticalFade.mul(0.6).add(0.4))\n    .mul(centralShelter.mul(0.75).add(0.25));\n  const plane = new Mesh(planeGeometry, planeMaterial);\n  plane.position.set(0, 0, -7);\n  plane.renderOrder = -20;\n  group.add(plane);\n\n  const membranes = new Group();\n  group.add(membranes);\n  const membraneGeometries: BufferGeometry[] = [];\n  const membraneMaterials: MeshBasicNodeMaterial[] = [];\n\n  // Real tapered ribbons frame the outer edges, like enormous translucent gills.\n  // Their depth stays behind the subject. Each has just 84 triangles.\n  for (let i = 0; i < 6; i++) {\n    const side = i < 3 ? -1 : 1;\n    const layer = i % 3;\n    const segments = 42;\n    const positions: number[] = [];\n    const coordinates: number[] = [];\n    const indices: number[] = [];\n    for (let j = 0; j <= segments; j++) {\n      const t = j / segments;\n      const y = (t - 0.5) * 9;\n      const arch = Math.sin(t * Math.PI);\n      const x = side * (3.0 + layer * 0.61 - arch * 0.52\n        + Math.sin(t * 7.4 + layer * 0.9) * 0.17);\n      const width = Math.pow(arch, 1.1) * (0.28 + layer * 0.08);\n      const z = -3.7 - layer * 0.65 + Math.sin(t * 5 + layer) * 0.27;\n      positions.push(x - width, y, z, x + width, y, z);\n      coordinates.push(0, t, 1, t);\n      if (j < segments) {\n        const k = j * 2;\n        indices.push(k, k + 1, k + 2, k + 1, k + 3, k + 2);\n      }\n    }\n    const geometry = new BufferGeometry();\n    geometry.setAttribute('position', new BufferAttribute(new Float32Array(positions), 3));\n    geometry.setAttribute('uv', new BufferAttribute(new Float32Array(coordinates), 2));\n    geometry.setIndex(indices);\n    const material = new MeshBasicNodeMaterial({\n      transparent: true,\n      depthWrite: false,\n      side: DoubleSide,\n      blending: AdditiveBlending,\n    });\n    const edgeFade = sin(uv().x.mul(Math.PI)).clamp(0, 1).pow(1.8);\n    const endFade = sin(uv().y.mul(Math.PI)).clamp(0, 1).pow(0.7);\n    const ribs = sin(uv().y.mul(112).add(uv().x.mul(5)).add(clock.mul(0.08)))\n      .mul(0.5).add(0.5).pow(8);\n    material.colorNode = color(side < 0 ? '#28cbb8' : '#9d57d0');\n    material.opacityNode = edgeFade.mul(endFade).mul(ribs.mul(0.055).add(0.035));\n    const mesh = new Mesh(geometry, material);\n    mesh.renderOrder = -10 + layer;\n    membranes.add(mesh);\n    membraneGeometries.push(geometry);\n    membraneMaterials.push(material);\n  }\n\n  return {\n    group,\n    update(timeSeconds: number) {\n      clock.value = timeSeconds;\n      membranes.rotation.z = Math.sin(timeSeconds * 0.055) * 0.014;\n      membranes.position.y = Math.sin(timeSeconds * 0.07) * 0.045;\n    },\n    dispose() {\n      planeGeometry.dispose();\n      planeMaterial.dispose();\n      for (const geometry of membraneGeometries) geometry.dispose();\n      for (const material of membraneMaterials) material.dispose();\n    },\n  };\n}\n",
      "companions.ts": "import {\n  AdditiveBlending,\n  BufferGeometry,\n  DoubleSide,\n  DynamicDrawUsage,\n  InstancedMesh,\n  Material,\n  Matrix4,\n  MeshBasicNodeMaterial,\n  Quaternion,\n  RingGeometry,\n  Vector3,\n} from 'three/webgpu';\nimport { atan, color, instanceIndex, positionLocal, sin, uniform, vec3 } from 'three/tsl';\n\n/**\n * Small companion pearls that stream out of the main pearl along curling\n * tentacle paths into the distance, like particles on streamers.\n * - They are instances of the main pearl: same live geometry and skin.\n * - Pulses (bass, kick) push their orbits outward.\n * - A shockwave (kick onset) hurls them down their streamers; the loop then\n *   brings fresh ones out from behind the pearl.\n * - Each carries its own three sine \"spectral\" rings (bass, mids, highs).\n */\ntype Band = { lobes: number; amp: number; scale: number; tint: string };\nexport const companionRingBands: Band[] = [\n  { lobes: 3, amp: 0.22, scale: 1.55, tint: '#2fe0cc' },\n  { lobes: 7, amp: 0.14, scale: 1.85, tint: '#9b7bff' },\n  { lobes: 13, amp: 0.08, scale: 2.15, tint: '#ffc58f' },\n];\n\nexport function createCompanions(random: () => number, geometry: BufferGeometry, material: Material, maxCount = 96) {\n  const mesh = new InstancedMesh(geometry, material, maxCount);\n  mesh.instanceMatrix.setUsage(DynamicDrawUsage);\n  mesh.frustumCulled = false;\n\n  // Spectral rings: one instanced ribbon per band, displaced on the GPU.\n  const ringGeometry = new RingGeometry(0.965, 1.035, 128, 1);\n  const rings = ([] as Band[]).map(band => { // per-companion rings removed (too busy)\n    const level = uniform(0);\n    const phase = uniform(0);\n    const m = new MeshBasicNodeMaterial({ transparent: true, depthWrite: false, blending: AdditiveBlending, side: DoubleSide });\n    const angle = atan(positionLocal.y, positionLocal.x);\n    const wobble = sin(angle.mul(band.lobes).add(phase).add(instanceIndex.toFloat().mul(1.73)))\n      .mul(level.mul(band.amp * 2.2).add(0.02));\n    m.positionNode = vec3(positionLocal.xy.mul(wobble.add(1)), positionLocal.z);\n    m.colorNode = color(band.tint);\n    m.opacityNode = level.mul(0.75).add(0.12);\n    const instanced = new InstancedMesh(ringGeometry, m, maxCount);\n    instanced.instanceMatrix.setUsage(DynamicDrawUsage);\n    instanced.frustumCulled = false;\n    instanced.renderOrder = -1;\n    return { band, mesh: instanced, material: m, level, phase };\n  });\n\n  const arms = 7;\n  const seeds = Array.from({ length: maxCount }, (_, i) => ({\n    arm: i % arms,\n    offset: random(),\n    speed: 0.06 + random() * 0.05,\n    jitter: random() * Math.PI * 2,\n    size: 0.6 + random() * 0.7,\n  }));\n  const armTilt = Array.from({ length: arms }, () => (random() - 0.5) * 1.4);\n  const armTwist = Array.from({ length: arms }, () => (random() < 0.5 ? -1 : 1) * (1.6 + random() * 1.4));\n  const m4 = new Matrix4();\n  const q = new Quaternion();\n  const identity = new Quaternion();\n  const pos = new Vector3();\n  const scl = new Vector3();\n  const ringScale = new Vector3();\n  let travel = 0;\n  let blast = 0;\n  let lastKick = 0;\n  let lastT = Number.NaN;\n  const phases = [0, 0, 0];\n\n  const group = [mesh, ...rings.map(r => r.mesh)];\n  return {\n    meshes: group,\n    update(t: number, count: number, size: number, reach: number, bass: number, mids: number, highs: number, kick: number) {\n      const dt = Number.isFinite(lastT) ? Math.min(0.1, Math.max(0, t - lastT)) : 0;\n      lastT = t;\n      // Shockwave: a kick onset hurls the companions down their streamers.\n      if (kick > 0.4 && lastKick <= 0.4) blast = Math.max(blast, 10);\n      lastKick = kick;\n      blast *= Math.exp(-dt * 2.6);\n      travel += dt * (1 + mids * 2.2 + blast);\n      // Pulse: orbits breathe outward with the body and the blast.\n      const push = 1 + bass * 0.35 + kick * 0.25 + Math.min(1, blast / 10) * 0.35;\n\n      const levels = [bass, mids, highs];\n      for (let b = 0; b < rings.length; b++) {\n        phases[b] += dt * (0.6 + levels[b] * 3) * (b % 2 ? -1 : 1);\n        rings[b].level.value = levels[b];\n        rings[b].phase.value = phases[b];\n      }\n\n      const n = Math.max(0, Math.min(maxCount, Math.round(count)));\n      mesh.count = n;\n      for (const r of rings) r.mesh.count = n;\n      for (let i = 0; i < n; i++) {\n        const s = seeds[i];\n        const u = (travel * s.speed + s.offset) % 1; // 0 = born behind the pearl, 1 = gone\n        const a = s.arm;\n        const base = (a / arms) * Math.PI * 2 + Math.sin(t * 0.11 + a) * 0.35;\n        const curl = base + u * armTwist[a] + Math.sin(u * 5 - t * 0.7 + a) * 0.25;\n        const radius = (1.25 + u * 4.6 * reach) * push;\n        const wave = Math.sin(u * 9 - t * 1.3 + s.jitter) * 0.18 * u;\n        pos.set(\n          Math.cos(curl) * radius + wave,\n          (Math.sin(curl) * radius * 0.62 + armTilt[a] * u * 2.2 + wave),\n          -u * 7 * reach + Math.sin(u * 6 + a) * 0.6 - 0.4 * (1 - Math.min(1, u * 9)),\n        );\n        const life = Math.min(1, u * 9) * Math.pow(1 - u, 1.15);\n        const scale = Math.max(0.0001, 0.16 * size * s.size * life * (1 + bass * 0.45 + kick * 0.3));\n        scl.setScalar(scale);\n        q.setFromAxisAngle(pos.clone().normalize(), t * 0.4 + s.jitter);\n        m4.compose(pos, q, scl);\n        mesh.setMatrixAt(i, m4);\n        for (const r of rings) {\n          ringScale.setScalar(scale * r.band.scale * (1 + kick * 0.25));\n          m4.compose(pos, identity, ringScale);\n          r.mesh.setMatrixAt(i, m4);\n        }\n      }\n      mesh.instanceMatrix.needsUpdate = true;\n      for (const r of rings) r.mesh.instanceMatrix.needsUpdate = true;\n    },\n    reset() { travel = 0; blast = 0; lastKick = 0; lastT = Number.NaN; phases.fill(0); },\n    dispose() {\n      mesh.dispose();\n      for (const r of rings) { r.mesh.dispose(); r.material.dispose(); }\n      ringGeometry.dispose();\n    },\n  };\n}\n",
      "kaleidoscope.ts": "import { defineComponent } from '@lux/visual-sdk';\nimport { DataTexture, Mesh, MeshBasicNodeMaterial, OrthographicCamera, PlaneGeometry, Scene, Texture } from 'three/webgpu';\nimport { abs, atan, clamp, cos, float, length, max, mix, mod, sin, texture, uniform, uv, vec2 } from 'three/tsl';\n\nconst TAU = Math.PI * 2;\n\nfunction smooth(x: number): number {\n  const t = Math.min(1, Math.max(0, x));\n  return t * t * (3 - 2 * t);\n}\n\n// Cycle: hold off, ease in, hold on, ease out. The ramps sit inside the on window.\nfunction cycleMix(time: number, period: number, onFraction: number, transition: number): number {\n  const onLength = period * onFraction;\n  const offLength = period - onLength;\n  const ramp = Math.max(0.0001, Math.min(transition, onLength / 2));\n  const t = ((time % period) + period) % period;\n  if (t < offLength) return 0;\n  const local = t - offLength;\n  if (local < ramp) return smooth(local / ramp);\n  if (local > onLength - ramp) return smooth((onLength - local) / ramp);\n  return 1;\n}\n\nexport default defineComponent({\n  metadata: {\n    declarationVersion: 1,\n    key: 'effects/kaleidoscope-cycle',\n    label: 'Kaleidoscope Cycle',\n    description: 'Mirrored-wedge kaleidoscope that slowly rotates and fades in and out on a regular cycle.',\n    tags: ['kaleidoscope', 'effect', 'mirror'],\n    inputs: { image: { type: { kind: 'image', colorSpace: 'linear-srgb', alphaMode: 'premultiplied' }, label: 'Image', description: 'Image to fold into mirrored wedges.' } },\n    outputs: { image: { type: { kind: 'image', colorSpace: 'linear-srgb', alphaMode: 'premultiplied' }, label: 'Image', description: 'Image with the cycling kaleidoscope applied.' } },\n    controls: {\n      segments: { type: 'number', label: 'Segments', group: 'Kaleidoscope', default: 6, min: 2, max: 16, step: 1 },\n      period: { type: 'number', label: 'Cycle length', group: 'Kaleidoscope', default: 16, min: 4, max: 120, step: 0.5, unit: 's' },\n      onFraction: { type: 'number', label: 'On fraction', group: 'Kaleidoscope', default: 0.4, min: 0.05, max: 0.95, step: 0.01 },\n      transition: { type: 'number', label: 'Transition', group: 'Kaleidoscope', default: 2.5, min: 0.2, max: 10, step: 0.1, unit: 's' },\n      spin: { type: 'number', label: 'Spin', group: 'Kaleidoscope', default: 0.08, min: -1, max: 1, step: 0.01, unit: 'rad/s' },\n      amount: { type: 'number', label: 'Amount', group: 'Kaleidoscope', default: 1, min: 0, max: 1, step: 0.01 },\n      force: { type: 'number', label: 'Force', group: 'Kaleidoscope', default: 0, min: 0, max: 1, step: 0.01 },\n    },\n    controlDescriptions: {\n      segments: 'Number of mirrored wedges around the centre.',\n      period: 'Seconds for one full off-and-on cycle.',\n      onFraction: 'Share of each cycle in which the kaleidoscope is on, including its fades.',\n      transition: 'Seconds to ease in and again to ease out. Limited to half the on time.',\n      spin: 'Rotation speed of the wedge pattern in radians per second.',\n      amount: 'Maximum blend toward the kaleidoscope. Zero keeps the original image.',\n      force: 'Added to the cycle blend, so an audio or LFO binding can push the effect in at any time.',\n    },\n    lifecycle: { state: 'stateful', reset: 'seed' },\n  },\n  async create() {\n    const fallback = new DataTexture(new Uint8Array([0, 0, 0, 0]), 1, 1);\n    const segmentsUniform = uniform(6);\n    const rotationUniform = uniform(0);\n    const aspectUniform = uniform(1);\n    const mixUniform = uniform(0);\n    const zoomUniform = uniform(0);\n\n    const coordinates = uv().flipY();\n    const original = texture(fallback, coordinates);\n\n    const centered = coordinates.sub(0.5).mul(vec2(aspectUniform, 1));\n    const radius = length(centered).mul(float(1).sub(zoomUniform));\n    const angle = atan(centered.y, centered.x).add(rotationUniform);\n    const wedge = segmentsUniform.reciprocal().mul(TAU);\n    const folded = abs(mod(angle, wedge).sub(wedge.mul(0.5)));\n    const mirrored = vec2(cos(folded), sin(folded)).mul(radius);\n    const kaleidoUv = clamp(mirrored.div(vec2(max(aspectUniform, 0.0001), 1)).add(0.5), 0, 1);\n    const kaleido = texture(fallback, kaleidoUv);\n\n    const geometry = new PlaneGeometry(2, 2);\n    const material = new MeshBasicNodeMaterial({ depthTest: false, depthWrite: false });\n    material.fragmentNode = mix(original, kaleido, mixUniform);\n    material.toneMapped = false;\n    const scene = new Scene();\n    scene.add(new Mesh(geometry, material));\n    const camera = new OrthographicCamera(-1, 1, 1, -1, 0, 1);\n\n    return {\n      update(frame) {\n        const controls = frame.controls;\n        const cycle = cycleMix(frame.timeSeconds, controls.period, controls.onFraction, controls.transition);\n        const blend = Math.min(1, Math.max(0, cycle * controls.amount + controls.force));\n        segmentsUniform.value = Math.max(2, Math.round(controls.segments));\n        rotationUniform.value = (controls.spin * frame.timeSeconds) % TAU;\n        mixUniform.value = blend;\n        // Gentle zoom pulse that peaks mid-transition and vanishes at full on or off.\n        zoomUniform.value = 0.06 * Math.sin(Math.PI * blend) * Math.sin(Math.PI * blend);\n      },\n      async evaluate(inputs, evaluation) {\n        const image = inputs.image.texture as Texture;\n        original.value = image;\n        kaleido.value = image;\n        aspectUniform.value = inputs.image.width / Math.max(1, inputs.image.height);\n        return { image: await evaluation.render(scene, camera) };\n      },\n      reset() {},\n      dispose() { geometry.dispose(); material.dispose(); fallback.dispose(); },\n    };\n  },\n});\n",
      "pearl.ts": "import { createPearlHabitat } from './background.ts';\nimport { createSpectralHalo } from './spectrum.ts';\nimport { createCompanions } from './companions.ts';\nimport { defineComponent } from '@lux/visual-sdk';\nimport {\n  Scene, Color, Mesh, SphereGeometry, MeshStandardNodeMaterial, DataTexture, RGBAFormat,\n  UnsignedByteType, SRGBColorSpace, LinearFilter, LinearMipmapLinearFilter, RepeatWrapping, ClampToEdgeWrapping, NormalBlending,\n  MeshBasicNodeMaterial, PerspectiveCamera, AmbientLight, DirectionalLight,\n  Group, AdditiveBlending, BufferAttribute, DynamicDrawUsage,\n} from 'three/webgpu';\nimport {\n  uniform, attribute, sin, mix, color, normalWorld, positionWorld,\n  cameraPosition, abs, pow, cos, vec3, vec2, float, texture, atan, asin, screenUV,\n} from 'three/tsl';\n\nexport default defineComponent({\n  metadata: {\n  declarationVersion: 1,\n  key: 'living-pearl/scene',\n  label: 'Living Pearl',\n  description: 'Audio-reactive nacre pearl with spectral halo, companions and echoes.',\n  tags: ['pearl', 'audio'],\n  inputs: {},\n  outputs: { image: { type: { kind: 'image', colorSpace: 'linear-srgb', alphaMode: 'premultiplied' }, label: 'Image', description: 'Rendered pearl scene.' } },\n  controlDescriptions: {\n    ringBloom: 'How far the occasional ring bloom spreads (0 off, 1 fills the screen).',\n    ringBloomPeriod: 'Seconds per bloom cycle.',\n    ringEchoes: 'Out-of-phase echo copies per spectrum ring (0-2).',\n    spikeHeight: 'Fold depth.',\n    noiseScale: 'Fold scale.',\n    sharpness: 'Fold definition.',\n    motionSpeed: 'Life speed.',\n    breath: 'Breathing.',\n    roughness: 'Skin roughness.',\n    glow: 'Inner glow.',\n    nacre: 'Nacre shimmer.',\n    bass: 'Bass.',\n    mids: 'Mids.',\n    highs: 'Highs.',\n    kick: 'Kick.',\n    sensitivity: 'Audio sensitivity.',\n    audioDrive: 'Body response.',\n    spectrumGain: 'Spectrum.',\n    colorShift: 'Colour shift.',\n    colorSpeed: 'Colour speed.',\n    screenTint: 'Screen tint.',\n    echoes: 'Echo trail.',\n    companions: 'Companions.',\n    companionSize: 'Companion size.',\n    companionReach: 'Streamer reach.',\n    echoInterval: 'Echo spacing (s).',\n  },\n  lifecycle: { state: 'stateful', reset: 'seed' },\n  controls: {\n    spikeHeight: { type: 'number', label: 'Fold depth', group: 'Body', default: 0.85, min: 0, max: 1.4, step: 0.01 },\n    noiseScale: { type: 'number', label: 'Fold scale', group: 'Body', default: 3.4, min: 1, max: 7, step: 0.1 },\n    sharpness: { type: 'number', label: 'Fold definition', group: 'Body', default: 3.2, min: 0.5, max: 5, step: 0.05 },\n    motionSpeed: { type: 'number', label: 'Life speed', group: 'Life', default: 0.28, min: 0, max: 1.5, step: 0.01 },\n    breath: { type: 'number', label: 'Breathing', group: 'Life', default: 0.65, min: 0, max: 1, step: 0.01 },\n    roughness: { type: 'number', label: 'Skin roughness', group: 'Skin', default: 0.38, min: 0.12, max: 0.8, step: 0.01 },\n    glow: { type: 'number', label: 'Inner glow', group: 'Skin', default: 0.65, min: 0, max: 2, step: 0.01 },\n    nacre: { type: 'number', label: 'Nacre shimmer', group: 'Skin', default: 0.8, min: 0, max: 1.5, step: 0.01 },\n    // Bind these to Studio audio (Animate > Add Audio). Base 0 means silent.\n    bass: { type: 'number', label: 'Bass', group: 'Audio', default: 0, min: 0, max: 1, step: 0.01 },\n    mids: { type: 'number', label: 'Mids', group: 'Audio', default: 0, min: 0, max: 1, step: 0.01 },\n    highs: { type: 'number', label: 'Highs', group: 'Audio', default: 0, min: 0, max: 1, step: 0.01 },\n    kick: { type: 'number', label: 'Kick', group: 'Audio', default: 0, min: 0, max: 1, step: 0.01 },\n    sensitivity: { type: 'number', label: 'Audio sensitivity', group: 'Audio', default: 2.2, min: 0.5, max: 6, step: 0.05 },\n    audioDrive: { type: 'number', label: 'Body response', group: 'Audio', default: 1.6, min: 0, max: 2, step: 0.01 },\n    spectrumGain: { type: 'number', label: 'Spectrum', group: 'Audio', default: 1, min: 0, max: 2, step: 0.01 },\n    colorShift: { type: 'number', label: 'Colour shift', group: 'Skin', default: 0.65, min: 0, max: 1, step: 0.01 },\n    colorSpeed: { type: 'number', label: 'Colour speed', group: 'Skin', default: 0.035, min: 0, max: 0.3, step: 0.001 },\n    screenTint: { type: 'number', label: 'Screen tint', group: 'Skin', default: 0.7, min: 0, max: 2, step: 0.01 },\n    ringBloom: { type: 'number', label: 'Ring bloom', group: 'Audio', default: 1, min: 0, max: 1, step: 0.01 },\n    ringBloomPeriod: { type: 'number', label: 'Ring bloom period (s)', group: 'Audio', default: 24, min: 6, max: 120, step: 0.5 },\n    ringEchoes: { type: 'number', label: 'Ring echoes', group: 'Audio', default: 2, min: 0, max: 2, step: 1 },\n    echoes: { type: 'number', label: 'Echo trail', group: 'Echo', default: 1, min: 0, max: 2, step: 0.01 },\n    companions: { type: 'number', label: 'Companions', group: 'Companions', default: 42, min: 0, max: 96, step: 1 },\n    companionSize: { type: 'number', label: 'Companion size', group: 'Companions', default: 1, min: 0.2, max: 3, step: 0.01 },\n    companionReach: { type: 'number', label: 'Streamer reach', group: 'Companions', default: 1, min: 0.3, max: 2, step: 0.01 },\n    echoInterval: { type: 'number', label: 'Echo spacing (s)', group: 'Echo', default: 0.6, min: 0.15, max: 3, step: 0.01 },\n  },\n  },\n  async create(context) {\n    // Seed once; reset samples the same field at Lux time zero.\n    const permutation = new Uint16Array(512);\n    for (let i = 0; i < 256; i++) permutation[i] = i;\n    for (let i = 255; i > 0; i--) {\n      const j = Math.floor(context.random() * (i + 1));\n      const swap = permutation[i];\n      permutation[i] = permutation[j];\n      permutation[j] = swap;\n    }\n    for (let i = 0; i < 256; i++) permutation[i + 256] = permutation[i];\n    const sample = new Float64Array(4);\n\n    // Improved gradient noise and its exact spatial derivative. This bounded\n    // CPU pass avoids tripling a large GPU noise graph for finite differences.\n    function noiseWithGradient(x: number, y: number, z: number) {\n      const ix = Math.floor(x);\n      const iy = Math.floor(y);\n      const iz = Math.floor(z);\n      const fx = x - ix;\n      const fy = y - iy;\n      const fz = z - iz;\n      const ux = fx * fx * fx * (fx * (fx * 6 - 15) + 10);\n      const uy = fy * fy * fy * (fy * (fy * 6 - 15) + 10);\n      const uz = fz * fz * fz * (fz * (fz * 6 - 15) + 10);\n      const dx = 30 * fx * fx * (fx - 1) * (fx - 1);\n      const dy = 30 * fy * fy * (fy - 1) * (fy - 1);\n      const dz = 30 * fz * fz * (fz - 1) * (fz - 1);\n      let value = 0;\n      let gradientX = 0;\n      let gradientY = 0;\n      let gradientZ = 0;\n      for (let a = 0; a < 2; a++) {\n        const wx = a ? ux : 1 - ux;\n        const dwx = a ? dx : -dx;\n        const hashX = permutation[(ix & 255) + a];\n        for (let b = 0; b < 2; b++) {\n          const wy = b ? uy : 1 - uy;\n          const dwy = b ? dy : -dy;\n          const hashY = permutation[hashX + (iy & 255) + b];\n          for (let c = 0; c < 2; c++) {\n            const wz = c ? uz : 1 - uz;\n            const dwz = c ? dz : -dz;\n            const h = permutation[hashY + (iz & 255) + c] & 15;\n            const signU = (h & 1) ? -1 : 1;\n            const signV = (h & 2) ? -1 : 1;\n            let gx = h < 8 ? signU : 0;\n            let gy = h < 8 ? 0 : signU;\n            let gz = 0;\n            if (h < 4) gy += signV;\n            else if (h === 12 || h === 14) gx += signV;\n            else gz += signV;\n            const dot = gx * (fx - a) + gy * (fy - b) + gz * (fz - c);\n            const weight = wx * wy * wz;\n            value += dot * weight;\n            gradientX += gx * weight + dot * dwx * wy * wz;\n            gradientY += gy * weight + dot * wx * dwy * wz;\n            gradientZ += gz * weight + dot * wx * wy * dwz;\n          }\n        }\n      }\n      sample[0] = value;\n      sample[1] = gradientX;\n      sample[2] = gradientY;\n      sample[3] = gradientZ;\n    }\n\n    const time = uniform(0);\n    const glow = uniform(0.65);\n    const roughness = uniform(0.38);\n    const geometry = new SphereGeometry(1, 128, 88);\n    const position = geometry.getAttribute('position') as BufferAttribute;\n    const normal = geometry.getAttribute('normal') as BufferAttribute;\n    position.setUsage(DynamicDrawUsage);\n    normal.setUsage(DynamicDrawUsage);\n    const rest = new Float32Array(position.array);\n    // Canonical rest directions make duplicate seam and pole vertices agree.\n    for (let i = 0; i < rest.length; i += 3) {\n      let x = Math.abs(rest[i]) < 0.000001 ? 0 : rest[i];\n      let y = Math.abs(rest[i + 1]) < 0.000001 ? 0 : rest[i + 1];\n      let z = Math.abs(rest[i + 2]) < 0.000001 ? 0 : rest[i + 2];\n      const length = Math.hypot(x, y, z);\n      rest[i] = x / length;\n      rest[i + 1] = y / length;\n      rest[i + 2] = z / length;\n    }\n    const fields = new Float32Array(position.count);\n    const fieldAttribute = new BufferAttribute(fields, 1).setUsage(DynamicDrawUsage);\n    geometry.setAttribute('livingField', fieldAttribute);\n    geometry.setAttribute('restPosition', new BufferAttribute(rest, 3));\n    geometry.computeBoundingSphere();\n    geometry.boundingSphere!.radius = 2.2;\n\n    let previousTime = Number.NaN;\n    let previousDepth = Number.NaN;\n    let previousScale = Number.NaN;\n    let previousSharpness = Number.NaN;\n    let previousBreath = Number.NaN;\n    let previousAudio = Number.NaN;\n    function deform(t: number, depth: number, scale: number, sharpness: number, breath: number,\n      flow = 0, punch = 0, shimmer = 0) {\n      const audioKey = flow * 7.13 + punch * 3.7 + shimmer;\n      if (t === previousTime && depth === previousDepth && scale === previousScale &&\n          sharpness === previousSharpness && breath === previousBreath && audioKey === previousAudio) return;\n      previousAudio = audioKey;\n      previousTime = t;\n      previousDepth = depth;\n      previousScale = scale;\n      previousSharpness = sharpness;\n      previousBreath = breath;\n      const exponent = sharpness * 0.55;\n      const breathing = Math.sin(t * 1.9) * breath * 0.055;\n      for (let i = 0; i < position.count; i++) {\n        const index = i * 3;\n        const x = rest[index];\n        const y = rest[index + 1];\n        const z = rest[index + 2];\n        noiseWithGradient(x * scale + t * 0.24 + flow, y * scale - t * 0.19 - flow * 0.6, z * scale + t * 0.13);\n        const field = sample[0];\n        const remapped = Math.max(0.001, Math.min(0.999, field * 0.5 + 0.5));\n        const folds = Math.pow(remapped, exponent);\n        const foldSlope = depth * 0.65 * exponent * Math.pow(remapped, exponent - 1) * 0.5;\n        const ripplePhase = y * 23 + field * 8 - t * 2;\n        const rippleAmount = 0.012 + shimmer * 0.018;\n        const ripple = Math.sin(ripplePhase) * rippleAmount;\n        const rippleSlope = Math.cos(ripplePhase) * rippleAmount;\n        const radius = 1 + depth * 0.65 * folds + ripple + breathing + punch * 0.07;\n        const slope = foldSlope + rippleSlope * 8;\n        const gx = sample[1] * scale * slope;\n        const gy = sample[2] * scale * slope + rippleSlope * 23;\n        const gz = sample[3] * scale * slope;\n        // Exact normal of p(n) = radius(n) * n: remove the radial part of\n        // the height gradient, then subtract its tangent component / radius.\n        const radialGradient = gx * x + gy * y + gz * z;\n        const nx = x - (gx - radialGradient * x) / radius;\n        const ny = y - (gy - radialGradient * y) / radius;\n        const nz = z - (gz - radialGradient * z) / radius;\n        const inverseLength = 1 / Math.hypot(nx, ny, nz);\n        position.setXYZ(i, x * radius, y * radius, z * radius);\n        normal.setXYZ(i, nx * inverseLength, ny * inverseLength, nz * inverseLength);\n        fields[i] = field;\n      }\n      position.needsUpdate = true;\n      normal.needsUpdate = true;\n      fieldAttribute.needsUpdate = true;\n    }\n    deform(0, 0.85, 3.4, 3.2, 0.65);\n\n    const field = attribute('livingField', 'float');\n    const restPosition = attribute('restPosition', 'vec3');\n    const nacre = uniform(0.8);\n    const audioGlow = uniform(0);\n    // Painted nacre plate (equirectangular RGB + height in alpha), mapped by\n    // rest direction so the pattern rides the folds instead of swimming.\n    const pixels = context.images.get('assets/nacre.png');\n    let nacreTexture: DataTexture | undefined;\n    if (pixels) {\n      nacreTexture = new DataTexture(pixels.data, pixels.width, pixels.height, RGBAFormat, UnsignedByteType);\n      nacreTexture.colorSpace = SRGBColorSpace;\n      nacreTexture.flipY = true;\n      nacreTexture.wrapS = RepeatWrapping;\n      nacreTexture.wrapT = ClampToEdgeWrapping;\n      nacreTexture.magFilter = LinearFilter;\n      nacreTexture.minFilter = LinearMipmapLinearFilter;\n      nacreTexture.generateMipmaps = true;\n      nacreTexture.needsUpdate = true;\n    }\n    const material = new MeshStandardNodeMaterial({ metalness: 0.1, roughness: 0.38, flatShading: false });\n    const view = cameraPosition.sub(positionWorld).normalize();\n    const facing = abs(normalWorld.dot(view));\n    const rim = pow(facing.oneMinus(), 2.6);\n    const r = restPosition;\n    const sphereUv = vec2(atan(r.z, r.x).div(Math.PI * 2).add(0.5), asin(r.y.clamp(-1, 1)).div(Math.PI).add(0.5));\n    // Slow drift of the plate with the music's flow keeps it alive.\n    const plateSample = nacreTexture ? texture(nacreTexture, sphereUv.add(vec2(time.mul(0.004), 0))) : undefined;\n    const plateRgb = plateSample ? plateSample.rgb : vec3(0.86, 0.8, 0.86);\n    const plateHeight = plateSample ? plateSample.a : float(0.5);\n    const film = facing.mul(2.4).add(field.mul(2.6)).add(plateHeight.mul(1.7)).add(time.mul(0.05));\n    const thinFilm = vec3(\n      cos(film.mul(6.2832)).mul(0.5).add(0.5),\n      cos(film.mul(6.2832).add(2.1)).mul(0.5).add(0.5),\n      cos(film.mul(6.2832).add(4.2)).mul(0.5).add(0.5),\n    );\n    const valley = field.mul(0.5).add(0.62).clamp(0.25, 1);\n    // Living colour: a cosine palette drifting over time and across the folds,\n    // so hues travel over the body instead of the whole blob changing at once.\n    const huePhase = uniform(0);\n    const colorShift = uniform(0.65);\n    const screenTint = uniform(0.7);\n    const paletteT = huePhase.add(screenUV.x.mul(screenTint.mul(0.6))).add(screenUV.y.mul(screenTint.mul(0.35))).add(field.mul(0.55)).add(plateHeight.mul(0.35)).add(facing.mul(0.25));\n    const palette = vec3(\n      cos(paletteT.add(0.0).mul(6.2832)).mul(0.5).add(0.5),\n      cos(paletteT.add(0.33).mul(6.2832)).mul(0.5).add(0.5),\n      cos(paletteT.add(0.67).mul(6.2832)).mul(0.5).add(0.5),\n    ).mul(vec3(0.95, 0.75, 1.0)).add(vec3(0.25, 0.3, 0.3));\n    const pearl = mix(plateRgb, plateRgb.mul(palette).mul(1.5), colorShift).mul(valley);\n    material.colorNode = mix(\n      mix(pearl, pearl.mul(thinFilm.mul(0.75).add(0.5)), nacre.mul(0.5).mul(rim.mul(0.7).add(0.3))),\n      color('#7bc6bc'),\n      rim.mul(0.22),\n    );\n    const seams = abs(sin(field.mul(19).add(time.mul(0.45)))).pow(24);\n    material.emissiveNode = color('#36c9b1').mul(seams.mul(glow).mul(float(0.1).add(audioGlow.mul(0.2))))\n      .add(color('#8276bd').mul(rim).mul(glow).mul(float(0.12).add(audioGlow.mul(0.25))))\n      .add(thinFilm.mul(plateHeight).mul(audioGlow).mul(0.07));\n    material.roughnessNode = plateHeight.oneMinus().mul(0.18).add(roughness).sub(0.06).clamp(0.06, 0.85);\n    const body = new Mesh(geometry, material);\n    const organism = new Group();\n    organism.add(body);\n    // Feedback echoes: snapshots of the living surface drift backward,\n    // swell and fade. One shared cheap shader, per-echo opacity uniform.\n    const echoCount = 9;\n    const echoRoot = new Group();\n    const echoFade = uniform(1);\n    const echoFresnel = pow(abs(normalWorld.dot(cameraPosition.sub(positionWorld).normalize())).oneMinus(), 1.8);\n    const echoes = Array.from({ length: echoCount }, (_, k) => {\n      const g = geometry.clone();\n      g.deleteAttribute('livingField');\n      g.boundingSphere!.radius = 2.4;\n      const m = new MeshBasicNodeMaterial({ transparent: true, depthWrite: false, blending: AdditiveBlending, side: 0 });\n      const fade = uniform(0);\n      m.colorNode = mix(color('#2fd6c4'), color('#a874f0'), float(k / echoCount)).mul(echoFresnel.mul(0.9).add(0.12));\n      m.opacityNode = fade.mul(echoFade);\n      const mesh = new Mesh(g, m);\n      mesh.visible = false;\n      mesh.renderOrder = -2 - k;\n      echoRoot.add(mesh);\n      return { mesh, geometry: g, material: m, fade, born: Number.NEGATIVE_INFINITY, rotY: 0, rotZ: 0, y: 0, scale: 1 };\n    });\n    let nextEcho = 0;\n    let lastEchoAt = Number.NEGATIVE_INFINITY;\n    const scene = new Scene();\n    const habitat = createPearlHabitat();\n    scene.add(habitat.group);\n    scene.background = new Color('#03050c');\n    scene.add(echoRoot, organism, new AmbientLight('#a0aac8', 0.7));\n    // Three broad, restrained studio directions: warm key, cool rim, low fill.\n    const key = new DirectionalLight('#ffeadb', 3.0);\n    key.position.set(-3, 4, 5);\n    const edge = new DirectionalLight('#66cdbc', 2.7);\n    edge.position.set(3, 1, -2);\n    const fill = new DirectionalLight('#9089d4', 0.9);\n    fill.position.set(3, -2, 3);\n    scene.add(key, edge, fill);\n    const moteGeometry = new SphereGeometry(0.009, 6, 4);\n    const moteMaterial = new MeshBasicNodeMaterial({ color: '#67b5c2', transparent: true, opacity: 0.28, blending: AdditiveBlending, depthWrite: false });\n    const motes = new Group();\n    for (let i = 0; i < 24; i++) {\n      const mote = new Mesh(moteGeometry, moteMaterial);\n      const angle = context.random() * Math.PI * 2;\n      const radius = 1.7 + context.random() * 1.5;\n      const height = (context.random() - 0.5) * 4.6;\n      mote.position.set(Math.cos(angle) * radius, height, Math.sin(angle) * radius);\n      mote.scale.setScalar(0.3 + context.random() * 1.1);\n      motes.add(mote);\n    }\n    scene.add(motes);\n    const companions = createCompanions(context.random, geometry, material);\n    scene.add(...companions.meshes);\n    const halo = createSpectralHalo(context.random);\n    scene.add(halo.group);\n    let flow = 0;\n    let lastT = Number.NaN;\n    let spin = 0;\n    let agcLast = Number.NaN;\n    const agcPeak = [0.004, 0.004, 0.004];\n    let hue = 0;\n    let lastKickHue = 0;\n    const camera = new PerspectiveCamera(38, context.settings.width / context.settings.height, 0.1, 30);\n    camera.position.set(0, 0.15, 5.7);\n    camera.lookAt(0, 0, 0);\n    return {\n      update(frame) {\n        const raw = frame.controls;\n        // Soft-knee boost: quiet music still moves things, loud saturates at 1.\n        // Auto gain: each band is normalised by its own slowly decaying recent peak,\n        // so quiet inputs still drive the full range. Sensitivity shapes the curve.\n        const agcDt = Number.isFinite(agcLast) ? Math.min(0.1, Math.max(0, frame.timeSeconds - agcLast)) : 0;\n        agcLast = frame.timeSeconds;\n        const decay = Math.exp(-agcDt / 6);\n        const norm = (x: number, k: number) => {\n          agcPeak[k] = Math.max(Math.max(0, x), agcPeak[k] * decay, 0.004);\n          return Math.min(1, Math.pow(Math.max(0, x) / agcPeak[k], 1.6 / Math.max(0.5, raw.sensitivity * 0.6)));\n        };\n        const c = { ...raw, bass: norm(raw.bass, 0), mids: norm(raw.mids, 1), highs: norm(raw.highs, 2), kick: Math.min(1, raw.kick * 1.4) };\n        const drive = c.audioDrive;\n        time.value = frame.timeSeconds * c.motionSpeed;\n        const t = time.value;\n        const dt = Number.isFinite(lastT) ? Math.min(0.1, Math.max(0, frame.timeSeconds - lastT)) : 0;\n        lastT = frame.timeSeconds;\n        // Mids push the fold field along; highs spin the halo.\n        flow += dt * c.mids * drive * 1.6;\n        spin += dt * (0.02 + c.highs * 0.35);\n        hue += dt * c.colorSpeed * (1 + c.mids * 3) + (c.kick > 0.5 && lastKickHue <= 0.5 ? 0.12 : 0);\n        lastKickHue = c.kick;\n        huePhase.value = hue % 1;\n        colorShift.value = c.colorShift;\n        screenTint.value = c.screenTint;\n        habitat.update(t);\n        glow.value = c.glow;\n        roughness.value = c.roughness;\n        nacre.value = c.nacre + c.highs * 0.4 * drive;\n        audioGlow.value = (c.kick * 0.9 + c.bass * 0.35) * drive;\n        deform(t, c.spikeHeight + c.bass * 0.6 * drive, c.noiseScale, c.sharpness, c.breath,\n          flow, c.kick * drive, c.highs * drive);\n        body.scale.setScalar(1 + c.kick * 0.09 * drive + c.bass * 0.04 * drive);\n        body.rotation.y = t * 0.28 + flow * 0.4;\n        body.rotation.z = Math.sin(t * 0.35) * 0.12;\n        organism.position.y = Math.sin(t * 0.7) * 0.07;\n        companions.update(frame.timeSeconds, c.companions, c.companionSize, c.companionReach, c.bass, c.mids, c.highs, c.kick);\n        // Ring bloom cycle: rest, swell outward to fill the frame, hold, recede.\n        const ph = ((frame.timeSeconds / c.ringBloomPeriod) % 1 + 1) % 1;\n        const smoothstep = (a: number, b: number, x: number) => { const u = Math.min(1, Math.max(0, (x - a) / (b - a))); return u * u * (3 - 2 * u); };\n        const bloom = c.ringBloom * (smoothstep(0.5, 0.78, ph) - smoothstep(0.88, 1, ph));\n        halo.update(frame.timeSeconds, c.bass, c.mids, c.highs, c.kick, c.spectrumGain, spin, Math.round(c.ringEchoes), bloom);\n        moteMaterial.opacity = 0.28 + c.highs * 0.5 * drive;\n        // Spawn a new echo on a slow clock, sooner on a kick.\n        const now = frame.timeSeconds;\n        const interval = c.echoInterval * (1 - c.kick * 0.6);\n        if (c.echoes > 0 && (now - lastEchoAt >= interval || now < lastEchoAt)) {\n          lastEchoAt = now;\n          const e = echoes[nextEcho];\n          nextEcho = (nextEcho + 1) % echoCount;\n          (e.geometry.getAttribute('position') as BufferAttribute).copy(position).needsUpdate = true;\n          (e.geometry.getAttribute('normal') as BufferAttribute).copy(normal).needsUpdate = true;\n          e.born = now;\n          e.rotY = body.rotation.y;\n          e.rotZ = body.rotation.z;\n          e.y = organism.position.y;\n          e.scale = body.scale.x;\n        }\n        echoFade.value = c.echoes;\n        const life = interval * echoCount;\n        for (const e of echoes) {\n          const age = now - e.born;\n          const u = age / life;\n          if (!(u >= 0 && u < 1)) { e.mesh.visible = false; continue; }\n          e.mesh.visible = true;\n          e.fade.value = Math.pow(1 - u, 1.6) * 0.32 * Math.min(1, age * 4);\n          e.mesh.position.set(0, e.y, -u * 2.6);\n          e.mesh.scale.setScalar(e.scale * (1 + u * 0.55));\n          e.mesh.rotation.set(0, e.rotY - u * 0.25, e.rotZ);\n        }\n        motes.rotation.y = t * -0.06 - spin * 0.5;\n        motes.rotation.z = Math.sin(t * 0.2) * 0.05;\n      },\n      async evaluate(_inputs, evaluation) {\n        return { image: await evaluation.render(scene, camera) };\n      },\n      reset() {\n        time.value = 0;\n        previousTime = Number.NaN;\n        flow = 0;\n        spin = 0;\n        agcLast = Number.NaN;\n        agcPeak.fill(0.004);\n        hue = 0;\n        lastKickHue = 0;\n        lastT = Number.NaN;\n        halo.reset();\n        companions.reset();\n        lastEchoAt = Number.NEGATIVE_INFINITY;\n        nextEcho = 0;\n        for (const e of echoes) { e.born = Number.NEGATIVE_INFINITY; e.mesh.visible = false; }\n      },\n      dispose() {\n        habitat.dispose();\n        halo.dispose();\n        companions.dispose();\n        nacreTexture?.dispose();\n        for (const e of echoes) { e.geometry.dispose(); e.material.dispose(); }\n        geometry.dispose();\n        material.dispose();\n        moteGeometry.dispose();\n        moteMaterial.dispose();\n      },\n    };\n  },\n});\n\n\n\n",
      "spectrum.ts": "import {\n  AdditiveBlending,\n  BufferAttribute,\n  BufferGeometry,\n  DoubleSide,\n  DynamicDrawUsage,\n  Group,\n  Mesh,\n  MeshBasicNodeMaterial,\n  RingGeometry,\n} from 'three/webgpu';\nimport { atan, attribute, color, mix, positionLocal, sin, uniform, uv } from 'three/tsl';\n\n/**\n * Sinusoidal spectral halo behind the pearl.\n *\n * Lux gives visuals band envelopes (bass, mids, highs, kick), not raw FFT\n * bins. Each band drives its own closed sine ribbon around the pearl:\n * bass = few slow lobes, mids = medium waves, highs = many fast ripples.\n * The ribbons interfere on a shared \"sum\" ribbon, so loud passages braid.\n * A kick sends an expanding shock ring outward.\n */\ntype Wave = { lobes: number; speed: number; base: number; width: number; tint: [string, string]; amp: number };\nconst waves: Wave[] = [\n  { lobes: 3, speed: 0.35, base: 2.05, width: 0.035, tint: ['#21d6c3', '#5fa8ff'], amp: 0.55 },\n  { lobes: 7, speed: -0.8, base: 2.3, width: 0.026, tint: ['#7d63e6', '#c58cff'], amp: 0.4 },\n  { lobes: 17, speed: 1.7, base: 2.55, width: 0.018, tint: ['#ffc98a', '#ff8fc8'], amp: 0.22 },\n  { lobes: 0, speed: 0, base: 2.85, width: 0.022, tint: ['#9ff3e8', '#e0c2ff'], amp: 1 },\n];\n\nexport function createSpectralHalo(random: () => number) {\n  const group = new Group();\n  const segments = 360;\n  const z = -1.6;\n  const gain = uniform(1);\n  const flash = uniform(0);\n  const makeRibbon = (wave: Wave, index: number, opacityScale: number) => {\n    const positions = new Float32Array((segments + 1) * 2 * 3);\n    const across = new Float32Array((segments + 1) * 2);\n    const indices: number[] = [];\n    for (let i = 0; i <= segments; i++) {\n      across[i * 2] = 0;\n      across[i * 2 + 1] = 1;\n      if (i < segments) {\n        const k = i * 2;\n        indices.push(k, k + 1, k + 2, k + 1, k + 3, k + 2);\n      }\n    }\n    const geometry = new BufferGeometry();\n    const attributePositions = new BufferAttribute(positions, 3).setUsage(DynamicDrawUsage);\n    geometry.setAttribute('position', attributePositions);\n    geometry.setAttribute('across', new BufferAttribute(across, 1));\n    geometry.setIndex(indices);\n    geometry.computeBoundingSphere();\n    geometry.boundingSphere!.radius = 6;\n    const material = new MeshBasicNodeMaterial({ transparent: true, depthWrite: false, blending: AdditiveBlending, side: DoubleSide });\n    const a = attribute('across', 'float');\n    const core = sin(a.mul(Math.PI)).pow(1.5);\n    const level = uniform(0);\n    material.colorNode = mix(color(wave.tint[0]), color(wave.tint[1]), uv().x.add(a).mul(0.5)).mul(flash.mul(0.6).add(1));\n    material.opacityNode = core.mul(level.mul(0.7).add(0.18)).mul(gain.min(1.5).mul(0.6).add(0.2)).mul(opacityScale);\n    const mesh = new Mesh(geometry, material);\n    mesh.renderOrder = -5 + index;\n    group.add(mesh);\n    return { wave, mesh, positions, attributePositions, geometry, material, level, phase: random() * Math.PI * 2 };\n  };\n  const ribbons = waves.map((wave, index) => makeRibbon(wave, index, 1.25));\n  // Bloom rings: extra copies that appear occasionally and spread to fill the screen.\n  const extraCount = 10;\n  const extras = Array.from({ length: extraCount }, (_, j) => ({ ...makeRibbon(waves[j % 3], -9, 0.7), w: j % 3, j }));\n  // Out-of-phase echo copies of each ring: dimmer, drifting at their own pace.\n  const echoes = waves.flatMap((wave, w) => [1, 2].map(k => ({\n    ...makeRibbon(wave, -8 - k, k === 1 ? 0.22 : 0.12), w, k,\n    drift: 0, driftRate: (0.12 + random() * 0.1) * k * (random() < 0.5 ? -1 : 1),\n  })));\n\n  // Shockwaves: a pool of thick glowing rings with a soft trailing wake.\n  // Kicks fire a full blast; strong bass surges fire a smaller one.\n  const ringGeometry = new RingGeometry(0.7, 1, 220, 1);\n  const shocks = Array.from({ length: 5 }, (_, k) => {\n    const m = new MeshBasicNodeMaterial({ transparent: true, depthWrite: false, blending: AdditiveBlending });\n    const fade = uniform(0);\n    // uv().y runs inner (0) to outer (1) on RingGeometry: bright crest, soft wake.\n    const across = positionLocal.xy.length().sub(0.7).div(0.3);\n    const crest = across.sub(0.93).abs().mul(-28).exp();\n    const wake = across.pow(3).mul(0.35);\n    const ripple = sin(atan(positionLocal.y, positionLocal.x).mul(48).add(k * 1.7)).mul(0.5).add(0.5);\n    m.colorNode = mix(color('#9bfff0'), color('#e2b8ff'), ripple).mul(crest.mul(1.6).add(0.4));\n    m.opacityNode = fade.mul(crest.add(wake)).mul(ripple.mul(0.3).add(0.7));\n    const mesh = new Mesh(ringGeometry, m);\n    mesh.position.z = z - 0.05 - k * 0.01;\n    mesh.renderOrder = -6;\n    mesh.visible = false;\n    group.add(mesh);\n    return { mesh, material: m, fade, age: 1, power: 0 };\n  });\n  let nextShock = 0;\n  let lastBass = 0;\n  const fire = (power: number) => {\n    const sh = shocks[nextShock];\n    nextShock = (nextShock + 1) % shocks.length;\n    sh.age = 0;\n    sh.power = power;\n  };\n  let lastKick = 0;\n  let lastTime = Number.NaN;\n  const smooth = [0, 0, 0];\n  const phases = ribbons.map(r => r.phase);\n\n  const writeRibbon = (r: number, positions: Float32Array, rotation: number, phaseShift: number,\n    amp: number, width: number, wave: Wave, radiusScale = 1) => {\n    for (let i = 0; i <= segments; i++) {\n      const theta = (i / segments) * Math.PI * 2 + rotation;\n      let offset;\n      if (r < 3) {\n        offset = Math.sin(theta * wave.lobes + phases[r] + phaseShift) * amp\n          + Math.sin(theta * (wave.lobes * 2 + 1) - (phases[r] + phaseShift) * 1.3) * amp * 0.25;\n      } else {\n        offset = (Math.sin(theta * 3 + phases[0] + phaseShift) * smooth[0] * 0.5\n          + Math.sin(theta * 7 + phases[1] + phaseShift) * smooth[1] * 0.35\n          + Math.sin(theta * 17 + phases[2] + phaseShift) * smooth[2] * 0.2) * gainNow + 0.03 * Math.sin(theta * 5 + phases[3]);\n      }\n      const radius = (wave.base + offset + kickNow * 0.16) * radiusScale;\n      const c = Math.cos(theta);\n      const sn = Math.sin(theta);\n      const o = i * 6;\n      positions[o] = c * (radius - width); positions[o + 1] = sn * (radius - width); positions[o + 2] = z;\n      positions[o + 3] = c * (radius + width); positions[o + 4] = sn * (radius + width); positions[o + 5] = z;\n    }\n  };\n  let gainNow = 1;\n  let kickNow = 0;\n  return {\n    group,\n    update(t: number, bass: number, mids: number, highs: number, kick: number, gainValue: number, spin: number, echoCount = 2, bloom = 0) {\n      const dt = Number.isFinite(lastTime) ? Math.min(0.1, Math.max(0, t - lastTime)) : 0;\n      lastTime = t;\n      gain.value = gainValue;\n      flash.value = kick;\n      if (kick > 0.4 && lastKick <= 0.4) fire(1);\n      lastKick = kick;\n      if (bass > 0.7 && lastBass <= 0.7) fire(0.55);\n      lastBass = bass;\n      for (const sh of shocks) {\n        sh.age = Math.min(1, sh.age + dt * 0.95);\n        const live = sh.age < 1;\n        sh.mesh.visible = live;\n        if (!live) continue;\n        const ease = 1 - Math.pow(1 - sh.age, 3);\n        sh.mesh.scale.setScalar(1.7 + ease * (3.5 + sh.power * 4.5));\n        sh.fade.value = Math.pow(1 - sh.age, 1.7) * (0.35 + sh.power * 0.75) * Math.max(0.4, gainValue);\n      }\n\n      gainNow = gainValue;\n      kickNow = kick;\n      const bands = [bass, mids, highs];\n      for (let b = 0; b < 3; b++) smooth[b] += (bands[b] - smooth[b]) * Math.min(1, dt * 10);\n      for (let r = 0; r < ribbons.length; r++) {\n        const { wave, positions, attributePositions, level } = ribbons[r];\n        const energy = r < 3 ? smooth[r] : (smooth[0] + smooth[1] + smooth[2]) / 3;\n        level.value = energy;\n        // Louder bands travel faster: the waves surge with the music.\n        phases[r] += dt * (wave.speed || 0.2) * (0.4 + energy * 2.2);\n        const amp = 0.04 + energy * wave.amp * gainValue;\n        const width = wave.width * (1 + energy * 1.4) + kick * 0.01;\n        writeRibbon(r, positions, spin * (r % 2 ? -1 : 1), 0, amp, width, wave);\n        attributePositions.needsUpdate = true;\n        for (const e of echoes) {\n          if (e.w !== r) continue;\n          e.mesh.visible = e.k <= echoCount;\n          if (!e.mesh.visible) continue;\n          e.level.value = energy;\n          // Drift faster when the band is loud; phase is pushed out of step.\n          e.drift += dt * e.driftRate * (1 + energy * 2.5);\n          const breathe = 1 + Math.sin(t * 0.4 + e.k * 1.9 + r) * 0.04 * e.k;\n          writeRibbon(r, e.positions, spin * (r % 2 ? -1 : 1) + e.drift, e.k * 2.3, amp * 0.9, width * 0.35, wave, breathe);\n          e.attributePositions.needsUpdate = true;\n        }\n      }\n      // Bloom: ring count grows with the envelope, each new ring pushing further out.\n      for (const x of extras) {\n        const appear = Math.min(1, Math.max(0, bloom * extraCount - x.j));\n        x.mesh.visible = appear > 0.001;\n        if (!x.mesh.visible) continue;\n        const energy = smooth[x.w];\n        x.level.value = energy * appear;\n        const spread = 1 + (x.j + 1) * 0.36 * Math.pow(bloom, 0.8);\n        writeRibbon(x.w, x.positions, spin * (x.j % 2 ? 1 : -1) * 1.3 + x.j * 0.7, x.j * 1.13,\n          (0.04 + energy * x.wave.amp * gainValue) * spread * 0.8, x.wave.width * (1 + energy) * spread * appear, x.wave, spread);\n        x.attributePositions.needsUpdate = true;\n      }\n    },\n    reset() {\n      for (const sh of shocks) { sh.age = 1; sh.mesh.visible = false; } lastKick = 0; lastBass = 0; nextShock = 0; lastTime = Number.NaN; smooth.fill(0);\n      ribbons.forEach((r, i) => { phases[i] = r.phase; });\n      for (const e of echoes) e.drift = 0;\n    },\n    dispose() {\n      for (const r of [...ribbons, ...echoes, ...extras]) { r.geometry.dispose(); r.material.dispose(); }\n      ringGeometry.dispose();\n      for (const sh of shocks) sh.material.dispose();\n    },\n  };\n}\n",
      "visual.ts": "import { defineVisual } from '@lux/visual-sdk';\nimport pearl from './pearl.ts';\nimport kaleidoscope from './kaleidoscope.ts';\n\nexport default defineVisual({\n  label: 'Living Pearl - Spectral',\n  definitions: { pearl, kaleidoscope },\n  nodes: [\n    { id: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', definition: 'pearl' },\n    { id: '5a1c0e11-7f3b-4a8e-9d2c-000000000002', definition: 'kaleidoscope' },\n  ],\n  edges: [\n    { id: '5a1c0e11-7f3b-4a8e-9d2c-000000000011', from: { nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', portId: 'image' }, to: { nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000002', portId: 'image' }, delay: 'none' },\n  ],\n  output: { nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000002', portId: 'image' },\n  expose: [\n    { id: 'spikeHeight', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'spikeHeight' },\n    { id: 'noiseScale', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'noiseScale' },\n    { id: 'sharpness', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'sharpness' },\n    { id: 'motionSpeed', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'motionSpeed' },\n    { id: 'breath', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'breath' },\n    { id: 'roughness', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'roughness' },\n    { id: 'glow', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'glow' },\n    { id: 'nacre', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'nacre' },\n    { id: 'bass', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'bass' },\n    { id: 'mids', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'mids' },\n    { id: 'highs', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'highs' },\n    { id: 'kick', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'kick' },\n    { id: 'sensitivity', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'sensitivity' },\n    { id: 'audioDrive', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'audioDrive' },\n    { id: 'spectrumGain', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'spectrumGain' },\n    { id: 'colorShift', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'colorShift' },\n    { id: 'colorSpeed', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'colorSpeed' },\n    { id: 'screenTint', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'screenTint' },\n    { id: 'ringBloom', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'ringBloom' },\n    { id: 'ringBloomPeriod', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'ringBloomPeriod' },\n    { id: 'ringEchoes', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'ringEchoes' },\n    { id: 'echoes', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'echoes' },\n    { id: 'companions', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'companions' },\n    { id: 'companionSize', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'companionSize' },\n    { id: 'companionReach', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'companionReach' },\n    { id: 'echoInterval', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000001', controlId: 'echoInterval' },\n    { id: 'kaleidoSegments', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000002', controlId: 'segments' },\n    { id: 'kaleidoPeriod', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000002', controlId: 'period' },\n    { id: 'kaleidoOnFraction', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000002', controlId: 'onFraction' },\n    { id: 'kaleidoTransition', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000002', controlId: 'transition' },\n    { id: 'kaleidoSpin', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000002', controlId: 'spin' },\n    { id: 'kaleidoAmount', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000002', controlId: 'amount' },\n    { id: 'kaleidoForce', nodeId: '5a1c0e11-7f3b-4a8e-9d2c-000000000002', controlId: 'force' },\n  ],\n});\n"
