{
  "format": "lux-scene",
  "version": 4,
  "source": {
    "sdkVersion": "0.4.0",
    "entry": "fiber-optic-heart/composition.ts",
    "files": {
      "fiber-optic-heart/composition.ts": "import { defineVisual } from '@lux/visual-sdk';\nimport core from './core.ts';\nimport paths from './paths.ts';\nimport renderer from './renderer.ts';\nimport dust from './dust.ts';\n\nexport default defineVisual({\n  label: 'Fiber-Optic Heart',\n  definitions: { core, paths, renderer, dust },\n  nodes: [\n    { id: 'a2ca5401-1e17-4c40-8dd6-6595f78a0001', definition: 'core' },\n    { id: 'a2ca5401-1e17-4c40-8dd6-6595f78a0002', definition: 'paths' },\n    { id: 'a2ca5401-1e17-4c40-8dd6-6595f78a0003', definition: 'renderer' },\n    { id: 'a2ca5401-1e17-4c40-8dd6-6595f78a0004', definition: 'dust' },\n  ],\n  edges: [\n    {\n      id: 'a2ca5401-1e17-4c40-8dd6-6595f78a0011',\n      from: { nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0001', portId: 'image' },\n      to: { nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0003', portId: 'image' },\n      delay: 'none',\n    },\n    {\n      id: 'a2ca5401-1e17-4c40-8dd6-6595f78a0012',\n      from: { nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0002', portId: 'paths' },\n      to: { nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0003', portId: 'paths' },\n      delay: 'none',\n    },\n    {\n      id: 'a2ca5401-1e17-4c40-8dd6-6595f78a0013',\n      from: { nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0003', portId: 'image' },\n      to: { nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0004', portId: 'image' },\n      delay: 'none',\n    },\n  ],\n  output: { nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0004', portId: 'image' },\n  expose: [\n    { id: 'coreBrightness', nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0001', controlId: 'brightness' },\n    { id: 'coreRadius', nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0001', controlId: 'radius' },\n    { id: 'haze', nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0001', controlId: 'haze' },\n    { id: 'breath', nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0001', controlId: 'breath' },\n    { id: 'flare', nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0001', controlId: 'flare' },\n    { id: 'strandCount', nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0002', controlId: 'count' },\n    { id: 'spread', nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0002', controlId: 'spread' },\n    { id: 'cableWidth', nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0002', controlId: 'width' },\n    { id: 'arrangement', nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0002', controlId: 'seed' },\n    { id: 'drift', nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0002', controlId: 'motion' },\n    { id: 'strandBrightness', nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0003', controlId: 'brightness' },\n    { id: 'palette', nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0003', controlId: 'palette' },\n    { id: 'pulseSpeed', nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0003', controlId: 'pulseSpeed' },\n    { id: 'pulseWidth', nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0003', controlId: 'pulseWidth' },\n    { id: 'pulseStrength', nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0003', controlId: 'pulseStrength' },\n    { id: 'ribbons', nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0003', controlId: 'ribbons' },\n    { id: 'ribbonWidth', nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0003', controlId: 'ribbonWidth' },\n    { id: 'cables', nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0003', controlId: 'cables' },\n    { id: 'collars', nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0003', controlId: 'collars' },\n    { id: 'dustCount', nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0004', controlId: 'count' },\n    { id: 'dustSize', nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0004', controlId: 'size' },\n    { id: 'dustDrift', nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0004', controlId: 'drift' },\n    { id: 'dustBrightness', nodeId: 'a2ca5401-1e17-4c40-8dd6-6595f78a0004', controlId: 'brightness' },\n  ],\n});\n",
      "fiber-optic-heart/core.ts": "import { defineComponent } from '@lux/visual-sdk';\nimport { Mesh, MeshBasicNodeMaterial, OrthographicCamera, PlaneGeometry, Scene } from 'three/webgpu';\nimport { uniform, uv, vec4, wgslFn } from 'three/tsl';\n\nconst coreShader = wgslFn(`\nfn fiberCore(st: vec2f, view: vec4f, settings: vec4f) -> vec4f {\n  let p = (st - 0.5) * vec2f(view.x, 1.0);\n  let breath = 1.0 + 0.1 * settings.y * sin(view.y * 0.65);\n  let radius = max(view.z * breath, 0.005);\n  let d = length(p / vec2f(0.9, 1.1));\n  let core = exp(-pow(d / radius, 2.0) * 2.5);\n  let aura = exp(-pow(d / (radius * 3.4), 2.0));\n  let magentaMist = exp(-pow((p.y - 0.10) / 0.24, 2.0)) * exp(-p.x * p.x * 0.7);\n  let flare = exp(-abs(p.y) * 160.0) * exp(-abs(p.x) * 2.8);\n  let vignette = 1.0 - 0.65 * smoothstep(0.25, 0.9, length(st - 0.5));\n  var color = vec3f(0.0015, 0.001, 0.012);\n  color += vec3f(0.32, 0.002, 0.15) * magentaMist * settings.x;\n  color += vec3f(0.65, 0.012, 0.19) * aura * view.w * 0.48;\n  color += vec3f(1.0, 0.79, 0.35) * core * view.w;\n  color += vec3f(0.5, 0.72, 0.65) * flare * settings.z;\n  return vec4f(color * vignette, 1.0);\n}\n`);\n\nexport default defineComponent({\n  metadata: {\n    declarationVersion: 1,\n    key: 'fiber-heart/radial-core',\n    label: 'Radiant Core',\n    description: 'White-gold breathing core with magenta atmosphere and a horizontal optical flare.',\n    tags: ['glow', 'core', 'background'],\n    inputs: {},\n    outputs: {\n      image: { type: { kind: 'image', colorSpace: 'linear-srgb', alphaMode: 'premultiplied' }, label: 'Image', description: 'Opaque radiant core background.' },\n    },\n    controls: {\n      radius: { type: 'number', group: 'Core', label: 'Radius', default: 0.14, min: 0.02, max: 0.35, step: 0.005 },\n      brightness: { type: 'number', group: 'Core', label: 'Brightness', default: 2.3, min: 0, max: 5, step: 0.01 },\n      haze: { type: 'number', group: 'Atmosphere', label: 'Magenta haze', default: 0.7, min: 0, max: 2, step: 0.01 },\n      breath: { type: 'number', group: 'Core', label: 'Breathing', default: 0.55, min: 0, max: 1, step: 0.01 },\n      flare: { type: 'number', group: 'Atmosphere', label: 'Horizontal flare', default: 0.45, min: 0, max: 2, step: 0.01 },\n    },\n    controlDescriptions: {\n      radius: 'Radius of the central light in canvas-height units.',\n      brightness: 'Linear light strength; values above one intentionally produce an exposed center.',\n      haze: 'Amount of broad magenta atmosphere behind the strands.',\n      breath: 'Depth of slow breathing driven by the Lux scene clock.',\n      flare: 'Strength of the thin horizontal flare through the core.',\n    },\n    lifecycle: { state: 'stateless', reset: 'seed' },\n  },\n  async create(context) {\n    const aspect = uniform(context.settings.width / context.settings.height);\n    const time = uniform(0);\n    const radius = uniform(0.14);\n    const brightness = uniform(2.3);\n    const haze = uniform(0.7);\n    const breath = uniform(0.55);\n    const flare = uniform(0.45);\n    const material = new MeshBasicNodeMaterial({ depthTest: false, depthWrite: false });\n    material.fragmentNode = coreShader(uv(), vec4(aspect, time, radius, brightness), vec4(haze, breath, flare, 0));\n    const geometry = new PlaneGeometry(2, 2);\n    const mesh = new Mesh(geometry, material);\n    mesh.frustumCulled = false;\n    const scene = new Scene();\n    scene.add(mesh);\n    const camera = new OrthographicCamera(-1, 1, 1, -1, 0, 1);\n    return {\n      update(frame) {\n        time.value = frame.timeSeconds;\n        radius.value = frame.controls.radius;\n        brightness.value = frame.controls.brightness;\n        haze.value = frame.controls.haze;\n        breath.value = frame.controls.breath;\n        flare.value = frame.controls.flare;\n      },\n      async evaluate(_inputs, evaluation) {\n        return { image: await evaluation.render(scene, camera) };\n      },\n      reset() { time.value = 0; },\n      dispose() {\n        geometry.dispose();\n        material.dispose();\n      },\n    };\n  },\n});\n",
      "fiber-optic-heart/dust.ts": "import { defineComponent } from '@lux/visual-sdk';\nimport {\n  AdditiveBlending, DataTexture, Mesh, MeshBasicNodeMaterial, OrthographicCamera,\n  PlaneGeometry, Scene, type Texture,\n} from 'three/webgpu';\nimport { texture, uniform, uv, vec4, wgslFn } from 'three/tsl';\n\nconst dustShader = wgslFn(`\nfn fiberDust(st: vec2f, strength: f32) -> vec4f {\n  let p = st * 2.0 - 1.0;\n  let glow = exp(-dot(p, p) * 6.0);\n  let edge = 1.0 - smoothstep(0.7, 1.0, length(p));\n  return vec4f(vec3f(1.0, 0.63, 0.22) * strength, glow * edge);\n}\n`);\n\nexport default defineComponent({\n  metadata: {\n    declarationVersion: 1,\n    key: 'fiber-heart/dust-field',\n    label: 'Luminous Dust',\n    description: 'Sparse seeded golden dust with scene-clock drift and soft additive sprites.',\n    tags: ['particles', 'dust', 'overlay'],\n    inputs: {\n      image: { type: { kind: 'image', colorSpace: 'linear-srgb', alphaMode: 'premultiplied' }, label: 'Background', description: 'Image under the dust.' },\n    },\n    outputs: {\n      image: { type: { kind: 'image', colorSpace: 'linear-srgb', alphaMode: 'premultiplied' }, label: 'Image', description: 'Background with luminous dust.' },\n    },\n    controls: {\n      count: { type: 'number', group: 'Dust', label: 'Particles', default: 44, min: 0, max: 96, step: 1 },\n      size: { type: 'number', group: 'Dust', label: 'Size', default: 0.009, min: 0.002, max: 0.03, step: 0.001 },\n      drift: { type: 'number', group: 'Dust', label: 'Drift', default: 0.35, min: 0, max: 2, step: 0.01 },\n      brightness: { type: 'number', group: 'Dust', label: 'Brightness', default: 0.55, min: 0, max: 3, step: 0.01 },\n    },\n    controlDescriptions: {\n      count: 'Visible particles out of a fixed pool of 96; identities do not shuffle.',\n      size: 'Base sprite diameter in canvas-height units. Supports stable per-instance variation.',\n      drift: 'Slow upward flow and lateral sway; zero freezes dust motion and twinkle.',\n      brightness: 'Additive golden light strength; zero removes dust light.',\n    },\n    lifecycle: { state: 'stateless', reset: 'seed' },\n  },\n  async create(context) {\n    const aspect = context.settings.width / context.settings.height;\n    const camera = new OrthographicCamera(-aspect / 2, aspect / 2, 0.5, -0.5, 0.1, 10);\n    camera.position.z = 2;\n    const scene = new Scene();\n    const fallback = new DataTexture(new Uint8Array([0, 0, 0, 255]), 1, 1);\n    fallback.needsUpdate = true;\n    const base = texture(fallback, uv().flipY());\n    const backgroundMaterial = new MeshBasicNodeMaterial({ depthTest: false, depthWrite: false });\n    backgroundMaterial.fragmentNode = base;\n    const backgroundGeometry = new PlaneGeometry(aspect, 1);\n    const background = new Mesh(backgroundGeometry, backgroundMaterial);\n    background.renderOrder = -1;\n    scene.add(background);\n\n    const brightness = uniform(0.55);\n    const material = new MeshBasicNodeMaterial({\n      transparent: true, blending: AdditiveBlending, depthTest: false, depthWrite: false,\n    });\n    // wgslFn's declarations do not infer the WGSL vec4f return type.\n    const color = dustShader(uv(), brightness) as ReturnType<typeof vec4>;\n    material.colorNode = color.rgb;\n    material.opacityNode = color.a;\n    const geometry = new PlaneGeometry(1, 1);\n    const particles = Array.from({ length: 96 }, (_, index) => {\n      const mesh = new Mesh(geometry, material);\n      mesh.renderOrder = 1;\n      mesh.frustumCulled = false;\n      scene.add(mesh);\n      return { mesh, index };\n    });\n    let seed = context.settings.seed;\n    function random(index: number): number {\n      const value = Math.sin(index * 127.1 + seed * 0.73) * 43758.5453;\n      return value - Math.floor(value);\n    }\n    return {\n      update(frame) {\n        const time = frame.timeSeconds * frame.controls.drift;\n        brightness.value = frame.controls.brightness;\n        for (const particle of particles) {\n          const { mesh, index } = particle;\n          mesh.visible = index < Math.round(frame.controls.count);\n          if (!mesh.visible) continue;\n          const phase = random(index * 3) * Math.PI * 2;\n          const y = ((random(index * 3 + 1) + time * 0.012) % 1) - 0.5;\n          const x = (random(index * 3 + 2) - 0.5) * aspect + Math.sin(time * 0.2 + phase) * 0.03;\n          const edgeFade = Math.max(0, Math.min(1, (0.5 - Math.abs(y)) * 15));\n          const size = frame.sampleControl?.('size', index) ?? frame.controls.size;\n          mesh.position.set(x, y, 0);\n          mesh.scale.setScalar(size * (0.55 + 0.45 * Math.sin(time * 0.7 + phase) ** 2) * edgeFade);\n        }\n      },\n      async evaluate(inputs, evaluation) {\n        base.value = inputs.image.texture as Texture;\n        return { image: await evaluation.render(scene, camera) };\n      },\n      reset(nextSeed) { seed = nextSeed; },\n      dispose() {\n        geometry.dispose();\n        material.dispose();\n        backgroundGeometry.dispose();\n        backgroundMaterial.dispose();\n        fallback.dispose();\n      },\n    };\n  },\n});\n",
      "fiber-optic-heart/geometry.ts": "// Structural match for SDK 0.4 paths2d. Kept free of GPU imports for later CPU tests.\nexport interface Point {\n  readonly x: number;\n  readonly y: number;\n  readonly width: number;\n  readonly distance: number;\n  readonly depositionTime: number;\n}\n\nexport interface LoopSettings {\n  count: number;\n  spread: number;\n  motion: number;\n  width: number;\n  seed: number;\n}\n\nexport const MAX_PATHS = 16;\nexport const POINTS = 97;\nconst TAU = Math.PI * 2;\n\nfunction hash(value: number): number {\n  const n = Math.sin(value * 127.1 + 311.7) * 43758.5453;\n  return n - Math.floor(n);\n}\n\nexport function makeLoops(time: number, aspect: number, settings: LoopSettings) {\n  const paths = [];\n  const count = Math.max(0, Math.min(MAX_PATHS, Math.round(settings.count)));\n  const clock = time * settings.motion;\n  for (let id = 0; id < count; id++) {\n    const seed = settings.seed * 37 + id * 13;\n    const phase = hash(seed) * TAU;\n    const points: Point[] = [];\n    let distance = 0;\n    for (let index = 0; index < POINTS; index++) {\n      // Explicit repeat makes the seam position and strip normal identical.\n      const angle = (index === POINTS - 1 ? 0 : index / (POINTS - 1)) * TAU;\n      const theta = angle + phase;\n      const radius = 0.26 + hash(seed + 1) * 0.15;\n      const x = settings.spread * aspect * (\n        radius * Math.cos(theta)\n        + 0.065 * Math.sin(theta * 3 + clock * 0.19 + phase)\n      );\n      const y = settings.spread * (\n        radius * 0.65 * Math.sin(theta * 2 + phase * 0.35)\n        + 0.055 * Math.cos(theta * 3 - clock * 0.15)\n      );\n      const previous = points[index - 1];\n      if (previous) distance += Math.hypot(x - previous.x, y - previous.y);\n      points.push({ x, y, width: settings.width, distance, depositionTime: 0 });\n    }\n    paths.push({\n      id, generation: 0, styleSeed: Math.floor(hash(seed + 2) * 65535),\n      birthTime: 0, lifetime: 3600, phase: 0, opacity: 1, points,\n    });\n  }\n  return { version: 1 as const, paths };\n}\n\nexport function writeStrip(\n  points: readonly Point[], positions: Float32Array, uvs: Float32Array, widthScale: number,\n): void {\n  if (points.length * 6 > positions.length || points.length * 4 > uvs.length) {\n    throw Error('Path exceeds strip capacity');\n  }\n  const last = points.length - 1;\n  const closed = last > 1 && Math.hypot(points[0]!.x - points[last]!.x, points[0]!.y - points[last]!.y) < 1e-6;\n  for (let i = 0; i <= last; i++) {\n    const a = points[i === 0 ? (closed ? last - 1 : 0) : i - 1]!;\n    const b = points[i === last ? (closed ? 1 : last) : i + 1]!;\n    const dx = b.x - a.x;\n    const dy = b.y - a.y;\n    const length = Math.hypot(dx, dy);\n    const nx = length > 1e-8 ? -dy / length : 0;\n    const ny = length > 1e-8 ? dx / length : 1;\n    const point = points[i]!;\n    const half = point.width * widthScale * 0.5;\n    for (let side = 0; side < 2; side++) {\n      const sign = side * 2 - 1;\n      positions.set([point.x + nx * half * sign, point.y + ny * half * sign, 0], i * 6 + side * 3);\n      uvs.set([point.distance, side], i * 4 + side * 2);\n    }\n  }\n}\n\nexport function samplePath(points: readonly Point[], fraction: number) {\n  if (points.length < 2) throw Error('A collar requires at least two path points');\n  const distance = ((fraction % 1) + 1) % 1 * points[points.length - 1]!.distance;\n  for (let i = 1; i < points.length; i++) {\n    const a = points[i - 1]!;\n    const b = points[i]!;\n    if (b.distance >= distance || i === points.length - 1) {\n      const t = Math.max(0, Math.min(1, (distance - a.distance) / Math.max(b.distance - a.distance, 1e-8)));\n      return { x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t, angle: Math.atan2(b.y - a.y, b.x - a.x) };\n    }\n  }\n  throw Error('No path segment');\n}\n",
      "fiber-optic-heart/paths.ts": "import { defineComponent } from '@lux/visual-sdk';\nimport { makeLoops } from './geometry.ts';\n\nexport default defineComponent({\n  metadata: {\n    declarationVersion: 1,\n    key: 'fiber-heart/looping-paths',\n    label: 'Looping Spline Paths',\n    description: 'Persistent closed figure-eight strands around a central opening; sampled paths2d for independent renderers.',\n    tags: ['paths', 'loops', 'cables'],\n    inputs: {},\n    outputs: {\n      paths: { type: { kind: 'paths2d', version: 1, coordinateSpace: 'canvas-height' }, label: 'Paths', description: 'Up to sixteen closed paths, 97 points each.' },\n    },\n    controls: {\n      count: { type: 'number', group: 'Shape', label: 'Strands', default: 12, min: 0, max: 16, step: 1 },\n      spread: { type: 'number', group: 'Shape', label: 'Spread', default: 1, min: 0.3, max: 1.4, step: 0.01 },\n      width: { type: 'number', group: 'Shape', label: 'Cable width', default: 0.018, min: 0.002, max: 0.05, step: 0.001 },\n      seed: { type: 'number', group: 'Shape', label: 'Arrangement', default: 7, min: 0, max: 999, step: 1 },\n      motion: { type: 'number', group: 'Motion', label: 'Drift', default: 0.35, min: 0, max: 2, step: 0.01 },\n    },\n    controlDescriptions: {\n      count: 'Number of persistent strands. Existing identities stay stable as more are added.',\n      spread: 'Scales the knot around its central opening.',\n      width: 'Full base width in canvas-height units; renderer style scales this width.',\n      seed: 'Chooses a repeatable arrangement of looping strands.',\n      motion: 'Slow analytic deformation; zero freezes the routes.',\n    },\n    lifecycle: { state: 'stateless', reset: 'seed' },\n  },\n  async create(context) {\n    const aspect = context.settings.width / context.settings.height;\n    let snapshot = makeLoops(0, aspect, { count: 12, spread: 1, width: 0.018, seed: 7, motion: 0.35 });\n    return {\n      update(frame) {\n        snapshot = makeLoops(frame.timeSeconds, aspect, frame.controls);\n      },\n      async evaluate(_inputs, evaluation) {\n        return { paths: evaluation.paths('paths', snapshot) };\n      },\n      reset() {},\n      dispose() {},\n    };\n  },\n});\n",
      "fiber-optic-heart/renderer.ts": "import { defineComponent } from '@lux/visual-sdk';\nimport {\n  AdditiveBlending, BufferAttribute, BufferGeometry, DataTexture, DoubleSide,\n  Mesh, MeshBasicNodeMaterial, NormalBlending, OrthographicCamera, PlaneGeometry,\n  Scene, type Texture,\n} from 'three/webgpu';\nimport { texture, uniform, uv, vec4 } from 'three/tsl';\nimport { MAX_PATHS, POINTS, samplePath, writeStrip } from './geometry.ts';\nimport { collarShader, strandShader } from './strand-shader.ts';\n\nexport default defineComponent({\n  metadata: {\n    declarationVersion: 1,\n    key: 'fiber-heart/neon-path-renderer',\n    label: 'Neon Cables & Ribbons',\n    description: 'Mesh-strip path renderer with luminous filaments, traveling pulses, glossy ribbons, glass-style cables and attached metallic collars.',\n    tags: ['renderer', 'neon', 'ribbons', 'cables'],\n    inputs: {\n      image: { type: { kind: 'image', colorSpace: 'linear-srgb', alphaMode: 'premultiplied' }, label: 'Background', description: 'Image behind the strands.' },\n      paths: { type: { kind: 'paths2d', version: 1, coordinateSpace: 'canvas-height' }, label: 'Paths', description: 'Up to 16 paths with at most 97 points per path.' },\n    },\n    outputs: {\n      image: { type: { kind: 'image', colorSpace: 'linear-srgb', alphaMode: 'premultiplied' }, label: 'Image', description: 'Strands composited over the background.' },\n    },\n    controls: {\n      brightness: { type: 'number', group: 'Light', label: 'Strand brightness', default: 1.3, min: 0, max: 4, step: 0.01 },\n      palette: { type: 'number', group: 'Light', label: 'Cyan to magenta', default: 0.5, min: 0, max: 1, step: 0.01 },\n      pulseSpeed: { type: 'number', group: 'Energy', label: 'Pulse speed', default: 0.12, min: -1, max: 1, step: 0.01 },\n      pulseWidth: { type: 'number', group: 'Energy', label: 'Pulse length', default: 0.07, min: 0.01, max: 0.3, step: 0.005 },\n      pulseStrength: { type: 'number', group: 'Energy', label: 'Pulse strength', default: 2, min: 0, max: 6, step: 0.01 },\n      ribbons: { type: 'number', group: 'Structure', label: 'Broad ribbons', default: 3, min: 0, max: 6, step: 1 },\n      ribbonWidth: { type: 'number', group: 'Structure', label: 'Ribbon width', default: 4, min: 1, max: 8, step: 0.05 },\n      cables: { type: 'number', group: 'Structure', label: 'Glass-style cables', default: 4, min: 0, max: 8, step: 1 },\n      collars: { type: 'number', group: 'Structure', label: 'Cable collars', default: 0.7, min: 0, max: 1, step: 0.01 },\n    },\n    controlDescriptions: {\n      brightness: 'Strength of strand color and highlights; zero leaves the background untouched.',\n      palette: 'Shifts alternating strands toward cyan or magenta.',\n      pulseSpeed: 'Signed circuits per second. Zero freezes each pulse at its phase.',\n      pulseWidth: 'Fraction of the route illuminated by each traveling packet.',\n      pulseStrength: 'Extra energy in traveling packets; zero gives steady strands.',\n      ribbons: 'First paths rendered as broad dark glossy ribbons. Remaining paths become cables or neon.',\n      ribbonWidth: 'Ribbon width as a multiple of the incoming path width.',\n      cables: 'Paths after the ribbons rendered as glass-style strips, without physical refraction.',\n      collars: 'Visibility of two metallic collars on each glass-style cable.',\n    },\n    lifecycle: { state: 'stateless', reset: 'seed' },\n  },\n  async create(context) {\n    const aspect = context.settings.width / context.settings.height;\n    const camera = new OrthographicCamera(-aspect / 2, aspect / 2, 0.5, -0.5, 0.1, 10);\n    camera.position.z = 2;\n    const scene = new Scene();\n    const fallback = new DataTexture(new Uint8Array([0, 0, 0, 255]), 1, 1);\n    fallback.needsUpdate = true;\n    const backgroundNode = texture(fallback, uv().flipY());\n    const backgroundMaterial = new MeshBasicNodeMaterial({ depthTest: false, depthWrite: false });\n    backgroundMaterial.fragmentNode = backgroundNode;\n    const backgroundGeometry = new PlaneGeometry(aspect, 1);\n    const background = new Mesh(backgroundGeometry, backgroundMaterial);\n    background.renderOrder = -100;\n    scene.add(background);\n\n    const time = uniform(0);\n    const brightness = uniform(1.3);\n    const speed = uniform(0.12);\n    const pulseWidth = uniform(0.07);\n    const strength = uniform(2);\n    const collarGeometry = new PlaneGeometry(1, 1);\n    const collarMaterial = new MeshBasicNodeMaterial({ transparent: true, depthTest: false, depthWrite: false });\n    const collarOpacity = uniform(0.7);\n    const collarColor = collarShader(uv()) as ReturnType<typeof vec4>;\n    collarMaterial.colorNode = collarColor.rgb;\n    collarMaterial.opacityNode = collarColor.a.mul(collarOpacity);\n    const strands = Array.from({ length: MAX_PATHS }, (_, index) => {\n      const positions = new Float32Array(POINTS * 6);\n      const uvs = new Float32Array(POINTS * 4);\n      const indices = new Uint16Array((POINTS - 1) * 6);\n      for (let i = 0; i < POINTS - 1; i++) {\n        const a = i * 2;\n        indices.set([a, a + 1, a + 2, a + 1, a + 3, a + 2], i * 6);\n      }\n      const geometry = new BufferGeometry();\n      geometry.setAttribute('position', new BufferAttribute(positions, 3));\n      geometry.setAttribute('uv', new BufferAttribute(uvs, 2));\n      geometry.setIndex(new BufferAttribute(indices, 1));\n      const tint = uniform(0.5);\n      const phase = uniform(index * 0.137);\n      const style = uniform(0);\n      const opacity = uniform(1);\n      const length = uniform(1);\n      const material = new MeshBasicNodeMaterial({\n        transparent: true, depthTest: false, depthWrite: false, side: DoubleSide,\n      });\n      const color = strandShader(uv(), vec4(tint, brightness, phase, 0), vec4(time, speed, pulseWidth, strength), vec4(style, opacity, length, 0)) as ReturnType<typeof vec4>;\n      material.colorNode = color.rgb;\n      material.opacityNode = color.a;\n      const mesh = new Mesh(geometry, material);\n      mesh.frustumCulled = false;\n      mesh.renderOrder = index * 3;\n      scene.add(mesh);\n      const collars = [0, 1].map(() => {\n        const collar = new Mesh(collarGeometry, collarMaterial);\n        collar.frustumCulled = false;\n        collar.renderOrder = index * 3 + 1;\n        scene.add(collar);\n        return collar;\n      });\n      return { mesh, geometry, material, positions, uvs, tint, phase, style, opacity, length, collars };\n    });\n    let appearance = { palette: 0.5, ribbons: 3, ribbonWidth: 4, cables: 4, collars: 0.7 };\n\n    return {\n      update(frame) {\n        time.value = frame.timeSeconds;\n        brightness.value = frame.controls.brightness;\n        speed.value = frame.controls.pulseSpeed;\n        pulseWidth.value = frame.controls.pulseWidth;\n        strength.value = frame.controls.pulseStrength;\n        appearance = frame.controls;\n      },\n      async evaluate(inputs, evaluation) {\n        const paths = inputs.paths.data.paths;\n        if (paths.length > MAX_PATHS || paths.some(path => path.points.length > POINTS)) {\n          throw Error('Neon renderer supports at most 16 paths of 97 points; no paths were truncated');\n        }\n        backgroundNode.value = inputs.image.texture as Texture;\n        collarOpacity.value = appearance.collars;\n        const ribbonCount = Math.round(appearance.ribbons);\n        const cableCount = Math.round(appearance.cables);\n        for (let index = 0; index < strands.length; index++) {\n          const strand = strands[index]!;\n          const path = paths[index];\n          strand.mesh.visible = Boolean(path && path.points.length >= 2 && brightness.value > 0);\n          for (const collar of strand.collars) collar.visible = false;\n          if (!path || !strand.mesh.visible) continue;\n          const style = index < ribbonCount ? 1 : index < ribbonCount + cableCount ? 2 : 0;\n          const widthScale = style === 1 ? appearance.ribbonWidth : style === 2 ? 1.7 : 2.8;\n          writeStrip(path.points, strand.positions, strand.uvs, widthScale);\n          strand.geometry.getAttribute('position').needsUpdate = true;\n          strand.geometry.getAttribute('uv').needsUpdate = true;\n          strand.geometry.setDrawRange(0, (path.points.length - 1) * 6);\n          strand.style.value = style;\n          strand.length.value = path.points[path.points.length - 1]!.distance;\n          strand.phase.value = (path.styleSeed % 997) / 997;\n          strand.tint.value = Math.min(1, Math.max(0, appearance.palette + (index % 2 ? 0.35 : -0.35)));\n          strand.opacity.value = path.opacity;\n          const blending = style === 0 ? AdditiveBlending : NormalBlending;\n          if (strand.material.blending !== blending) {\n            strand.material.blending = blending;\n            strand.material.needsUpdate = true;\n          }\n          strand.collars.forEach((collar, collarIndex) => {\n            collar.visible = style === 2 && appearance.collars > 0 && path.opacity > 0.99;\n            if (!collar.visible) return;\n            const point = samplePath(path.points, 0.17 + collarIndex * 0.5 + index * 0.037);\n            collar.position.set(point.x, point.y, 0);\n            collar.rotation.z = point.angle;\n            collar.scale.set(0.025, path.points[0]!.width * widthScale * 1.4, 1);\n          });\n        }\n        return { image: await evaluation.render(scene, camera) };\n      },\n      reset() { time.value = 0; },\n      dispose() {\n        for (const strand of strands) {\n          strand.geometry.dispose();\n          strand.material.dispose();\n        }\n        collarGeometry.dispose();\n        collarMaterial.dispose();\n        backgroundGeometry.dispose();\n        backgroundMaterial.dispose();\n        fallback.dispose();\n      },\n    };\n  },\n});\n",
      "fiber-optic-heart/strand-shader.ts": "import { wgslFn } from 'three/tsl';\n\n// UV.x is cumulative arc distance, UV.y spans the strip. Style: 0 neon,\n// 1 broad opaque ribbon, 2 stylized glass. No physical transmission or bloom pass.\nexport const strandShader = wgslFn(`\nfn fiberStrand(st: vec2f, paint: vec4f, pulse: vec4f, appearance: vec4f) -> vec4f {\n  let across = st.y * 2.0 - 1.0;\n  let edge = abs(across);\n  let aa = max(fwidth(across), 0.002);\n  let coverage = 1.0 - smoothstep(1.0 - aa, 1.0, edge);\n  let tint = mix(vec3f(0.01, 0.85, 0.63), vec3f(0.95, 0.015, 0.40), paint.x);\n  let along = fract(st.x / max(appearance.z, 0.001) - pulse.x * pulse.y + paint.z);\n  let packetDistance = min(along, 1.0 - along);\n  let packet = exp(-pow(packetDistance / max(pulse.z, 0.005), 2.0));\n  let light = 1.0 + packet * pulse.w;\n  let core = exp(-across * across * 350.0);\n  let halo = exp(-across * across * 7.0);\n  var color = tint * paint.y * light;\n  var alpha = (core + halo * 0.16) * coverage;\n  if (appearance.x > 0.5) {\n    let rim = exp(-pow((edge - 0.86) / 0.07, 2.0));\n    let shine = pow(max(0.0, 1.0 - abs(across + 0.30)), 14.0);\n    let twist = 0.6 + 0.4 * sin(st.x * 6.0 + paint.z * 6.28318 + pulse.x * 0.14);\n    let stripes = pow(0.5 + 0.5 * cos(across * 44.0), 12.0);\n    color = vec3f(0.003, 0.009, 0.028) + tint * (0.025 + rim * 0.35 + shine * twist * 0.6);\n    color += tint * packet * pulse.w * stripes * 0.18;\n    alpha = coverage * 0.98;\n    if (appearance.x > 1.5) {\n      color += tint * stripes * 0.12 + vec3f(0.35, 0.53, 0.48) * shine;\n      alpha = coverage * (0.22 + rim * 0.65 + shine * 0.35);\n    }\n    color *= paint.y;\n  }\n  return vec4f(color, clamp(alpha * appearance.y, 0.0, 1.0));\n}\n`);\n\nexport const collarShader = wgslFn(`\nfn fiberCollar(st: vec2f) -> vec4f {\n  let side = abs(st.y * 2.0 - 1.0);\n  let band = 1.0 - smoothstep(0.78, 1.0, side);\n  let rim = smoothstep(0.78, 0.93, abs(st.x * 2.0 - 1.0));\n  let shine = exp(-pow((st.y - 0.68) * 12.0, 2.0));\n  let color = vec3f(0.015, 0.027, 0.045) + vec3f(0.35, 0.48, 0.42) * shine\n    + vec3f(0.75, 0.59, 0.25) * rim * 0.7;\n  return vec4f(color, band);\n}\n`);\n"
    }
  },
