  {
    "name": "lux.studio.build",
    "description": "Compile and preview one complete replacement. Read first; expectedDraftVersion prevents overwriting intervening edits. Pass source (plus optional libraryLinks/Story v1) for single-visual scenes, or pass the complete Scene v7 document with no source/libraryLinks/story siblings. For Scene v7, preserve all visuals, sources, caches, animations, settings, tempo and Story v2. Successful builds return Story to Normal. Failed builds retain the working preview.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "expectedDraftVersion": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "entry": {
                  "type": "string",
                  "minLength": 1
                },
                "files": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "sdkVersion": {
                  "type": "string",
                  "enum": [
                    "0.1.0",
                    "0.2.0",
                    "0.4.0"
                  ]
                }
              },
              "required": [
                "entry",
                "files",
                "sdkVersion"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "entry": {
                  "$ref": "#/properties/source/anyOf/0/properties/entry"
                },
                "files": {
                  "$ref": "#/properties/source/anyOf/0/properties/files"
                },
                "sdkVersion": {
                  "$ref": "#/properties/source/anyOf/0/properties/sdkVersion"
                },
                "sourceVersion": {
                  "type": "number",
                  "const": 2
                },
                "assets": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "mediaType": {
                        "type": "string",
                        "enum": [
                          "image/bmp",
                          "image/png",
                          "image/jpeg"
                        ]
                      },
                      "encoding": {
                        "type": "string",
                        "const": "base64"
                      },
                      "data": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "mediaType",
                      "encoding",
                      "data"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "entry",
                "files",
                "sdkVersion",
                "sourceVersion",
                "assets"
              ],
              "additionalProperties": false
            }
          ]
        },
        "document": {},
        "libraryLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "componentId": {
                "type": "string",
                "format": "uuid"
              },
              "mountPath": {
                "type": "string",
                "maxLength": 180,
                "pattern": "^(?:[A-Za-z0-9_-]+\\/)*[A-Za-z0-9_-]+$"
              }
            },
            "required": [
              "componentId",
              "mountPath"
            ],
            "additionalProperties": false
          }
        },
        "story": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "version": {
                  "type": "number",
                  "const": 1
                },
                "beats": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "timing": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "sustained"
                              }
                            },
                            "required": [
                              "kind"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "timed"
                              },
                              "durationSeconds": {
                                "type": "number",
                                "exclusiveMinimum": 0
                              }
                            },
                            "required": [
                              "kind",
                              "durationSeconds"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "label",
                      "timing"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 128
                },
                "sequence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "$ref": "#/properties/story/anyOf/0/properties/beats/items/properties/id"
                      },
                      "beatId": {
                        "$ref": "#/properties/story/anyOf/0/properties/beats/items/properties/id"
                      },
                      "follow": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "manual"
                              }
                            },
                            "required": [
                              "kind"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "after"
                              },
                              "seconds": {
                                "type": "number",
                                "exclusiveMinimum": 0
                              }
                            },
                            "required": [
                              "kind",
                              "seconds"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "beatId",
                      "follow"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 1024
                }
              },
              "required": [
                "version",
                "beats",
                "sequence"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "expectedDraftVersion"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
