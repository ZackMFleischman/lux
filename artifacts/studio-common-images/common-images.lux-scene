    "entry": "visual.ts",
    "files": {
      "visual.ts": "import { defineVisual } from '@lux/visual-sdk';\nimport { Color, Scene, Mesh, PlaneGeometry, MeshBasicNodeMaterial, OrthographicCamera, DataTexture, RGBAFormat, UnsignedByteType, NearestFilter, SRGBColorSpace } from 'three/webgpu';\n\nexport default defineVisual({\n  controls: { backdrop: { type: 'number', label: 'Backdrop', min: -1, max: 1, default: -1, step: 1 } },\n  async create(context) {\n    const pixels = context.images.get('assets/alpha.png');\n    if (!pixels) throw Error('Missing required decoded image: assets/alpha.png');\n    const image = new DataTexture(pixels.data, pixels.width, pixels.height, RGBAFormat, UnsignedByteType);\n    image.colorSpace = SRGBColorSpace;\n    image.minFilter = NearestFilter; image.magFilter = NearestFilter;\n    image.flipY = true; image.generateMipmaps = false; image.premultiplyAlpha = false; image.needsUpdate = true;\n    const material = new MeshBasicNodeMaterial();\n    material.map = image; material.toneMapped = false; material.transparent = true; material.depthWrite = false;\n    const geometry = new PlaneGeometry(2, 2), scene = new Scene();\n    scene.add(new Mesh(geometry, material));\n    const camera = new OrthographicCamera(-1, 1, 1, -1, 0, 1);\n    return {\n      update(frame) { const value = frame.controls.backdrop; scene.background = value < 0 ? null : new Color(value, value, value); },\n      render(target) { return context.renderer.render(scene, camera, target); },\n      reset(_seed) {},\n      dispose() { image.dispose(); material.dispose(); geometry.dispose(); },\n    };\n  },\n});\n"
    },
