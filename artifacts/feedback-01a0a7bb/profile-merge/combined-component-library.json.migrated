{
  "format": "lux-component-library",
  "version": 1,
  "components": [
    {
      "id": "84afe10a-a999-40f5-956c-bace96cce23b",
      "revision": 1,
      "name": "Prismatic Observatory",
      "description": "Reusable nested orbital instrument: nine gyroscopic rings, satellites, a crystal heart and a star field. Controls for motion, expansion, inclination and palette.",
      "updatedAt": "2026-09-14T04:53:12.562Z",
      "source": {
        "sdkVersion": "0.4.0",
        "entry": "instrument.ts",
        "files": {
          "instrument.ts": "import {defineComponent} from '@lux/visual-sdk';\nimport {Scene,PerspectiveCamera,Color} from 'three/webgpu';\nimport {makeInstrument} from './parts/instrument.ts';\nexport default defineComponent({metadata:{declarationVersion:1,key:'observatory/orbital-instrument',label:'Orbital instrument',description:'Nested armillary rings, orbiting satellites and a luminous crystalline heart.',tags:['space','generative'],inputs:{},outputs:{image:{type:{kind:'image',colorSpace:'linear-srgb',alphaMode:'premultiplied'},label:'Image',description:'Linear light image'}},controls:{speed:{type:'number',label:'Orbit speed',default:0.35,min:0,max:2,step:0.01},spread:{type:'number',label:'Ring expansion',default:1,min:0.6,max:1.5,step:0.01},twist:{type:'number',label:'Gimbal tilt',default:0.65,min:0,max:1.5,step:0.01},hue:{type:'number',label:'Spectrum',default:0.53,min:0,max:1,step:0.01}},controlDescriptions:{speed:'Speed of the nested orbital assemblies. Zero freezes orbital rotation.',spread:'Radius of the orbital rings around the crystalline core.',twist:'Inclination of each nested gimbal assembly.',hue:'Base hue of the instrument, offset around each orbital assembly.'},lifecycle:{state:'stateful',reset:'seed'}},async create(context){\n const scene=new Scene();scene.background=new Color(0.001,0.002,0.009);\n const camera=new PerspectiveCamera(38,context.settings.width/context.settings.height,0.1,100);camera.position.set(0,0,8);\n const instrument=makeInstrument();scene.add(instrument.root);\n return {update(frame){instrument.update(frame.timeSeconds,frame.controls.speed,frame.controls.spread,frame.controls.twist,frame.controls.hue);},async evaluate(_inputs,evaluation){return {image:await evaluation.render(scene,camera)}},reset(){},dispose(){instrument.dispose()}};\n}});",
          "parts/instrument.ts": "import {Group,Mesh,TorusGeometry,IcosahedronGeometry,SphereGeometry,MeshBasicNodeMaterial,Color,BufferGeometry,Float32BufferAttribute,Points,PointsMaterial,AdditiveBlending} from 'three/webgpu';\nexport function makeInstrument(){\n const root=new Group();const assemblies:Group[]=[];const halos:Mesh[]=[];const mats:MeshBasicNodeMaterial[]=[];\n const ringGeo=new TorusGeometry(1,0.007,6,192);const beadGeo=new SphereGeometry(0.036,10,8);const coreGeo=new IcosahedronGeometry(0.48,1);\n const coreMat=new MeshBasicNodeMaterial({color:0xb2faff,wireframe:true});const core=new Mesh(coreGeo,coreMat);root.add(core);\n for(let i=0;i<9;i++){\n  const assembly=new Group();const orbit=new Group();assembly.add(orbit);root.add(assembly);assemblies.push(assembly);\n  const mat=new MeshBasicNodeMaterial({color:new Color().setHSL(0.52+i*0.043,0.85,0.6)});mats.push(mat);\n  const ring=new Mesh(ringGeo,mat);const r=0.82+i*0.14;ring.scale.setScalar(r);orbit.add(ring);\n  for(let j=0;j<3;j++){const bead=new Mesh(beadGeo,mat);const a=j*Math.PI*2/3;bead.position.set(Math.cos(a)*r,Math.sin(a)*r,0);orbit.add(bead);}\n }\n const haloMat=new MeshBasicNodeMaterial({color:0x245969,transparent:true,opacity:0.48});\n for(let i=0;i<4;i++){const halo=new Mesh(ringGeo,haloMat);halo.scale.setScalar(2.03+i*0.045);root.add(halo);halos.push(halo);}\n const stars:number[]=[];for(let i=0;i<650;i++){const a=i*2.39996323;const r=1.5+Math.sqrt(i/650)*7;stars.push(Math.cos(a)*r,Math.sin(a)*r,-2-(i%7)*0.1);}\n const starGeo=new BufferGeometry();starGeo.setAttribute('position',new Float32BufferAttribute(stars,3));const starMat=new PointsMaterial({color:0x5695ad,size:0.012,transparent:true,opacity:0.65,blending:AdditiveBlending});root.add(new Points(starGeo,starMat));\n return {root,update(t:number,speed:number,spread:number,twist:number,hue:number){root.rotation.z=0.05*Math.sin(t*0.12);core.rotation.set(t*speed*0.6,t*speed*0.4,t*0.1);core.scale.setScalar(1+0.08*Math.sin(t*1.6));assemblies.forEach((g,i)=>{g.rotation.set(twist*Math.sin(i*1.2+t*speed*0.31),twist*Math.cos(i*0.7+t*speed*0.27),i*0.43+t*speed*(i%2?1:-1)*0.3);g.children[0].rotation.z=t*speed*(1+i*0.07);g.scale.setScalar(spread);mats[i].color.setHSL((hue+i*0.044)%1,0.8,0.57);});halos.forEach((h,i)=>{h.rotation.x=0.07*Math.sin(t*0.2+i);});},dispose(){ringGeo.dispose();beadGeo.dispose();coreGeo.dispose();coreMat.dispose();mats.forEach(m=>m.dispose());haloMat.dispose();starGeo.dispose();starMat.dispose();}};\n}"
        }
      }
    },
    {
      "id": "489bada1-64e6-40c6-bae6-9b31077bf0d4",
      "revision": 2,
      "name": "Particle Tornado",
      "description": "Blue particles and amber sparks with adjustable count, height, width, spin, turbulence, size and glow.",
      "updatedAt": "2026-09-15T04:12:52.901Z",
      "source": {
        "sdkVersion": "0.4.0",
        "entry": "particle-tornado-component.ts",
        "files": {
          "particle-tornado-component.ts": "import { defineComponent } from '@lux/visual-sdk';\nimport {\n  Scene,\n  PerspectiveCamera,\n  InstancedMesh,\n  PlaneGeometry,\n  MeshBasicNodeMaterial,\n  Object3D,\n  Color,\n  AdditiveBlending,\n  DynamicDrawUsage,\n} from 'three/webgpu';\nimport { uv, float, uniform } from 'three/tsl';\n\nexport default defineComponent({\n  metadata: {\n    declarationVersion: 1,\n    key: 'particles/tornado',\n    label: 'Particle Tornado',\n    description: 'A luminous blue particle funnel with warm sparks and a swirling ground skirt.',\n    tags: ['particles', 'tornado', 'generative'],\n    inputs: {},\n    outputs: {\n      image: {\n        type: { kind: 'image', colorSpace: 'linear-srgb', alphaMode: 'premultiplied' },\n        label: 'Image',\n        description: 'The rendered particle tornado.',\n      },\n    },\n    controls: {\n      particleCount: { type: 'number', label: 'Particle count', default: 11000, min: 0, max: 50000, step: 100 },\n      height: { type: 'number', label: 'Height', default: 7, min: 1, max: 18, step: 0.1 },\n    spin: { type: 'number', label: 'Spin', default: -0.04, min: -0.25, max: 0.25, step: 0.001 },\n    width: { type: 'number', label: 'Funnel width', default: 1.17, min: 0.1, max: 4, step: 0.01 },\n    turbulence: { type: 'number', label: 'Turbulence', default: 1.25, min: 0, max: 5, step: 0.01 },\n    particleSize: { type: 'number', label: 'Particle size', default: 1.35, min: 0.1, max: 8, step: 0.01 },\n    glow: { type: 'number', label: 'Glow', default: 0.82, min: 0, max: 8, step: 0.01 },\n  },\n    controlDescriptions: {\n      particleCount: 'Total visible particles, including the ground skirt. Higher counts use more GPU and CPU time.',\n      height: 'Funnel height with a fixed camera. Large values extend past the screen edges.',\n      spin: 'Rotation speed. Negative values reverse the vortex.',\n      width: 'Radius multiplier for the funnel and ground skirt.',\n      turbulence: 'Strength of the waves and disturbances in the funnel.',\n      particleSize: 'Particle diameter multiplier.',\n      glow: 'Particle light strength. Zero turns off the particles; higher values add brighter halos.',\n    },\n    lifecycle: { state: 'stateless', reset: 'seed' },\n  },\n  async create(context) {\n    const scene = new Scene();\n    scene.background = new Color('#030711');\n    const camera = new PerspectiveCamera(43, context.settings.width / context.settings.height, 0.1, 100);\n    camera.position.set(0, 3.0, 16.8);\n    camera.lookAt(0, 0.25, 0);\n\n    const capacity = 50000;\n    const geometry = new PlaneGeometry(1, 1);\n    const material = new MeshBasicNodeMaterial();\n    material.transparent = true;\n    material.depthWrite = false;\n    material.blending = AdditiveBlending;\n    const glow = uniform(1);\n    const radius = uv().sub(0.5).length().mul(2);\n    material.opacityNode = float(1).sub(radius).max(0).pow(2).mul(glow);\n    const particles = new InstancedMesh(geometry, material, capacity);\n    particles.instanceMatrix.setUsage(DynamicDrawUsage);\n    particles.frustumCulled = false;\n    scene.add(particles);\n\n    const seeds = new Float32Array(capacity * 4);\n    const transform = new Object3D();\n    transform.quaternion.copy(camera.quaternion);\n    const color = new Color();\n    for (let i = 0; i < capacity; i++) {\n      seeds[i * 4] = context.random();\n      seeds[i * 4 + 1] = context.random();\n      seeds[i * 4 + 2] = context.random();\n      seeds[i * 4 + 3] = context.random();\n      const warm = seeds[i * 4 + 3] > 0.92;\n      color.set(warm ? '#ffad54' : '#75cfff');\n      color.multiplyScalar(0.5 + context.random() * 0.9);\n      particles.setColorAt(i, color);\n    }\n\n    return {\n      update(frame) {\n        const time = frame.timeSeconds;\n        const controls = frame.controls;\n        glow.value = controls.glow;\n        const count = Math.round(controls.particleCount);\n        particles.count = count;\n        // Keep the camera fixed so dimensions can fill or overflow the frame.\n        camera.position.set(0, 3, 16.8);\n        camera.lookAt(0, 0.25, 0);\n        transform.quaternion.copy(camera.quaternion);\n        for (let i = 0; i < count; i++) {\n          const a = seeds[i * 4];\n          const b = seeds[i * 4 + 1];\n          const c = seeds[i * 4 + 2];\n          const d = seeds[i * 4 + 3];\n          const ground = i % 8 === 0;\n          const height = (a + time * 0.055) % 1;\n          const angle = b * Math.PI * 2 + time * controls.spin * (2.2 - height * 0.9) - height * 15;\n          const shell = 0.7 + c * 0.3;\n          const funnel = (0.14 + 2.75 * Math.pow(height, 1.8)) * controls.width;\n          const ripple = Math.sin(angle * 3 + height * 21 - time * 1.4) * 0.12 * controls.turbulence;\n          let radius = funnel * shell + ripple;\n          let y = height * controls.height - controls.height / 2 + 0.05;\n          if (ground) {\n            radius = (0.35 + a * 3.6) * controls.width;\n            y = -controls.height / 2 + Math.sin(b * 16 + time) * 0.06 + c * 0.18;\n          }\n          const bend = Math.sin(height * 3.8 + time * 0.35) * height * 0.38;\n          const x = Math.cos(angle) * radius + (ground ? 0 : bend);\n          const z = Math.sin(angle) * radius;\n          y += Math.sin(angle * 2 + time + c * 8) * 0.10 * controls.turbulence;\n          transform.position.set(x, y, z);\n          const fade = ground ? 0.65 : Math.min(1, height * 18, (1 - height) * 18);\n          const size = (0.025 + d * d * 0.060) * controls.particleSize * Math.max(0.1, fade);\n          transform.scale.set(size, size, size);\n          transform.updateMatrix();\n          particles.setMatrixAt(i, transform.matrix);\n        }\n        particles.instanceMatrix.needsUpdate = true;\n      },\n      async evaluate(_inputs, evaluation) {\n        return { image: await evaluation.render(scene, camera) };\n      },\n      reset(_seed) {},\n      dispose() {\n        geometry.dispose();\n        material.dispose();\n      },\n    };\n  },\n});\r\n"
        }
      }
    },
    {
      "id": "6ea599ba-1669-4a84-8ef0-4306c234715f",
      "revision": 1,
      "name": "Metallic Cube",
      "description": "Reusable spinning metallic cube. Includes a shared cube primitive module with the fan's six-color metallic palette.",
      "updatedAt": "2026-09-15T05:23:57.824Z",
      "source": {
        "sdkVersion": "0.4.0",
        "entry": "component.ts",
        "files": {
          "component.ts": "import { defineComponent } from '@lux/visual-sdk';\nimport {\n  Scene, Color, Mesh, BoxGeometry, MeshStandardNodeMaterial,\n  PerspectiveCamera, AmbientLight, DirectionalLight,\n} from 'three/webgpu';\n\nimport { createCubeKit } from './cube-kit.ts';\n\nexport default defineComponent({\n  metadata: {\n    declarationVersion: 1,\n    key: 'cubes/metallic-cube',\n    label: 'Metallic Cube',\n    description: 'A reusable spinning metallic cube using the same cube primitive as the fan.',\n    tags: ['cubes', 'metallic', 'cascade'],\n    inputs: {},\n    outputs: {\n      image: {\n        type: { kind: 'image', colorSpace: 'linear-srgb', alphaMode: 'premultiplied' },\n        label: 'Image',\n        description: 'A single metallic cube.',\n      },\n    },\n    controls: {\n    spinSpeed: {\n      type: 'number', label: 'Spin speed', default: 0.6,\n      min: -2, max: 2, step: 0.01, unit: 'rad/s',\n    },\n    cubeSize: {\n      type: 'number', label: 'Cube size', default: 0.7,\n      min: 0.15, max: 0.85, step: 0.01,\n    },\n  },\n    controlDescriptions: {\n      spinSpeed: 'Rotation speed of each cube.',\n      cubeSize: 'Size multiplier for the cubes along each trail.',\n    },\n    lifecycle: { state: 'stateless', reset: 'seed' },\n  },\n  async create(context) {\n    const scene = new Scene();\n    scene.background = new Color(0x05070d);\n    const kit = createCubeKit();\n    const cubes: Mesh[] = [];\n    for (let i = 0; i < 1; i++) {\n      const cube = kit.makeCube(Math.floor(i / 28));\n      cubes.push(cube);\n      scene.add(cube);\n    }\n    scene.add(new AmbientLight(0xc4d8ff, 1.5));\n    const key = new DirectionalLight(0xffffff, 6);\n    key.position.set(3, 5, 7);\n    scene.add(key);\n    const rim = new DirectionalLight(0x74bfff, 4);\n    rim.position.set(-5, 1, 3);\n    scene.add(rim);\n    const gold = new DirectionalLight(0xffc5a0, 3);\n    gold.position.set(1, -4, -2);\n    scene.add(gold);\n    const camera = new PerspectiveCamera(\n      45, context.settings.width / context.settings.height, 0.1, 100,\n    );\n    camera.position.z = 5;\n    return {\n      update(frame) {\n        const spin = frame.timeSeconds * frame.controls.spinSpeed;\n        const cube = cubes[0];\n        cube.scale.setScalar(frame.controls.cubeSize * 2);\n        cube.rotation.set(0.35 + spin * 0.45, 0.5 + spin, 0);\n      },\n      async evaluate(_inputs, evaluation) {\n        return { image: await evaluation.render(scene, camera) };\n      },\n      reset(_seed) {},\n      dispose() {\n        kit.dispose();\n      },\n    };\n  },\n});\n",
          "cube-kit.ts": "import { BoxGeometry, Mesh, MeshStandardNodeMaterial } from 'three/webgpu';\n\n// Shared cube primitive. The caller owns the kit and disposes it once.\nexport function createCubeKit() {\n  const geometry = new BoxGeometry(1, 1, 1);\n  const palette = [0x36dccc, 0x368dff, 0x9568eb, 0xf078af, 0xffc678, 0xa4e7f5];\n  const materials = palette.map(color => new MeshStandardNodeMaterial({\n    color,\n    metalness: 0.82,\n    roughness: 0.23,\n  }));\n  return {\n    makeCube(paletteIndex: number) {\n      return new Mesh(geometry, materials[paletteIndex % materials.length]);\n    },\n    dispose() {\n      geometry.dispose();\n      for (const material of materials) material.dispose();\n    },\n  };\n}\n"
        }
      }
    },
    {
      "id": "78a8f505-dde8-4ec4-9e25-934a14ccd31a",
      "revision": 1,
      "name": "Metallic Cube Fan",
      "description": "The complete six-arm, 168-cube metallic cascade as a reusable image-source component. Uses the shared cube primitive, with spin, spread, cascade speed and size controls.",
      "updatedAt": "2026-09-15T05:24:11.043Z",
      "source": {
        "sdkVersion": "0.4.0",
        "entry": "component.ts",
        "files": {
          "component.ts": "import { defineComponent } from '@lux/visual-sdk';\nimport {\n  Scene, Color, Mesh, BoxGeometry, MeshStandardNodeMaterial,\n  PerspectiveCamera, AmbientLight, DirectionalLight,\n} from 'three/webgpu';\n\nimport { createCubeKit } from './cube-kit.ts';\n\nexport default defineComponent({\n  metadata: {\n    declarationVersion: 1,\n    key: 'cubes/metallic-fan',\n    label: 'Metallic Cube Fan',\n    description: 'Six fanned trails of spinning metallic cubes.',\n    tags: ['cubes', 'metallic', 'cascade'],\n    inputs: {},\n    outputs: {\n      image: {\n        type: { kind: 'image', colorSpace: 'linear-srgb', alphaMode: 'premultiplied' },\n        label: 'Image',\n        description: 'The full metallic cube fan.',\n      },\n    },\n    controls: {\n    spinSpeed: {\n      type: 'number', label: 'Spin speed', default: 0.6,\n      min: -2, max: 2, step: 0.01, unit: 'rad/s',\n    },\n    spread: {\n      type: 'number', label: 'Fan spread', default: 1.15,\n      min: 0.2, max: 1.6, step: 0.01,\n    },\n    flowSpeed: {\n      type: 'number', label: 'Cascade speed', default: 1.35,\n      min: 0, max: 2, step: 0.01,\n    },\n    cubeSize: {\n      type: 'number', label: 'Cube size', default: 0.7,\n      min: 0.15, max: 0.85, step: 0.01,\n    },\n  },\n    controlDescriptions: {\n      spinSpeed: 'Rotation speed of each cube.',\n      spread: 'Radius multiplier for the six fanned trails.',\n      flowSpeed: 'Speed of the cascading fan motion.',\n      cubeSize: 'Size multiplier for the cubes along each trail.',\n    },\n    lifecycle: { state: 'stateless', reset: 'seed' },\n  },\n  async create(context) {\n    const scene = new Scene();\n    scene.background = new Color(0x05070d);\n    const kit = createCubeKit();\n    const cubes: Mesh[] = [];\n    for (let i = 0; i < 168; i++) {\n      const cube = kit.makeCube(Math.floor(i / 28));\n      cubes.push(cube);\n      scene.add(cube);\n    }\n    scene.add(new AmbientLight(0xc4d8ff, 1.5));\n    const key = new DirectionalLight(0xffffff, 6);\n    key.position.set(3, 5, 7);\n    scene.add(key);\n    const rim = new DirectionalLight(0x74bfff, 4);\n    rim.position.set(-5, 1, 3);\n    scene.add(rim);\n    const gold = new DirectionalLight(0xffc5a0, 3);\n    gold.position.set(1, -4, -2);\n    scene.add(gold);\n    const camera = new PerspectiveCamera(\n      45, context.settings.width / context.settings.height, 0.1, 100,\n    );\n    camera.position.z = 18;\n    return {\n      update(frame) {\n        const time = frame.timeSeconds * frame.controls.flowSpeed;\n        const spin = frame.timeSeconds * frame.controls.spinSpeed;\n        for (let i = 0; i < cubes.length; i++) {\n          const arm = Math.floor(i / 28);\n          const trail = i % 28;\n          const u = trail / 27;\n          const phase = time * 0.65 - u * 2.5 + arm * Math.PI / 3;\n          const radius = (0.8 + u * 7.4) * frame.controls.spread;\n          const cube = cubes[i];\n          cube.position.set(\n            Math.cos(phase) * radius * 1.45,\n            Math.sin(phase) * radius * 0.77 + 0.45 * Math.sin(time * 1.3 + u * 7),\n            Math.sin(u * 5 - time + arm) * 1.7,\n          );\n          const size = frame.controls.cubeSize * (0.55 + u * 0.85);\n          cube.scale.setScalar(size);\n          cube.rotation.set(\n            0.35 + spin * 0.45 + u * 3 + arm,\n            0.5 + spin + u * 4,\n            phase * 0.4,\n          );\n        }\n      },\n      async evaluate(_inputs, evaluation) {\n        return { image: await evaluation.render(scene, camera) };\n      },\n      reset(_seed) {},\n      dispose() {\n        kit.dispose();\n      },\n    };\n  },\n});\n",
          "cube-kit.ts": "import { BoxGeometry, Mesh, MeshStandardNodeMaterial } from 'three/webgpu';\n\n// Shared cube primitive. The caller owns the kit and disposes it once.\nexport function createCubeKit() {\n  const geometry = new BoxGeometry(1, 1, 1);\n  const palette = [0x36dccc, 0x368dff, 0x9568eb, 0xf078af, 0xffc678, 0xa4e7f5];\n  const materials = palette.map(color => new MeshStandardNodeMaterial({\n    color,\n    metalness: 0.82,\n    roughness: 0.23,\n  }));\n  return {\n    makeCube(paletteIndex: number) {\n      return new Mesh(geometry, materials[paletteIndex % materials.length]);\n    },\n    dispose() {\n      geometry.dispose();\n      for (const material of materials) material.dispose();\n    },\n  };\n}\n"
        }
      }
    },
    {
      "id": "80b280b0-c2a7-4f38-a34c-0a18bbb0947d",
      "revision": 1,
      "name": "Prismatic Cube Fan",
      "description": "Reusable metallic cube spiral with 1–20 rainbow arms, palette shift, reversible lightness gradient and cube size taper. Preserves the original Metallic Cube Fan separately.",
      "updatedAt": "2026-09-15T05:26:27.829Z",
      "source": {
        "sdkVersion": "0.4.0",
        "entry": "component.ts",
        "files": {
          "component.ts": "import { defineComponent } from '@lux/visual-sdk';\nimport {\n  Scene, Color, Object3D,\n  PerspectiveCamera, AmbientLight, DirectionalLight,\n} from 'three/webgpu';\n\nimport { createCubeKit } from './cube-kit.ts';\n\nexport default defineComponent({\n  metadata: {\n    declarationVersion: 1,\n    key: 'cubes/prismatic-fan',\n    label: 'Prismatic Cube Fan',\n    description: 'One to twenty rainbow trails with reversible color and size gradients.',\n    tags: ['cubes', 'metallic', 'cascade'],\n    inputs: {},\n    outputs: {\n      image: {\n        type: { kind: 'image', colorSpace: 'linear-srgb', alphaMode: 'premultiplied' },\n        label: 'Image',\n        description: 'The full metallic cube fan.',\n      },\n    },\n    controls: {\n      armCount: {\n        type: 'number', label: 'Spiral arms', default: 10,\n        min: 1, max: 20, step: 1,\n      },\n      hueShift: {\n        type: 'number', label: 'Palette shift', default: 0,\n        min: 0, max: 1, step: 0.01,\n      },\n      colorGradient: {\n        type: 'number', label: 'Arm light gradient', default: 0.35,\n        min: -1, max: 1, step: 0.01,\n      },\n      sizeTaper: {\n        type: 'number', label: 'Cube size taper', default: 0.65,\n        min: -1, max: 1, step: 0.01,\n      },\n    spinSpeed: {\n      type: 'number', label: 'Spin speed', default: 0.6,\n      min: -2, max: 2, step: 0.01, unit: 'rad/s',\n    },\n    spread: {\n      type: 'number', label: 'Fan spread', default: 1.15,\n      min: 0.2, max: 1.6, step: 0.01,\n    },\n    flowSpeed: {\n      type: 'number', label: 'Cascade speed', default: 1.35,\n      min: 0, max: 2, step: 0.01,\n    },\n    cubeSize: {\n      type: 'number', label: 'Cube size', default: 0.7,\n      min: 0.15, max: 0.85, step: 0.01,\n    },\n  },\n    controlDescriptions: {\n      armCount: 'Number of evenly spaced spiral arms.',\n      hueShift: 'Rotate the rainbow palette across all arms.',\n      colorGradient: 'Positive fades light to dark toward the tip; negative reverses it. Zero is even.',\n      sizeTaper: 'Positive grows cubes toward the tip; negative shrinks them. Zero is uniform.',\n      spinSpeed: 'Rotation speed of each cube.',\n      spread: 'Radius multiplier for the fanned trails.',\n      flowSpeed: 'Speed of the cascading fan motion.',\n      cubeSize: 'Size multiplier for the cubes along each trail.',\n    },\n    lifecycle: { state: 'stateless', reset: 'seed' },\n  },\n  async create(context) {\n    const scene = new Scene();\n    scene.background = new Color(0x05070d);\n    const kit = createCubeKit();\n    const cubes = kit.makeInstances(560);\n    cubes.frustumCulled = false;\n    scene.add(cubes);\n    const cube = new Object3D();\n    const color = new Color();\n    scene.add(new AmbientLight(0xc4d8ff, 1.5));\n    const key = new DirectionalLight(0xffffff, 6);\n    key.position.set(3, 5, 7);\n    scene.add(key);\n    const rim = new DirectionalLight(0x74bfff, 4);\n    rim.position.set(-5, 1, 3);\n    scene.add(rim);\n    const gold = new DirectionalLight(0xffc5a0, 3);\n    gold.position.set(1, -4, -2);\n    scene.add(gold);\n    const camera = new PerspectiveCamera(\n      45, context.settings.width / context.settings.height, 0.1, 100,\n    );\n    camera.position.z = 18;\n    return {\n      update(frame) {\n        const time = frame.timeSeconds * frame.controls.flowSpeed;\n        const spin = frame.timeSeconds * frame.controls.spinSpeed;\n        const armCount = Math.round(frame.controls.armCount);\n        cubes.count = armCount * 28;\n        for (let i = 0; i < cubes.count; i++) {\n          const arm = Math.floor(i / 28);\n          const trail = i % 28;\n          const u = trail / 27;\n          const phase = time * 0.65 - u * 2.5 + arm * Math.PI * 2 / armCount;\n          const radius = (0.8 + u * 7.4) * frame.controls.spread;\n\n          cube.position.set(\n            Math.cos(phase) * radius * 1.45,\n            Math.sin(phase) * radius * 0.77 + 0.45 * Math.sin(time * 1.3 + u * 7),\n            Math.sin(u * 5 - time + arm) * 1.7,\n          );\n          const size = frame.controls.cubeSize * (0.975 + (u - 0.5) * 1.3 * frame.controls.sizeTaper);\n          cube.scale.setScalar(size);\n          cube.rotation.set(\n            0.35 + spin * 0.45 + u * 3 + arm,\n            0.5 + spin + u * 4,\n            phase * 0.4,\n          );\n          cube.updateMatrix();\n          cubes.setMatrixAt(i, cube.matrix);\n          const hue = (0.46 + arm / armCount + frame.controls.hueShift) % 1;\n          const lightness = 0.55 + (0.5 - u) * frame.controls.colorGradient * 0.65;\n          color.setHSL(hue, 0.78, lightness);\n          cubes.setColorAt(i, color);\n        }\n        cubes.instanceMatrix.needsUpdate = true;\n        if (cubes.instanceColor) cubes.instanceColor.needsUpdate = true;\n      },\n      async evaluate(_inputs, evaluation) {\n        return { image: await evaluation.render(scene, camera) };\n      },\n      reset(_seed) {},\n      dispose() {\n        cubes.dispose();\n        kit.dispose();\n      },\n    };\n  },\n});\n",
          "cube-kit.ts": "import { BoxGeometry, InstancedMesh, Mesh, MeshStandardNodeMaterial } from 'three/webgpu';\n\n// Shared cube primitive. The caller owns the kit and disposes it once.\nexport function createCubeKit() {\n  const geometry = new BoxGeometry(1, 1, 1);\n  const palette = [0x36dccc, 0x368dff, 0x9568eb, 0xf078af, 0xffc678, 0xa4e7f5];\n  const materials = palette.map(color => new MeshStandardNodeMaterial({\n    color,\n    metalness: 0.82,\n    roughness: 0.23,\n  }));\n  const instanceMaterial = new MeshStandardNodeMaterial({\n    color: 0xffffff, metalness: 0.82, roughness: 0.23,\n  });\n  return {\n    makeInstances(count: number) {\n      return new InstancedMesh(geometry, instanceMaterial, count);\n    },\n    makeCube(paletteIndex: number) {\n      return new Mesh(geometry, materials[paletteIndex % materials.length]);\n    },\n    dispose() {\n      geometry.dispose();\n      instanceMaterial.dispose();\n      for (const material of materials) material.dispose();\n    },\n  };\n}\n"
        }
      }
    },
    {
      "id": "e84c1b88-e3b7-447a-85dd-38ebeddbfe28",
      "revision": 1,
      "name": "Colorful Sweeping Beams",
      "description": "Layered colorful beams with width, length, sweep speed, angle, pulse, brightness and palette controls.",
      "updatedAt": "2026-09-15T06:08:12.475Z",
      "source": {
        "sdkVersion": "0.4.0",
        "entry": "component.ts",
        "files": {
          "component.ts": "import { defineComponent } from '@lux/visual-sdk';\nimport {\n  Scene, Color, Group, Mesh, MeshBasicNodeMaterial,\n  OrthographicCamera, PlaneGeometry, AdditiveBlending,\n} from 'three/webgpu';\n\nexport default defineComponent({\n  metadata: {\n    declarationVersion: 1,\n    key: 'lights/sweeping-beams',\n    label: 'Colorful Sweeping Beams',\n    description: 'Fifty layered colorful beams with sweeping, pulsing motion.',\n    tags: ['beams', 'lights'],\n    inputs: {},\n    outputs: {\n      image: {\n        type: { kind: 'image', colorSpace: 'linear-srgb', alphaMode: 'premultiplied' },\n        label: 'Image',\n        description: 'The sweeping beam formation.',\n      },\n    },\n    controls: {\n      palette: {\n        type: 'number', label: 'Palette: 0 Fire / 1 Sunset / 2 Acid / 3 Rainbow', default: 0,\n        min: 0, max: 3, step: 1,\n      },\n      hueShift: {\n        type: 'number', label: 'Palette hue shift', default: 0,\n        min: 0, max: 1, step: 0.01,\n      },\n      paletteSpread: {\n        type: 'number', label: 'Palette spread', default: 1,\n        min: 0, max: 2, step: 0.01,\n      },\n      colorCycleSpeed: {\n        type: 'number', label: 'Palette cycle speed', default: 0,\n        min: 0, max: 0.5, step: 0.005,\n      },\n      beamHueOffset: {\n        type: 'number', label: 'Beam hue offset', default: 0,\n        min: -0.5, max: 0.5, step: 0.01,\n      },\n      beamSaturation: {\n        type: 'number', label: 'Beam saturation', default: 1,\n        min: 0, max: 1, step: 0.01,\n      },\n      backgroundBrightness: {\n        type: 'number', label: 'Background brightness', default: 0.15,\n        min: 0, max: 1, step: 0.01,\n      },\n      beamWidth: {\n        type: 'number', label: 'Beam width', default: 1,\n        min: 0.1, max: 5, step: 0.01,\n      },\n      beamLength: {\n        type: 'number', label: 'Beam length', default: 5.5,\n        min: 0.5, max: 12, step: 0.1,\n      },\n      beamSweepSpeed: {\n        type: 'number', label: 'Beam sweep speed', default: 0.65,\n        min: 0, max: 4, step: 0.01,\n      },\n      beamSweepAngle: {\n        type: 'number', label: 'Beam sweep angle', default: 0.65,\n        min: 0, max: 1.5, step: 0.01,\n      },\n      beamPulseDepth: {\n        type: 'number', label: 'Beam pulse strength', default: 0.6,\n        min: 0, max: 1, step: 0.01,\n      },\n      beamBrightness: { type: 'number', label: 'Beam brightness', default: 0.7, min: 0, max: 1, step: 0.01 },\n      danceSpeed: { type: 'number', label: 'Pulse / sway speed', default: 1.2, min: 0, max: 3, step: 0.01 },\n      dabDepth: { type: 'number', label: 'Emitter sway depth', default: 1, min: 0, max: 1.4, step: 0.01 },\n    },\n    controlDescriptions: {\n      palette: 'Select Fire, Sunset, Acid neon, or full Rainbow.',\n      hueShift: 'Rotate all beam hues.',\n      paletteSpread: 'Palette width. Zero gives one hue.',\n      colorCycleSpeed: 'Hue cycles per second. Zero keeps colors fixed.',\n      beamHueOffset: 'Shift beams relative to the palette.',\n      beamSaturation: 'Separate beam saturation.',\n      backgroundBrightness: 'Warm background level. Zero is black.',\n      beamWidth: 'Width multiplier for the beam core and glow.',\n      beamLength: 'Length of each beam from its beacon.',\n      beamSweepSpeed: 'Sweep speed. Zero holds the sweep still.',\n      beamSweepAngle: 'Maximum side-to-side sweep in radians.',\n      beamPulseDepth: 'Zero gives steady brightness; one pulses down to black.',\n      beamBrightness: 'Brightness of the sweeping rainbow beams.',\n      danceSpeed: 'Speed of the repeating dance.',\n      dabDepth: 'Strength of the emitter tilt.',\n    },\n    lifecycle: { state: 'stateless', reset: 'seed' },\n  },\n  async create(context) {\n    const scene = new Scene();\n    scene.background = new Color(0x080b22);\n    const aspect = context.settings.width / context.settings.height;\n    const camera = new OrthographicCamera(-9 * aspect, 9 * aspect, 9, -9, 0.1, 100);\n    camera.position.set(0, 0, 30);\n    // Each beacon emits a layered colorful beam that follows its head.\n    const beamGeometry = new PlaneGeometry(1, 1);\n    beamGeometry.translate(0, 0.5, 0);\n    const beams: { root: Group; materials: MeshBasicNodeMaterial[] }[] = [];\n    for (let i = 0; i < 50; i++) {\n      const root = new Group();\n      root.position.set(0, 0.91, -0.08);\n      const materials: MeshBasicNodeMaterial[] = [];\n      for (let layer = 0; layer < 3; layer++) {\n        const material = new MeshBasicNodeMaterial({\n          color: new Color().setHSL((i % 10) / 10, 1, 0.55),\n          transparent: true,\n          opacity: 0.2,\n          blending: AdditiveBlending,\n          depthWrite: false,\n        });\n        const beam = new Mesh(beamGeometry, material);\n        beam.scale.set([0.055, 0.18, 0.42][layer], 5.5, 1);\n        root.add(beam);\n        materials.push(material);\n      }\n      beams.push({ root, materials });\n    }\n    const dancers: { root: Group; head: Group }[] = [];\n    for (let i = 0; i < 50; i++) {\n      const root = new Group();\n      root.position.set((i % 10 - 4.5) * 3.05, (2 - Math.floor(i / 10)) * 3.35 - 1.05, 0);\n      scene.add(root);\n      const head = new Group();\n      head.position.y = 1.88;\n      root.add(head);\n      head.add(beams[i].root);\n      dancers.push({ root, head });\n    }\n    return {\n      update(frame) {\n        const time = frame.timeSeconds * frame.controls.danceSpeed * 3;\n        const c = frame.controls;\n        const preset = Math.round(c.palette);\n        const startHue = [0.005, 0.92, 0.18, 0][preset];\n        const hueWidth = [0.12, 0.22, 0.65, 0.85][preset] * c.paletteSpread;\n        const cycle = frame.timeSeconds * c.colorCycleSpeed;\n        const wrapHue = (hue: number) => ((hue % 1) + 1) % 1;\n        const baseHue = startHue + c.hueShift + cycle;\n        scene.background = new Color().setRGB(\n          c.backgroundBrightness * 0.02,\n          c.backgroundBrightness * 0.001,\n          c.backgroundBrightness * 0.003,\n        );\n        for (let i = 0; i < beams.length; i++) {\n          const beam = beams[i];\n          beam.root.rotation.z = Math.sin(frame.timeSeconds * c.beamSweepSpeed + i * 0.3) * c.beamSweepAngle;\n          beam.root.scale.set(c.beamWidth, c.beamLength / 5.5, 1);\n          const pulse = 1 - c.beamPulseDepth * 0.5 + c.beamPulseDepth * 0.5 * Math.sin(time + i * 0.5);\n          for (let layer = 0; layer < beam.materials.length; layer++) {\n            beam.materials[layer].color.setHSL(\n              wrapHue(baseHue + (i % 10) / 9 * hueWidth + c.beamHueOffset),\n              c.beamSaturation,\n              0.5,\n            );\n            beam.materials[layer].opacity = frame.controls.beamBrightness\n              * pulse * [0.8, 0.16, 0.045][layer];\n          }\n        }\n        for (let i = 0; i < dancers.length; i++) {\n          const dancer = dancers[i];\n          const pulse = (0.5 + 0.5 * Math.sin(time - (i % 10) * 0.28 - Math.floor(i / 10) * 0.4));\n          const dab = (0.35 + 0.65 * pulse) * frame.controls.dabDepth;\n          dancer.root.rotation.z = 0.08 * Math.sin(time - i * 0.15) - dab * 0.1;\n          dancer.head.rotation.z = dab * 0.38;\n          dancer.head.rotation.x = dab * 0.18;\n        }\n      },\n      async evaluate(_inputs, evaluation) {\n        return { image: await evaluation.render(scene, camera) };\n      },\n      reset(_seed) {},\n      dispose() {\n        beamGeometry.dispose();\n        for (const beam of beams) {\n          for (const material of beam.materials) material.dispose();\n        }\n      },\n    };\n  },\n});\n"
        }
      }
    },
    {
      "id": "f573cb7b-c14a-4051-b4f3-d11111a5c4a0",
      "revision": 1,
      "name": "Dancing Space Needle Dabbers",
      "description": "Fifty dancing Space Needle characters with dab depth, dance speed and vivid palette controls; beams saved separately.",
      "updatedAt": "2026-09-15T06:08:40.671Z",
      "source": {
        "sdkVersion": "0.4.0",
        "entry": "component.ts",
        "files": {
          "component.ts": "import { defineComponent } from '@lux/visual-sdk';\nimport {\n  Scene, Color, Group, Mesh, CylinderGeometry, SphereGeometry,\n  MeshStandardNodeMaterial, MeshBasicNodeMaterial, OrthographicCamera,\n  AmbientLight, DirectionalLight, Vector3,\n} from 'three/webgpu';\n\nexport default defineComponent({\n  metadata: {\n    declarationVersion: 1,\n    key: 'dance/space-needles',\n    label: 'Dancing Space Needle Dabbers',\n    description: 'Fifty neon Space Needle characters performing a staggered dab.',\n    tags: ['dance', 'architecture'],\n    inputs: {},\n    outputs: {\n      image: {\n        type: { kind: 'image', colorSpace: 'linear-srgb', alphaMode: 'premultiplied' },\n        label: 'Image',\n        description: 'The dancing formation.',\n      },\n    },\n    controls: {\n      palette: {\n        type: 'number', label: 'Palette: 0 Fire / 1 Sunset / 2 Acid / 3 Rainbow', default: 0,\n        min: 0, max: 3, step: 1,\n      },\n      hueShift: {\n        type: 'number', label: 'Palette hue shift', default: 0,\n        min: 0, max: 1, step: 0.01,\n      },\n      paletteSpread: {\n        type: 'number', label: 'Palette spread', default: 1,\n        min: 0, max: 2, step: 0.01,\n      },\n      saturation: {\n        type: 'number', label: 'Color saturation', default: 1,\n        min: 0, max: 1, step: 0.01,\n      },\n      colorBrightness: {\n        type: 'number', label: 'Tower brightness', default: 0.85,\n        min: 0.1, max: 1, step: 0.01,\n      },\n      bodyHueOffset: {\n        type: 'number', label: 'Tower body hue offset', default: 0,\n        min: -0.5, max: 0.5, step: 0.01,\n      },\n      colorCycleSpeed: {\n        type: 'number', label: 'Palette cycle speed', default: 0,\n        min: 0, max: 0.5, step: 0.005,\n      },\n      backgroundBrightness: {\n        type: 'number', label: 'Background brightness', default: 0.15,\n        min: 0, max: 1, step: 0.01,\n      },\n      danceSpeed: { type: 'number', label: 'Dance speed', default: 1.2, min: 0, max: 3, step: 0.01 },\n      dabDepth: { type: 'number', label: 'Dab depth', default: 1, min: 0, max: 1.4, step: 0.01 },\n    },\n    controlDescriptions: {\n      palette: 'Select Fire, Sunset, Acid neon, or full Rainbow.',\n      hueShift: 'Rotate all tower hues.',\n      paletteSpread: 'Palette width. Zero gives one hue.',\n      saturation: 'One is vivid; zero is grayscale.',\n      colorBrightness: 'Brightness without adding pastel white.',\n      bodyHueOffset: 'Shift supports and deck relative to arms and roof.',\n      colorCycleSpeed: 'Hue cycles per second. Zero keeps colors fixed.',\n      backgroundBrightness: 'Warm background level. Zero is black.',\n      danceSpeed: 'Speed of the repeating dance.',\n      dabDepth: 'Strength of the head dip and arm pose.',\n    },\n    lifecycle: { state: 'stateless', reset: 'seed' },\n  },\n  async create(context) {\n    const scene = new Scene();\n    scene.background = new Color(0x080b22);\n    const aspect = context.settings.width / context.settings.height;\n    const camera = new OrthographicCamera(-9 * aspect, 9 * aspect, 9, -9, 0.1, 100);\n    camera.position.set(0, 0, 30);\n    const rod = new CylinderGeometry(1, 1, 1, 8);\n    const saucer = new CylinderGeometry(0.39, 0.66, 0.17, 24);\n    const roof = new CylinderGeometry(0.08, 0.66, 0.19, 24);\n    const glass = new CylinderGeometry(0.43, 0.48, 0.18, 24);\n    const ball = new SphereGeometry(1, 8, 6);\n    const steel = new MeshBasicNodeMaterial({ color: 0xff6500 });\n    const windows = new MeshBasicNodeMaterial({ color: 0x641209 });\n    const accents = [0xffdd00, 0xff7900, 0xff3045, 0xffb000, 0xff4930].map(\n      color => new MeshBasicNodeMaterial({ color }),\n    );\n    scene.add(new AmbientLight(0xffe0b0, 2));\n    const light = new DirectionalLight(0xffffff, 4);\n    light.position.set(-4, 8, 12);\n    scene.add(light);\n    const up = new Vector3(0, 1, 0);\n    const delta = new Vector3();\n    function segment(parent: Group, material: MeshStandardNodeMaterial | MeshBasicNodeMaterial) {\n      const mesh = new Mesh(rod, material);\n      parent.add(mesh);\n      return mesh;\n    }\n    function link(mesh: Mesh, ax: number, ay: number, az: number, bx: number, by: number, bz: number, radius: number) {\n      delta.set(bx - ax, by - ay, bz - az);\n      mesh.position.set((ax + bx) / 2, (ay + by) / 2, (az + bz) / 2);\n      mesh.scale.set(radius, delta.length(), radius);\n      mesh.quaternion.setFromUnitVectors(up, delta.normalize());\n    }\n    const dancers: { root: Group; head: Group; arms: Mesh[] }[] = [];\n    for (let i = 0; i < 50; i++) {\n      const root = new Group();\n      root.position.set((i % 10 - 4.5) * 3.05, (2 - Math.floor(i / 10)) * 3.35 - 1.05, 0);\n      scene.add(root);\n      const accent = accents[Math.floor(i / 10)];\n      // Three splayed supports converge below the observation deck.\n      for (let leg = 0; leg < 3; leg++) {\n        const angle = leg * Math.PI * 2 / 3 + Math.PI / 6;\n        const x = Math.cos(angle) * 0.48;\n        const z = Math.sin(angle) * 0.3;\n        link(segment(root, steel), x, 0, z, x * 0.24, 1.05, z * 0.24, 0.047);\n        link(segment(root, steel), x * 0.24, 1.05, z * 0.24, x * 0.4, 1.92, z * 0.4, 0.047);\n      }\n      const head = new Group();\n      head.position.y = 1.88;\n      root.add(head);\n      const lower = new Mesh(saucer, steel);\n      head.add(lower);\n      const deck = new Mesh(glass, windows);\n      deck.position.y = 0.15;\n      head.add(deck);\n      const top = new Mesh(roof, accent);\n      top.position.y = 0.32;\n      head.add(top);\n      link(segment(head, steel), 0, 0.4, 0, 0, 0.9, 0, 0.023);\n      const beacon = new Mesh(ball, accent);\n      beacon.scale.setScalar(0.045);\n      beacon.position.y = 0.91;\n      head.add(beacon);\n      const arms = [segment(root, accent), segment(root, accent), segment(root, accent), segment(root, accent)];\n      dancers.push({ root, head, arms });\n    }\n    return {\n      update(frame) {\n        const time = frame.timeSeconds * frame.controls.danceSpeed * 3;\n        const c = frame.controls;\n        const preset = Math.round(c.palette);\n        const startHue = [0.005, 0.92, 0.18, 0][preset];\n        const hueWidth = [0.12, 0.22, 0.65, 0.85][preset] * c.paletteSpread;\n        const cycle = frame.timeSeconds * c.colorCycleSpeed;\n        const wrapHue = (hue: number) => ((hue % 1) + 1) % 1;\n        // Keep lightness below 0.5 to avoid whitening saturated colors.\n        const level = c.colorBrightness * 0.5;\n        const baseHue = startHue + c.hueShift + cycle;\n        steel.color.setHSL(wrapHue(baseHue + hueWidth * 0.4 + c.bodyHueOffset), c.saturation, level);\n        windows.color.setHSL(wrapHue(baseHue), c.saturation, 0.025);\n        for (let row = 0; row < accents.length; row++) {\n          accents[row].color.setHSL(wrapHue(baseHue + row / 4 * hueWidth), c.saturation, level);\n        }\n        scene.background = new Color().setRGB(\n          c.backgroundBrightness * 0.02,\n          c.backgroundBrightness * 0.001,\n          c.backgroundBrightness * 0.003,\n        );\n        for (let i = 0; i < dancers.length; i++) {\n          const dancer = dancers[i];\n          const pulse = (0.5 + 0.5 * Math.sin(time - (i % 10) * 0.28 - Math.floor(i / 10) * 0.4));\n          const dab = (0.35 + 0.65 * pulse) * frame.controls.dabDepth;\n          dancer.root.rotation.z = 0.08 * Math.sin(time - i * 0.15) - dab * 0.1;\n          dancer.head.rotation.z = dab * 0.38;\n          dancer.head.rotation.x = dab * 0.18;\n          // Right arm extends high; left forearm folds across the saucer face.\n          link(dancer.arms[0], 0.13, 1.6, 0.12, 0.69, 1.65 + dab * 0.25, 0.14, 0.065);\n          link(dancer.arms[1], 0.69, 1.65 + dab * 0.25, 0.14, 1.19, 1.68 + dab * 0.65, 0.16, 0.059);\n          link(dancer.arms[2], -0.13, 1.6, 0.12, -0.7, 1.52 + dab * 0.05, 0.22, 0.065);\n          link(dancer.arms[3], -0.7, 1.52 + dab * 0.05, 0.22, -0.16 + dab * 0.2, 1.72 + dab * 0.39, 0.59, 0.059);\n        }\n      },\n      async evaluate(_inputs, evaluation) {\n        return { image: await evaluation.render(scene, camera) };\n      },\n      reset(_seed) {},\n      dispose() {\n        rod.dispose();\n        saucer.dispose();\n        roof.dispose();\n        glass.dispose();\n        ball.dispose();\n        steel.dispose();\n        windows.dispose();\n        for (const material of accents) material.dispose();\n      },\n    };\n  },\n});\n"
        }
      }
    }
  ]
}