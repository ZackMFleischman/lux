{
  "format": "lux-scene",
  "version": 4,
  "source": {
    "sdkVersion": "0.4.0",
    "entry": "composition.ts",
    "files": {
      "background.ts": "import { defineComponent } from '@lux/visual-sdk';\nimport {\n  Mesh,\n  MeshBasicNodeMaterial,\n  OrthographicCamera,\n  PlaneGeometry,\n  Scene,\n} from 'three/webgpu';\nimport { uniform, uv, wgslFn } from 'three/tsl';\n\nconst paperWash = wgslFn(`\nfn wanderingTracerPaper(st: vec2f, time: f32, motion: f32) -> vec4f {\n  let centered = st - 0.5;\n  let broad = 0.5 + 0.5 * sin(centered.x * 5.1 - centered.y * 3.4 + time * 0.13 * motion);\n  let cross = 0.5 + 0.5 * cos(centered.y * 7.3 + centered.x * 2.2 - time * 0.09 * motion);\n  let pool = smoothstep(0.18, 0.92, broad * 0.58 + cross * 0.42);\n  let cool = vec3f(0.12, 0.20, 0.29);\n  let pale = vec3f(0.60, 0.66, 0.61);\n  let warm = vec3f(0.69, 0.57, 0.39);\n  var color = mix(cool, pale, pool);\n  color = mix(color, warm, 0.18 * smoothstep(0.66, 0.95, cross));\n  let vignette = 1.0 - 0.12 * smoothstep(0.28, 0.72, length(centered));\n  return vec4f(color * vignette, 1.0);\n}\n`);\n\nexport default defineComponent({\n  metadata: {\n    declarationVersion: 1,\n    key: 'examples/wandering-tracer-background',\n    label: 'Slow Paper Wash',\n    description: 'An independent moving paper wash used to demonstrate tracer overlay reuse.',\n    tags: ['background', 'demo'],\n    inputs: {},\n    outputs: {\n      image: {\n        type: { kind: 'image', colorSpace: 'linear-srgb', alphaMode: 'premultiplied' },\n        label: 'Image',\n        description: 'Slow paper wash image.',\n      },\n    },\n    controls: {\n      motion: { type: 'number', group: 'Background', label: 'Motion', default: 0.55, min: 0, max: 2, step: 0.01 },\n    },\n    controlDescriptions: {\n      motion: 'Sets the speed of the independent background wash.',\n    },\n    lifecycle: { state: 'stateful', reset: 'seed' },\n  },\n  async create() {\n    const time = uniform(0);\n    const motion = uniform(0.55);\n    const material = new MeshBasicNodeMaterial({ depthTest: false, depthWrite: false });\n    material.fragmentNode = paperWash(uv(), time, motion);\n    const geometry = new PlaneGeometry(2, 2);\n    const mesh = new Mesh(geometry, material);\n    mesh.frustumCulled = false;\n    const scene = new Scene();\n    scene.add(mesh);\n    const camera = new OrthographicCamera(-1, 1, 1, -1, 0, 1);\n    return {\n      update(frame) {\n        time.value = frame.timeSeconds;\n        motion.value = frame.controls.motion;\n      },\n      async evaluate(_inputs, evaluation) {\n        return { image: await evaluation.render(scene, camera) };\n      },\n      reset() {\n        time.value = 0;\n      },\n      dispose() {\n        geometry.dispose();\n        material.dispose();\n      },\n    };\n  },\n});\n",
      "composition.ts": "import { defineComposition } from '@lux/visual-sdk';\n\nimport background from './background.ts';\nimport overlay from './overlay.ts';\n\nexport default defineComposition({\n  label: 'Wandering Tracers',\n  definitions: { background, overlay },\n  nodes: [\n    { id: 'c28d1010-63ac-49c7-8ad7-8cf6458b5101', definition: 'background' },\n    { id: 'c28d2020-63ac-49c7-8ad7-8cf6458b5102', definition: 'overlay' },\n  ],\n  edges: [\n    {\n      id: 'c28d3030-63ac-49c7-8ad7-8cf6458b5103',\n      from: { nodeId: 'c28d1010-63ac-49c7-8ad7-8cf6458b5101', portId: 'image' },\n      to: { nodeId: 'c28d2020-63ac-49c7-8ad7-8cf6458b5102', portId: 'image' },\n      delay: 'none',\n    },\n  ],\n  output: { nodeId: 'c28d2020-63ac-49c7-8ad7-8cf6458b5102', portId: 'image' },\n  expose: [\n    { id: 'backgroundMotion', nodeId: 'c28d1010-63ac-49c7-8ad7-8cf6458b5101', controlId: 'motion' },\n    { id: 'count', nodeId: 'c28d2020-63ac-49c7-8ad7-8cf6458b5102', controlId: 'count' },\n    { id: 'speed', nodeId: 'c28d2020-63ac-49c7-8ad7-8cf6458b5102', controlId: 'speed' },\n    { id: 'curl', nodeId: 'c28d2020-63ac-49c7-8ad7-8cf6458b5102', controlId: 'curl' },\n    { id: 'sway', nodeId: 'c28d2020-63ac-49c7-8ad7-8cf6458b5102', controlId: 'sway' },\n    { id: 'seed', nodeId: 'c28d2020-63ac-49c7-8ad7-8cf6458b5102', controlId: 'seed' },\n    { id: 'width', nodeId: 'c28d2020-63ac-49c7-8ad7-8cf6458b5102', controlId: 'width' },\n    { id: 'pace', nodeId: 'c28d2020-63ac-49c7-8ad7-8cf6458b5102', controlId: 'pace' },\n    { id: 'contrast', nodeId: 'c28d2020-63ac-49c7-8ad7-8cf6458b5102', controlId: 'contrast' },\n    { id: 'hatch', nodeId: 'c28d2020-63ac-49c7-8ad7-8cf6458b5102', controlId: 'hatch' },\n    { id: 'bleed', nodeId: 'c28d2020-63ac-49c7-8ad7-8cf6458b5102', controlId: 'bleed' },\n  ],\n});\n",
      "overlay.ts": "import { defineComposition } from '@lux/visual-sdk';\n\nimport paths from './paths.ts';\nimport renderer from './renderer.ts';\n\nexport default defineComposition({\n  label: 'Wandering Tracer Overlay',\n  definitions: { paths, renderer },\n  nodes: [\n    { id: 'b17c1010-5f6a-4f88-9db5-e8b4e5534201', definition: 'paths' },\n    { id: 'b17c2020-5f6a-4f88-9db5-e8b4e5534202', definition: 'renderer' },\n  ],\n  edges: [\n    {\n      id: 'b17c3030-5f6a-4f88-9db5-e8b4e5534203',\n      from: { nodeId: 'b17c1010-5f6a-4f88-9db5-e8b4e5534201', portId: 'paths' },\n      to: { nodeId: 'b17c2020-5f6a-4f88-9db5-e8b4e5534202', portId: 'paths' },\n      delay: 'none',\n    },\n  ],\n  input: { nodeId: 'b17c2020-5f6a-4f88-9db5-e8b4e5534202', portId: 'image' },\n  output: { nodeId: 'b17c2020-5f6a-4f88-9db5-e8b4e5534202', portId: 'image' },\n  expose: [\n    { id: 'count', nodeId: 'b17c1010-5f6a-4f88-9db5-e8b4e5534201', controlId: 'count' },\n    { id: 'speed', nodeId: 'b17c1010-5f6a-4f88-9db5-e8b4e5534201', controlId: 'speed' },\n    { id: 'curl', nodeId: 'b17c1010-5f6a-4f88-9db5-e8b4e5534201', controlId: 'curl' },\n    { id: 'sway', nodeId: 'b17c1010-5f6a-4f88-9db5-e8b4e5534201', controlId: 'sway' },\n    { id: 'seed', nodeId: 'b17c1010-5f6a-4f88-9db5-e8b4e5534201', controlId: 'seed' },\n    { id: 'width', nodeId: 'b17c1010-5f6a-4f88-9db5-e8b4e5534201', controlId: 'width' },\n    { id: 'pace', nodeId: 'b17c1010-5f6a-4f88-9db5-e8b4e5534201', controlId: 'pace' },\n    { id: 'contrast', nodeId: 'b17c2020-5f6a-4f88-9db5-e8b4e5534202', controlId: 'contrast' },\n    { id: 'hatch', nodeId: 'b17c2020-5f6a-4f88-9db5-e8b4e5534202', controlId: 'hatch' },\n    { id: 'bleed', nodeId: 'b17c2020-5f6a-4f88-9db5-e8b4e5534202', controlId: 'bleed' },\n  ],\n});\n",
      "painting-composition.ts": "import { defineComposition } from '@lux/visual-sdk';\nimport paths from './paths.ts';\nimport painting from './painting.ts';\nimport renderer from './renderer.ts';\n\n// One immutable snapshot drives both region carving and the visible tracer ink.\nexport default defineComposition({\n  label: 'Living Painting — Shared Tracers',\n  definitions: { paths, painting, renderer },\n  nodes: [\n    { id: 'd10d1010-63ac-49c7-8ad7-8cf6458b5101', definition: 'paths' },\n    { id: 'd10d2020-63ac-49c7-8ad7-8cf6458b5102', definition: 'painting' },\n    { id: 'd10d3030-63ac-49c7-8ad7-8cf6458b5103', definition: 'renderer' },\n  ],\n  edges: [\n    { id: 'd10d4010-63ac-49c7-8ad7-8cf6458b5104', from: { nodeId: 'd10d1010-63ac-49c7-8ad7-8cf6458b5101', portId: 'paths' }, to: { nodeId: 'd10d2020-63ac-49c7-8ad7-8cf6458b5102', portId: 'paths' }, delay: 'none' },\n    { id: 'd10d4020-63ac-49c7-8ad7-8cf6458b5105', from: { nodeId: 'd10d1010-63ac-49c7-8ad7-8cf6458b5101', portId: 'paths' }, to: { nodeId: 'd10d3030-63ac-49c7-8ad7-8cf6458b5103', portId: 'paths' }, delay: 'none' },\n    { id: 'd10d4030-63ac-49c7-8ad7-8cf6458b5106', from: { nodeId: 'd10d2020-63ac-49c7-8ad7-8cf6458b5102', portId: 'image' }, to: { nodeId: 'd10d3030-63ac-49c7-8ad7-8cf6458b5103', portId: 'image' }, delay: 'none' },\n  ],\n  output: { nodeId: 'd10d3030-63ac-49c7-8ad7-8cf6458b5103', portId: 'image' },\n  expose: [\n  {\n    \"id\": \"pace\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"pace\"\n  },\n  {\n    \"id\": \"motion\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"motion\"\n  },\n  {\n    \"id\": \"phrasing\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"phrasing\"\n  },\n  {\n    \"id\": \"scale\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"scale\"\n  },\n  {\n    \"id\": \"warp\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"warp\"\n  },\n  {\n    \"id\": \"growth\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"growth\"\n  },\n  {\n    \"id\": \"seed\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"seed\"\n  },\n  {\n    \"id\": \"composition\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"composition\"\n  },\n  {\n    \"id\": \"tension\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"tension\"\n  },\n  {\n    \"id\": \"hierarchy\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"hierarchy\"\n  },\n  {\n    \"id\": \"coverage\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"coverage\"\n  },\n  {\n    \"id\": \"spacing\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"spacing\"\n  },\n  {\n    \"id\": \"curvature\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"curvature\"\n  },\n  {\n    \"id\": \"angle\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"angle\"\n  },\n  {\n    \"id\": \"hatchWidth\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"hatchWidth\"\n  },\n  {\n    \"id\": \"relation\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"relation\"\n  },\n  {\n    \"id\": \"spacingVar\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"spacingVar\"\n  },\n  {\n    \"id\": \"curvatureVar\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"curvatureVar\"\n  },\n  {\n    \"id\": \"angleVar\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"angleVar\"\n  },\n  {\n    \"id\": \"palette\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"palette\"\n  },\n  {\n    \"id\": \"warmth\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"warmth\"\n  },\n  {\n    \"id\": \"contrast\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"contrast\"\n  },\n  {\n    \"id\": \"pooling\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"pooling\"\n  },\n  {\n    \"id\": \"blooms\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"blooms\"\n  },\n  {\n    \"id\": \"outline\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"outline\"\n  },\n  {\n    \"id\": \"inkWarmth\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"inkWarmth\"\n  },\n  {\n    \"id\": \"handDrawn\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"handDrawn\"\n  },\n  {\n    \"id\": \"grain\",\n    \"nodeId\": \"d10d2020-63ac-49c7-8ad7-8cf6458b5102\",\n    \"controlId\": \"grain\"\n  },\n  {\n    \"id\": \"tracerCount\",\n    \"nodeId\": \"d10d1010-63ac-49c7-8ad7-8cf6458b5101\",\n    \"controlId\": \"count\"\n  },\n  {\n    \"id\": \"tracerSpeed\",\n    \"nodeId\": \"d10d1010-63ac-49c7-8ad7-8cf6458b5101\",\n    \"controlId\": \"speed\"\n  },\n  {\n    \"id\": \"tracerCurl\",\n    \"nodeId\": \"d10d1010-63ac-49c7-8ad7-8cf6458b5101\",\n    \"controlId\": \"curl\"\n  },\n  {\n    \"id\": \"tracerSway\",\n    \"nodeId\": \"d10d1010-63ac-49c7-8ad7-8cf6458b5101\",\n    \"controlId\": \"sway\"\n  },\n  {\n    \"id\": \"tracerSeed\",\n    \"nodeId\": \"d10d1010-63ac-49c7-8ad7-8cf6458b5101\",\n    \"controlId\": \"seed\"\n  },\n  {\n    \"id\": \"tracerWidth\",\n    \"nodeId\": \"d10d1010-63ac-49c7-8ad7-8cf6458b5101\",\n    \"controlId\": \"width\"\n  },\n  {\n    \"id\": \"tracerPace\",\n    \"nodeId\": \"d10d1010-63ac-49c7-8ad7-8cf6458b5101\",\n    \"controlId\": \"pace\"\n  },\n  {\n    \"id\": \"tracerContrast\",\n    \"nodeId\": \"d10d3030-63ac-49c7-8ad7-8cf6458b5103\",\n    \"controlId\": \"contrast\"\n  },\n  {\n    \"id\": \"tracerHatch\",\n    \"nodeId\": \"d10d3030-63ac-49c7-8ad7-8cf6458b5103\",\n    \"controlId\": \"hatch\"\n  },\n  {\n    \"id\": \"tracerBleed\",\n    \"nodeId\": \"d10d3030-63ac-49c7-8ad7-8cf6458b5103\",\n    \"controlId\": \"bleed\"\n  }\n],\n});\n",
      "painting.ts": "import { defineComponent, type Paths2DResource } from '@lux/visual-sdk';\nimport {\n  Scene,\n  DataTexture,\n  FloatType,\n  RGBAFormat,\n  NearestFilter,\n  Mesh,\n  PlaneGeometry,\n  MeshBasicNodeMaterial,\n  OrthographicCamera,\n} from 'three/webgpu';\nimport { uniform, texture, uv, vec4, wgslFn } from 'three/tsl';\n\n// A deliberately self-contained painting study. All pattern coordinates share\n// the same slowly deforming sheet; region identities never reseed each frame.\nconst painting = wgslFn(`\nfn livingPainting(st: vec2f, view: vec4f, form: vec4f, hatch: vec4f, pigment: vec4f, ink: vec4f, character: vec4f, music: vec4f, variety: vec4f, tracers: vec4f, trailData: texture_2d<f32>) -> vec4f {\n  let t = view.x;\n  let p = (st - 0.5) * vec2f(view.y, 1.0) * form.x;\n  let seed = vec2f(view.z * 3.17, view.z * 7.31);\n  // Compact regions: a gentle turning current and bounded local perturbations.\n  // Avoid stacked directional shears, which stretched the earlier study.\n  var q = p;\n  let phrase = lpPhrase(p, t);\n  let energy = music.x * (1.0 + music.y * (phrase - 0.5) * 0.85);\n  let turn = form.y * 0.075 * sin(t * 0.055) * exp(-dot(p, p) * 0.035);\n  q += vec2f(-p.y, p.x) * turn;\n  let drift = vec2f(t * 0.009, -t * 0.007);\n  q += form.y * 0.19 * (vec2f(lpNoise(p * 1.25 + seed + drift), lpNoise(p * 1.25 + seed + 48.9 - drift)) - 0.5);\n  q += form.y * 0.065 * (0.65 + energy * 0.35)\n    * (vec2f(lpNoise(p * 3.2 + seed + drift), lpNoise(p * 3.2 + seed + 17.8 - drift)) - 0.5);\n  q += character.y * 0.022 * (vec2f(lpNoise(p * 7.0 + seed), lpNoise(p * 7.0 + seed + 13.8)) - 0.5);\n  let cell = floor(q);\n  var first = 1000.0;\n  var owner = vec2f(0.0);\n  var center = vec2f(0.0);\n  // Nearby weighted seeds trade territory continuously. No frame-wise randomness.\n  for (var y = -2; y <= 2; y++) {\n    for (var x = -2; x <= 2; x++) {\n      let id = cell + vec2f(f32(x), f32(y));\n      let region = lpRegion(id, seed, t, form, music);\n      let site = region.xy;\n      let weight = region.z;\n      let d = dot(q - site, q - site) - weight;\n      if (d < first) {\n        first = d;\n        owner = id;\n        center = site;\n      }\n    }\n  }\n  let r = lpHash2(owner + seed + 7.0);\n  let local = q - center;\n  // True minimum distance to the competing weighted bisectors. The original\n  // first/second shortcut changed denominator abruptly, creating stray arcs.\n  // Reuse the weighted cell's half planes for every tracer.\n  var cellPlanes: array<vec3f, 25>;\n  var planeCount = 0;\n  let ownerWeight = lpRegion(owner, seed, t, form, music).z;\n  var edge = 1000.0;\n  for (var y = -2; y <= 2; y++) {\n    for (var x = -2; x <= 2; x++) {\n      let id = cell + vec2f(f32(x), f32(y));\n      if (any(id != owner)) {\n        let region = lpRegion(id, seed, t, form, music);\n        let site = region.xy;\n        let weight = region.z;\n        let d = dot(q - site, q - site) - weight;\n        let normal = 2.0 * (site - center);\n        let plane = dot(site, site) - weight - dot(center, center) + ownerWeight;\n        cellPlanes[planeCount] = vec3f(normal, plane);\n        planeCount += 1;\n        edge = min(edge, max(0.0, d - first) / max(2.0 * length(site - center), 0.01));\n      }\n    }\n  }\n  let pixelSize = max(length(dpdx(q)), length(dpdy(q)));\n  let edgeAA = clamp(fwidth(edge), 0.0001, pixelSize * 1.4);\n\n  // Broad translucent washes cross region boundaries; local tints add identity.\n  // Pigment has its own gentle movement, so a changing boundary cannot drag\n  // the wash into ribbons. The color phrase answers the shape phrase later.\n  let colorPhrase = lpPhrase(p, t - 7.0);\n  let cloud = lpFbm(p * 1.31 + seed * 0.1 + vec2f(t * 0.008, -t * 0.006));\n  let broad = lpFbm(p * 0.46 + vec2f(3.7 + t * 0.006, 8.2 - t * 0.007));\n  let wash = clamp(broad * 0.4 + cloud * 0.6 + pigment.x * 0.2, 0.0, 1.0);\n  let palettePhase = 0.5 + 0.5 * sin(t * 0.065 + broad * 2.0);\n  let deepPigment = mix(vec3f(0.075, 0.17, 0.31), vec3f(0.065, 0.25, 0.25), palettePhase);\n  let lightPigment = mix(vec3f(0.29, 0.49, 0.68), vec3f(0.30, 0.61, 0.54), palettePhase);\n  var color = mix(deepPigment, lightPigment, smoothstep(0.27, 0.66, wash));\n  let green = smoothstep(0.50, 0.79, lpNoise(p * 0.62 + vec2f(8.0, 2.0) + t * 0.014));\n  color = mix(color, vec3f(0.31, 0.49, 0.31), green * 0.83);\n  let lightCenter = vec2f(sin(t * 0.043 - 0.65) * form.x * view.y * 0.32,\n    cos(t * 0.057 + 0.6) * form.x * 0.26);\n  let secondCenter = vec2f(cos(t * 0.037 + 0.6) * form.x * view.y * 0.34,\n    sin(t * 0.051 - 0.6) * form.x * 0.29);\n  let paleCenter = vec2f(sin(t * 0.029 + 0.1) * form.x * 0.30,\n    cos(t * 0.041 + 1.4) * form.x * 0.23);\n  let lightPool = exp(-dot(p - lightCenter, p - lightCenter) * (0.72 + colorPhrase * 0.30));\n  let secondLight = exp(-dot(p - secondCenter, p - secondCenter) * 0.90);\n  let palePool = exp(-dot(p - paleCenter, p - paleCenter) * 0.62);\n  color = mix(color, vec3f(0.67, 0.74, 0.73), palePool * 0.68);\n  let warmPigment = mix(vec3f(0.90, 0.79, 0.43), vec3f(0.82, 0.63, 0.49), 0.5 + 0.5 * sin(t * 0.033));\n  color = mix(color, warmPigment, clamp((lightPool * 0.85 + secondLight * 0.62) * pigment.y\n    * (1.0 + music.y * 0.13 * (colorPhrase - 0.5)), 0.0, 0.93));\n  let regionTone = lpHash(owner + seed + 61.0);\n  color *= 1.0 + (regionTone - 0.5) * pigment.z * 0.50;\n  color = mix(color, vec3f(0.12, 0.145, 0.30), smoothstep(0.76, 0.98, regionTone) * min(0.82, pigment.z * 0.64));\n  color += (cloud - 0.5) * 0.23;\n  let wet = lpFbm(p * 3.8 + seed * 0.13);\n  let bloomRim = exp(-abs(wet - 0.51) * 82.0);\n  color += character.z * ((wet - 0.5) * 0.18 - bloomRim * 0.023);\n  let pooling = exp(-edge * 23.0) * (0.35 + 0.65 * lpNoise(q * 3.0 + seed));\n  color *= 1.0 - pooling * pigment.w * 0.18;\n\n  let baseWash = color;\n  var underpainting = color;\n  let cream = mix(vec3f(0.89, 0.86, 0.70), vec3f(0.94, 0.79, 0.75), ink.z);\n  let parentDrawing = lpRegionMarks(color, owner, center, local, edge, seed, t,\n    form, hatch, ink, character, music, variety);\n  color = parentDrawing;\n  // Each cut contributes its own daughter style. Combining changes relative to\n  // the parent preserves earlier divisions where different tracers intersect.\n  var totalSplit = 0.0;\n  var styleDelta = vec3f(0.0);\n  var washDelta = vec3f(0.0);\n  for (var traceIndex = 0; traceIndex < 4; traceIndex++) {\n    if (textureLoad(trailData, vec2i(256 + traceIndex, 0), 0).x > 1.0) {\n      let split = lpTracerSplit(p, q, center, owner, cellPlanes, planeCount,\n        t, form.x, view.y, tracers, seed.x, f32(traceIndex), trailData);\n      let childOwner = split.yz;\n      let childTone = lpHash(childOwner + seed + 61.0);\n      // Related but visibly distinct pigments on opposite sides of each cut.\n      let family = lpHash(owner + seed + f32(traceIndex) * 31.7 + 407.0);\n      let coolPigment = mix(vec3f(0.13, 0.28, 0.48), vec3f(0.16, 0.51, 0.43), family);\n      let warmPigment = mix(vec3f(0.85, 0.64, 0.32), vec3f(0.67, 0.43, 0.48), family);\n      let daughterPigment = mix(coolPigment, warmPigment, split.w);\n      let washLight = dot(baseWash, vec3f(0.2126, 0.7152, 0.0722));\n      let childWash = mix(baseWash * (0.84 + childTone * 0.30),\n        daughterPigment * (0.70 + washLight * 0.65), 0.62);\n      let daughterColor = lpRegionMarks(childWash, childOwner, center, local,\n        edge, seed, t, form, hatch, ink, character, music, variety);\n      totalSplit += split.x;\n      styleDelta += (daughterColor - parentDrawing) * split.x;\n      washDelta += (childWash - baseWash) * split.x;\n    }\n  }\n  color += styleDelta / max(1.0, totalSplit);\n  underpainting += washDelta / max(1.0, totalSplit);\n\n  let edgePressure = 0.57 + 0.68 * lpNoise(q * 7.0 + seed)\n    + character.y * 0.13 * sin(q.x * 37.0 + q.y * 21.0);\n  let boundaryWidth = ink.x * 140.0 * pixelSize * edgePressure;\n  let boundary = 1.0 - smoothstep(boundaryWidth - edgeAA * 0.55, boundaryWidth + edgeAA * 0.55, edge);\n  color = mix(color, cream, boundary * (0.62 + 0.32 * lpNoise(q * 2.3 + seed)));\n  // Stationary paper grain avoids animated video noise.\n  let grain = lpHash(floor(st * vec2f(1920.0, 1080.0))) - 0.5;\n  let fibers = lpNoise(p * 92.0) - 0.5;\n  color += (grain * 0.026 + fibers * 0.037) * ink.w;\n  color *= 0.96 + 0.04 * smoothstep(0.0, 0.25, min(min(st.x, 1.0 - st.x), min(st.y, 1.0 - st.y)));\n  return vec4f(pow(clamp(color, vec3f(0.0), vec3f(1.0)), vec3f(2.2)), 1.0);\n}\n\n\nfn lpRegionMarks(baseColor: vec3f, owner: vec2f, center: vec2f, local: vec2f,\n  edge: f32, seed: vec2f, t: f32, form: vec4f, hatch: vec4f, ink: vec4f,\n  character: vec4f, music: vec4f, variety: vec4f) -> vec3f {\n  var color = baseColor;\n  let r = lpHash2(owner + seed + 7.0);\n  // Each region has a durable line family. Angles, fans and wave amplitudes\n  // vary across regions; adjacent strokes inside one family bend together.\n  let linePhrase = lpPhrase(center, t - 3.5);\n  let lineEnergy = music.x * (1.0 + music.y * (linePhrase - 0.5) * 0.85);\n  // Persistent region styles: restrained parallel marks, broad sweeps, fans,\n  // and occasional contours. Shared family traits relate spacing and weight;\n  // independent small variations prevent adjacent regions feeling stamped.\n  let style = lpHash(owner + seed + 211.0);\n  let detail = lpHash2(owner + seed + 317.0);\n  let quietStyle = 1.0 - step(0.25, style);\n  let fanStyle = step(0.65, style) * (1.0 - step(0.90, style));\n  let contourStyle = step(0.90, style);\n  let intrinsicBend = mix(0.72 + detail.x * 0.55, 0.12 + detail.x * 0.22, quietStyle)\n    + fanStyle * 0.43;\n  let regionCurvature = hatch.z * mix(1.0, intrinsicBend, variety.y);\n  let sharedAngle = (lpNoise(center * 0.34 + seed * 0.01) - 0.5) * 2.5;\n  let counterpoint = step(0.77, lpHash(owner + seed + 203.0));\n  let localDirection = (r.x - 0.5) * mix(4.9, 1.35, music.z)\n    + counterpoint * (1.05 + lineEnergy * 0.32) + (detail.y - 0.5) * 0.65;\n  let angle = sharedAngle + localDirection * variety.z + hatch.w\n    + music.y * 0.09 * (linePhrase - 0.5);\n  let axis = vec2f(cos(angle), sin(angle));\n  let along = dot(local, vec2f(-axis.y, axis.x));\n  let across = dot(local, axis);\n  let bend = 0.18 * sin(along * (1.3 + r.y) + r.y * 8.0 + t * 0.10)\n    + 0.16 * (lpNoise(vec2f(along * 2.1 + t * 0.016, r.x * 21.0)) - 0.5)\n    + 0.02 * sin(along * 6.1 - t * 0.07 + r.x * 13.0);\n  let fan = (r.y - 0.5) * (0.28 + fanStyle * 0.85) * along * along;\n  var path = across + regionCurvature * (bend + fan) * (0.82 + lineEnergy * 0.18);\n  if (contourStyle > 0.5) {\n    path = length(local + vec2f(0.68, -0.60)) + regionCurvature * bend * 0.45;\n  }\n  // Three related spacing bands create dense phrases, ordinary passages, rests.\n  let intrinsicSpacing = select(select(0.58, 1.0, detail.x > 0.30), 1.55, detail.x > 0.75)\n    * (0.90 + r.y * 0.20);\n  let spacingBand = mix(1.0, intrinsicSpacing, variety.x);\n  let spacing = hatch.y * spacingBand\n    * (1.0 - music.y * music.x * 0.14 * (linePhrase - 0.5));\n  let phase = path / spacing;\n  let lineId = floor(phase + 0.5);\n  let lineJitter = (lpHash(vec2f(lineId, r.x * 79.0)) - 0.5) * 0.17\n    + character.y * 0.065 * (lpNoise(vec2f(along * 10.0, lineId + r.y * 91.0)) - 0.5);\n  let stripeDistance = abs(fract(phase + 0.5 + lineJitter) - 0.5);\n  let stripeAA = max(fwidth(phase), 0.001);\n  let pressure = 0.73 + 0.36 * lpNoise(vec2f(along * 5.0, lineId * 1.7 + r.y * 4.0))\n    + character.y * 0.20 * sin(along * 18.0 + lineId * 1.9);\n  let intrinsicWeight = clamp(sqrt(intrinsicSpacing) * (0.68 + detail.y * 0.66)\n    * (1.0 + quietStyle * 0.12), 0.48, 1.65);\n  let regionWeight = ink.y * mix(1.0, intrinsicWeight, variety.w);\n  let halfWidth = min(0.28, regionWeight * 4.0 * pressure * stripeAA);\n  let stripe = 1.0 - smoothstep(halfWidth - stripeAA * 0.5, halfWidth + stripeAA * 0.5, stripeDistance);\n  // Dense at lower/right, breathing room upper/left, slowly shifting overall.\n  let position = center / form.x;\n  let activity = smoothstep(-0.28, 0.30, position.x * 0.67 - position.y * 0.9 + 0.035 + 0.055 * sin(t * 0.045));\n  let quiet = exp(-dot(center - vec2f(-0.8, 0.65), center - vec2f(-0.8, 0.65)) * 0.40);\n  let eligibility = lpHash(owner + seed + 103.0);\n  let score = hatch.x + character.x * ((activity - 0.5) * 0.92 - quiet * 0.29)\n    + music.y * 0.07 * (linePhrase - 0.5);\n  var coverage = smoothstep(eligibility - 0.045, eligibility + 0.045, score);\n  coverage *= smoothstep(0.0, 0.1, hatch.x);\n  coverage = mix(coverage, 1.0, smoothstep(0.94, 1.0, hatch.x));\n  let growth = 0.80 + music.y * 0.23 * linePhrase + 0.05 * r.y;\n  let reveal = 1.0 - smoothstep(growth - 0.08, growth + 0.08, along * 0.31 + 0.40);\n  let inset = smoothstep(0.003, 0.012, edge);\n  // A few small empty islands give the drawing secondary scale and punctuation.\n  let islandDistance = length((local - vec2f(0.08, -0.05)) * vec2f(0.9, 1.3)) - (0.045 + r.x * 0.055);\n  let islandAA = max(fwidth(islandDistance), 0.001);\n  let islandActive = step(0.89, r.y) * smoothstep(0.025, 0.065, edge);\n  let island = (1.0 - smoothstep(-islandAA, islandAA, islandDistance)) * islandActive;\n  // A sparse, stable second family runs perpendicular to the primary axis.\n  // Keep it lighter and more open so crosshatched regions remain accents.\n  let crossStyle = lpHash(owner + seed + 509.0);\n  let crossEligible = step(0.81, crossStyle) * (1.0 - contourStyle);\n  let crossBend = regionCurvature * 0.065\n    * sin(across * (1.5 + detail.y) + r.x * 9.0 + t * 0.08);\n  let crossPhase = (along + crossBend) / (spacing * (1.18 + detail.y * 0.40));\n  let crossId = floor(crossPhase + 0.5);\n  let crossJitter = (lpHash(vec2f(crossId, r.y * 91.0)) - 0.5) * 0.12;\n  let crossDistance = abs(fract(crossPhase + crossJitter + 0.5) - 0.5);\n  let crossAA = max(fwidth(crossPhase), 0.001);\n  let crossWidth = min(0.24, regionWeight * 3.2 * pressure * crossAA);\n  let crossStripe = 1.0 - smoothstep(crossWidth - crossAA * 0.5,\n    crossWidth + crossAA * 0.5, crossDistance);\n  let drawing = 1.0 - (1.0 - stripe) * (1.0 - crossStripe * crossEligible * 0.72);\n  let hatchAlpha = drawing * coverage * reveal * inset * (1.0 - island) * 0.92;\n  let cream = mix(vec3f(0.89, 0.86, 0.70), vec3f(0.94, 0.79, 0.75), ink.z);\n  color = mix(color, cream, hatchAlpha);\n  color = mix(color, color * 0.78, island * 0.38);\n  let islandLine = (1.0 - smoothstep(ink.x, ink.x + islandAA, abs(islandDistance))) * islandActive;\n  color = mix(color, cream, islandLine * 0.70);\n\n  return color;\n}\n\n\n// Consume the exact geometry published by Tracer Paths. The region transition\n// intentionally retains the uneven per-pixel wash behavior of the saved study.\nfn lpTracerSplit(p: vec2f, q: vec2f, center: vec2f, owner: vec2f,\n  planes: array<vec3f, 25>, planeCount: i32, time: f32, scale: f32,\n  aspect: f32, settings: vec4f, seed: f32, index: f32,\n  trailData: texture_2d<f32>) -> vec4f {\n  let slot = i32(index);\n  let metadata = textureLoad(trailData, vec2i(256 + slot, 0), 0);\n  let count = i32(metadata.x);\n  let offset = slot * 64;\n  let sheetOffset = q - p;\n  var crossingEntry = 1000.0;\n  var crossingExit = -1000.0;\n  var nearest = 1000.0;\n  var signedSide = 0.0;\n  for (var j = 0; j < 63; j++) {\n    if (j + 1 >= count) { break; }\n    let a = textureLoad(trailData, vec2i(offset + j, 0), 0);\n    let b = textureLoad(trailData, vec2i(offset + j + 1, 0), 0);\n    let start = a.xy * scale;\n    let direction = (b.xy - a.xy) * scale;\n    let ratio = clamp(dot(p - start, direction) / max(dot(direction, direction), 0.000001), 0.0, 1.0);\n    let delta = p - (start + direction * ratio);\n    let distance = dot(delta, delta);\n    if (distance < nearest) {\n      nearest = distance;\n      signedSide = direction.x * delta.y - direction.y * delta.x;\n    }\n    let origin = start + sheetOffset;\n    // Skip distant segments before clipping against the cell half planes.\n    if (length(origin + direction * 0.5 - center) < 3.5) {\n      var low = 0.0;\n      var high = 1.0;\n      for (var k = 0; k < planeCount; k++) {\n        let numerator = planes[k].z - dot(planes[k].xy, origin);\n        let denominator = dot(planes[k].xy, direction);\n        if (abs(denominator) < 0.00001) {\n          if (numerator < 0.0) { high = -1.0; }\n        } else if (denominator > 0.0) {\n          high = min(high, numerator / denominator);\n        } else {\n          low = max(low, numerator / denominator);\n        }\n      }\n      if (high > low) {\n        crossingEntry = min(crossingEntry, mix(a.w, b.w, low) * scale);\n        crossingExit = max(crossingExit, mix(a.w, b.w, high) * scale);\n      }\n    }\n  }\n  let headDistance = textureLoad(trailData, vec2i(offset + max(count - 1, 0), 0), 0).w * scale;\n  let blend = smoothstep(0.08, 0.25, crossingExit - crossingEntry)\n    * smoothstep(0.0, 0.48, headDistance - crossingExit) * metadata.y;\n  let side = step(0.0, signedSide);\n  let childOwner = owner + vec2f(137.7 + side * 79.3 + index * 53.1,\n    213.1 + metadata.w * 31.7 + side * 43.9 + index * 117.3);\n  return vec4f(blend, childOwner, side);\n}\n\n// A slow rise, a short crest, then a longer release and a quiet interval.\n// Nearby regions share a phrase; its position-dependent delay prevents a pulse\n// that makes the entire image breathe in lockstep.\nfn lpPhrase(position: vec2f, time: f32) -> f32 {\n  let phase = fract(time * 0.028 + lpNoise(position * 0.28 + 19.7) * 0.32);\n  return smoothstep(0.10, 0.58, phase) * (1.0 - smoothstep(0.66, 0.91, phase));\n}\n\nfn lpRegion(id: vec2f, seed: vec2f, time: f32, form: vec4f, music: vec4f) -> vec3f {\n  let random = lpHash2(id + seed);\n  let group = floor(id * 0.5);\n  let slot = id - group * 2.0;\n  let anchorSlot = floor(lpHash(group + seed + 137.0) * 4.0);\n  let anchor = select(0.0, 1.0, slot.x + slot.y * 2.0 == anchorSlot);\n  let phrase = lpPhrase(id + 0.5, time);\n  let groupAngle = lpHash(group + seed + 51.0) * 6.283185;\n  let localAngle = lpHash(id + seed + 87.0) * 6.283185;\n  let motionGate = 0.42 + music.y * 0.58 * phrase;\n  let movement = vec2f(sin(time * 0.10 + groupAngle), cos(time * 0.085 + groupAngle)) * 0.10\n    + vec2f(cos(time * 0.13 + localAngle), sin(time * 0.11 + localAngle)) * 0.045;\n  let site = id + 0.5 + (random - 0.5) * 0.83 + form.z * motionGate * movement;\n  let hierarchy = music.w * (anchor * 0.86 - 0.17);\n  let staticWeight = (lpHash(id + seed + 13.0) - 0.5) * 0.72 + hierarchy;\n  let response = mix(-0.65, 1.0, anchor);\n  let growth = form.w * music.x * 0.37 * response * music.y * (phrase - 0.45);\n  return vec3f(site, staticWeight + growth);\n}\n\nfn lpHash(p: vec2f) -> f32 {\n  var p3 = fract(vec3f(p.x, p.y, p.x) * 0.1031);\n  p3 += dot(p3, p3.yzx + 33.33);\n  return fract((p3.x + p3.y) * p3.z);\n}\n\nfn lpHash2(p: vec2f) -> vec2f {\n  return vec2f(lpHash(p), lpHash(p + vec2f(39.7, 17.2)));\n}\n\nfn lpNoise(p: vec2f) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(lpHash(i), lpHash(i + vec2f(1.0, 0.0)), u.x),\n    mix(lpHash(i + vec2f(0.0, 1.0)), lpHash(i + vec2f(1.0, 1.0)), u.x), u.y);\n}\n\nfn lpFbm(p: vec2f) -> f32 {\n  return lpNoise(p) * 0.56 + lpNoise(p * 2.03 + 7.1) * 0.27 + lpNoise(p * 4.09 + 19.3) * 0.12 + lpNoise(p * 8.13 + 31.7) * 0.05;\n}\n`);\n\nexport default defineComponent({\n  metadata: {\n    declarationVersion: 1, key: 'lux/living-painting', label: 'Living Painting',\n    description: 'Organic watercolor regions that adopt new colors and hatch styles when shared tracer paths cross them.',\n    tags: ['painting', 'regions', 'watercolor'],\n    inputs: { paths: { type: { kind: 'paths2d', version: 1, coordinateSpace: 'canvas-height' }, label: 'Paths', description: 'Shared tracer geometry used to carve the regions.' } },\n    outputs: { image: { type: { kind: 'image', colorSpace: 'linear-srgb', alphaMode: 'premultiplied' }, label: 'Image', description: 'The painting before tracer ink is composited.' } },\n  controls: {\n    pace: { type: 'number', group: 'Motion', label: 'Pace', default: 1.24, min: 0, max: 3, step: 0.01 },\n    motion: { type: 'number', group: 'Motion', label: 'Drift', default: 1.08, min: 0, max: 1.5, step: 0.01 },\n    phrasing: { type: 'number', group: 'Motion', label: 'Tension and release', default: 1, min: 0, max: 1, step: 0.01, description: 'Slow build, crest, release, and rest. Shapes lead; linework and color follow.' },\n\n    scale: { type: 'number', group: 'Regions', label: 'Scale', default: 6.2, min: 2, max: 10, step: 0.01 },\n    warp: { type: 'number', group: 'Regions', label: 'Flowing bends', default: 2.65, min: 0, max: 3, step: 0.01 },\n    growth: { type: 'number', group: 'Regions', label: 'Region growth', default: 0.88, min: 0, max: 1.5, step: 0.01 },\n    seed: { type: 'number', group: 'Regions', label: 'Variation', default: 7, min: 0, max: 100, step: 1 },\n\n    composition: { type: 'number', group: 'Composition', label: 'Quiet to intricate', default: 0.44, min: 0, max: 1.5, step: 0.01 },\n    tension: { type: 'number', group: 'Composition', label: 'Tension', default: 0.72, min: 0, max: 1.5, step: 0.01, description: 'Strength of local pressure, contrasting line directions, and rhythmic compression.' },\n    hierarchy: { type: 'number', group: 'Composition', label: 'Large and small rhythm', default: 0.99, min: 0, max: 1.5, step: 0.01, description: 'Large anchor regions alternate with smaller supporting regions.' },\n\n    coverage: { type: 'number', group: 'Hatching', label: 'Coverage', default: 0.23, min: 0, max: 1, step: 0.01 },\n    spacing: { type: 'number', group: 'Hatching', label: 'Average spacing', default: 0.096, min: 0.015, max: 0.12, step: 0.001, description: 'Overall spacing scale. Each region keeps its own spacing ratio.' },\n    curvature: { type: 'number', group: 'Hatching', label: 'Overall bend', default: 1.52, min: 0, max: 3, step: 0.01, description: 'Strength of distinct regional styles: restrained lines, sweeping curves, fans, and contours.' },\n    angle: { type: 'number', group: 'Hatching', label: 'Direction bias', default: 2.31, min: -3.1416, max: 3.1416, step: 0.01, description: 'Shifts the overall direction while preserving regional relationships.' },\n    hatchWidth: { type: 'number', group: 'Hatching', label: 'Average ink weight', default: 0.12, min: 0.035, max: 0.4, step: 0.005, description: 'Overall stroke weight. Dense patterns tend toward finer strokes; open patterns can carry heavier marks.' },\n    relation: { type: 'number', group: 'Hatching', label: 'Neighboring harmony', default: 0.54, min: 0, max: 1, step: 0.01, description: 'Neighboring patterns share direction, with occasional opposing accents.' },\n\n    spacingVar: { type: 'number', group: 'Regional variety', label: 'Spacing variety', default: 1, min: 0, max: 1, step: 0.01 },\n    curvatureVar: { type: 'number', group: 'Regional variety', label: 'Bend variety', default: 1, min: 0, max: 1, step: 0.01 },\n    angleVar: { type: 'number', group: 'Regional variety', label: 'Direction variety', default: 1.19, min: 0, max: 1.5, step: 0.01 },\n\n    palette: { type: 'number', group: 'Color & watercolor', label: 'Wash lightness', default: 0.07, min: -1, max: 1, step: 0.01 },\n    warmth: { type: 'number', group: 'Color & watercolor', label: 'Warm pools', default: 1.3, min: 0, max: 2, step: 0.01 },\n    contrast: { type: 'number', group: 'Color & watercolor', label: 'Region contrast', default: 1.05, min: 0, max: 2, step: 0.01 },\n    pooling: { type: 'number', group: 'Color & watercolor', label: 'Pigment pooling', default: 0.74, min: 0, max: 2, step: 0.01 },\n    blooms: { type: 'number', group: 'Color & watercolor', label: 'Watercolor blooms', default: 0.94, min: 0, max: 2, step: 0.01 },\n\n    outline: { type: 'number', group: 'Ink & paper', label: 'Boundary width', default: 0.005, min: 0.002, max: 0.03, step: 0.001 },\n    inkWarmth: { type: 'number', group: 'Ink & paper', label: 'Warmth', default: 0.15, min: 0, max: 1, step: 0.01 },\n    handDrawn: { type: 'number', group: 'Ink & paper', label: 'Hand-drawn character', default: 1.34, min: 0, max: 1.5, step: 0.01 },\n    grain: { type: 'number', group: 'Ink & paper', label: 'Grain', default: 1.48, min: 0, max: 2, step: 0.01 },\n\n\n  },\n    controlDescriptions: {pace: 'pace setting for the painting.',\n      motion: 'motion setting for the painting.',\n      phrasing: 'phrasing setting for the painting.',\n      scale: 'scale setting for the painting.',\n      warp: 'warp setting for the painting.',\n      growth: 'growth setting for the painting.',\n      seed: 'seed setting for the painting.',\n      composition: 'composition setting for the painting.',\n      tension: 'tension setting for the painting.',\n      hierarchy: 'hierarchy setting for the painting.',\n      coverage: 'coverage setting for the painting.',\n      spacing: 'spacing setting for the painting.',\n      curvature: 'curvature setting for the painting.',\n      angle: 'angle setting for the painting.',\n      hatchWidth: 'hatchWidth setting for the painting.',\n      relation: 'relation setting for the painting.',\n      spacingVar: 'spacingVar setting for the painting.',\n      curvatureVar: 'curvatureVar setting for the painting.',\n      angleVar: 'angleVar setting for the painting.',\n      palette: 'palette setting for the painting.',\n      warmth: 'warmth setting for the painting.',\n      contrast: 'contrast setting for the painting.',\n      pooling: 'pooling setting for the painting.',\n      blooms: 'blooms setting for the painting.',\n      outline: 'outline setting for the painting.',\n      inkWarmth: 'inkWarmth setting for the painting.',\n      handDrawn: 'handDrawn setting for the painting.',\n      grain: 'grain setting for the painting.'},\n    lifecycle: { state: 'stateful', reset: 'seed' },\n  },\n  async create(context) {\n    const time = uniform(0);\n    const aspect = context.settings.width / context.settings.height;\n    const seed = uniform(7);\n    const scale = uniform(5.4);\n    const warp = uniform(1.3);\n    const motion = uniform(0.8);\n    const growth = uniform(0.65);\n    const coverage = uniform(0.58);\n    const spacing = uniform(0.042);\n    const curvature = uniform(1.3);\n    const angle = uniform(0);\n    const palette = uniform(0.1);\n    const warmth = uniform(1);\n    const contrast = uniform(1);\n    const pooling = uniform(0.8);\n    const outline = uniform(0.008);\n    const hatchWidth = uniform(0.15);\n    const inkWarmth = uniform(0.23);\n    const grain = uniform(1);\n    const composition = uniform(0.9);\n    const handDrawn = uniform(0.85);\n    const blooms = uniform(1.1);\n    const tension = uniform(0.72);\n    const phrasing = uniform(0.85);\n    const relation = uniform(0.74);\n    const hierarchy = uniform(1.0);\n    const spacingVar = uniform(1);\n    const curvatureVar = uniform(1);\n    const angleVar = uniform(1);\n    // Preserve the saved study’s regional weight variety.\n    const widthVar = uniform(0.81);\n    // Bounded texture upload avoids large uniform arrays and uses the exact shared paths.\n    const pathData = new Float32Array(260 * 4);\n    const pathTexture = new DataTexture(pathData, 260, 1, RGBAFormat, FloatType);\n    pathTexture.minFilter = pathTexture.magFilter = NearestFilter;\n    pathTexture.generateMipmaps = false;\n    const material = new MeshBasicNodeMaterial({ depthTest: false, depthWrite: false });\n    material.fragmentNode = painting(\n      uv(),\n      vec4(time, aspect, seed, 0),\n      vec4(scale, warp, motion, growth),\n      vec4(coverage, spacing, curvature, angle),\n      vec4(palette, warmth, contrast, pooling),\n      vec4(outline, hatchWidth, inkWarmth, grain),\n      vec4(composition, handDrawn, blooms, 0),\n      vec4(tension, phrasing, relation, hierarchy),\n      vec4(spacingVar, curvatureVar, angleVar, widthVar),\n      vec4(4, 0, 0, 0),\n      texture(pathTexture),\n    );\n    const geometry = new PlaneGeometry(2, 2);\n    const scene = new Scene();\n    const mesh = new Mesh(geometry, material);\n    mesh.frustumCulled = false;\n    scene.add(mesh);\n    const camera = new OrthographicCamera(-1, 1, 1, -1, 0, 1);\n    let artisticTime = 0;\n    let previousTime = 0;\n    return {\n      update(frame) {\n        const c = frame.controls;\n        artisticTime += Math.max(0, frame.timeSeconds - previousTime) * c.pace;\n        previousTime = frame.timeSeconds;\n        time.value = artisticTime;\n        seed.value = c.seed;\n        scale.value = c.scale;\n        warp.value = c.warp;\n        motion.value = c.motion;\n        growth.value = c.growth;\n        coverage.value = c.coverage;\n        spacing.value = c.spacing;\n        curvature.value = c.curvature;\n        angle.value = c.angle;\n        palette.value = c.palette;\n        warmth.value = c.warmth;\n        contrast.value = c.contrast;\n        pooling.value = c.pooling;\n        outline.value = c.outline;\n        hatchWidth.value = c.hatchWidth;\n        inkWarmth.value = c.inkWarmth;\n        grain.value = c.grain;\n        composition.value = c.composition;\n        handDrawn.value = c.handDrawn;\n        blooms.value = c.blooms;\n        tension.value = c.tension;\n        phrasing.value = c.phrasing;\n        relation.value = c.relation;\n        hierarchy.value = c.hierarchy;\n        spacingVar.value = c.spacingVar;\n        curvatureVar.value = c.curvatureVar;\n        angleVar.value = c.angleVar;\n      },\n      async evaluate(inputs, evaluation) {\n        const paths = (inputs.paths as Paths2DResource).data.paths;\n        if (paths.length > 4 || paths.some(path => path.points.length > 64)) {\n          throw Error('Living Painting supports at most four paths of 64 points.');\n        }\n        pathData.fill(0);\n        paths.forEach((path, index) => {\n          pathData.set([path.points.length, path.opacity, path.styleSeed, path.generation], (256 + index) * 4);\n          path.points.forEach((point, j) => pathData.set([point.x, point.y, point.width, point.distance], (index * 64 + j) * 4));\n        });\n        pathTexture.needsUpdate = true;\n        return { image: await evaluation.render(scene, camera) };\n      },\n      reset(_seed) {\n        artisticTime = 0;\n        previousTime = 0;\n      },\n      dispose() {\n        geometry.dispose();\n        material.dispose();\n        pathTexture.dispose();\n      },\n    };\n  },\n});\n",
      "paths.ts": "import { defineComponent } from '@lux/visual-sdk';\n\nimport {\n  createTracerGenerator,\n  stepTracerGenerator,\n  type PathsSnapshot,\n} from './tracer-state.ts';\n\nexport default defineComponent({\n  metadata: {\n    declarationVersion: 1,\n    key: 'examples/wandering-tracer-paths',\n    label: 'Wandering Tracer Paths',\n    description: 'Generates reusable paths that enter from the canvas perimeter and grow across the frame.',\n    tags: ['tracers', 'generator'],\n    inputs: {},\n    outputs: {\n      paths: {\n        type: { kind: 'paths2d', version: 1, coordinateSpace: 'canvas-height' },\n        label: 'Paths',\n        description: 'Grown tracer paths in centered canvas-height coordinates.',\n      },\n    },\n    controls: {\n      count: { type: 'number', group: 'Tracer paths', label: 'Count', default: 3, min: 0, max: 4, step: 1 },\n      speed: { type: 'number', group: 'Tracer paths', label: 'Speed', default: 0.75, min: 0.1, max: 2, step: 0.01 },\n      curl: { type: 'number', group: 'Tracer paths', label: 'Curl', default: 1, min: 0, max: 2.5, step: 0.01 },\n      sway: { type: 'number', group: 'Tracer paths', label: 'Sway', default: 0.65, min: 0, max: 2, step: 0.01 },\n      seed: { type: 'number', group: 'Tracer paths', label: 'Seed', default: 17, min: 0, max: 999, step: 1 },\n      width: { type: 'number', group: 'Tracer paths', label: 'Width', default: 0.052, min: 0.012, max: 0.12, step: 0.001 },\n      pace: { type: 'number', group: 'Tracer paths', label: 'Pace', default: 1, min: 0, max: 2, step: 0.01 },\n    },\n    controlDescriptions: {\n      count: 'Sets the number of independent tracer lifetimes, up to four.',\n      speed: 'Sets how quickly each tracer head advances through canvas-height space.',\n      curl: 'Sets the stable curvature chosen for each lifetime.',\n      sway: 'Sets a subtle shared-body movement without changing the deposited route.',\n      seed: 'Chooses perimeter entries, headings, pigments, and hatch families.',\n      width: 'Sets the full ribbon width in canvas-height units.',\n      pace: 'Scales artistic time while deposition timestamps remain scene seconds.',\n    },\n    lifecycle: { state: 'stateful', reset: 'seed' },\n  },\n  async create(context) {\n    const aspect = context.settings.width / context.settings.height;\n    let generator = createTracerGenerator(aspect, Math.floor(context.random() * 0x7fff_ffff));\n    let snapshot: PathsSnapshot = Object.freeze({ version: 1, paths: Object.freeze([]) });\n    return {\n      update(frame) {\n        snapshot = stepTracerGenerator(generator, frame, frame.controls);\n      },\n      async evaluate(_inputs, evaluation) {\n        return { paths: evaluation.paths('paths', snapshot) };\n      },\n      reset(seed) {\n        generator = createTracerGenerator(aspect, seed);\n        snapshot = Object.freeze({ version: 1, paths: Object.freeze([]) });\n      },\n      dispose() {\n        snapshot = Object.freeze({ version: 1, paths: Object.freeze([]) });\n      },\n    };\n  },\n});\n",
      "renderer.ts": "import { defineComponent, type ImageResource } from '@lux/visual-sdk';\nimport {\n  BufferGeometry,\n  Color,\n  DoubleSide,\n  Float32BufferAttribute,\n  Mesh,\n  MeshBasicNodeMaterial,\n  OrthographicCamera,\n  PlaneGeometry,\n  Scene,\n  type Texture,\n} from 'three/webgpu';\nimport { texture as textureNode } from 'three/tsl';\n\nimport { buildTracerGeometry, type TracerGeometryOptions } from './tracer-geometry.ts';\n\nexport default defineComponent({\n  metadata: {\n    declarationVersion: 1,\n    key: 'examples/wandering-tracer-renderer',\n    label: 'Wandering Tracer Renderer',\n    description: 'Draws reusable tracer paths over an image with muted pigment, stable hatching, and optional bleed.',\n    tags: ['tracers', 'effect'],\n    inputs: {\n      image: {\n        type: { kind: 'image', colorSpace: 'linear-srgb', alphaMode: 'premultiplied' },\n        label: 'Image',\n        description: 'Background image under the tracer ribbons.',\n      },\n      paths: {\n        type: { kind: 'paths2d', version: 1, coordinateSpace: 'canvas-height' },\n        label: 'Paths',\n        description: 'Tracer path snapshot to draw.',\n      },\n    },\n    outputs: {\n      image: {\n        type: { kind: 'image', colorSpace: 'linear-srgb', alphaMode: 'premultiplied' },\n        label: 'Image',\n        description: 'Background image with tracer ribbons composited over it.',\n      },\n      overlay: {\n        type: { kind: 'image', colorSpace: 'linear-srgb', alphaMode: 'premultiplied' },\n        label: 'Overlay',\n        description: 'Transparent tracer-only image for another compositor.',\n      },\n    },\n    controls: {\n      contrast: { type: 'number', group: 'Tracer appearance', label: 'Contrast', default: 0.55, min: 0, max: 1, step: 0.01 },\n      hatch: { type: 'number', group: 'Tracer appearance', label: 'Hatching', default: 0.8, min: 0, max: 1, step: 0.01 },\n      bleed: { type: 'number', group: 'Tracer appearance', label: 'Bleed', default: 0.65, min: 0, max: 1, step: 0.01 },\n    },\n    controlDescriptions: {\n      contrast: 'Moves each lifetime pigment from quiet watercolor toward a clearer accent.',\n      hatch: 'Sets the opacity and weight of the lifetime-seeded hatch family.',\n      bleed: 'Adds a broad translucent pigment spread around the ribbon.',\n    },\n    lifecycle: { state: 'stateful', reset: 'seed' },\n  },\n  async create(context) {\n    const aspect = context.settings.width / context.settings.height;\n    const camera = new OrthographicCamera(-aspect / 2, aspect / 2, 0.5, -0.5, 0, 1);\n    const imageScene = new Scene();\n    const overlayScene = new Scene();\n    const imageGeometry = new PlaneGeometry(aspect, 1);\n    const imageMaterial = new MeshBasicNodeMaterial({ depthTest: false, depthWrite: false });\n    const imageMesh = new Mesh(imageGeometry, imageMaterial);\n    imageMesh.frustumCulled = false;\n    imageMesh.renderOrder = 0;\n    imageScene.add(imageMesh);\n\n    let input: ImageResource | undefined;\n    let options: TracerGeometryOptions = { contrast: 0.55, hatch: 0.8, bleed: 0.65 };\n    let dynamicGeometries: BufferGeometry[] = [];\n    let dynamicMaterials: MeshBasicNodeMaterial[] = [];\n    let imageMeshes: Mesh[] = [];\n    let overlayMeshes: Mesh[] = [];\n\n    function clearTracers(): void {\n      for (const mesh of imageMeshes) imageScene.remove(mesh);\n      for (const mesh of overlayMeshes) overlayScene.remove(mesh);\n      for (const geometry of dynamicGeometries) geometry.dispose();\n      for (const material of dynamicMaterials) material.dispose();\n      dynamicGeometries = [];\n      dynamicMaterials = [];\n      imageMeshes = [];\n      overlayMeshes = [];\n    }\n\n    function bindImage(source: ImageResource): void {\n      input = source;\n      imageMaterial.fragmentNode = textureNode(source.texture as Texture);\n      imageMaterial.needsUpdate = true;\n    }\n\n    function rebuild(snapshot: Parameters<typeof buildTracerGeometry>[0]): void {\n      clearTracers();\n      const layers = buildTracerGeometry(snapshot, options);\n      for (const [index, layer] of layers.entries()) {\n        if (layer.positions.length === 0 || layer.opacity <= 0) continue;\n        const geometry = new BufferGeometry();\n        geometry.setAttribute('position', new Float32BufferAttribute(layer.positions, 3));\n        const material = new MeshBasicNodeMaterial({\n          color: new Color(layer.color[0], layer.color[1], layer.color[2]),\n          transparent: true,\n          opacity: layer.opacity,\n          depthTest: false,\n          depthWrite: false,\n          side: DoubleSide,\n        });\n        const imageLayer = new Mesh(geometry, material);\n        const overlayLayer = new Mesh(geometry, material);\n        imageLayer.frustumCulled = false;\n        overlayLayer.frustumCulled = false;\n        imageLayer.renderOrder = index + 1;\n        overlayLayer.renderOrder = index + 1;\n        imageScene.add(imageLayer);\n        overlayScene.add(overlayLayer);\n        dynamicGeometries.push(geometry);\n        dynamicMaterials.push(material);\n        imageMeshes.push(imageLayer);\n        overlayMeshes.push(overlayLayer);\n      }\n    }\n\n    return {\n      update(frame) {\n        options = {\n          contrast: frame.controls.contrast,\n          hatch: frame.controls.hatch,\n          bleed: frame.controls.bleed,\n        };\n      },\n      async evaluate(inputs, evaluation) {\n        bindImage(inputs.image);\n        rebuild(inputs.paths.data);\n        const overlay = await evaluation.render(overlayScene, camera, 'overlay');\n        const image = await evaluation.render(imageScene, camera, 'image');\n        return { image, overlay };\n      },\n      reset() {\n        clearTracers();\n      },\n      dispose() {\n        input = undefined;\n        clearTracers();\n        imageGeometry.dispose();\n        imageMaterial.dispose();\n      },\n    };\n  },\n});\n",
      "tracer-geometry.ts": "import type { PathsSnapshot } from './tracer-state.ts';\nimport type { TracerPath, TracerPoint } from './tracer-state.ts';\n\nexport interface TracerGeometryOptions {\n  readonly contrast: number;\n  readonly bleed: number;\n  readonly hatch: number;\n}\n\nexport interface TracerGeometryLayer {\n  readonly kind: 'bleed' | 'core' | 'hatch';\n  readonly color: readonly [number, number, number];\n  readonly opacity: number;\n  readonly positions: readonly number[];\n}\n\nconst PALETTE = [\n  [0.21, 0.35, 0.49],\n  [0.19, 0.47, 0.43],\n  [0.40, 0.48, 0.30],\n  [0.64, 0.51, 0.30],\n  [0.59, 0.38, 0.40],\n  [0.40, 0.32, 0.48],\n] as const;\n\nfunction clamp(value: number, minimum: number, maximum: number): number {\n  return Math.min(maximum, Math.max(minimum, value));\n}\n\nfunction hash01(seed: number): number {\n  let value = Math.trunc(seed) | 0;\n  value = Math.imul(value ^ (value >>> 16), 0x21f0aaad);\n  value = Math.imul(value ^ (value >>> 15), 0x735a2d97);\n  return ((value ^ (value >>> 15)) >>> 0) / 0x1_0000_0000;\n}\n\nfunction pushTriangle(\n  positions: number[],\n  a: readonly [number, number],\n  b: readonly [number, number],\n  c: readonly [number, number],\n): void {\n  positions.push(a[0], a[1], 0, b[0], b[1], 0, c[0], c[1], 0);\n}\n\nfunction tangent(points: readonly TracerPoint[], index: number): readonly [number, number] {\n  const before = points[Math.max(0, index - 1)]!;\n  const after = points[Math.min(points.length - 1, index + 1)]!;\n  const length = Math.hypot(after.x - before.x, after.y - before.y);\n  return length > 1e-8\n    ? [(after.x - before.x) / length, (after.y - before.y) / length]\n    : [1, 0];\n}\n\nfunction addRoundCap(\n  positions: number[],\n  point: TracerPoint,\n  widthScale: number,\n): void {\n  const radius = point.width * widthScale * 0.5;\n  const segments = 12;\n  for (let index = 0; index < segments; index += 1) {\n    const start = index / segments * Math.PI * 2;\n    const end = (index + 1) / segments * Math.PI * 2;\n    pushTriangle(\n      positions,\n      [point.x, point.y],\n      [point.x + Math.cos(start) * radius, point.y + Math.sin(start) * radius],\n      [point.x + Math.cos(end) * radius, point.y + Math.sin(end) * radius],\n    );\n  }\n}\n\nfunction ribbonPositions(path: TracerPath, widthScale: number): number[] {\n  const positions: number[] = [];\n  const points = path.points;\n  if (points.length < 2) return positions;\n  for (let index = 0; index < points.length - 1; index += 1) {\n    const a = points[index]!;\n    const b = points[index + 1]!;\n    const tangentA = tangent(points, index);\n    const tangentB = tangent(points, index + 1);\n    const halfA = a.width * widthScale * 0.5;\n    const halfB = b.width * widthScale * 0.5;\n    const leftA: readonly [number, number] = [a.x - tangentA[1] * halfA, a.y + tangentA[0] * halfA];\n    const rightA: readonly [number, number] = [a.x + tangentA[1] * halfA, a.y - tangentA[0] * halfA];\n    const leftB: readonly [number, number] = [b.x - tangentB[1] * halfB, b.y + tangentB[0] * halfB];\n    const rightB: readonly [number, number] = [b.x + tangentB[1] * halfB, b.y - tangentB[0] * halfB];\n    pushTriangle(positions, leftA, rightA, leftB);\n    pushTriangle(positions, rightA, rightB, leftB);\n  }\n  addRoundCap(positions, points[0]!, widthScale);\n  addRoundCap(positions, points.at(-1)!, widthScale);\n  return positions;\n}\n\nfunction samplePath(path: TracerPath, distance: number): Readonly<{\n  x: number;\n  y: number;\n  width: number;\n  tangentX: number;\n  tangentY: number;\n}> {\n  const points = path.points;\n  let index = 0;\n  while (index < points.length - 2 && points[index + 1]!.distance < distance) index += 1;\n  const a = points[index]!;\n  const b = points[Math.min(index + 1, points.length - 1)]!;\n  const amount = b.distance > a.distance ? clamp((distance - a.distance) / (b.distance - a.distance), 0, 1) : 0;\n  const length = Math.max(Math.hypot(b.x - a.x, b.y - a.y), 1e-8);\n  return {\n    x: a.x + (b.x - a.x) * amount,\n    y: a.y + (b.y - a.y) * amount,\n    width: a.width + (b.width - a.width) * amount,\n    tangentX: (b.x - a.x) / length,\n    tangentY: (b.y - a.y) / length,\n  };\n}\n\nfunction hatchPositions(path: TracerPath, amount: number): number[] {\n  const positions: number[] = [];\n  if (path.points.length < 2 || amount <= 0) return positions;\n  const lastDistance = path.points.at(-1)!.distance;\n  const spacing = 0.045 + hash01(path.styleSeed + 31) * 0.055;\n  const offset = spacing * hash01(path.styleSeed + 47);\n  const hatchAngle = 0.75 + hash01(path.styleSeed + 71) * 0.72;\n  const weight = 0.0012 + amount * 0.0018;\n\n  for (let distance = offset; distance < lastDistance - 0.01; distance += spacing) {\n    const sample = samplePath(path, distance);\n    const directionX = sample.tangentX * Math.cos(hatchAngle) - sample.tangentY * Math.sin(hatchAngle);\n    const directionY = sample.tangentX * Math.sin(hatchAngle) + sample.tangentY * Math.cos(hatchAngle);\n    const normalX = -directionY;\n    const normalY = directionX;\n    const halfLength = sample.width * (0.24 + amount * 0.18);\n    const start: readonly [number, number] = [sample.x - directionX * halfLength, sample.y - directionY * halfLength];\n    const end: readonly [number, number] = [sample.x + directionX * halfLength, sample.y + directionY * halfLength];\n    const a: readonly [number, number] = [start[0] + normalX * weight, start[1] + normalY * weight];\n    const b: readonly [number, number] = [start[0] - normalX * weight, start[1] - normalY * weight];\n    const c: readonly [number, number] = [end[0] + normalX * weight, end[1] + normalY * weight];\n    const d: readonly [number, number] = [end[0] - normalX * weight, end[1] - normalY * weight];\n    pushTriangle(positions, a, b, c);\n    pushTriangle(positions, b, d, c);\n  }\n  return positions;\n}\n\nfunction pigment(styleSeed: number, contrast: number): readonly [number, number, number] {\n  const base = PALETTE[Math.floor(hash01(styleSeed) * PALETTE.length)]!;\n  const strength = 0.72 + clamp(contrast, 0, 1) * 0.42;\n  return [\n    clamp(base[0] * strength, 0, 1),\n    clamp(base[1] * strength, 0, 1),\n    clamp(base[2] * strength, 0, 1),\n  ];\n}\n\nexport function buildTracerGeometry(\n  snapshot: PathsSnapshot,\n  options: TracerGeometryOptions,\n): readonly TracerGeometryLayer[] {\n  const layers: TracerGeometryLayer[] = [];\n  const contrast = clamp(options.contrast, 0, 1);\n  const bleed = clamp(options.bleed, 0, 1);\n  const hatch = clamp(options.hatch, 0, 1);\n  for (const path of snapshot.paths) {\n    if (path.points.length < 2 || path.opacity <= 0) continue;\n    const color = pigment(path.styleSeed, contrast);\n    if (bleed > 0) {\n      layers.push(Object.freeze({\n        kind: 'bleed',\n        color,\n        opacity: path.opacity * bleed * 0.24,\n        positions: Object.freeze(ribbonPositions(path, 2.4 + bleed * 1.2)),\n      }));\n    }\n    layers.push(Object.freeze({\n      kind: 'core',\n      color,\n      opacity: path.opacity,\n      positions: Object.freeze(ribbonPositions(path, 1)),\n    }));\n    if (hatch > 0) {\n      const cream = 0.78 + contrast * 0.18;\n      layers.push(Object.freeze({\n        kind: 'hatch',\n        color: [cream, cream * 0.94, cream * 0.84] as const,\n        opacity: path.opacity * (0.55 + contrast * 0.35),\n        positions: Object.freeze(hatchPositions(path, hatch)),\n      }));\n    }\n  }\n  return Object.freeze(layers);\n}\n",
      "tracer-state.ts": "export interface TracerControls {\n  readonly count: number;\n  readonly speed: number;\n  readonly curl: number;\n  readonly sway: number;\n  readonly seed: number;\n  readonly width: number;\n  readonly pace: number;\n}\n\nexport interface TracerPoint {\n  readonly x: number;\n  readonly y: number;\n  readonly width: number;\n  readonly distance: number;\n  readonly depositionTime: number;\n}\n\nexport interface TracerPath {\n  readonly id: number;\n  readonly generation: number;\n  readonly styleSeed: number;\n  readonly birthTime: number;\n  readonly lifetime: number;\n  readonly phase: number;\n  readonly opacity: number;\n  readonly points: readonly TracerPoint[];\n}\n\nexport interface PathsSnapshot {\n  readonly version: 1;\n  readonly paths: readonly TracerPath[];\n}\n\ninterface DepositedPoint {\n  distance: number;\n  depositionTime: number;\n  width: number;\n}\n\ninterface TracerSlot {\n  id: number;\n  active: boolean;\n  hasSpawned: boolean;\n  generation: number;\n  styleSeed: number;\n  birthTime: number;\n  lifetime: number;\n  distance: number;\n  targetDistance: number;\n  fadeAge: number;\n  spacing: number;\n  nextSampleDistance: number;\n  entryX: number;\n  entryY: number;\n  axisX: number;\n  axisY: number;\n  normalX: number;\n  normalY: number;\n  curvePhase: number;\n  points: DepositedPoint[];\n}\n\nexport interface TracerGenerator {\n  readonly aspect: number;\n  readonly resetSeed: number;\n  readonly slots: TracerSlot[];\n  controlSeed: number | undefined;\n}\n\nconst MAX_TRACERS = 4;\nconst MAX_POINTS = 64;\nconst DISTANCE_PER_SECOND = 0.22;\nconst FADE_ARTISTIC_SECONDS = 2.7;\n\nfunction clamp(value: number, minimum: number, maximum: number): number {\n  return Math.min(maximum, Math.max(minimum, value));\n}\n\nfunction smoothstep(edge0: number, edge1: number, value: number): number {\n  const x = clamp((value - edge0) / (edge1 - edge0), 0, 1);\n  return x * x * (3 - 2 * x);\n}\n\nfunction hash32(value: number): number {\n  let integer = Math.trunc(value) | 0;\n  integer = Math.imul(integer ^ (integer >>> 16), 0x21f0aaad);\n  integer = Math.imul(integer ^ (integer >>> 15), 0x735a2d97);\n  return (integer ^ (integer >>> 15)) >>> 0;\n}\n\nfunction random01(seed: number): number {\n  return hash32(seed) / 0x1_0000_0000;\n}\n\nfunction seedFor(resetSeed: number, controlSeed: number, index: number, generation: number, salt = 0): number {\n  return hash32(\n    Math.trunc(resetSeed) + Math.trunc(controlSeed * 1_000) * 0x9e37 +\n    index * 0x85eb + generation * 0xc2b2 + salt,\n  );\n}\n\nfunction emptySlot(id: number): TracerSlot {\n  return {\n    id,\n    active: false,\n    hasSpawned: false,\n    generation: -1,\n    styleSeed: 0,\n    birthTime: 0,\n    lifetime: 0,\n    distance: 0,\n    targetDistance: 1,\n    fadeAge: 0,\n    spacing: 1 / (MAX_POINTS - 1),\n    nextSampleDistance: 0,\n    entryX: 0,\n    entryY: 0,\n    axisX: 1,\n    axisY: 0,\n    normalX: 0,\n    normalY: 1,\n    curvePhase: 0,\n    points: [],\n  };\n}\n\nexport function createTracerGenerator(aspect: number, resetSeed: number): TracerGenerator {\n  return {\n    aspect: Number.isFinite(aspect) && aspect > 0 ? aspect : 1,\n    resetSeed: Number.isFinite(resetSeed) ? resetSeed : 0,\n    slots: Array.from({ length: MAX_TRACERS }, (_value, index) => emptySlot(index)),\n    controlSeed: undefined,\n  };\n}\n\nfunction pointOnPerimeter(aspect: number, unit: number): readonly [number, number] {\n  const halfWidth = aspect * 0.5;\n  const halfHeight = 0.5;\n  const width = halfWidth * 2;\n  const height = halfHeight * 2;\n  let distance = unit * (2 * width + 2 * height);\n  if (distance < width) return [-halfWidth + distance, -halfHeight];\n  distance -= width;\n  if (distance < height) return [halfWidth, -halfHeight + distance];\n  distance -= height;\n  if (distance < width) return [halfWidth - distance, halfHeight];\n  distance -= width;\n  return [-halfWidth, halfHeight - distance];\n}\n\nfunction rayExitDistance(\n  x: number,\n  y: number,\n  dx: number,\n  dy: number,\n  aspect: number,\n): number {\n  const halfWidth = aspect * 0.5;\n  const candidates = [\n    dx > 1e-8 ? (halfWidth - x) / dx : dx < -1e-8 ? (-halfWidth - x) / dx : Infinity,\n    dy > 1e-8 ? (0.5 - y) / dy : dy < -1e-8 ? (-0.5 - y) / dy : Infinity,\n  ].filter(value => value > 1e-6 && Number.isFinite(value));\n  return Math.max(0.1, Math.min(...candidates));\n}\n\nfunction spawn(\n  generator: TracerGenerator,\n  slot: TracerSlot,\n  index: number,\n  sceneTime: number,\n  controls: TracerControls,\n): void {\n  slot.generation = slot.hasSpawned ? slot.generation + 1 : 0;\n  slot.hasSpawned = true;\n  slot.active = true;\n  const frameSeed = seedFor(generator.resetSeed, controls.seed, index, slot.generation);\n  const [entryX, entryY] = pointOnPerimeter(generator.aspect, random01(frameSeed));\n  const halfWidth = generator.aspect * 0.5;\n  const aimX = (random01(frameSeed + 1) - 0.5) * halfWidth * 0.9;\n  const aimY = (random01(frameSeed + 2) - 0.5) * 0.45;\n  const length = Math.hypot(aimX - entryX, aimY - entryY);\n  const axisX = (aimX - entryX) / Math.max(length, 1e-6);\n  const axisY = (aimY - entryY) / Math.max(length, 1e-6);\n  const targetDistance = rayExitDistance(entryX, entryY, axisX, axisY, generator.aspect);\n  const pace = Math.max(controls.pace, 0.01);\n  const speed = Math.max(controls.speed, 0.01);\n\n  slot.styleSeed = seedFor(generator.resetSeed, controls.seed, index, slot.generation, 0x27d4);\n  slot.birthTime = sceneTime;\n  slot.lifetime = targetDistance / (DISTANCE_PER_SECOND * speed * pace) + FADE_ARTISTIC_SECONDS / pace;\n  slot.distance = 0;\n  slot.targetDistance = targetDistance;\n  slot.fadeAge = 0;\n  slot.spacing = Math.max(targetDistance / (MAX_POINTS - 1), 0.018);\n  slot.nextSampleDistance = slot.spacing;\n  slot.entryX = entryX;\n  slot.entryY = entryY;\n  slot.axisX = axisX;\n  slot.axisY = axisY;\n  slot.normalX = -axisY;\n  slot.normalY = axisX;\n  slot.curvePhase = random01(frameSeed + 3) * Math.PI * 2;\n  slot.points = [{\n    distance: 0,\n    depositionTime: sceneTime,\n    width: Math.max(0.002, controls.width),\n  }];\n}\n\nfunction advance(\n  slot: TracerSlot,\n  frame: Readonly<{ timeSeconds: number; deltaSeconds: number }>,\n  controls: TracerControls,\n): void {\n  const deltaSeconds = Math.max(0, frame.deltaSeconds);\n  const artisticDelta = deltaSeconds * Math.max(0, controls.pace);\n  const oldDistance = slot.distance;\n  const proposedDistance = oldDistance + artisticDelta * Math.max(0, controls.speed) * DISTANCE_PER_SECOND;\n  const nextDistance = Math.min(slot.targetDistance, proposedDistance);\n  const proposedDelta = proposedDistance - oldDistance;\n  const frameStart = frame.timeSeconds - deltaSeconds;\n\n  while (slot.nextSampleDistance <= nextDistance + 1e-10 && slot.points.length < MAX_POINTS - 1) {\n    const fraction = proposedDelta > 1e-10\n      ? clamp((slot.nextSampleDistance - oldDistance) / proposedDelta, 0, 1)\n      : 1;\n    slot.points.push({\n      distance: slot.nextSampleDistance,\n      depositionTime: frameStart + deltaSeconds * fraction,\n      width: Math.max(0.002, controls.width),\n    });\n    slot.nextSampleDistance += slot.spacing;\n  }\n\n  const lastPoint = slot.points.at(-1)!;\n  if (\n    nextDistance >= slot.targetDistance - 1e-10 &&\n    lastPoint.distance < slot.targetDistance - 1e-10 &&\n    slot.points.length < MAX_POINTS\n  ) {\n    const fraction = proposedDelta > 1e-10\n      ? clamp((slot.targetDistance - oldDistance) / proposedDelta, 0, 1)\n      : 1;\n    slot.points.push({\n      distance: slot.targetDistance,\n      depositionTime: frameStart + deltaSeconds * fraction,\n      width: Math.max(0.002, controls.width),\n    });\n  }\n\n  slot.distance = nextDistance;\n  if (proposedDistance > slot.targetDistance) {\n    const unusedDistance = proposedDistance - slot.targetDistance;\n    const rate = Math.max(controls.speed, 1e-6) * DISTANCE_PER_SECOND;\n    slot.fadeAge += unusedDistance / rate;\n  } else if (slot.distance >= slot.targetDistance - 1e-10) {\n    slot.fadeAge += artisticDelta;\n  }\n}\n\nfunction pathPhase(slot: TracerSlot): number {\n  if (slot.distance < slot.targetDistance - 1e-10) {\n    return 0.72 * clamp(slot.distance / slot.targetDistance, 0, 1);\n  }\n  return 0.72 + 0.28 * clamp(slot.fadeAge / FADE_ARTISTIC_SECONDS, 0, 1);\n}\n\nfunction curvedPoint(\n  slot: TracerSlot,\n  deposit: DepositedPoint,\n  sceneTime: number,\n  controls: TracerControls,\n): TracerPoint {\n  const progress = clamp(deposit.distance / slot.targetDistance, 0, 1);\n  const envelope = Math.sin(Math.PI * progress);\n  const curl = clamp(controls.curl, 0, 3) * (\n    Math.sin(deposit.distance * 1.16 + slot.curvePhase) * 0.025 +\n    Math.sin(deposit.distance * 2.31 + slot.curvePhase * 1.7) * 0.011\n  );\n  const sway = clamp(controls.sway, 0, 2) *\n    Math.sin(sceneTime * 0.19 + slot.curvePhase + deposit.distance * 0.61) * 0.012;\n  const offset = (curl + sway) * envelope;\n  return Object.freeze({\n    x: slot.entryX + slot.axisX * deposit.distance + slot.normalX * offset,\n    y: slot.entryY + slot.axisY * deposit.distance + slot.normalY * offset,\n    width: deposit.width,\n    distance: deposit.distance,\n    depositionTime: deposit.depositionTime,\n  });\n}\n\nfunction snapshotPath(slot: TracerSlot, sceneTime: number, controls: TracerControls): TracerPath {\n  const deposits = slot.points.slice();\n  const last = deposits.at(-1)!;\n  if (slot.distance > last.distance + 1e-10 && deposits.length < MAX_POINTS) {\n    deposits.push({\n      distance: slot.distance,\n      depositionTime: sceneTime,\n      width: Math.max(0.002, controls.width),\n    });\n  }\n  const phase = pathPhase(slot);\n  const opacity = 1 - smoothstep(0.82, 1, phase);\n  return Object.freeze({\n    id: slot.id,\n    generation: slot.generation,\n    styleSeed: slot.styleSeed,\n    birthTime: slot.birthTime,\n    lifetime: slot.lifetime,\n    phase,\n    opacity,\n    points: Object.freeze(deposits.map(point => curvedPoint(slot, point, sceneTime, controls))),\n  });\n}\n\nexport function stepTracerGenerator(\n  generator: TracerGenerator,\n  frame: Readonly<{ timeSeconds: number; deltaSeconds: number }>,\n  controls: TracerControls,\n): PathsSnapshot {\n  const sceneTime = Number.isFinite(frame.timeSeconds) ? frame.timeSeconds : 0;\n  const count = clamp(Math.round(controls.count), 0, MAX_TRACERS);\n  const seedChanged = generator.controlSeed !== undefined && generator.controlSeed !== controls.seed;\n  generator.controlSeed = controls.seed;\n  const paths: TracerPath[] = [];\n\n  for (let index = 0; index < generator.slots.length; index += 1) {\n    const slot = generator.slots[index]!;\n    if (index >= count) {\n      slot.active = false;\n      continue;\n    }\n    const needsSpawn = !slot.active || seedChanged;\n    if (needsSpawn) spawn(generator, slot, index, sceneTime, controls);\n    else advance(slot, frame, controls);\n    if (pathPhase(slot) >= 1) spawn(generator, slot, index, sceneTime, controls);\n    paths.push(snapshotPath(slot, sceneTime, controls));\n  }\n\n  return Object.freeze({ version: 1, paths: Object.freeze(paths) });\n}\n"
    }
  },
