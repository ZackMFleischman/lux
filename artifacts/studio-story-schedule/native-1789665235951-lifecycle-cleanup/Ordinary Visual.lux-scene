    "files": {
      "visual.ts": "import {defineVisual} from '@lux/visual-sdk';\nimport {Scene,Mesh,PlaneGeometry,MeshBasicNodeMaterial,OrthographicCamera} from 'three/webgpu';\nimport {vec4} from 'three/tsl';\nexport default defineVisual({controls:{},async create(context){const material=new MeshBasicNodeMaterial();material.fragmentNode=vec4(0.08,0.12,0.18,1);const geometry=new PlaneGeometry(2,2),mesh=new Mesh(geometry,material),scene=new Scene();scene.add(mesh);const camera=new OrthographicCamera(-1,1,1,-1,0,1);return {update(){},render(target){return context.renderer.render(scene,camera,target);},reset(){},dispose(){geometry.dispose();material.dispose();}};}});"
    }
  },
