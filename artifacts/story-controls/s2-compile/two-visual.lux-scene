        "entry": "visual.ts",
        "files": {
          "visual.ts": "import {defineVisual} from '@lux/visual-sdk';import {Scene,PerspectiveCamera,Mesh,PlaneGeometry,MeshBasicMaterial} from 'three/webgpu';export default defineVisual({controls:{amount:{type:'number',label:'Amount',default:1,min:0,max:2}},story:{version:1,beats:{hold:{kind:'sustained',seek:'none'}}},async create({renderer}){const scene=new Scene(),camera=new PerspectiveCamera(45,1,.1,100);camera.position.z=3;const geometry=new PlaneGeometry(2,2),material=new MeshBasicMaterial({color:0x0088ff});scene.add(new Mesh(geometry,material));return {update(){},render(target){renderer.render(scene,camera,target);},reset(){},dispose(){geometry.dispose();material.dispose();}};}});"
        }
