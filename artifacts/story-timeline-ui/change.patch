+.story-header,.story-heading,.story-section-heading,.story-primary-actions,.story-follow-actions,.story-selection{display:flex;align-items:center;gap:8px;min-width:0}
+.story-header{flex-wrap:wrap;padding-bottom:5px;border-bottom:1px solid #383b48}.story-heading{flex:0 1 auto;max-width:35%}.story-state{flex-shrink:0;padding:2px 6px;border-radius:3px;font-size:9px;font-weight:500;text-transform:uppercase;background:#30333e;color:#b9bdca}.story-state-active{background:#3c3854;color:#e6e0ff}
+.story-panel .MuiButton-root{min-height:28px;min-width:0;padding:3px 8px;font-size:11px;line-height:1.3;text-transform:none;flex-shrink:0}.story-primary-actions{gap:4px}.story-follow-actions{margin-left:auto;gap:4px}.story-follow-actions .MuiFormControlLabel-root{margin:0}.story-follow-actions .MuiFormControlLabel-label{font-size:11px}
+.story-active-summary{display:flex;align-items:baseline;gap:6px 12px;margin-top:2px;font-size:11px;color:#aeb3c3}.story-transition{display:flex;flex:1;flex-wrap:wrap;gap:4px 10px;min-width:0}.story-transition strong{color:#d6edea;font-weight:500}.story-active-summary>span{white-space:nowrap;font-variant-numeric:tabular-nums}
+.story-retry{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:6px 0;padding:6px;border:1px solid #8b6d33;border-radius:4px;background:#3b3020;font-size:11px}.story-preparation-failure{margin:6px 0;padding:6px;border:1px solid #92565c;border-radius:4px;background:#40262b;color:#ffdadd;font-size:11px;line-height:1.4}.story-preparation,.story-crossfade{margin:5px 0;font-size:11px}
+.story-sequence{margin-top:4px}.story-section-heading{justify-content:space-between}.story-section-heading>span{font-size:10px;color:#aeb3c3}.story-count{margin-left:6px;color:#969bac;font-size:10px;font-weight:400;letter-spacing:0;text-transform:none}
+.story-ribbon{display:flex;align-items:stretch;gap:4px;overflow-x:auto;margin:4px 0 0;padding:3px 2px 4px;list-style:none;scrollbar-width:thin}.story-ribbon>li{position:relative;flex:var(--story-dwell-weight,1) 0 112px;min-width:112px;max-width:280px;height:58px;border:1px solid #454957;border-radius:3px;background:#252833;overflow:hidden}.story-ribbon>li.story-occurrence-manual{border-style:dashed;background:#25232e}.story-ribbon>li.story-occurrence-selected{outline:2px solid #b2a4f5;outline-offset:0}.story-ribbon>li.story-occurrence-current{border-color:#76d6ca;background:#233c3b}.story-ribbon button{display:flex;flex-direction:column;gap:3px;width:100%;height:100%;padding:7px 9px 18px;border:0;background:transparent;color:inherit;text-align:left;cursor:pointer}.story-ribbon button:focus-visible,.story-beat-select:focus-visible{outline:2px solid #fff;outline-offset:-3px}.story-ribbon button>span:first-child{overflow:hidden;max-width:100%;text-overflow:ellipsis;white-space:nowrap;font-size:12px;font-weight:500}.story-ribbon button small{font-size:10px;color:#b3b7c7}.story-ribbon .story-occurrence-timing{position:absolute;right:7px;bottom:5px;font-size:10px;color:#d0d3de;font-variant-numeric:tabular-nums}.story-occurrence-current .story-occurrence-timing{display:none}.story-cursor{position:absolute;top:0;bottom:0;left:clamp(1px,var(--story-progress,0%),calc(100% - 2px));width:1px;background:#8ee8db;pointer-events:none}.story-cursor:before{content:'';position:absolute;top:0;left:-3px;border-left:4px solid transparent;border-right:4px solid transparent;border-top:5px solid #8ee8db}
+.story-occurrence-manual .story-cursor{left:1px}.story-dwell-progress{position:absolute;bottom:0;left:0;right:0;height:3px;background:#191b22;pointer-events:none}.story-dwell-progress i{display:block;height:100%;background:#69c8bf}.story-dwell-label{position:absolute;bottom:7px;left:8px;right:4px;color:#c3e7e1;font-size:10px;pointer-events:none}
+.story-selection{justify-content:space-between;gap:6px;min-height:28px}.story-selected-detail{font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#c1badb}.story-start-here.MuiButton-root{color:#d2c7ff}.story-local-time{display:flex;align-items:center;gap:10px;margin-top:4px;padding:0;border-top:1px solid #343744}.story-local-time>div{display:flex;align-items:center;gap:8px;font-size:11px;flex-shrink:0}.story-local-time>div:first-child{min-width:0;flex-shrink:1}.story-local-time strong{max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.story-local-time input[type="range"]{flex:1;min-width:70px;min-height:28px;margin:0;accent-color:#b2a4f5}.story-local-time>div>span{white-space:nowrap;font-variant-numeric:tabular-nums}
+.story-beats{display:flex;align-items:center;gap:10px;margin-top:5px;padding-top:5px;border-top:1px solid #343744}.story-beats h3{flex:0 0 auto}.story-beats ul{display:flex;flex:1;min-width:0;gap:5px;overflow-x:auto;margin:0;padding:1px 1px 4px;list-style:none;scrollbar-width:thin}.story-beats li{display:flex;align-items:stretch;flex:0 0 210px;min-width:0;border:1px solid #3d414d;border-radius:3px;background:#242630}.story-beats li.story-beat-active{border-color:#69c8bf;background:#233735}.story-beats li.story-beat-selected{box-shadow:inset 2px 0 #b2a4f5}.story-beat-select{display:flex;flex:1;min-width:0;flex-direction:column;justify-content:center;gap:2px;padding:4px 7px;border:0;background:transparent;color:inherit;text-align:left;cursor:pointer}.story-beat-select span,.story-beat-select small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.story-beat-select span{font-size:11px;font-weight:500}.story-beat-select small{font-size:10px;color:#afb4c4}.story-launch.MuiButton-root{min-width:32px;border-left:1px solid #3d414d;border-radius:0 3px 3px 0}.story-panel>.hint{font-size:11px;margin:5px 0}.status-story{gap:5px}.status-story span:last-child{font-weight:500;color:#d4cef8}
+@container (max-width:620px){.story-heading{max-width:100%;flex:1}.story-follow-actions{flex:1 0 100%;justify-content:flex-end}.story-local-time{flex-wrap:wrap}.story-local-time>div:first-child{flex:1}.story-local-time input[type="range"]{order:2;flex-basis:100%}.story-transition{gap:4px 8px}.story-beats{align-items:flex-start;flex-direction:column;gap:4px}.story-beats ul{width:100%;flex:auto}.story-selected-detail{white-space:normal}.story-active-summary{flex-wrap:wrap}}
 @media (prefers-reduced-motion:reduce){.story-panel *{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
diff --git a/tests/studio/interactions.test.tsx b/tests/studio/interactions.test.tsx
index d055ee92..262b4fd2 100644
--- a/tests/studio/interactions.test.tsx
+++ b/tests/studio/interactions.test.tsx
@@ -1093,3 +1093,18 @@ test('RTL: question mark opens the shortcut reference without intercepting text
   assert.equal(repeatedQuestionMark.defaultPrevented, false, 'repeated question mark is not intercepted');
   assert.equal(screen.getAllByRole('dialog', { name: 'Keyboard shortcuts' }).length, 1);
 });
+
+test('RTL: sequence timing is visible before launch and selection does not alter transport',async()=>{
+  const calls:any[]=[];
+  const {StoryPanel}=await import('../../apps/studio/src/story/StoryPanel.tsx');
+  render(<StoryPanel status={storyStatus()} available controller={{storyTransport:async(...args:any[])=>{calls.push(args);return {};}} as any} onError={()=>{}}/>);
+  const rows=within(screen.getByRole('list',{name:'Story sequence'})).getAllByRole('listitem');
+  assert.match(rows[0]!.textContent??'',/4\.0s/,'show scheduled dwell, not the 10s local beat duration');
+  assert.match(rows[1]!.textContent??'',/Manual cue/,'manual waits are explicit before activation');
+  assert.match(rows[2]!.textContent??'',/5\.0s/);
+  fireEvent.click(within(rows[2]!).getByRole('button'));
+  assert.equal(calls.length,0);
+  fireEvent.click(screen.getByRole('button',{name:/Start here: Hold — occurrence 3 of 3/}));
+  await waitFor(()=>assert.equal(calls.length,1));
+  assert.deepEqual(calls[0][0],{action:'start',occurrenceId:'hold-b'});
+});
