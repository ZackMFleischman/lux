{"format":"lux-scene","version":3,"source":{"sdkVersion":"0.2.0","entry":"visual.ts","files":{"visual.ts":"import { defineVisual } from '@lux/visual-sdk';\nimport {\n  Scene, Color, Mesh, SphereGeometry, MeshStandardNodeMaterial,\n  PerspectiveCamera, AmbientLight, DirectionalLight,\n} from 'three/webgpu';\nimport { uniform, positionLocal, normalLocal, vec3, mx_noise_float } from 'three/tsl';\n\n// SDK 0.2: numeric controls are declared below; color remains a source setting.\nexport default defineVisual({\n  controls: {\ncontrol5:{type:'number',label:'Control 6',group:'Motion 1',min:0,max:2,default:.5},\ncontrol6:{type:'number',label:'Control 7',group:'Motion 1',min:0,max:2,default:.5},\ncontrol7:{type:'number',label:'Control 8',group:'Motion 1',min:0,max:2,default:.5},\ncontrol8:{type:'number',label:'Control 9',group:'Motion 2',min:0,max:2,default:.5},\ncontrol9:{type:'number',label:'Control 10',group:'Motion 2',min:0,max:2,default:.5},\ncontrol10:{type:'number',label:'Control 11',group:'Motion 2',min:0,max:2,default:.5},\ncontrol11:{type:'number',label:'Control 12',group:'Motion 2',min:0,max:2,default:.5},\ncontrol12:{type:'number',label:'Control 13',group:'Motion 2',min:0,max:2,default:.5},\ncontrol13:{type:'number',label:'Control 14',group:'Motion 2',min:0,max:2,default:.5},\ncontrol14:{type:'number',label:'Control 15',group:'Motion 2',min:0,max:2,default:.5},\ncontrol15:{type:'number',label:'Control 16',group:'Motion 2',min:0,max:2,default:.5},\ncontrol16:{type:'number',label:'Control 17',group:'Motion 3',min:0,max:2,default:.5},\ncontrol17:{type:'number',label:'Control 18',group:'Motion 3',min:0,max:2,default:.5},\ncontrol18:{type:'number',label:'Control 19',group:'Motion 3',min:0,max:2,default:.5},\ncontrol19:{type:'number',label:'Control 20',group:'Motion 3',min:0,max:2,default:.5},\ncontrol20:{type:'number',label:'Control 21',group:'Motion 3',min:0,max:2,default:.5},\ncontrol21:{type:'number',label:'Control 22',group:'Motion 3',min:0,max:2,default:.5},\ncontrol22:{type:'number',label:'Control 23',group:'Motion 3',min:0,max:2,default:.5},\ncontrol23:{type:'number',label:'Control 24',group:'Motion 3',min:0,max:2,default:.5},\ncontrol24:{type:'number',label:'Control 25',group:'Motion 4',min:0,max:2,default:.5},\ncontrol25:{type:'number',label:'Control 26',group:'Motion 4',min:0,max:2,default:.5},\ncontrol26:{type:'number',label:'Control 27',group:'Motion 4',min:0,max:2,default:.5},\ncontrol27:{type:'number',label:'Control 28',group:'Motion 4',min:0,max:2,default:.5},\ncontrol28:{type:'number',label:'Control 29',group:'Motion 4',min:0,max:2,default:.5},\ncontrol29:{type:'number',label:'Control 30',group:'Motion 4',min:0,max:2,default:.5},\ncontrol30:{type:'number',label:'Control 31',group:'Motion 4',min:0,max:2,default:.5},\ncontrol31:{type:'number',label:'Control 32',group:'Motion 4',min:0,max:2,default:.5},\ncontrol32:{type:'number',label:'Control 33',group:'Motion 5',min:0,max:2,default:.5},\ncontrol33:{type:'number',label:'Control 34',group:'Motion 5',min:0,max:2,default:.5},\ncontrol34:{type:'number',label:'Control 35',group:'Motion 5',min:0,max:2,default:.5},\ncontrol35:{type:'number',label:'Control 36',group:'Motion 5',min:0,max:2,default:.5},\ncontrol36:{type:'number',label:'Control 37',group:'Motion 5',min:0,max:2,default:.5},\ncontrol37:{type:'number',label:'Control 38',group:'Motion 5',min:0,max:2,default:.5},\ncontrol38:{type:'number',label:'Control 39',group:'Motion 5',min:0,max:2,default:.5},\ncontrol39:{type:'number',label:'Control 40',group:'Motion 5',min:0,max:2,default:.5},\ncontrol40:{type:'number',label:'Control 41',group:'Motion 6',min:0,max:2,default:.5},\ncontrol41:{type:'number',label:'Control 42',group:'Motion 6',min:0,max:2,default:.5},\ncontrol42:{type:'number',label:'Control 43',group:'Motion 6',min:0,max:2,default:.5},\ncontrol43:{type:'number',label:'Control 44',group:'Motion 6',min:0,max:2,default:.5},\ncontrol44:{type:'number',label:'Control 45',group:'Motion 6',min:0,max:2,default:.5},\ncontrol45:{type:'number',label:'Control 46',group:'Motion 6',min:0,max:2,default:.5},\ncontrol46:{type:'number',label:'Control 47',group:'Motion 6',min:0,max:2,default:.5},\ncontrol47:{type:'number',label:'Control 48',group:'Motion 6',min:0,max:2,default:.5},\ncontrol48:{type:'number',label:'Control 49',group:'Motion 7',min:0,max:2,default:.5},\ncontrol49:{type:'number',label:'Control 50',group:'Motion 7',min:0,max:2,default:.5},\ncontrol50:{type:'number',label:'Control 51',group:'Motion 7',min:0,max:2,default:.5},\ncontrol51:{type:'number',label:'Control 52',group:'Motion 7',min:0,max:2,default:.5},\ncontrol52:{type:'number',label:'Control 53',group:'Motion 7',min:0,max:2,default:.5},\ncontrol53:{type:'number',label:'Control 54',group:'Motion 7',min:0,max:2,default:.5},\ncontrol54:{type:'number',label:'Control 55',group:'Motion 7',min:0,max:2,default:.5},\ncontrol55:{type:'number',label:'Control 56',group:'Motion 7',min:0,max:2,default:.5},\ncontrol56:{type:'number',label:'Control 57',group:'Motion 8',min:0,max:2,default:.5},\ncontrol57:{type:'number',label:'Control 58',group:'Motion 8',min:0,max:2,default:.5},\ncontrol58:{type:'number',label:'Control 59',group:'Motion 8',min:0,max:2,default:.5},\ncontrol59:{type:'number',label:'Control 60',group:'Motion 8',min:0,max:2,default:.5},\ncontrol60:{type:'number',label:'Control 61',group:'Motion 8',min:0,max:2,default:.5},\ncontrol61:{type:'number',label:'Control 62',group:'Motion 8',min:0,max:2,default:.5},\ncontrol62:{type:'number',label:'Control 63',group:'Motion 8',min:0,max:2,default:.5},\ncontrol63:{type:'number',label:'Control 64',group:'Motion 8',min:0,max:2,default:.5},\n    spikeHeight: {\n      type: 'number', label: 'Spike height', group: 'Shape', default: 0.85, min: 0, max: 2, step: 0.01,\n    },\n    noiseScale: {\n      type: 'number', label: 'Noise scale', group: 'Shape', default: 3.4, min: 0.5, max: 12, step: 0.1,\n    },\n    sharpness: {\n      type: 'number', label: 'Sharpness', group: 'Shape', default: 3.2, min: 0.25, max: 8, step: 0.05,\n    },\n    motionSpeed: {\n      type: 'number', label: 'Motion speed', default: 0.28, min: 0, max: 2, step: 0.01,\n    },\n    roughness: {\n      type: 'number', label: 'Roughness', default: 0.38, min: 0, max: 1, step: 0.01,\n    },\n  },\n  async create(context) {\n    const time = uniform(0);\n    const spikeHeight = uniform(0.85);\n    const noiseScale = uniform(3.4);\n    const sharpness = uniform(3.2);\n    const drift = vec3(time.mul(0.31), time.mul(0.17), time.mul(0.23));\n    const noise = mx_noise_float(positionLocal.mul(noiseScale).add(drift));\n    const peaks = noise.mul(0.5).add(0.5).clamp(0, 1).pow(sharpness);\n    const material = new MeshStandardNodeMaterial({\n      color: '#8b5cff',\n      roughness: 0.38,\n      metalness: 0.15,\n      flatShading: true,\n    });\n    material.positionNode = positionLocal.add(\n      normalLocal.mul(peaks.mul(spikeHeight)),\n    );\n    const geometry = new SphereGeometry(1, 128, 64);\n    const sphere = new Mesh(geometry, material);\n    // Bound includes maximum GPU displacement, which CPU culling cannot see.\n    geometry.computeBoundingSphere();\n    geometry.boundingSphere!.radius = 3;\n    const scene = new Scene();\n    scene.background = new Color('#070b16');\n    scene.add(sphere, new AmbientLight('#b7c6ff', 1.4));\n    const key = new DirectionalLight('#e4d4ff', 4);\n    key.position.set(3, 4, 5);\n    const rim = new DirectionalLight('#35e6cf', 2.5);\n    rim.position.set(-3, 1, -2);\n    scene.add(key, rim);\n    const camera = new PerspectiveCamera(42, context.settings.width / context.settings.height, 0.1, 30);\n    camera.position.z = 5.6;\n    return {\n      update(frame) {\n        time.value += frame.deltaSeconds * frame.controls.motionSpeed;\n        spikeHeight.value = frame.controls.control63;\n        noiseScale.value = frame.controls.noiseScale;\n        sharpness.value = frame.controls.sharpness;\n        material.roughness = frame.controls.roughness;\n        sphere.rotation.y = frame.timeSeconds * 0.12;\n        sphere.rotation.x = Math.sin(frame.timeSeconds * 0.17) * 0.18;\n      },\n      render(target) {\n        return context.renderer.render(scene, camera, target);\n      },\n      reset(_seed) {\n        time.value = 0;\n      },\n      dispose() {\n        geometry.dispose();\n        material.dispose();\n      },\n    };\n  },\n});\n"}},"settings":{"width":1920,"height":1080,"fps":60,"seed":0},"controls":{"sourceHash":"2641982e22521b4c70846558fee6e9aaa2f79dcaeee0c6a4223bb87c2f40f2a3","schema":[{"id":"control5","type":"number","label":"Control 6","default":0.5,"min":0,"max":2,"group":"Motion 1","changeCost":"live"},{"id":"control6","type":"number","label":"Control 7","default":0.5,"min":0,"max":2,"group":"Motion 1","changeCost":"live"},{"id":"control7","type":"number","label":"Control 8","default":0.5,"min":0,"max":2,"group":"Motion 1","changeCost":"live"},{"id":"control8","type":"number","label":"Control 9","default":0.5,"min":0,"max":2,"group":"Motion 2","changeCost":"live"},{"id":"control9","type":"number","label":"Control 10","default":0.5,"min":0,"max":2,"group":"Motion 2","changeCost":"live"},{"id":"control10","type":"number","label":"Control 11","default":0.5,"min":0,"max":2,"group":"Motion 2","changeCost":"live"},{"id":"control11","type":"number","label":"Control 12","default":0.5,"min":0,"max":2,"group":"Motion 2","changeCost":"live"},{"id":"control12","type":"number","label":"Control 13","default":0.5,"min":0,"max":2,"group":"Motion 2","changeCost":"live"},{"id":"control13","type":"number","label":"Control 14","default":0.5,"min":0,"max":2,"group":"Motion 2","changeCost":"live"},{"id":"control14","type":"number","label":"Control 15","default":0.5,"min":0,"max":2,"group":"Motion 2","changeCost":"live"},{"id":"control15","type":"number","label":"Control 16","default":0.5,"min":0,"max":2,"group":"Motion 2","changeCost":"live"},{"id":"control16","type":"number","label":"Control 17","default":0.5,