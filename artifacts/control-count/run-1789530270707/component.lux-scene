      "ball.ts": "import {defineComponent} from '@lux/visual-sdk';\n import {Scene,Mesh,PlaneGeometry,MeshBasicNodeMaterial,OrthographicCamera} from 'three/webgpu';\n import {uniform,vec3} from 'three/tsl';\n export default defineComponent({metadata:{declarationVersion:1,key:'test/many-controls',label:'Many controls',description:'Control-count test',tags:[],inputs:{},outputs:{image:{type:{kind:'image',colorSpace:'linear-srgb',alphaMode:'premultiplied'},label:'Image',description:'Preview'}},controls:{\"intensity\":{\"type\":\"number\",\"label\":\"Component control 1\",\"group\":\"Motion 1\",\"min\":0,\"max\":1,\"default\":0.5},\"control1\":{\"type\":\"number\",\"label\":\"Component control 2\",\"group\":\"Motion 1\",\"min\":0,\"max\":1,\"default\":0.5},\"control2\":{\"type\":\"number\",\"label\":\"Component control 3\",\"group\":\"Motion 1\",\"min\":0,\"max\":1,\"default\":0.5},\"control3\":{\"type\":\"number\",\"label\":\"Component control 4\",\"group\":\"Motion 1\",\"min\":0,\"max\":1,\"default\":0.5},\"control4\":{\"type\":\"number\",\"label\":\"Component control 5\",\"group\":\"Motion 1\",\"min\":0,\"max\":1,\"default\":0.5},\"control5\":{\"type\":\"number\",\"label\":\"Component control 6\",\"group\":\"Motion 1\",\"min\":0,\"max\":1,\"default\":0.5},\"control6\":{\"type\":\"number\",\"label\":\"Component control 7\",\"group\":\"Motion 1\",\"min\":0,\"max\":1,\"default\":0.5},\"control7\":{\"type\":\"number\",\"label\":\"Component control 8\",\"group\":\"Motion 1\",\"min\":0,\"max\":1,\"default\":0.5},\"control8\":{\"type\":\"number\",\"label\":\"Component control 9\",\"group\":\"Motion 2\",\"min\":0,\"max\":1,\"default\":0.5},\"control9\":{\"type\":\"number\",\"label\":\"Component control 10\",\"group\":\"Motion 2\",\"min\":0,\"max\":1,\"default\":0.5},\"control10\":{\"type\":\"number\",\"label\":\"Component control 11\",\"group\":\"Motion 2\",\"min\":0,\"max\":1,\"default\":0.5},\"control11\":{\"type\":\"number\",\"label\":\"Component control 12\",\"group\":\"M