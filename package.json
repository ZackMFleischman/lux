{
  "name": "lux",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.12.0",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/unit/*.test.ts tests/unit/*.test.mjs",
    "build": "tsc -p tsconfig.build.json && node tools/gpu-spike/build.mjs",
    "native:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native-build.ps1",
    "test:gpu": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-gpu.ps1",
    "test:mcp": "node scripts/test-mcp.mjs",
    "test:studio": "node scripts/unavailable.mjs TR-05 Electron-studio-and-core",
    "test:host": "node scripts/unavailable.mjs TR-06 live-Resolume-and-native-plugin",
    "test:acceptance": "node scripts/unavailable.mjs TR-07 measured-host-acceptance",
    "studio": "node apps/studio/build.mjs && node scripts/studio.mjs",
    "studio:mcp": "node scripts/studio-mcp.mjs",
    "test:studio:cpu": "node apps/studio/test-cpu.mjs",
    "test:studio:smoke": "node apps/studio/build.mjs && node scripts/studio.mjs --smoke",
    "test:studio:mcp": "node apps/studio/build.mjs && node scripts/test-studio-mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "three": "0.186.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@babel/parser": "8.0.5",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.4.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "electron": "44.3.0",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
