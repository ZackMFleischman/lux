{
  "name": "lux",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.12.0",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "transport:prepare": "node scripts/transport-prepare.mjs",
    "transport:play": "node scripts/transport-play.mjs",
    "export:resolume": "node scripts/export-resolume.mjs",
    "test:export": "node --test tests/unit/export-package.test.mjs tests/unit/export-electron-fs.test.mjs tests/unit/install-flow.test.cjs tests/unit/runtime-capability.test.cjs",
    "test:installed:cpu": "node --test tests/unit/installed-registry.test.cjs tests/unit/installed-health.test.cjs tests/unit/installed-health-wiring.test.cjs tests/unit/installed-drain.test.cjs tests/unit/installed-scan.test.cjs",
    "test:installed:package": "node scripts/test-installed-package.mjs",
    "preflight": "node scripts/preflight.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/unit/*.test.ts tests/unit/*.test.mjs",
    "build": "tsc -p tsconfig.build.json && node tools/gpu-spike/build.mjs",
    "native:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native-build.ps1",
    "test:gpu": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-gpu.ps1",
    "test:mcp": "node scripts/test-mcp.mjs",
    "test:studio": "node scripts/unavailable.mjs TR-05 Electron-studio-and-core",
    "test:host": "node scripts/unavailable.mjs TR-06 live-Resolume-and-native-plugin",
    "test:acceptance": "node scripts/unavailable.mjs TR-07 measured-host-acceptance",
    "studio": "node apps/studio/build.mjs && node scripts/studio.mjs",
    "studio:mcp": "node scripts/studio-mcp.mjs",
    "test:studio:cpu": "node apps/studio/test-cpu.mjs",
    "test:studio:smoke": "node apps/studio/build.mjs && node scripts/studio.mjs --smoke",
    "test:studio:mcp": "node apps/studio/build.mjs && node scripts/test-studio-mcp.mjs",
    "test:studio:ui": "node apps/studio/build.mjs && node scripts/test-studio-ui.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@lezer/highlight": "1.2.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "dockview": "7.0.4",
    "dockview-core": "7.0.4",
    "dockview-react": "7.0.4",
    "fast-png": "8.0.0",
    "fflate": "0.8.2",
    "iobuffer": "6.0.1",
    "jpeg-js": "0.4.4",
    "pako": "2.1.0",
    "three": "0.186.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@babel/parser": "8.0.5",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.4.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "electron": "44.3.0",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
