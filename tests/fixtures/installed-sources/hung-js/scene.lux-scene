    "entry": "visual.ts",
    "files": {
      "visual.ts": "import { defineVisual } from '@lux/visual-sdk';\nimport { Scene, Mesh, PlaneGeometry, MeshBasicNodeMaterial, OrthographicCamera } from 'three/webgpu';\nimport { vec4 } from 'three/tsl';\n\nexport default defineVisual({\n  controls: { arm: { type: 'number', label: 'Arm test hang', default: 0, min: 0, max: 1, step: 1 } },\n  async create(context) {\n    const material = new MeshBasicNodeMaterial();\n    material.fragmentNode = vec4(1, 0, 1, 1);\n    const geometry = new PlaneGeometry(1.4, 1.4);\n    const scene = new Scene();\n    scene.add(new Mesh(geometry, material));\n    const camera = new OrthographicCamera(-1, 1, 1, -1, 0, 1);\n    return {\n      update(frame) {\n        if (frame.controls.arm >= 0.5) {\n          console.log('LUX_QA_INSTALLED_HANG_ENTERED');\n          while (true) {}\n        }\n      },\n      render(target) { return context.renderer.render(scene, camera, target); },\n      reset(_seed) {},\n      dispose() { geometry.dispose(); material.dispose(); },\n    };\n  },\n});\n"
    }
  },
  "settings": {
    "width": 1920,
    "height": 1080,
    "fps": 60,
    "seed": 0
  },
