{
  "format": "lux-scene",
  "version": 3,
  "source": {
    "sdkVersion": "0.2.0",
    "entry": "visual.ts",
    "files": {
      "visual.ts": "import { defineVisual } from '@lux/visual-sdk';\nimport { Scene, Mesh, PlaneGeometry, MeshBasicNodeMaterial, OrthographicCamera } from 'three/webgpu';\nimport { uniform, float, uv, select, vec4 } from 'three/tsl';\nexport default defineVisual({\n controls: { probeStep: { type: 'number', label: 'Diagnostic step', default: 0, min: 0, max: 8, step: 1 } },\n async create(context) {\n  const frameNumber=uniform(1),version=uniform(0),bits=[];\n  for(let i=0;i<4;i++)bits.push(version.div(2**i).floor().mod(2));\n  for(let i=0;i<16;i++)bits.push(frameNumber.div(2**i).floor().mod(2));\n  for(let i=0;i<8;i++)bits.push(float((0xa5>>>i)&1));\n  for(let i=0;i<3;i++)bits.push(frameNumber.add(version).mod(8).div(2**i).floor().mod(2));\n  bits.push(version.mod(2));\n  const column=uv().x.mul(32).floor();let shade=select(column.equal(-1),float(0),float(0));\n  for(let i=0;i<32;i++)shade=select(column.equal(i),bits[i],shade);\n  const material=new MeshBasicNodeMaterial();material.fragmentNode=vec4(shade,shade,shade,1);\n  const geometry=new PlaneGeometry(2,2),scene=new Scene();scene.add(new Mesh(geometry,material));\n  const camera=new OrthographicCamera(-1,1,1,-1,0,1);\n  return {update(frame){frameNumber.value=frame.tick+1;version.value=frame.controls.probeStep;},\n   render(target){return context.renderer.render(scene,camera,target);},reset(_seed){},dispose(){geometry.dispose();material.dispose();}};\n }\n});\n"
    }
  },
  "settings": {
    "width": 1920,
    "height": 1080,
    "fps": 60,
    "seed": 0
  },
  "controls": {
    "sourceHash": "22451091702c6ea1e2874ff519fdd80f057fdffd83dde4529c82cffe75bb3fe5",
